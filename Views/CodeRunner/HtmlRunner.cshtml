@{
}

<div class="container-fluid mt-3 px-4">

    <h2 class="mb-3">
        🌐 Interactive HTML & JS Code Playground
    </h2>

    <div class="row"
         style="height: calc(100vh - 140px); min-height: 600px;">

        <!-- ================================================= -->
        <!-- SOURCE CODE EDITOR -->
        <!-- ================================================= -->

        <div class="col-md-6 d-flex flex-column h-100">

            <div class="card border-0 shadow-sm flex-grow-1 d-flex flex-column bg-light p-2">

                <label class="form-label fw-bold text-secondary mb-1">
                    ✍️ Source Code Editor:
                </label>

                <textarea id="codeEditor"
                          class="form-control font-monospace p-3 text-white bg-dark flex-grow-1"
                          style="resize: none;
                font-size: 0.9rem;
                line-height: 1.4;"></textarea>

                <button type="button"
                        id="runBtn"
                        class="btn btn-success btn-lg w-100 mt-2 shadow-sm fw-bold">
                    ▶ Render & Run Code
                </button>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- OUTPUT SECTION -->
        <!-- ================================================= -->

        <div class="col-md-6 d-flex flex-column h-100 mt-3 mt-md-0">

            <!-- ================================================= -->
            <!-- LIVE PREVIEW -->
            <!-- ================================================= -->

            <div class="card border-0 shadow-sm mb-3"
                 style="height: 65%;">

                <div class="card-header bg-secondary bg-opacity-10 fw-bold text-secondary py-2">

                    🖥️ Live Preview Screen

                </div>

                <div class="card-body p-0 h-100">

                    <iframe id="previewFrame"
                            sandbox="allow-scripts allow-modals allow-same-origin"
                            class="w-100 h-100 border-0"
                            style="background-color: #ffffff;">
                    </iframe>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ERROR CONSOLE -->
            <!-- ================================================= -->

            <div class="card border-0 shadow-sm flex-grow-1 bg-dark text-white font-monospace"
                 style="height: 30%;">

                <div class="card-header bg-danger bg-opacity-25 fw-bold text-danger py-2 border-bottom border-secondary">

                    🐞 JavaScript Console / Error Logs

                </div>

                <div id="errorConsole"
                     class="card-body p-3 overflow-auto text-success"
                     style="font-size: 0.85rem; max-height: 150px;">

                    Waiting for code...

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->

<script>

    // =========================================================
    // GET ELEMENTS
    // =========================================================

    const codeEditor =
        document.getElementById("codeEditor");

    const previewFrame =
        document.getElementById("previewFrame");

    const runBtn =
        document.getElementById("runBtn");

    const errorConsole =
        document.getElementById("errorConsole");


    // =========================================================
    // RENDER CODE
    // =========================================================

    function renderCode() {

        // IMPORTANT:
        // Always get the latest code from Source Code Editor

        const sourceCode =
            codeEditor.value;


        console.log(
            "Render & Run clicked"
        );

        console.log(
            "Latest Editor Code:",
            sourceCode
        );


        // =====================================================
        // CLEAR ERROR CONSOLE
        // =====================================================

        errorConsole.innerHTML =
            '<span class="text-muted">Console reset. Running script...</span><br/>';


        // =====================================================
        // CHECK EMPTY CODE
        // =====================================================

        if (!sourceCode.trim()) {

            previewFrame.srcdoc = "";

            errorConsole.innerHTML =
                '<span class="text-muted">Waiting for code...</span>';

            return;

        }


        // =====================================================
        // RENDER CURRENT EDITOR CODE
        // =====================================================

        previewFrame.srcdoc =
            sourceCode;


        // =====================================================
        // JAVASCRIPT ERROR HANDLING
        // =====================================================

        previewFrame.onload = function() {

            try {

                previewFrame.contentWindow.onerror =
                    function(
                        message,
                        source,
                        lineno,
                        colno,
                        error
                    ) {

                        const errorElement =
                            document.createElement("div");


                        errorElement.className =
                            "text-danger fw-bold mt-1";


                        errorElement.innerHTML =
                            `💥 Runtime Error: ${message}
                                <br/>
                                <span class="text-secondary">
                                    (Line: ${lineno}, Col: ${colno})
                                </span>`;


                        errorConsole.appendChild(
                            errorElement
                        );


                        errorConsole.scrollTop =
                            errorConsole.scrollHeight;


                        return false;

                    };

            }
            catch (error) {

                console.error(
                    "Preview Error:",
                    error
                );

            }

        };

    }


    // =========================================================
    // RUN BUTTON
    // =========================================================

    runBtn.addEventListener(
        "click",
        function(event) {

            event.preventDefault();


            console.log(
                "Render & Run button clicked"
            );


            // IMPORTANT:
            // Run ONLY when user clicks the button

            renderCode();

        }
    );


    // =========================================================
    // LOAD CODE FROM TRY IT BUTTON
    // =========================================================

    function loadTryItCode() {

        const urlParams =
            new URLSearchParams(
                window.location.search
            );


        const encodedCode =
            urlParams.get("code");


        // =====================================================
        // NO CODE RECEIVED
        // =====================================================

        if (!encodedCode) {

            codeEditor.value = "";

            previewFrame.srcdoc = "";

            errorConsole.innerHTML =
                '<span class="text-muted">Waiting for code...</span>';

            return;

        }


        // =====================================================
        // DECODE BASE64 CODE
        // =====================================================

        try {

            let base64 =
                encodedCode
                    .replace(/-/g, "+")
                    .replace(/_/g, "/");


            // =================================================
            // ADD MISSING BASE64 PADDING
            // =================================================

            while (
                base64.length % 4 !== 0
            ) {

                base64 += "=";

            }


            // =================================================
            // DECODE
            // =================================================

            const decodedCode =
                decodeURIComponent(
                    escape(
                        window.atob(base64)
                    )
                );


            // =================================================
            // PUT CODE INTO EDITOR
            // =================================================

            codeEditor.value =
                decodedCode;


            // =================================================
            // IMPORTANT
            // =================================================
            // DO NOT CALL renderCode() HERE.
            //
            // Preview must remain blank until
            // user clicks "Render & Run Code".
            // =================================================

            previewFrame.srcdoc = "";


            errorConsole.innerHTML =
                '<span class="text-muted">' +
                'Code loaded. Click "Render & Run Code" to see the output.' +
                '</span>';

        }
        catch (error) {

            console.error(
                "Code Decode Error:",
                error
            );


            codeEditor.value = "";

            previewFrame.srcdoc = "";


            errorConsole.innerHTML =
                '<span class="text-danger fw-bold">' +
                '❌ Unable to load HTML code.' +
                '</span>';

        }

    }


    // =========================================================
    // PAGE LOAD
    // =========================================================

    window.addEventListener(
        "DOMContentLoaded",
        function() {

            loadTryItCode();

        }
    );

</script>

