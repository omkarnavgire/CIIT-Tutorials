﻿@{
ViewData["Title"] = "Full Stack Java";
}

<style>
    .fullstack-java-page {
        background: #ffffff;
        padding: 55px 20px 70px;
        min-height: 600px;
    }

    .fullstack-java-container {
        max-width: 1450px;
        margin: 0 auto;
        display: flex;
        gap: 40px;
        align-items: flex-start;
    }

    /* =========================
                   COURSES SIDEBAR
                   ========================= */

    .courses-sidebar {
        width: 285px;
        flex-shrink: 0;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.07);
        overflow: hidden;
        position: sticky;
        top: 20px;
    }

    .courses-sidebar-title {
        background: #f8fafc;
        padding: 20px 24px;
        font-size: 22px;
        color: #111827;
        border-bottom: 1px solid #e5e7eb;
        margin: 0;
    }

    .courses-list {
        display: flex;
        flex-direction: column;
    }

    .course-link {
        display: block;
        padding: 17px 24px;
        text-decoration: none;
        color: #374151;
        font-size: 16px;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s ease;
    }

        .course-link:hover {
            background: #f0f7ff;
            color: #1677ff;
        }

        .course-link.active {
            background: #eef6ff;
            color: #1677ff;
            border-left: 5px solid #1677ff;
            padding-left: 19px;
        }

    /* =========================
                   MAIN CONTENT
                   ========================= */

    .fullstack-java-main {
        flex: 1;
        min-width: 0;
    }

    .fullstack-java-header {
        text-align: center;
        margin-bottom: 45px;
    }

    .fullstack-java-title {
        font-size: 42px;
        color: #111827;
        margin-bottom: 12px;
    }

    .fullstack-java-subtitle {
        font-size: 18px;
        color: #6b7280;
        margin: 0;
    }

    /* =========================
                   JAVA TOPIC CARDS
                   ========================= */

    .java-topic-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .java-topic-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 30px 22px;
        min-height: 190px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .java-topic-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.10);
        }

    .java-topic-icon {
        font-size: 42px;
        margin-bottom: 15px;
        line-height: 1;
    }

    .java-topic-title {
        font-size: 21px;
        color: #111827;
        margin: 0;
    }

    .java-topic-text {
        font-size: 14px;
        color: #6b7280;
        margin-top: 8px;
        margin-bottom: 0;
    }

    /* =========================
                   RESPONSIVE
                   ========================= */

    @@media (max-width: 1150px) {
        .java-topic-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 800px) {
        .fullstack-java-container {
            flex-direction: column;
        }

        .courses-sidebar {
            width: 100%;
            position: static;
        }

        .courses-list {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .course-link {
            flex: 1;
            min-width: 180px;
            text-align: center;
        }

        .java-topic-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .java-topic-grid {
            grid-template-columns: 1fr;
        }

        .fullstack-java-title {
            font-size: 32px;
        }

        .course-link {
            width: 100%;
            flex: 100%;
        }
    }
</style>


