@{
    ViewData["Title"] = "Angular Event Handling Introduction";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Event Handling Introduction</h1>
        <p class="lead text-muted">
            Learn how Angular handles user interactions such as clicks, keyboard actions,
            input changes, mouse events and form submissions.
        </p>
        <div class="info-card">
            <strong>CIIT Training Institute:</strong>
            Event handling helps you build interactive Angular applications by responding
            to actions performed by users.
        </div>
    </section>

    <!-- WHAT IS EVENT HANDLING -->
    <section class="mb-4">
        <h2 class="fw-bold">What is Event Handling?</h2>

        <p>
            Event handling in Angular is the process of responding to actions performed
            by the user on a web page.
        </p>

        <p>
            For example, when <strong>Sam</strong> clicks a button, Angular can execute
            a component method. Similarly, when <strong>Pradnya</strong> types inside
            an input box, Angular can capture the entered value.
        </p>

        <div class="syntax-flow">
            <div class="syntax-box">
                <span class="syntax-icon">1</span>
                <strong>User Action</strong>
                <small>Click / Input / Key</small>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <span class="syntax-icon">2</span>
                <strong>DOM Event</strong>
                <small>Browser detects event</small>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <span class="syntax-icon">3</span>
                <strong>Angular Binding</strong>
                <small>(click), (input)</small>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <span class="syntax-icon">4</span>
                <strong>Component Method</strong>
                <small>Business logic</small>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <span class="syntax-icon">5</span>
                <strong>UI Update</strong>
                <small>Updated screen</small>
            </div>
        </div>
    </section>

    <!-- COMMON EVENTS -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Angular Events</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">🖱️</div>
                <h5>Click Events</h5>
                <p>
                    Execute an action when the user clicks a button or element.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">⌨️</div>
                <h5>Input Events</h5>
                <p>
                    Capture values while the user types inside an input field.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">🔤</div>
                <h5>Keyboard Events</h5>
                <p>
                    Handle keyboard actions such as keyup and keydown.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">📝</div>
                <h5>Form Events</h5>
                <p>
                    Handle form submission and changes in form controls.
                </p>
            </div>

        </div>
    </section>

    <!-- EVENT BINDING SYNTAX -->
    <section class="mb-4">
        <h2 class="fw-bold">Angular Event Binding Syntax</h2>

        <p>
            Angular uses parentheses <strong>()</strong> to bind DOM events.
        </p>

        <div class="code-card">
            <div class="code-title">HTML Template</div>

            <pre><code>&lt;button (click)="showMessage()"&gt;
    Click Me
&lt;/button&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Explanation:</strong>

            <div class="output-preview">
                <p class="mb-2">
                    <strong>(click)</strong> → Angular event binding
                </p>

                <p class="mb-2">
                    <strong>showMessage()</strong> → Component method
                </p>

                <button class="btn btn-primary">
                    Click Me
                </button>
            </div>
        </div>
    </section>

    <!-- COMPONENT METHOD -->
    <section class="mb-4">
        <h2 class="fw-bold">Handling Event in Component</h2>

        <p>
            The event can call a method defined inside the Angular component class.
        </p>

        <div class="code-card">
            <div class="code-title">student.component.ts</div>

            <pre><code>showMessage() {
    console.log('Welcome to CIIT Training Institute');
}</code></pre>
        </div>

        <div class="info-card">
            When the button is clicked, Angular calls the
            <strong>showMessage()</strong> method.
        </div>
    </section>

    <!-- EVENT OBJECT -->
    <section class="mb-4">
        <h2 class="fw-bold">Using the Event Object</h2>

        <p>
            Angular provides the <strong>$event</strong> object when we need information
            about the event that occurred.
        </p>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;input
    type="text"
    (input)="onInput($event)"
    placeholder="Enter your name"&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">TypeScript</div>

            <pre><code>onInput(event: Event) {

    const value =
        (event.target as HTMLInputElement).value;

    console.log(value);
}</code></pre>
        </div>

        <div class="output-box">
            <strong>Example:</strong>

            <div class="output-preview">
                <label class="form-label">
                    Enter Student Name
                </label>

                <input type="text"
                       class="form-control"
                       placeholder="Type something...">

                <p class="mt-3 mb-0 text-muted">
                    Angular can capture the value entered by the user.
                </p>
            </div>
        </div>
    </section>

    <!-- EVENT TYPES TABLE -->
    <section class="mb-4">
        <h2 class="fw-bold">Common DOM Events</h2>

        <div class="table-responsive">
            <table class="table table-bordered syntax-table">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Syntax</th>
                        <th>When It Occurs</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Click</td>
                        <td>(click)</td>
                        <td>When an element is clicked</td>
                    </tr>

                    <tr>
                        <td>Double Click</td>
                        <td>(dblclick)</td>
                        <td>When an element is double-clicked</td>
                    </tr>

                    <tr>
                        <td>Input</td>
                        <td>(input)</td>
                        <td>When input value changes while typing</td>
                    </tr>

                    <tr>
                        <td>Change</td>
                        <td>(change)</td>
                        <td>When an input value changes</td>
                    </tr>

                    <tr>
                        <td>Key Up</td>
                        <td>(keyup)</td>
                        <td>When a keyboard key is released</td>
                    </tr>

                    <tr>
                        <td>Key Down</td>
                        <td>(keydown)</td>
                        <td>When a keyboard key is pressed</td>
                    </tr>

                    <tr>
                        <td>Mouse Enter</td>
                        <td>(mouseenter)</td>
                        <td>When mouse enters an element</td>
                    </tr>

                    <tr>
                        <td>Mouse Leave</td>
                        <td>(mouseleave)</td>
                        <td>When mouse leaves an element</td>
                    </tr>

                    <tr>
                        <td>Submit</td>
                        <td>(submit)</td>
                        <td>When a form is submitted</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- COMPLETE EXAMPLE -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete Example – CIIT Student Selection</h2>

        <p>
            Let's create a simple example where CIIT students can be selected using
            buttons.
        </p>

        <div class="code-card">
            <div class="code-title">student.component.html</div>

            <pre><code>&lt;h3&gt;CIIT Training Institute&lt;/h3&gt;

&lt;button
    (click)="selectStudent('Sam')"
    class="btn btn-primary me-2"&gt;
    Sam
&lt;/button&gt;

&lt;button
    (click)="selectStudent('Pradnya')"
    class="btn btn-primary me-2"&gt;
    Pradnya
&lt;/button&gt;

&lt;button
    (click)="selectStudent('Samiksha')"
    class="btn btn-primary"&gt;
    Samiksha
&lt;/button&gt;

&lt;p&gt;
    Selected Student: &#123;&#123; selectedStudent &#125;&#125;
&lt;/p&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">student.component.ts</div>

            <pre><code>selectedStudent = '';

selectStudent(name: string) {
    this.selectedStudent = name;
}</code></pre>
        </div>

        <div class="student-preview">
            <h4 class="fw-bold mb-3">
                CIIT Training Institute
            </h4>

            <p class="text-muted">
                Select a student:
            </p>

            <div class="mb-3">
                <button class="btn btn-primary me-2 mb-2">
                    Sam
                </button>

                <button class="btn btn-primary me-2 mb-2">
                    Pradnya
                </button>

                <button class="btn btn-primary mb-2">
                    Samiksha
                </button>
            </div>

            <div class="alert alert-light border mb-0">
                <strong>Selected Student:</strong>
                Sam
            </div>
        </div>
    </section>

    <!-- EVENT FLOW -->
    <section class="mb-4">
        <h2 class="fw-bold">Event Handling Flow</h2>

        <div class="binding-flow">

            <div class="binding-item">
                <strong>1. User</strong>
                <span>Clicks button</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>2. Event</strong>
                <span>click event occurs</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>3. Angular</strong>
                <span>(click) detects event</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>4. Method</strong>
                <span>selectStudent()</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>5. UI</strong>
                <span>Student name updates</span>
            </div>

        </div>
    </section>

    <!-- BEST PRACTICES -->
    <section class="mb-4">
        <h2 class="fw-bold">Event Handling Best Practices</h2>

        <ul class="best-practice-list">
            <li>Keep event handler methods small and readable.</li>
            <li>Use meaningful method names such as <strong>selectStudent()</strong>.</li>
            <li>Use <strong>$event</strong> when event information is required.</li>
            <li>Avoid putting complex business logic directly inside templates.</li>
            <li>Use appropriate DOM events for the required interaction.</li>
            <li>Keep reusable logic inside services when required.</li>
            <li>Follow consistent naming conventions in Angular components.</li>
        </ul>
    </section>

    <!-- SUMMARY -->
    <section class="mb-4">
        <div class="summary-box">
            <h4 class="fw-bold">Summary</h4>

            <p class="mb-2">
                Angular event handling allows applications to respond to user actions.
            </p>

            <ul class="mb-0">
                <li>Events make Angular applications interactive.</li>
                <li>Parentheses <strong>()</strong> are used for event binding.</li>
                <li>Methods can be called when events occur.</li>
                <li><strong>$event</strong> provides event information.</li>
                <li>Angular supports click, input, keyboard, mouse and form events.</li>
                <li>CIIT Training Institute examples help students understand real-world event handling.</li>
            </ul>
        </div>
    </section>

    <!-- NAVIGATION -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("CustomPipes", "Pipes", new { area = "Angular" })">
            ← Previous
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("DOMEvents", "EventHandling", new { area = "Angular" })">
            Next →
        </a>

    </div>

</div>

<style>

    .info-card {
        background: #ede9fe;
        border-left: 5px solid #4c1d95;
        padding: 18px 20px;
        border-radius: 10px;
        color: #334155;
    }

    .syntax-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 25px;
    }

    .syntax-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 18px;
        text-align: center;
        min-width: 145px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }

        .syntax-box strong {
            display: block;
            color: #2e1065;
            margin-top: 8px;
        }

        .syntax-box small {
            color: #64748b;
        }

    .syntax-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .syntax-arrow {
        font-size: 25px;
        color: #4c1d95;
        font-weight: bold;
    }

    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }

        .syntax-card h5 {
            margin-top: 15px;
            font-weight: 700;
            color: #2e1065;
        }

        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
        }

    .code-card {
        background: #0f172a;
        border-radius: 10px;
        overflow: hidden;
        margin: 20px 0;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.12);
    }

    .code-title {
        background: #1e293b;
        color: #d8c9f5;
        padding: 10px 16px;
        font-weight: 600;
    }

    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }

    .code-card code {
        color: #f8fafc;
        font-size: 14px;
        line-height: 1.7;
    }

    .output-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        margin-top: 20px;
    }

    .output-preview {
        background: #ffffff;
        border: 1px solid #ddd6fe;
        border-radius: 10px;
        padding: 20px;
        margin-top: 12px;
    }

    .syntax-table {
        background: #ffffff;
        margin-top: 20px;
    }

        .syntax-table th {
            background: #4c1d95;
            color: #ffffff;
        }

        .syntax-table td,
        .syntax-table th {
            padding: 12px;
            vertical-align: middle;
        }

    .student-preview {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 25px;
        margin-top: 20px;
    }

    .binding-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
    }

    .binding-item {
        background: #ede9fe;
        border: 1px solid #ddd6fe;
        border-radius: 10px;
        padding: 15px 20px;
        text-align: center;
        min-width: 150px;
    }

        .binding-item strong {
            display: block;
            color: #2e1065;
        }

        .binding-item span {
            color: #64748b;
            font-size: 14px;
        }

    .best-practice-list {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px 25px 22px 45px;
    }

        .best-practice-list li {
            margin-bottom: 10px;
            color: #334155;
        }

            .best-practice-list li:last-child {
                margin-bottom: 0;
            }

    .summary-box {
        background: #cfe2ff;
        color: #084298;
        border-radius: 10px;
        padding: 22px;
    }

        .summary-box h4 {
            color: #084298;
        }

    @@media (max-width: 991px) {

        .syntax-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syntax-flow {
            gap: 8px;
        }

        .syntax-arrow {
            font-size: 20px;
        }
    }

    @@media (max-width: 576px) {

        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-box {
            width: 100%;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }

        .binding-flow {
            flex-direction: column;
        }

        .binding-item {
            width: 100%;
        }

        .binding-flow .syntax-arrow {
            transform: rotate(90deg);
        }

        .code-card code {
            font-size: 13px;
        }

        .student-preview {
            padding: 18px;
        }
    }

</style>