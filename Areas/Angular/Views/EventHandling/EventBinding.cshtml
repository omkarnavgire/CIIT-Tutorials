@{
    ViewData["Title"] = "Angular Event Binding";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">
            Event Binding in Angular
        </h1>

        <p class="lead text-muted">
            Learn how Angular connects DOM events with component methods using
            event binding syntax.
        </p>

        <div class="info-card">

            <h5>CIIT Training Institute</h5>

            <p>
                Event binding makes Angular applications interactive by allowing
                the component to respond to actions performed by users.
            </p>

        </div>

    </section>


    <!-- What is Event Binding -->
    <section class="mb-4">

        <h2 class="fw-bold">
            What is Event Binding?
        </h2>

        <p>
            Event binding is an Angular feature used to listen for events
            generated by HTML elements and execute component methods.
        </p>

        <p>
            Angular uses parentheses <strong>()</strong> around the event name
            to create an event binding.
        </p>

        <div class="syntax-flow">

            <div class="syntax-box">
                <i>👤</i>
                <strong>User</strong>
                <span>Performs an action</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <i>⚡</i>
                <strong>DOM Event</strong>
                <span>click / input / keyup</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <i>🔗</i>
                <strong>Event Binding</strong>
                <span>(click)</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <i>🔧</i>
                <strong>Component Method</strong>
                <span>Method executes</span>
            </div>

        </div>

    </section>


    <!-- Basic Syntax -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Event Binding Syntax
        </h2>

        <div class="code-card">

            <div class="code-title">
                Basic Syntax
            </div>

            <pre><code>&lt;element (event)="method()"&gt;
    Content
&lt;/element&gt;</code></pre>

        </div>

        <div class="info-card">

            <p>
                <strong>(event)</strong> represents the DOM event and
                <strong>method()</strong> represents the component method
                that should execute when the event occurs.
            </p>

        </div>

    </section>


    <!-- Click Event Binding -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Click Event Binding
        </h2>

        <p>
            The most common event binding is the <strong>click</strong> event.
        </p>

        <div class="code-card">

            <div class="code-title">
                student.component.html
            </div>

            <pre><code>&lt;button (click)="welcomeStudent()"&gt;
    Welcome
&lt;/button&gt;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                student.component.ts
            </div>

            <pre><code>welcomeStudent() {

    console.log(
        'Welcome to CIIT Training Institute'
    );

}</code></pre>

        </div>

        <div class="output-box">

            <strong>Output:</strong>

            <div class="student-preview">

                <h4 class="fw-bold">
                    CIIT Training Institute
                </h4>

                <button class="btn btn-primary">
                    Welcome
                </button>

                <p class="mt-3 mb-0 text-muted">
                    Clicking the button calls
                    <strong>welcomeStudent()</strong>.
                </p>

            </div>

        </div>

    </section>


    <!-- Passing Data -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Passing Data with Event Binding
        </h2>

        <p>
            We can pass values from the template to the component method
            when an event occurs.
        </p>

        <div class="code-card">

            <div class="code-title">
                HTML
            </div>

            <pre><code>&lt;button
    (click)="selectStudent('Sam')"&gt;
    Sam
&lt;/button&gt;

&lt;button
    (click)="selectStudent('Pradnya')"&gt;
    Pradnya
&lt;/button&gt;

&lt;button
    (click)="selectStudent('Samiksha')"&gt;
    Samiksha
&lt;/button&gt;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                TypeScript
            </div>

            <pre><code>selectStudent(name: string) {

    console.log(
        'Selected student: ' + name
    );

}</code></pre>

        </div>

    </section>


    <!-- Event with $event -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Event Binding with $event
        </h2>

        <p>
            Angular provides the <strong>$event</strong> object when we need
            information about the event.
        </p>

        <div class="code-card">

            <div class="code-title">
                HTML
            </div>

            <pre><code>&lt;input
    type="text"
    (input)="onInput($event)"
    placeholder="Enter student name"&gt;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                TypeScript
            </div>

            <pre><code>onInput(event: Event) {

    const name =
        (event.target as HTMLInputElement).value;

    console.log(name);

}</code></pre>

        </div>

    </section>


    <!-- Multiple Events -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Multiple Event Bindings
        </h2>

        <p>
            Multiple events can be handled on the same element.
        </p>

        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>&lt;input
    (focus)="onFocus()"
    (input)="onInput($event)"
    (blur)="onBlur()"&gt;</code></pre>

        </div>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="event-icon">
                    🔍
                </div>

                <h5>Focus</h5>

                <p>
                    Executes when the input receives focus.
                </p>

                <code>
                    (focus)
                </code>

            </div>

            <div class="syntax-card">

                <div class="event-icon">
                    ⌨️
                </div>

                <h5>Input</h5>

                <p>
                    Executes when the user changes the input value.
                </p>

                <code>
                    (input)
                </code>

            </div>

            <div class="syntax-card">

                <div class="event-icon">
                    👋
                </div>

                <h5>Blur</h5>

                <p>
                    Executes when the input loses focus.
                </p>

                <code>
                    (blur)
                </code>

            </div>

            <div class="syntax-card">

                <div class="event-icon">
                    🖱️
                </div>

                <h5>Click</h5>

                <p>
                    Executes when the element is clicked.
                </p>

                <code>
                    (click)
                </code>

            </div>

        </div>

    </section>


    <!-- Event Binding Table -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Common Event Binding Syntax
        </h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>
                        <th>Event</th>
                        <th>Angular Syntax</th>
                        <th>Purpose</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>Click</td>
                        <td><code>(click)</code></td>
                        <td>Handle button or element clicks</td>
                    </tr>

                    <tr>
                        <td>Double Click</td>
                        <td><code>(dblclick)</code></td>
                        <td>Handle double-click actions</td>
                    </tr>

                    <tr>
                        <td>Input</td>
                        <td><code>(input)</code></td>
                        <td>Capture input changes</td>
                    </tr>

                    <tr>
                        <td>Change</td>
                        <td><code>(change)</code></td>
                        <td>Handle value changes</td>
                    </tr>

                    <tr>
                        <td>Key Down</td>
                        <td><code>(keydown)</code></td>
                        <td>Handle key press</td>
                    </tr>

                    <tr>
                        <td>Key Up</td>
                        <td><code>(keyup)</code></td>
                        <td>Handle key release</td>
                    </tr>

                    <tr>
                        <td>Focus</td>
                        <td><code>(focus)</code></td>
                        <td>Handle focus event</td>
                    </tr>

                    <tr>
                        <td>Blur</td>
                        <td><code>(blur)</code></td>
                        <td>Handle focus loss</td>
                    </tr>

                    <tr>
                        <td>Submit</td>
                        <td><code>(submit)</code></td>
                        <td>Handle form submission</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- Complete Example -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Complete Example – CIIT Training Institute
        </h2>

        <div class="code-card">

            <div class="code-title">
                student.component.ts
            </div>

            <pre><code>selectedStudent = '';

selectStudent(name: string) {

    this.selectedStudent = name;

}

welcomeStudent() {

    console.log(
        'Welcome to CIIT Training Institute'
    );

}</code></pre>

        </div>


        <div class="code-card">

            <div class="code-title">
                student.component.html
            </div>

            <pre><code>&lt;h2&gt;
    CIIT Training Institute
&lt;/h2&gt;

&lt;p&gt;
    Select your name:
&lt;/p&gt;

&lt;button
    class="btn btn-primary me-2 mb-2"
    (click)="selectStudent('Sam')"&gt;
    Sam
&lt;/button&gt;

&lt;button
    class="btn btn-primary me-2 mb-2"
    (click)="selectStudent('Pradnya')"&gt;
    Pradnya
&lt;/button&gt;

&lt;button
    class="btn btn-primary mb-2"
    (click)="selectStudent('Samiksha')"&gt;
    Samiksha
&lt;/button&gt;

&lt;p class="mt-3"&gt;
    Selected Student:
    &#123;&#123; selectedStudent &#125;&#125;
&lt;/p&gt;

&lt;button
    class="btn btn-success"
    (click)="welcomeStudent()"&gt;
    Welcome to CIIT
&lt;/button&gt;</code></pre>

        </div>


        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>
                    CIIT Training Institute
                </h3>

                <p>
                    Select your name:
                </p>

                <div class="mb-3">

                    <button class="btn btn-primary me-2 mb-2">
                        Sam
                    </button>

                    <button class="btn btn-primary me-2 mb-2">
                        Pradnya
                    </button>

                    <button class="btn btn-primary mb-2">
                        Samiksha
                    </button>

                </div>

                <p>
                    <strong>
                        Selected Student:
                    </strong>

                    Sam
                </p>

                <button class="btn btn-success">
                    Welcome to CIIT
                </button>

            </div>

        </div>

    </section>


    <!-- Event Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Event Binding Flow
        </h2>

        <div class="binding-flow">

            <div class="binding-item">
                <strong>User Action</strong>
                <span>Click / Input</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>Event</strong>
                <span>DOM event occurs</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>Binding</strong>
                <span>(click)</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>Method</strong>
                <span>Component executes</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>Result</strong>
                <span>UI / Logic updates</span>
            </div>

        </div>

    </section>


    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Event Binding Best Practices
        </h2>

        <ul class="best-practice-list">

            <li>
                Use parentheses <strong>()</strong> for event binding.
            </li>

            <li>
                Keep event handler methods short and meaningful.
            </li>

            <li>
                Use <strong>$event</strong> when event information is required.
            </li>

            <li>
                Pass only the required values to component methods.
            </li>

            <li>
                Avoid complex business logic inside the HTML template.
            </li>

            <li>
                Use meaningful method names such as
                <strong>selectStudent()</strong>.
            </li>

            <li>
                Keep interactive components reusable and maintainable.
            </li>

        </ul>

    </section>


    <!-- Summary -->
    <section class="summary-box">

        <h3>
            Summary
        </h3>

        <p>
            Angular Event Binding connects DOM events with component methods.
        </p>

        <p>
            The basic syntax is:
            <strong>(event)="method()"</strong>
        </p>

        <p>
            Event binding can handle click, input, keyboard, mouse and form
            events. The <strong>$event</strong> object can be used when
            information about the event is required.
        </p>

        <p class="mb-0">
            Event binding is an important part of creating interactive
            applications at <strong>CIIT Training Institute</strong>.
        </p>

    </section>


    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("DOMEvents", "EventHandling", new { area = "Angular" })">
            ← DOM Events
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("EventObject", "EventHandling", new { area = "Angular" })">
            Event Object →
        </a>

    </div>

</div>


<style>

