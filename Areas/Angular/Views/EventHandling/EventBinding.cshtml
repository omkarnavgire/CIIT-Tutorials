            color: #4c1d95;
            margin-bottom: 8px;
            font-style: normal;
        }

        .syntax-box strong {
            display: block;
            color: #2e1065;
            font-weight: 700;
        }

        .syntax-box span {
            display: block;
            color: #64748b;
            font-size: 13px;
            margin-top: 5px;
        }

    .syntax-arrow {
        color: #4c1d95;
