@{
    ViewData["Title"] = "Component Styles";
}

<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->

    <section class="mb-4">

        <h1 class="fw-bold text-dark">
            Angular Component Styles
        </h1>

        <p class="text-muted fs-5">
            Component styles define the visual appearance of an Angular
            component. Angular allows styles to be associated with an
            individual component so that its user interface can be
            organized and maintained easily.
        </p>

    </section>


    <!-- ================= WHAT ARE COMPONENT STYLES ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            What are Component Styles?
        </h2>

        <p>
            Component styles are CSS rules associated with a specific
            Angular component. They control properties such as colors,
            fonts, spacing, borders and layout.
        </p>

        <div class="info-highlight">

            <strong>Simple Definition:</strong>

            <span>
                Component Styles = CSS Rules + Component UI Appearance
            </span>

        </div>

    </section>


    <!-- ================= STYLE FLOW ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Component Styling Flow
        </h2>

        <div class="style-flow">

            <div class="flow-card">

                <div class="flow-number">
                    1
                </div>

                <h5>Component</h5>

                <p>
                    Defines the Angular component.
                </p>

            </div>

            <div class="flow-arrow">
                →
            </div>

            <div class="flow-card">

                <div class="flow-number">
                    2
                </div>

                <h5>CSS</h5>

                <p>
                    Defines visual styles.
                </p>

            </div>

            <div class="flow-arrow">
                →
            </div>

            <div class="flow-card">

                <div class="flow-number">
                    3
                </div>

                <h5>Angular</h5>

                <p>
                    Associates styles with the component.
                </p>

            </div>

            <div class="flow-arrow">
                →
            </div>

            <div class="flow-card">

                <div class="flow-number">
                    4
                </div>

                <h5>Browser</h5>

                <p>
                    Displays the styled UI.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= BASIC COMPONENT ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Basic Component with Styles
        </h2>

        <div class="code-box">

            <div class="code-header">
                <span>student.component.ts</span>
            </div>

            <pre><code>import { Component } from '@@angular/core';

@@Component({
    selector: 'app-student',
    templateUrl: './student.component.html',
    styleUrl: './student.component.css'
})
export class StudentComponent {

    studentName = 'Sam';

}</code></pre>

        </div>

        <p class="mt-4">
            The component is connected to its stylesheet using
            <strong>styleUrl</strong>.
        </p>

    </section>


    <!-- ================= CSS FILE ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Component CSS File
        </h2>

        <p>
            CSS rules can be written in the component stylesheet.
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>student.component.css</span>
            </div>

            <pre><code>h2 {
    color: #4c1d95;
    font-size: 28px;
}

p {
    color: #475569;
    font-size: 18px;
}</code></pre>

        </div>

    </section>


    <!-- ================= HTML TEMPLATE ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            HTML Template
        </h2>

        <div class="code-box">

            <div class="code-header">
                <span>student.component.html</span>
            </div>

            <pre><code>&lt;h2&gt;
    Student Details
&lt;/h2&gt;

&lt;p&gt;
    Student Name: &#123;&#123; studentName &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

    </section>


    <!-- ================= EXPECTED OUTPUT ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Expected Output
        </h2>

        <div class="styled-output">

            <h2>
                Student Details
            </h2>

            <p class="mb-0">
                Student Name: Sam
            </p>

        </div>

    </section>


    <!-- ================= INLINE STYLES ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Inline Component Styles
        </h2>

        <p>
            For small components, styles can also be written directly
            inside the component metadata using the
            <strong>styles</strong> property.
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>student.component.ts</span>
            </div>

            <pre><code>import { Component } from '@@angular/core';

@@Component({
    selector: 'app-student',

    template: `
        &lt;h2&gt;Student Details&lt;/h2&gt;
        &lt;p&gt;Student Name: Sam&lt;/p&gt;
    `,

    styles: [`
        h2 {
            color: #4c1d95;
        }

        p {
            font-size: 18px;
        }
    `]
})
export class StudentComponent {
}</code></pre>

        </div>

    </section>


    <!-- ================= EXTERNAL VS INLINE ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            External Styles vs Inline Styles
        </h2>

        <div class="comparison-table">

            <div class="comparison-row comparison-header">

                <div>
                    External Styles
                </div>

                <div>
                    Inline Styles
                </div>

            </div>


            <div class="comparison-row">

                <div>
                    CSS is stored in a separate file.
                </div>

                <div>
                    CSS is written inside the component.
                </div>

            </div>


            <div class="comparison-row">

                <div>
                    Useful for larger components.
                </div>

                <div>
                    Useful for small components.
                </div>

            </div>


            <div class="comparison-row">

                <div>
                    Easier to organize larger stylesheets.
                </div>

                <div>
                    Keeps a small component self-contained.
                </div>

            </div>

        </div>

    </section>


    <!-- ================= STYLE PROPERTIES ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Common CSS Properties
        </h2>

        <div class="property-grid">

            <div class="property-card">

                <div class="property-icon">
                    A
                </div>

                <h5>Color</h5>

                <code>color</code>

                <p>
                    Changes text color.
                </p>

            </div>


            <div class="property-card">

                <div class="property-icon">
                    B
                </div>

                <h5>Background</h5>

                <code>background</code>

                <p>
                    Changes background appearance.
                </p>

            </div>


            <div class="property-card">

                <div class="property-icon">
                    T
                </div>

                <h5>Typography</h5>

                <code>font-size</code>

                <p>
                    Controls text size.
                </p>

            </div>


            <div class="property-card">

                <div class="property-icon">
                    S
                </div>

                <h5>Spacing</h5>

                <code>margin / padding</code>

                <p>
                    Controls element spacing.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= CLASS STYLING ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Styling HTML Classes
        </h2>

        <p>
            CSS classes can be created in the component stylesheet and
            applied to HTML elements.
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>student.component.css</span>
            </div>

            <pre><code>.student-card {
    border: 1px solid #ddd6fe;
    padding: 20px;
    border-radius: 8px;
}

.student-name {
    color: #4c1d95;
    font-weight: 700;
}</code></pre>

        </div>


        <div class="code-box mt-4">

            <div class="code-header">
                <span>student.component.html</span>
            </div>

            <pre><code>&lt;div class="student-card"&gt;

    &lt;h2 class="student-name"&gt;
        Sam
    &lt;/h2&gt;

&lt;/div&gt;</code></pre>

        </div>

    </section>


    <!-- ================= STYLE URL ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Using styleUrl
        </h2>

        <p>
            The <strong>styleUrl</strong> property connects the component
            with its external stylesheet.
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>Component Metadata</span>
            </div>

            <pre><code>@@Component({
    selector: 'app-student',
    templateUrl: './student.component.html',
    styleUrl: './student.component.css'
})</code></pre>

        </div>

    </section>


    <!-- ================= COMPONENT STYLE SCOPE ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Component Style Scope
        </h2>

        <p>
            Angular component styles are associated with the component
            rather than simply being treated as one large application
            stylesheet.
        </p>

        <div class="scope-diagram">

            <div class="scope-root">
                Angular Application
            </div>

            <div class="scope-line">
                │
            </div>

            <div class="scope-components">

                <div class="scope-card">

                    <strong>
                        HeaderComponent
                    </strong>

                    <span>
                        header styles
                    </span>

                </div>


                <div class="scope-card active-scope">

                    <strong>
                        StudentComponent
                    </strong>

                    <span>
                        student styles
                    </span>

                </div>


                <div class="scope-card">

                    <strong>
                        FooterComponent
                    </strong>

                    <span>
                        footer styles
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= BEST PRACTICES ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Component Styling Best Practices
        </h2>

        <div class="practice-list">

            <div class="practice-item">
                <span>✓</span>
                <p>
                    Keep component-specific styles close to the component.
                </p>
            </div>

            <div class="practice-item">
                <span>✓</span>
                <p>
                    Use meaningful CSS class names.
                </p>
            </div>

            <div class="practice-item">
                <span>✓</span>
                <p>
                    Avoid unnecessary duplication of styles.
                </p>
            </div>

            <div class="practice-item">
                <span>✓</span>
                <p>
                    Keep styles organized and easy to maintain.
                </p>
            </div>

        </div>

    </section>


    <!-- ================= SUMMARY ================= -->

    <section class="mb-5">

        <div class="summary-box">

            <h3>
                Summary
            </h3>

            <p>
                Angular component styles control the visual appearance
                of a component.
            </p>

            <p>
                Styles can be stored in an external CSS file using
                <strong>styleUrl</strong> or written directly using
                the <strong>styles</strong> property.
            </p>

            <p class="mb-0">
                Keeping component styles organized makes Angular applications
                easier to maintain and understand.
            </p>

        </div>

    </section>


    <!-- ================= NAVIGATION ================= -->

    <div class="topic-navigation">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("ComponentTemplate", "Components", new { area = "Angular" })">
            ← Component Template
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("ComponentMetadata", "Components", new { area = "Angular" })">
            Component Metadata →
        </a>

    </div>

</div>


<style>

    /* ================= SECTION TITLE ================= */

    .section-title {
        font-size: 25px;
        font-weight: 700;
        color: #2e1065;
        margin-bottom: 18px;
        border-left: 5px solid #4c1d95;
        padding-left: 12px;
    }


    /* ================= INFO ================= */

    .info-highlight {
        background: #f3eefe;
        border-left: 5px solid #4c1d95;
        padding: 15px 18px;
        border-radius: 7px;
        margin-top: 20px;
    }

        .info-highlight strong {
            color: #2e1065;
            margin-right: 8px;
        }

        .info-highlight span {
            color: #4c1d95;
            font-weight: 600;
        }


    /* ================= FLOW ================= */

    .style-flow {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        background: #f8f7fc;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 25px;
    }

    .flow-card {
        width: 175px;
        min-height: 140px;
        text-align: center;
        padding: 18px;
        background: white;
        border: 1px solid #ddd6fe;
        border-radius: 9px;
    }

    .flow-number {
        width: 40px;
        height: 40px;
        margin: 0 auto 10px;
        background: #4c1d95;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .flow-card h5 {
        color: #2e1065;
        font-weight: 700;
    }

    .flow-card p {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 0;
    }

    .flow-arrow {
        align-self: center;
        color: #4c1d95;
        font-size: 25px;
        font-weight: 700;
    }


    /* ================= CODE ================= */

    .code-box {
        background: #0f172a;
        border-radius: 8px;
        margin-top: 15px;
        overflow: hidden;
    }

    .code-header {
        background: #1e293b;
        color: #cbd5e1;
        padding: 8px 15px;
        font-size: 13px;
        font-weight: 600;
        border-bottom: 1px solid #334155;
    }

    .code-box pre {
        margin: 0;
        padding: 18px 20px;
        overflow-x: auto;
    }

    .code-box code {
        color: #e2e8f0;
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        line-height: 1.7;
    }


    /* ================= OUTPUT ================= */

    .styled-output {
        background: white;
        border: 1px solid #ddd6fe;
        border-left: 5px solid #4c1d95;
        border-radius: 8px;
        padding: 25px;
    }

        .styled-output h2 {
            color: #4c1d95;
            font-size: 28px;
            font-weight: 700;
        }

        .styled-output p {
            color: #475569;
            font-size: 18px;
        }


    /* ================= INFO CARD ================= */

    .info-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-left: 5px solid #4c1d95;
        border-radius: 7px;
        padding: 18px 20px;
    }

        .info-card h5 {
            color: #4c1d95;
            font-weight: 700;
        }


    /* ================= COMPARISON ================= */

    .comparison-table {
        border: 1px solid #ddd6fe;
        border-radius: 8px;
        overflow: hidden;
    }

    .comparison-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

        .comparison-row > div {
            padding: 14px 18px;
            border-bottom: 1px solid #e5e7eb;
        }

            .comparison-row > div:first-child {
                border-right: 1px solid #e5e7eb;
            }

    .comparison-header {
        background: #4c1d95;
        color: white;
        font-weight: 700;
    }

    .comparison-row:not(.comparison-header):hover {
        background: #f5f3ff;
    }


    /* ================= PROPERTY GRID ================= */

    .property-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .property-card {
        background: #f8f7fc;
        border: 1px solid #ddd6fe;
        border-radius: 9px;
        padding: 18px;
        text-align: center;
    }

    .property-icon {
        width: 44px;
        height: 44px;
        margin: 0 auto 10px;
        background: #4c1d95;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .property-card h5 {
        color: #2e1065;
        font-weight: 700;
    }

    .property-card code {
        display: inline-block;
        background: #ede9fe;
        color: #4c1d95;
        padding: 5px 8px;
        border-radius: 5px;
        margin-bottom: 8px;
    }

    .property-card p {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 0;
    }


    /* ================= SCOPE ================= */

    .scope-diagram {
        background: #f8f7fc;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 30px 20px;
        text-align: center;
    }

    .scope-root {
        display: inline-block;
        background: #4c1d95;
        color: white;
        padding: 14px 25px;
        border-radius: 8px;
        font-weight: 700;
    }

    .scope-line {
        color: #4c1d95;
        font-size: 25px;
        font-weight: 700;
        margin: 5px;
    }

    .scope-components {
        display: flex;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .scope-card {
        width: 190px;
        background: white;
        border: 1px solid #ddd6fe;
        border-radius: 8px;
        padding: 16px;
    }

        .scope-card strong {
            display: block;
            color: #2e1065;
        }

        .scope-card span {
            display: block;
            color: #64748b;
            font-size: 13px;
            margin-top: 6px;
        }

    .active-scope {
        border: 2px solid #4c1d95;
        background: #f3eefe;
    }


    /* ================= PRACTICES ================= */

    .practice-list {
        background: #f8f7fc;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        padding: 10px 20px;
    }

    .practice-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #e5e7eb;
    }

        .practice-item:last-child {
            border-bottom: none;
        }

        .practice-item span {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #4c1d95;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .practice-item p {
            margin: 0;
        }


    /* ================= SUMMARY ================= */

    .summary-box {
        background: #cfe2ff;
        border-radius: 6px;
        padding: 18px 22px;
        margin-top: 20px;
    }

        .summary-box h3 {
            font-size: 20px;
            font-weight: 700;
            color: #084298;
            margin-bottom: 10px;
        }

        .summary-box p {
            font-size: 16px !important;
            line-height: 1.6 !important;
            color: #084298 !important;
            margin-bottom: 8px;
        }


    /* ================= NAVIGATION ================= */

    .topic-navigation {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-top: 35px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

        .topic-navigation .btn {
            padding: 10px 18px;
            font-weight: 600;
        }

        .topic-navigation .btn-primary {
            background: #4c1d95;
            border-color: #4c1d95;
        }

            .topic-navigation .btn-primary:hover {
                background: #2e1065;
                border-color: #2e1065;
            }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 991px) {

        .property-grid {
            grid-template-columns: 1fr 1fr;
        }

        .flow-arrow {
            display: none;
        }
    }


    @@media (max-width: 576px) {

        .section-title {
            font-size: 22px;
        }

        .property-grid {
            grid-template-columns: 1fr;
        }

        .style-flow {
            flex-direction: column;
        }

        .flow-card {
            width: 100%;
        }

        .comparison-row {
            grid-template-columns: 1fr;
        }

            .comparison-row > div:first-child {
                border-right: none;
            }

        .scope-components {
            flex-direction: column;
            align-items: center;
        }

        .scope-card {
            width: 100%;
        }

        .topic-navigation {
            flex-direction: column;
        }

            .topic-navigation .btn {
                width: 100%;
                text-align: center;
            }

        .code-box code {
            font-size: 13px;
        }
    }

</style>