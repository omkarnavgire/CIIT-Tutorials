            }

    @@media (max-width: 991px) {

        .benefit-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .children-row {
            gap: 15px;
        }
    }

    @@media (max-width: 576px) {

        .communication-grid,
        .benefit-grid {
            grid-template-columns: 1fr;
        }

        .children-row {
            flex-direction: column;
            align-items: center;
        }

            .children-row::before {
                display: none;
            }

        .tree-line {
            height: 25px;
        }

        .tree-node {
            width: 100%;
            max-width: 280px;
        }

        .input-flow {
            flex-direction: column;
        }

        .input-arrow {
            transform: rotate(90deg);
        }

        .input-item {
            width: 100%;
            max-width: 250px;
        }

        .code-card code {
            font-size: 13px;
        }

        .d-flex.justify-content-between {
            gap: 10px;
        }

            .d-flex.justify-content-between .btn {
                font-size: 13px;
                padding: 8px 12px;
            }
    }

</style>