@{
    ViewData["Title"] = "Component Selector";
}

<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->

    <section class="mb-4">

        <h1 class="fw-bold text-dark">
            Angular Component Selector
        </h1>

        <p class="text-muted fs-5">
            A component selector defines the HTML element, attribute or
            pattern that Angular uses to identify and display a component.
        </p>

    </section>


    <!-- ================= WHAT IS SELECTOR ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            What is a Component Selector?
        </h2>

        <p>
            The selector is a property inside the
            <strong>@@Component</strong> decorator.
            It tells Angular how the component should be used inside
            another HTML template.
        </p>

        <div class="info-highlight">

            <strong>Simple Definition:</strong>

            <span>
                Selector = Identifies where the component is used
            </span>

        </div>

    </section>


    <!-- ================= BASIC EXAMPLE ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Basic Selector Example
        </h2>

        <p>
            Consider a Student component with the following selector:
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>student.component.ts</span>
            </div>

            <pre><code>import { Component } from '@@angular/core';

@@Component({
    selector: 'app-student'
})
export class StudentComponent {

    studentName = 'Sam';

}</code></pre>

        </div>

        <p class="mt-4">
            The selector is:
        </p>

        <div class="selector-display">
            app-student
        </div>

    </section>


    <!-- ================= ELEMENT SELECTOR ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            1. Element Selector
        </h2>

        <p>
            The most common selector type is an element selector.
            It allows the component to be used as a custom HTML element.
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>Component</span>
            </div>

            <pre><code>@@Component({
    selector: 'app-student'
})</code></pre>

        </div>

        <p class="mt-3">
            Use the component in an HTML template:
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>HTML Template</span>
            </div>

            <pre><code>&lt;app-student&gt;&lt;/app-student&gt;</code></pre>

        </div>

        <div class="output-box mt-3">

            <h5>
                Result
            </h5>

            <p class="mb-0">
                Angular renders the StudentComponent wherever
                <strong>&lt;app-student&gt;</strong> is used.
            </p>

        </div>

    </section>


    <!-- ================= ATTRIBUTE SELECTOR ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            2. Attribute Selector
        </h2>

        <p>
            A component can also use an attribute selector.
            In this case, the component is applied through an HTML attribute.
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>Component</span>
            </div>

            <pre><code>@@Component({
    selector: '[app-student]'
})
export class StudentComponent {
}</code></pre>

        </div>

        <p class="mt-3">
            The selector can then be used as an attribute:
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>HTML</span>
            </div>

            <pre><code>&lt;div app-student&gt;&lt;/div&gt;</code></pre>

        </div>

        <div class="info-card mt-3">

            <h5>Important</h5>

            <p class="mb-0">
                Attribute selectors are useful when a component or directive
                needs to be identified through an HTML attribute.
            </p>

        </div>

    </section>


    <!-- ================= CLASS SELECTOR ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            3. Class Selector
        </h2>

        <p>
            A selector can also be defined using a CSS class pattern.
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>Component</span>
            </div>

            <pre><code>@@Component({
    selector: '.student-card'
})
export class StudentComponent {
}</code></pre>

        </div>

        <p class="mt-3">
            It can then be referenced using the class name:
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>HTML</span>
            </div>

            <pre><code>&lt;div class="student-card"&gt;&lt;/div&gt;</code></pre>

        </div>

    </section>


    <!-- ================= SELECTOR TYPES ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Selector Types
        </h2>

        <div class="selector-grid">

            <div class="selector-card">

                <div class="selector-icon">
                    E
                </div>

                <h5>Element</h5>

                <code>app-student</code>

                <p>
                    Used as a custom HTML element.
                </p>

            </div>


            <div class="selector-card">

                <div class="selector-icon">
                    A
                </div>

                <h5>Attribute</h5>

                <code>[app-student]</code>

                <p>
                    Used as an HTML attribute.
                </p>

            </div>


            <div class="selector-card">

                <div class="selector-icon">
                    C
                </div>

                <h5>Class</h5>

                <code>.student-card</code>

                <p>
                    Identifies an element through a class selector.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= SELECTOR FLOW ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            How Selector Works
        </h2>

        <div class="selector-flow">

            <div class="flow-step">

                <div class="flow-number">
                    1
                </div>

                <h5>Define Selector</h5>

                <p>
                    Selector is defined in @@Component.
                </p>

            </div>


            <div class="flow-arrow">
                →
            </div>


            <div class="flow-step">

                <div class="flow-number">
                    2
                </div>

                <h5>Use Selector</h5>

                <p>
                    Selector is placed in HTML.
                </p>

            </div>


            <div class="flow-arrow">
                →
            </div>


            <div class="flow-step">

                <div class="flow-number">
                    3
                </div>

                <h5>Angular Matches</h5>

                <p>
                    Angular finds the matching element.
                </p>

            </div>


            <div class="flow-arrow">
                →
            </div>


            <div class="flow-step">

                <div class="flow-number">
                    4
                </div>

                <h5>Component Rendered</h5>

                <p>
                    Angular displays the component.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= STUDENT EXAMPLE ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Practical Example
        </h2>

        <p>
            Let's create a Student component and use its selector inside
            the application.
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>student.component.ts</span>
            </div>

            <pre><code>import { Component } from '@@angular/core';

@@Component({
    selector: 'app-student',
    template: `
        &lt;h2&gt;Student Details&lt;/h2&gt;
        &lt;p&gt;Student Name: Sam&lt;/p&gt;
    `
})
export class StudentComponent {
}</code></pre>

        </div>


        <p class="mt-4">
            Use the component in the parent template:
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>app.component.html</span>
            </div>

            <pre><code>&lt;h1&gt;CIIT Student Management&lt;/h1&gt;

&lt;app-student&gt;&lt;/app-student&gt;</code></pre>

        </div>

    </section>


    <!-- ================= EXPECTED OUTPUT ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Expected Output
        </h2>

        <div class="output-box">

            <h3>
                CIIT Student Management
            </h3>

            <hr />

            <h4>
                Student Details
            </h4>

            <p class="mb-0">
                Student Name: Sam
            </p>

        </div>

    </section>


    <!-- ================= NAMING CONVENTION ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Selector Naming Convention
        </h2>

        <p>
            Angular projects commonly use a prefix in component selectors.
            This helps avoid conflicts with existing HTML elements.
        </p>

        <div class="code-box">

            <div class="code-header">
                <span>Examples</span>
            </div>

            <pre><code>app-student
app-header
app-footer
app-dashboard
app-student-list</code></pre>

        </div>

        <div class="info-highlight mt-3">

            <strong>Recommended:</strong>

            <span>
                Use clear and meaningful selector names.
            </span>

        </div>

    </section>


    <!-- ================= SELECTOR VS CLASS ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Selector vs Component Name
        </h2>

        <div class="comparison-table">

            <div class="comparison-row comparison-header">

                <div>
                    Component Name
                </div>

                <div>
                    Selector
                </div>

            </div>


            <div class="comparison-row">

                <div>
                    StudentComponent
                </div>

                <div>
                    app-student
                </div>

            </div>


            <div class="comparison-row">

                <div>
                    HeaderComponent
                </div>

                <div>
                    app-header
                </div>

            </div>


            <div class="comparison-row">

                <div>
                    FooterComponent
                </div>

                <div>
                    app-footer
                </div>

            </div>

        </div>

    </section>


    <!-- ================= COMMON MISTAKES ================= -->

    <section class="mb-5">

        <h2 class="section-title">
            Common Selector Mistakes
        </h2>

        <div class="issue-card">

            <h5>
                1. Incorrect selector
            </h5>

            <p>
                Make sure the selector used in the HTML matches the
                selector defined in the component.
            </p>

        </div>


        <div class="issue-card">

            <h5>
                2. Missing component availability
            </h5>

            <p>
                The component must be available in the Angular context
                where the selector is used.
            </p>

        </div>


        <div class="issue-card">

            <h5>
                3. Confusing class and element selectors
            </h5>

            <p>
                Use the correct syntax according to the selector defined
                in the component.
            </p>

        </div>

    </section>


    <!-- ================= SUMMARY ================= -->

    <section class="mb-5">

        <div class="summary-box">

            <h3>
                Summary
            </h3>

            <p>
                A component selector tells Angular how a component is
                identified and used in an HTML template.
            </p>

            <p>
                The most common approach is an element selector such as
                <strong>app-student</strong>.
            </p>

            <p class="mb-0">
                Selectors should be meaningful and consistently named
                throughout the Angular application.
            </p>

        </div>

    </section>


    <!-- ================= NAVIGATION ================= -->

    <div class="topic-navigation">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("CreatingComponents", "Components", new { area = "Angular" })">
            ← Creating Components
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("ComponentTemplate", "Components", new { area = "Angular" })">
            Component Template →
        </a>

    </div>

</div>


<style>

    /* ================= SECTION TITLE ================= */

    .section-title {
        font-size: 25px;
        font-weight: 700;
        color: #2e1065;
        margin-bottom: 18px;
        border-left: 5px solid #4c1d95;
        padding-left: 12px;
    }


    /* ================= INFO ================= */

    .info-highlight {
        background: #f3eefe;
        border-left: 5px solid #4c1d95;
        padding: 15px 18px;
        border-radius: 7px;
        margin-top: 20px;
    }

        .info-highlight strong {
            color: #2e1065;
            margin-right: 8px;
        }

        .info-highlight span {
            color: #4c1d95;
            font-weight: 600;
        }


    /* ================= CODE ================= */

    .code-box {
        background: #0f172a;
        border-radius: 8px;
        margin-top: 15px;
        overflow: hidden;
    }

    .code-header {
        background: #1e293b;
        color: #cbd5e1;
        padding: 8px 15px;
        font-size: 13px;
        font-weight: 600;
        border-bottom: 1px solid #334155;
    }

    .code-box pre {
        margin: 0;
        padding: 18px 20px;
        overflow-x: auto;
    }

    .code-box code {
        color: #e2e8f0;
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        line-height: 1.7;
    }


    /* ================= SELECTOR DISPLAY ================= */

    .selector-display {
        display: inline-block;
        background: #4c1d95;
        color: white;
        padding: 12px 22px;
        border-radius: 7px;
        font-family: Consolas, "Courier New", monospace;
        font-size: 18px;
        font-weight: 700;
        margin-top: 5px;
    }


    /* ================= OUTPUT ================= */

    .output-box {
        background: #f1f5f9;
        border-left: 5px solid #4c1d95;
        border-radius: 7px;
        padding: 20px;
    }

        .output-box h3,
        .output-box h4,
        .output-box h5 {
            color: #4c1d95;
            font-weight: 700;
        }


    /* ================= INFO CARD ================= */

    .info-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-left: 5px solid #4c1d95;
        border-radius: 7px;
        padding: 18px 20px;
    }

        .info-card h5 {
            color: #4c1d95;
            font-weight: 700;
        }


    /* ================= SELECTOR GRID ================= */

    .selector-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-top: 20px;
    }

    .selector-card {
        background: #f8f7fc;
        border: 1px solid #ddd6fe;
        border-radius: 9px;
        padding: 20px;
        text-align: center;
    }

    .selector-icon {
        width: 45px;
        height: 45px;
        margin: 0 auto 12px;
        border-radius: 50%;
        background: #4c1d95;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
    }

    .selector-card h5 {
        color: #2e1065;
        font-weight: 700;
    }

    .selector-card code {
        display: inline-block;
        background: #ede9fe;
        color: #4c1d95;
        padding: 6px 9px;
        border-radius: 5px;
        font-size: 13px;
        margin-bottom: 10px;
    }

    .selector-card p {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 0;
    }


    /* ================= FLOW ================= */

    .selector-flow {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        background: #f8f7fc;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 25px;
    }

    .flow-step {
        width: 175px;
        min-height: 135px;
        text-align: center;
        padding: 17px;
        background: white;
        border: 1px solid #ddd6fe;
        border-radius: 9px;
    }

    .flow-number {
        width: 38px;
        height: 38px;
        margin: 0 auto 10px;
        background: #4c1d95;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .flow-step h5 {
        color: #2e1065;
        font-weight: 700;
        font-size: 16px;
    }

    .flow-step p {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 0;
    }

    .flow-arrow {
        align-self: center;
        color: #4c1d95;
        font-size: 25px;
        font-weight: 700;
    }


    /* ================= COMPARISON ================= */

    .comparison-table {
        border: 1px solid #ddd6fe;
        border-radius: 8px;
        overflow: hidden;
    }

    .comparison-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

        .comparison-row > div {
            padding: 14px 18px;
            border-bottom: 1px solid #e5e7eb;
        }

            .comparison-row > div:first-child {
                border-right: 1px solid #e5e7eb;
            }

    .comparison-header {
        background: #4c1d95;
        color: white;
        font-weight: 700;
    }

    .comparison-row:not(.comparison-header):hover {
        background: #f5f3ff;
    }


    /* ================= ISSUES ================= */

    .issue-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-left: 5px solid #4c1d95;
        border-radius: 7px;
        padding: 17px 20px;
        margin-bottom: 15px;
    }

        .issue-card h5 {
            color: #4c1d95;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .issue-card p {
            margin-bottom: 0;
        }


    /* ================= SUMMARY ================= */

    .summary-box {
        background: #cfe2ff;
        border-radius: 6px;
        padding: 18px 22px;
        margin-top: 20px;
    }

        .summary-box h3 {
            font-size: 20px;
            font-weight: 700;
            color: #084298;
            margin-bottom: 10px;
        }

        .summary-box p {
            font-size: 16px !important;
            line-height: 1.6 !important;
            color: #084298 !important;
            margin-bottom: 8px;
        }


    /* ================= NAVIGATION ================= */

    .topic-navigation {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-top: 35px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

        .topic-navigation .btn {
            padding: 10px 18px;
            font-weight: 600;
        }

        .topic-navigation .btn-primary {
            background: #4c1d95;
            border-color: #4c1d95;
        }

            .topic-navigation .btn-primary:hover {
                background: #2e1065;
                border-color: #2e1065;
            }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 991px) {

        .selector-grid {
            grid-template-columns: 1fr 1fr;
        }

        .flow-arrow {
            display: none;
        }
    }


    @@media (max-width: 576px) {

        .section-title {
            font-size: 22px;
        }

        .selector-grid {
            grid-template-columns: 1fr;
        }

        .selector-flow {
            flex-direction: column;
        }

        .flow-step {
            width: 100%;
        }

        .comparison-row {
            grid-template-columns: 1fr;
        }

            .comparison-row > div:first-child {
                border-right: none;
            }

        .topic-navigation {
            flex-direction: column;
        }

            .topic-navigation .btn {
                width: 100%;
                text-align: center;
            }

        .code-box code {
            font-size: 13px;
        }
    }

</style>