@{
    ViewData["Title"] = "Angular Setup";
}

<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">
            Angular Setup
        </h1>

        <p class="text-muted fs-5">
            Before developing Angular applications, we need to prepare the
            development environment. This includes installing Node.js,
            Angular CLI and creating our first Angular application.
        </p>
    </section>


    <!-- ================= WHAT IS SETUP ================= -->
    <section class="mb-5">

        <h2 class="section-title">
            What is Angular Setup?
        </h2>

        <p>
            Angular requires a development environment where we can create,
            run, test and build Angular applications.
        </p>

        <p>
            The basic setup involves installing
            <strong>Node.js</strong>,
            installing <strong>Angular CLI</strong>,
            creating an Angular application and running it in the browser.
        </p>

        <div class="setup-note">
            <strong>In simple words:</strong>
            Angular Setup means preparing all the required tools before
            starting Angular application development.
        </div>

    </section>


    <!-- ================= SETUP FLOW ================= -->
    <section class="mb-5">

        <h2 class="section-title">
            Angular Setup Flow
        </h2>

        <div class="setup-flow">

            <div class="setup-step">

                <div class="setup-icon">
                    1
                </div>

                <h4>
                    Node.js
                </h4>

                <p>
                    Install Node.js and npm.
                </p>

            </div>


            <div class="flow-arrow">
                →
            </div>


            <div class="setup-step">

                <div class="setup-icon">
                    2
                </div>

                <h4>
                    Angular CLI
                </h4>

                <p>
                    Install Angular Command Line Interface.
                </p>

            </div>


            <div class="flow-arrow">
                →
            </div>


            <div class="setup-step">

                <div class="setup-icon">
                    3
                </div>

                <h4>
                    Create App
                </h4>

                <p>
                    Create a new Angular application.
                </p>

            </div>


            <div class="flow-arrow">
                →
            </div>


            <div class="setup-step">

                <div class="setup-icon">
                    4
                </div>

                <h4>
                    Run App
                </h4>

                <p>
                    Start the application in browser.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= PREREQUISITES ================= -->
    <section class="mb-5">

        <h2 class="section-title">
            Prerequisites
        </h2>

        <div class="info-card">

            <!-- Node.js -->
            <div class="prerequisite">

                <span class="check">
                    ✓
                </span>

                <div>

                    <h5>
                        Node.js
                    </h5>

                    <p>
                        Node.js provides the runtime environment required
                        for Angular development.
                    </p>

                </div>

            </div>


            <!-- npm -->
            <div class="prerequisite">

                <span class="check">
                    ✓
                </span>

                <div>

                    <h5>
                        npm
                    </h5>

                    <p>
                        npm is used to install and manage Angular packages
                        and dependencies.
                    </p>

                </div>

            </div>


            <!-- Code Editor -->
            <div class="prerequisite">

                <span class="check">
                    ✓
                </span>

                <div>

                    <h5>
                        Code Editor
                    </h5>

                    <p>
                        Visual Studio Code or another suitable editor can
                        be used to write Angular code.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= CHECK NODE ================= -->
    <section class="mb-5">

        <h2 class="section-title">
            Check Node.js Installation
        </h2>

        <p>
            After installing Node.js, open Command Prompt or Terminal and
            check the installed Node.js version.
        </p>


        <div class="code-box">

            <div class="code-header">
                <span>
                    Terminal
                </span>
            </div>

            <pre><code>node --version</code></pre>

        </div>


        <p class="mt-3">
            You can also check the npm installation:
        </p>


        <div class="code-box">

            <div class="code-header">
                <span>
                    Terminal
                </span>
            </div>

            <pre><code>npm --version</code></pre>

        </div>


        <div class="output-box">

            <h5>
                Expected Result
            </h5>

            <p>
                The terminal displays the installed Node.js and npm version
                information.
            </p>

            <div class="terminal-output">

                Node.js:
                v[installed-version]

                <br />

                npm:
                [installed-version]

            </div>

        </div>

    </section>


    <!-- ================= INSTALL ANGULAR CLI ================= -->
    <section class="mb-5">

        <h2 class="section-title">
            Install Angular CLI
        </h2>

        <p>
            Angular CLI is a command-line tool that helps developers create,
            develop, test and build Angular applications.
        </p>


        <div class="code-box">

            <div class="code-header">
                <span>
                    Terminal
                </span>
            </div>

            <pre><code>npm install -g @@angular/cli</code></pre>

        </div>


        <p class="mt-3">
            After installation, verify Angular CLI:
        </p>


        <div class="code-box">

            <div class="code-header">
                <span>
                    Terminal
                </span>
            </div>

            <pre><code>ng version</code></pre>

        </div>


        <div class="output-box">

            <h5>
                Expected Result
            </h5>

            <p>
                Angular CLI displays information about the Angular CLI,
                Node.js environment and related Angular packages.
            </p>

        </div>

    </section>


    <!-- ================= CREATE APPLICATION ================= -->
    <section class="mb-5">

        <h2 class="section-title">
            Create Angular Application
        </h2>

        <p>
            Once Angular CLI is installed, we can create a new Angular
            application using the <strong>ng new</strong> command.
        </p>


        <div class="code-box">

            <div class="code-header">
                <span>
                    Terminal
                </span>
            </div>

            <pre><code>ng new CIITStudentApp</code></pre>

        </div>


        <p class="mt-3">
            Angular CLI will ask some configuration questions.
            Select the options according to your project requirements.
        </p>


        <div class="info-highlight">

            <strong>
                Example Project:
            </strong>

            <span>
                CIITStudentApp
            </span>

        </div>

    </section>


    <!-- ================= RUN APPLICATION ================= -->
    <section class="mb-5">

        <h2 class="section-title">
            Run Angular Application
        </h2>

        <p>
            Move inside the project folder and start the Angular development
            server.
        </p>


        <div class="code-box">

            <div class="code-header">
                <span>
                    Terminal
                </span>
            </div>

            <pre><code>cd CIITStudentApp
ng serve</code></pre>

        </div>


        <div class="output-box">

            <h5>
                Expected Output
            </h5>

            <p>
                Angular starts the development server and provides a local
                address where the application can be opened in the browser.
            </p>


            <div class="browser-output">
                http://localhost:4200
            </div>

        </div>

    </section>


    <!-- ================= BROWSER FLOW ================= -->
    <section class="mb-5">

        <h2 class="section-title">
            Angular Application Flow
        </h2>


        <div class="browser-flow">

            <div class="flow-box">

                <strong>
                    Developer
                </strong>

                <span>
                    Writes Angular Code
                </span>

            </div>


            <div class="big-arrow">
                ↓
            </div>


            <div class="flow-box">

                <strong>
                    Angular CLI
                </strong>

                <span>
                    Builds Application
                </span>

            </div>


            <div class="big-arrow">
                ↓
            </div>


            <div class="flow-box">

                <strong>
                    Development Server
                </strong>

                <span>
                    Runs Application
                </span>

            </div>


            <div class="big-arrow">
                ↓
            </div>


            <div class="flow-box">

                <strong>
                    Browser
                </strong>

                <span>
                    Displays UI
                </span>

            </div>

        </div>

    </section>


    <!-- ================= IMPORTANT COMMANDS ================= -->
    <section class="mb-5">

        <h2 class="section-title">
            Important Angular Commands
        </h2>


        <div class="table-responsive">

            <table class="table command-table">

                <thead>

                    <tr>

                        <th>
                            Command
                        </th>

                        <th>
                            Purpose
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <tr>

                        <td>
                            <code>node --version</code>
                        </td>

                        <td>
                            Check Node.js version
                        </td>

                    </tr>


                    <tr>

                        <td>
                            <code>npm --version</code>
                        </td>

                        <td>
                            Check npm version
                        </td>

                    </tr>


                    <tr>

                        <td>
                            <code>ng version</code>
                        </td>

                        <td>
                            Check Angular CLI information
                        </td>

                    </tr>


                    <tr>

                        <td>
                            <code>ng new ProjectName</code>
                        </td>

                        <td>
                            Create a new Angular application
                        </td>

                    </tr>


                    <tr>

                        <td>
                            <code>ng serve</code>
                        </td>

                        <td>
                            Run Angular development server
                        </td>

                    </tr>


                    <tr>

                        <td>
                            <code>ng generate component name</code>
                        </td>

                        <td>
                            Create an Angular component
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- ================= SETUP CHECKLIST ================= -->
    <section class="mb-5">

        <h2 class="section-title">
            Angular Setup Checklist
        </h2>


        <div class="checklist-box">

            <div class="checklist-item">
                <span>✓</span>
                <p>
                    Node.js installed
                </p>
            </div>


            <div class="checklist-item">
                <span>✓</span>
                <p>
                    npm available
                </p>
            </div>


            <div class="checklist-item">
                <span>✓</span>
                <p>
                    Angular CLI installed
                </p>
            </div>


            <div class="checklist-item">
                <span>✓</span>
                <p>
                    Angular application created
                </p>
            </div>


            <div class="checklist-item">
                <span>✓</span>
                <p>
                    Angular development server started
                </p>
            </div>


            <div class="checklist-item">
                <span>✓</span>
                <p>
                    Application opened in browser
                </p>
            </div>

        </div>

    </section>


    <!-- ================= SUMMARY ================= -->
    <section class="mb-5">

        <div class="summary-box">

            <h3>
                Summary
            </h3>

            <p>
                Angular setup prepares the development environment required
                to create Angular applications.
            </p>

            <p>
                The basic process is
                <strong>
                    Node.js → Angular CLI → Create Application → ng serve → Browser
                </strong>.
            </p>

            <p class="mb-0">
                In the next topic, we will learn about
                <strong>
                    Node.js
                </strong>
                and its role in Angular development.
            </p>

        </div>

    </section>


    <!-- ================= NAVIGATION ================= -->
    <div class="topic-navigation">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", "Setup", new { area = "Angular" })">

            ← Angular Setup

        </a>


        <a class="btn btn-primary"
           href="@Url.Action("InstallingNodeJS", "Setup", new { area = "Angular" })">

            Installing Node.js →

        </a>

    </div>

</div>


<style>

    /* ================= SECTION TITLE ================= */

    .section-title {

        font-size: 25px;
        font-weight: 700;
        color: #2e1065;

        margin-bottom: 18px;

        border-left: 5px solid #4c1d95;

        padding-left: 12px;
    }


    /* ================= SETUP NOTE ================= */

    .setup-note {

        background: #f3f0ff;

        border-left: 5px solid #4c1d95;

        border-radius: 6px;

        padding: 16px 20px;

        margin-top: 18px;

        color: #4c1d95;

        line-height: 1.6;
    }


    /* ================= SETUP FLOW ================= */

    .setup-flow {

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 15px;

        flex-wrap: wrap;

        padding: 25px;

        background: #f8f7fc;

        border-radius: 10px;

        border: 1px solid #e5e7eb;
    }


    .setup-step {

        width: 180px;

        min-height: 150px;

        text-align: center;

        padding: 18px;

        background: white;

        border-radius: 10px;

        border: 1px solid #ddd6fe;

        box-shadow: 0 3px 10px rgba(0,0,0,0.06);
    }


    .setup-icon {

        width: 42px;

        height: 42px;

        margin: 0 auto 10px;

        border-radius: 50%;

        background: #4c1d95;

        color: white;

        display: flex;

        align-items: center;

        justify-content: center;

        font-weight: 700;

        font-size: 18px;
    }


    .setup-step h4 {

        font-size: 17px;

        font-weight: 700;

        color: #2e1065;
    }


    .setup-step p {

        font-size: 14px;

        color: #64748b;

        margin-bottom: 0;
    }


    .flow-arrow {

        font-size: 28px;

        color: #4c1d95;

        font-weight: 700;
    }


    /* ================= PREREQUISITES ================= */

    .info-card {

        background: #ffffff;

        border: 1px solid #e5e7eb;

        border-radius: 10px;

        padding: 20px;

        box-shadow: 0 3px 10px rgba(0,0,0,0.05);
    }


    .prerequisite {

        display: flex;

        gap: 15px;

        padding: 15px 5px;

        border-bottom: 1px solid #eee;
    }


    .prerequisite:last-child {

        border-bottom: none;
    }


    .check {

        width: 30px;

        height: 30px;

        border-radius: 50%;

        background: #4c1d95;

        color: white;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        font-weight: 700;
    }


    .prerequisite h5 {

        color: #2e1065;

        font-weight: 700;

        margin-bottom: 5px;
    }


    .prerequisite p {

        margin-bottom: 0;

        color: #64748b;

        line-height: 1.6;
    }


    /* ================= CODE BOX ================= */

    .code-box {

        background: #0f172a;

        border-radius: 8px;

        overflow: hidden;

        margin-top: 15px;
    }


    .code-header {

        background: #1e293b;

        color: #cbd5e1;

        padding: 9px 15px;

        font-size: 14px;

        font-weight: 600;
    }


    .code-box pre {

        margin: 0;

        padding: 18px;

        overflow-x: auto;
    }


    .code-box code {

        color: #e2e8f0;

        font-size: 15px;

        line-height: 1.7;
    }


    /* ================= OUTPUT ================= */

    .output-box {

        background: #ecfdf5;

        border-left: 5px solid #198754;

        padding: 16px 20px;

        margin-top: 18px;

        border-radius: 6px;
    }


    .output-box h5 {

        color: #146c43;

        font-weight: 700;

        margin-bottom: 8px;
    }


    .output-box p {

        margin-bottom: 10px;

        color: #14532d;

        line-height: 1.6;
    }


    .terminal-output {

        background: white;

        border: 1px solid #bbf7d0;

        padding: 10px 14px;

        border-radius: 5px;

        color: #166534;

        font-family: monospace;

        font-weight: 600;

        line-height: 1.7;
    }


    .browser-output {

        margin-top: 12px;

        background: white;

        border: 1px solid #bbf7d0;

        padding: 10px 14px;

        border-radius: 5px;

        color: #166534;

        font-family: monospace;

        font-weight: 600;
    }


    /* ================= INFO HIGHLIGHT ================= */

    .info-highlight {

        background: #ede9fe;

        border-left: 5px solid #4c1d95;

        padding: 14px 18px;

        border-radius: 6px;

        margin-top: 15px;

        color: #2e1065;
    }


    .info-highlight span {

        font-family: monospace;

        font-weight: 700;

        margin-left: 8px;
    }


    /* ================= BROWSER FLOW ================= */

    .browser-flow {

        display: flex;

        flex-direction: column;

        align-items: center;

        background: #f8f7fc;

        border: 1px solid #e5e7eb;

        border-radius: 10px;

        padding: 25px;
    }


    .flow-box {

        width: 280px;

        text-align: center;

        background: white;

        border: 2px solid #4c1d95;

        border-radius: 8px;

        padding: 15px;
    }


    .flow-box strong {

        display: block;

        color: #2e1065;

        font-size: 17px;
    }


    .flow-box span {

        display: block;

        color: #64748b;

        margin-top: 5px;

        font-size: 14px;
    }


    .big-arrow {

        color: #4c1d95;

        font-size: 28px;

        font-weight: 700;

        margin: 5px 0;
    }


    /* ================= COMMAND TABLE ================= */

    .command-table {

        border: 1px solid #e5e7eb;

        overflow: hidden;
    }


    .command-table thead {

        background: #4c1d95;

        color: white;
    }


    .command-table th,
    .command-table td {

        padding: 13px 15px;

        vertical-align: middle;
    }


    .command-table code {

        color: #4c1d95;

        font-weight: 600;
    }


    /* ================= CHECKLIST ================= */

    .checklist-box {

        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 15px;

        background: #f8f7fc;

        border: 1px solid #e5e7eb;

        border-radius: 10px;

        padding: 20px;
    }


    .checklist-item {

        display: flex;

        align-items: center;

        gap: 12px;

        background: white;

        border: 1px solid #ddd6fe;

        border-radius: 8px;

        padding: 14px 16px;
    }


    .checklist-item span {

        width: 30px;

        height: 30px;

        border-radius: 50%;

        background: #4c1d95;

        color: white;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        font-weight: 700;
    }


    .checklist-item p {

        margin: 0;

        color: #334155;

        font-weight: 600;
    }


    /* ================= SUMMARY ================= */

    .summary-box {

        background: #cfe2ff;

        border-radius: 6px;

        padding: 18px 22px;

        margin-top: 20px;
    }


    .summary-box h3 {

        font-size: 20px;

        font-weight: 700;

        color: #084298;

        margin-bottom: 10px;
    }


    .summary-box p {

        font-size: 16px !important;

        line-height: 1.6 !important;

        color: #084298 !important;

        margin-bottom: 8px;
    }


    /* ================= NAVIGATION ================= */

    .topic-navigation {

        display: flex;

        justify-content: space-between;

        align-items: center;

        margin-top: 30px;

        padding-top: 20px;

        border-top: 1px solid #e5e7eb;
    }


    .topic-navigation .btn-primary {

        background: #4c1d95;

        border-color: #4c1d95;
    }


    .topic-navigation .btn-primary:hover {

        background: #2e1065;

        border-color: #2e1065;
    }


    /* ================= MOBILE ================= */

    @@media (max-width: 768px) {

        .setup-flow {

            flex-direction: column;
        }


        .flow-arrow {

            transform: rotate(90deg);
        }


        .setup-step {

            width: 100%;

            max-width: 300px;
        }


        .flow-box {

            width: 100%;

            max-width: 280px;
        }


        .checklist-box {

            grid-template-columns: 1fr;
        }


        .section-title {

            font-size: 21px;
        }


        .code-box code {

            font-size: 13px;
        }


        .topic-navigation {

            gap: 10px;
        }


        .topic-navigation .btn {

            font-size: 13px;

            padding: 8px 10px;
        }

    }

</style>