    }

    .output-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 25px;
    }

    .student-preview {
        background: white;
        border: 1px solid #ddd6fe;
        border-radius: 10px;
        padding: 22px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
    }

        .student-preview h4 {
            color: #4c1d95;
            font-weight: 700;
        }

