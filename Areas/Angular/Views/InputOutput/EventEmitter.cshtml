            transform: rotate(90deg);
        }

        .binding-flow {
            flex-direction: column;
        }
    }

    @@media (max-width: 576px) {

        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-box {
            width: 100%;
        }

        .binding-item {
            width: 100%;
        }

        .code-card pre {
            font-size: 13px;
        }

        .syntax-table {
            font-size: 13px;
        }
