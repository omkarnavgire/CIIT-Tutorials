@{
    ViewData["Title"] = "Angular EventEmitter";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Angular EventEmitter</h1>
        <p class="lead text-muted">
            Learn how EventEmitter works with @@Output to send events and data from a child
            component to a parent component in Angular.
        </p>
    </section>

    <!-- Introduction -->
    <section class="mb-4">
        <h2 class="fw-bold">What is EventEmitter?</h2>

        <div class="info-card">
            <p>
                In Angular, <strong>EventEmitter</strong> is used with
                <strong>@@Output</strong> to create custom events in a child component.
            </p>

            <p>
                The child component can use the <strong>emit()</strong> method to send
                information to its parent component.
            </p>

            <p class="mb-0">
                This provides a clear communication flow from
                <strong>Child → Parent</strong>.
            </p>
        </div>
    </section>

    <!-- Communication Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">EventEmitter Communication Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <strong>Child Component</strong>
                <span>User Action</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>EventEmitter</strong>
                <span>emit()</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>Parent Component</strong>
                <span>$event</span>
            </div>

        </div>
    </section>

    <!-- Basic Syntax -->
    <section class="mb-4">
        <h2 class="fw-bold">Basic EventEmitter Syntax</h2>

        <div class="code-card">

            <div class="code-title">
                Import EventEmitter
            </div>

            <pre><code>import { Component, Output, EventEmitter } from '@@angular/core';</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Create EventEmitter
            </div>

            <pre><code>@@Output() courseSelected =
    new EventEmitter&lt;string&gt;();</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Emit Event
            </div>

            <pre><code>this.courseSelected.emit('Java Full Stack');</code></pre>

        </div>
    </section>

    <!-- How EventEmitter Works -->
    <section class="mb-4">
        <h2 class="fw-bold">How EventEmitter Works</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">1</div>
                <h5>Create Event</h5>
                <p>
                    Create a custom event using @@Output and EventEmitter.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">2</div>
                <h5>User Action</h5>
                <p>
                    A button click or another action triggers the event.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">3</div>
                <h5>Emit Data</h5>
                <p>
                    The emit() method sends the event and optional data.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">4</div>
                <h5>Parent Receives</h5>
                <p>
                    The parent receives the emitted value using $event.
                </p>
            </div>

        </div>
    </section>

    <!-- Simple Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Simple EventEmitter Example</h2>

        <div class="code-card">

            <div class="code-title">
                Child Component
            </div>

            <pre><code>import {
    Component,
    Output,
    EventEmitter
} from '@@angular/core';

@@Component({
    selector: 'app-course-card',
    templateUrl: './course-card.component.html'
})
export class CourseCardComponent {

    @@Output() courseSelected =
        new EventEmitter&lt;string&gt;();

    selectCourse() {

        this.courseSelected.emit('Python Full Stack');

    }

}</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Child HTML
            </div>

            <pre><code>&lt;button
    type="button"
    (click)="selectCourse()"&gt;

    Select Course

&lt;/button&gt;</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Parent HTML
            </div>

            <pre><code>&lt;app-course-card
    (courseSelected)="receiveCourse($event)"&gt;
&lt;/app-course-card&gt;</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Parent Component
            </div>

            <pre><code>receiveCourse(course: string) {

    console.log('Selected Course:', course);

}</code></pre>

        </div>
    </section>

    <!-- Output -->
    <section class="mb-4">
        <h2 class="fw-bold">Output</h2>

        <div class="output-box">

            <div class="student-preview">

                <h4>Python Full Stack</h4>

                <p class="mb-0">
                    Course selected successfully at CIIT Training Institute.
                </p>

            </div>

        </div>
    </section>

    <!-- emit() -->
    <section class="mb-4">
        <h2 class="fw-bold">Using emit()</h2>

        <div class="info-card">
            <p>
                The <strong>emit()</strong> method is used to trigger an EventEmitter event.
            </p>

            <p class="mb-0">
                It can send a value from the child component to the parent component.
            </p>
        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Emit Without Data
            </div>

            <pre><code>@@Output() enquiry =
    new EventEmitter&lt;void&gt;();

sendEnquiry() {

    this.enquiry.emit();

}</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Emit With Data
            </div>

            <pre><code>@@Output() courseSelected =
    new EventEmitter&lt;string&gt;();

selectCourse() {

    this.courseSelected.emit('Full Stack .NET');

}</code></pre>

        </div>
    </section>

    <!-- Event Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">EventEmitter with Event Binding</h2>

        <p>
            The parent component listens to the custom event using Angular event binding.
        </p>

        <div class="code-card">

            <div class="code-title">
                Parent Template
            </div>

            <pre><code>&lt;app-course-card
    (courseSelected)="receiveCourse($event)"&gt;
&lt;/app-course-card&gt;</code></pre>

        </div>

        <div class="binding-flow mt-4">

            <div class="binding-item">
                <strong>Child Action</strong>
                <span>Button Click</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>emit()</strong>
                <span>Event Trigger</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>(courseSelected)</strong>
                <span>Event Binding</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>$event</strong>
                <span>Received Value</span>
            </div>

        </div>
    </section>

    <!-- Different Data Types -->
    <section class="mb-4">
        <h2 class="fw-bold">EventEmitter with Different Data Types</h2>

        <div class="code-card">

            <div class="code-title">
                String
            </div>

            <pre><code>@@Output() course =
    new EventEmitter&lt;string&gt;();

this.course.emit('Java Full Stack');</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Number
            </div>

            <pre><code>@@Output() fees =
    new EventEmitter&lt;number&gt;();

this.fees.emit(35000);</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Boolean
            </div>

            <pre><code>@@Output() availability =
    new EventEmitter&lt;boolean&gt;();

this.availability.emit(true);</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Object
            </div>

            <pre><code>@@Output() courseDetails =
    new EventEmitter&lt;object&gt;();

this.courseDetails.emit({
    name: 'Python Full Stack',
    duration: '6 Months',
    mode: 'Online'
});</code></pre>

        </div>
    </section>

    <!-- CIIT Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete CIIT Training Institute Example</h2>

        <div class="info-card">

            <p>
                Suppose CIIT Training Institute has a reusable course card.
                When a visitor clicks the <strong>Enquire Now</strong> button,
                the child component sends the selected course information to
                the parent component.
            </p>

            <p class="mb-0">
                EventEmitter handles this Child → Parent communication.
            </p>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Child Component
            </div>

            <pre><code>import {
    Component,
    Output,
    EventEmitter
} from '@@angular/core';

@@Component({
    selector: 'app-course-card',
    templateUrl: './course-card.component.html'
})
export class CourseCardComponent {

    @@Output() enquiry =
        new EventEmitter&lt;string&gt;();

    courseName = 'Full Stack .NET';

    sendEnquiry() {

        this.enquiry.emit(this.courseName);

    }

}</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Child Template
            </div>

            <pre><code>&lt;div class="course-card"&gt;

    &lt;h3&gt;&#123;&#123; courseName &#125;&#125;&lt;/h3&gt;

    &lt;p&gt;
        Learn Full Stack Development
        at CIIT Training Institute.
    &lt;/p&gt;

    &lt;button
        type="button"
        (click)="sendEnquiry()"&gt;

        Enquire Now

    &lt;/button&gt;

&lt;/div&gt;</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Parent Template
            </div>

            <pre><code>&lt;app-course-card
    (enquiry)="receiveEnquiry($event)"&gt;
&lt;/app-course-card&gt;</code></pre>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Parent Component
            </div>

            <pre><code>receiveEnquiry(course: string) {

    console.log(
        'Enquiry received for:',
        course
    );

}</code></pre>

        </div>
    </section>

    <!-- Event Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Event Flow</h2>

        <div class="binding-flow">

            <div class="binding-item">
                <strong>Enquire Now</strong>
                <span>User Action</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>sendEnquiry()</strong>
                <span>Child Method</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>emit()</strong>
                <span>EventEmitter</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>$event</strong>
                <span>Parent Receives Data</span>
            </div>

        </div>
    </section>

    <!-- Important Points -->
    <section class="mb-4">
        <h2 class="fw-bold">Important Points</h2>

        <div class="best-practice-list">

            <div class="info-card mb-3">
                <strong>1. Event Creation</strong>
                <p class="mb-0">
                    EventEmitter is generally used with @@Output to create custom events.
                </p>
            </div>

            <div class="info-card mb-3">
                <strong>2. emit() Method</strong>
                <p class="mb-0">
                    The emit() method triggers the custom event.
                </p>
            </div>

            <div class="info-card mb-3">
                <strong>3. Send Data</strong>
                <p class="mb-0">
                    Data can be passed as an argument to emit().
                </p>
            </div>

            <div class="info-card">
                <strong>4. Parent Receives Data</strong>
                <p class="mb-0">
                    The parent accesses emitted data through $event.
                </p>
            </div>

        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">EventEmitter Best Practices</h2>

        <ul class="best-practice-list">
            <li>Use meaningful custom event names.</li>
            <li>Use EventEmitter with @@Output for Child → Parent communication.</li>
            <li>Use emit() only when the required event occurs.</li>
            <li>Use appropriate TypeScript types for emitted values.</li>
            <li>Send only the required information to the parent.</li>
            <li>Keep communication between components simple and clear.</li>
        </ul>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <div class="summary-box">

            <h4 class="fw-bold">Summary</h4>

            <p class="mb-0">
                <strong>EventEmitter</strong> is used with Angular
                <strong>@@Output</strong> to create custom events. The child component
                uses <strong>emit()</strong> to send an event or data, while the parent
                listens to the event using event binding and receives the value through
                <strong>$event</strong>.
            </p>

        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Output", "InputOutput", new { area = "Angular" })">
            ← Output
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("Index", "LifecycleHooks", new { area = "Angular" })">
            Lifecycle Hook →
        </a>

    </div>

</div>

<style>

    .info-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        line-height: 1.7;
    }

    .syntax-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        margin: 25px 0;
    }

    .syntax-box {
        background: linear-gradient(135deg, #2e1065, #4c1d95);
        color: white;
        padding: 18px 25px;
        border-radius: 12px;
        text-align: center;
        min-width: 180px;
        box-shadow: 0 5px 15px rgba(76, 29, 149, 0.15);
    }

        .syntax-box strong {
            display: block;
            font-size: 16px;
        }

        .syntax-box span {
            display: block;
            margin-top: 5px;
            color: #d8c9f5;
            font-size: 14px;
        }

    .syntax-arrow {
        font-size: 28px;
        font-weight: bold;
        color: #4c1d95;
    }

    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }

        .syntax-card h5 {
            margin-top: 15px;
            font-weight: 700;
        }

        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
            line-height: 1.6;
        }

    .syntax-icon {
        width: 48px;
        height: 48px;
        margin: auto;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
    }

    .code-card {
        background: #0f172a;
        border-radius: 10px;
        overflow: hidden;
        margin-top: 15px;
    }

    .code-title {
        background: #1e293b;
        color: #ddd6fe;
        padding: 10px 16px;
        font-weight: 600;
        border-bottom: 1px solid #334155;
    }

