@{
    ViewData["Title"] = "Angular History";
}

<div class="container-fluid">

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <div class="mb-4">

        <h1 class="fw-bold">
            Angular History
        </h1>

        <p class="text-muted">
            Understand how Angular evolved from AngularJS into a
            modern TypeScript-based framework for web application development.
        </p>

    </div>


    <!-- ===================================================== -->
    <!-- INTRODUCTION -->
    <!-- ===================================================== -->

    <section class="mb-5">

        <h2>
            Introduction to Angular History
        </h2>

        <p>
            Angular has evolved significantly over the years. It started
            with AngularJS and later became a modern framework known simply
            as Angular.
        </p>

        <p>
            The evolution of Angular introduced major improvements in
            application architecture, performance, development tools,
            TypeScript support, components, and application structure.
        </p>

    </section>


    <!-- ===================================================== -->
    <!-- ANGULAR EVOLUTION DIAGRAM -->
    <!-- ===================================================== -->

    <section class="mb-5">

        <h2>
            Evolution of Angular
        </h2>

        <p>
            The basic evolution of Angular can be understood through
            the following flow:
        </p>


        <div class="history-diagram">

            <div class="history-box">

                <div class="history-year">
                    2010
                </div>

                <h5>
                    AngularJS
                </h5>

                <p>
                    JavaScript-based framework introduced
                    for building web applications.
                </p>

            </div>


            <div class="history-arrow">
                →
            </div>


            <div class="history-box">

                <div class="history-year">
                    2016
                </div>

                <h5>
                    Angular 2+
                </h5>

                <p>
                    Major redesign with TypeScript,
                    components, and a new architecture.
                </p>

            </div>


            <div class="history-arrow">
                →
            </div>


            <div class="history-box">

                <div class="history-year">
                    Modern Angular
                </div>

                <h5>
                    Angular
                </h5>

                <p>
                    Modern framework for scalable and
                    component-based applications.
                </p>

            </div>

        </div>

    </section>


    <!-- ===================================================== -->
    <!-- ANGULARJS -->
    <!-- ===================================================== -->

    <section class="mb-5">

        <h2>
            AngularJS
        </h2>

        <p>
            AngularJS was the original Angular framework. It was
            based primarily on JavaScript and introduced concepts
            such as controllers, scopes, directives, dependency
            injection, and two-way data binding.
        </p>

        <p>
            AngularJS helped developers create dynamic web applications
            and single-page applications using a structured approach.
        </p>

    </section>


    <!-- ===================================================== -->
    <!-- ANGULAR 2 -->
    <!-- ===================================================== -->

    <section class="mb-5">

        <h2>
            Angular 2
        </h2>

        <p>
            Angular 2 represented a major redesign of AngularJS.
            Instead of being a direct continuation of AngularJS,
            it introduced a new application architecture.
        </p>

        <p>
            Angular 2 introduced a component-based approach and
            strong TypeScript support. This provided a more structured
            way to build large and maintainable applications.
        </p>

    </section>


    <!-- ===================================================== -->
    <!-- MODERN ANGULAR -->
    <!-- ===================================================== -->

    <section class="mb-5">

        <h2>
            Modern Angular
        </h2>

        <p>
            Modern Angular continues to evolve as a framework for
            building scalable web applications. It provides features
            such as components, templates, data binding, dependency
            injection, routing, forms, HTTP communication, and
            reactive programming.
        </p>

        <p>
            Modern Angular applications are primarily developed
            using TypeScript and follow a component-based architecture.
        </p>

    </section>


    <!-- ===================================================== -->
    <!-- IMPORTANT CHANGES -->
    <!-- ===================================================== -->

    <section class="mb-5">

        <h2>
            Important Changes in Angular Evolution
        </h2>


        <div class="row g-4 mt-2">

            <!-- COMPONENTS -->

            <div class="col-md-6 col-lg-4">

                <div class="history-feature-card h-100">

                    <h5>
                        Component-Based Architecture
                    </h5>

                    <p>
                        Applications are organized into reusable
                        components that manage specific parts of
                        the user interface.
                    </p>

                </div>

            </div>


            <!-- TYPESCRIPT -->

            <div class="col-md-6 col-lg-4">

                <div class="history-feature-card h-100">

                    <h5>
                        TypeScript
                    </h5>

                    <p>
                        TypeScript became an important part of Angular
                        development and provides strong typing and
                        modern programming features.
                    </p>

                </div>

            </div>


            <!-- PERFORMANCE -->

            <div class="col-md-6 col-lg-4">

                <div class="history-feature-card h-100">

                    <h5>
                        Better Performance
                    </h5>

                    <p>
                        Angular has continuously improved its
                        application performance and development
                        experience.
                    </p>

                </div>

            </div>


            <!-- TOOLING -->

            <div class="col-md-6 col-lg-4">

                <div class="history-feature-card h-100">

                    <h5>
                        Angular CLI
                    </h5>

                    <p>
                        Angular CLI provides commands for creating,
                        developing, testing, and building Angular
                        applications.
                    </p>

                </div>

            </div>


            <!-- ROUTING -->

            <div class="col-md-6 col-lg-4">

                <div class="history-feature-card h-100">

                    <h5>
                        Application Routing
                    </h5>

                    <p>
                        Angular provides routing capabilities for
                        creating applications with multiple views
                        and navigation paths.
                    </p>

                </div>

            </div>


            <!-- REACTIVE -->

            <div class="col-md-6 col-lg-4">

                <div class="history-feature-card h-100">

                    <h5>
                        Reactive Programming
                    </h5>

                    <p>
                        Angular works closely with RxJS and
                        Observable-based programming for handling
                        asynchronous operations.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ===================================================== -->
    <!-- ANGULAR HISTORY TIMELINE -->
    <!-- ===================================================== -->

    <section class="mb-5">

        <h2>
            Angular History at a Glance
        </h2>


        <div class="timeline">

            <div class="timeline-item">

                <div class="timeline-number">
                    1
                </div>

                <div>

                    <h5>
                        AngularJS
                    </h5>

                    <p class="mb-0">
                        The original JavaScript-based Angular framework.
                    </p>

                </div>

            </div>


            <div class="timeline-item">

                <div class="timeline-number">
                    2
                </div>

                <div>

                    <h5>
                        Angular 2+
                    </h5>

                    <p class="mb-0">
                        A major architectural change introduced
                        component-based development and TypeScript.
                    </p>

                </div>

            </div>


            <div class="timeline-item">

                <div class="timeline-number">
                    3
                </div>

                <div>

                    <h5>
                        Modern Angular
                    </h5>

                    <p class="mb-0">
                        A continuously evolving framework for building
                        modern and scalable web applications.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ===================================================== -->
    <!-- SUMMARY -->
    <!-- ===================================================== -->

    <section class="mb-5">

        <div class="summary-box">

            <h3>
                Summary
            </h3>

            <p>
                Angular evolved from AngularJS into a modern,
                TypeScript-based and component-oriented framework.
                The evolution introduced a new architecture,
                improved tooling, better development practices,
                and features for building scalable applications.
            </p>

            <p class="mb-0">
                In the next topic, we will learn about
                <strong>Angular Fundamentals</strong>.
            </p>

        </div>

    </section>


    <!-- ===================================================== -->
    <!-- PREVIOUS / NEXT -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between align-items-center
                border-top pt-4 mt-5">

        <!-- PREVIOUS -->

        <a href="@Url.Action("Index", "Introduction", new { area = "Angular" })"
           class="btn btn-outline-secondary px-4">

            ← Previous: Introduction

        </a>


        <!-- NEXT -->

        <a href="@Url.Action("Fundamentals", "Introduction", new { area = "Angular" })"
           class="btn btn-primary px-4">

            Next: Fundamentals →

        </a>

    </div>

</div>


<!-- ========================================================= -->
<!-- PAGE SPECIFIC CSS -->
<!-- ========================================================= -->

<style>

    /* ===================================================== */
    /* HISTORY DIAGRAM */
    /* ===================================================== */

    .history-diagram {

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 20px;

        padding: 35px 20px;

        margin-top: 25px;

        background: #f8f9fa;

        border: 1px solid #e9ecef;

        border-radius: 12px;

    }


    .history-box {

        width: 250px;

        min-height: 180px;

        padding: 22px;

        text-align: center;

        background: #ffffff;

        border: 1px solid #dee2e6;

        border-radius: 10px;

        box-shadow:
            0 3px 12px rgba(0, 0, 0, 0.05);

    }


    .history-year {

        display: inline-block;

        margin-bottom: 12px;

        padding: 5px 12px;

        background: #f1f3f5;

        border-radius: 20px;

        font-size: 13px;

        font-weight: 700;

    }


    .history-box h5 {

        font-weight: 700;

        margin-bottom: 10px;

    }


    .history-box p {

        font-size: 14px !important;

        line-height: 1.6 !important;

        margin-bottom: 0;

    }


    .history-arrow {

        font-size: 32px;

        font-weight: 600;

        color: #495057;

    }


    /* ===================================================== */
    /* FEATURE CARDS */
    /* ===================================================== */

    .history-feature-card {

        padding: 22px;

        background: #ffffff;

        border: 1px solid #e9ecef;

        border-radius: 10px;

        transition: 0.2s ease;

    }


    .history-feature-card:hover {

        box-shadow:
            0 4px 15px rgba(0, 0, 0, 0.08);

        transform: translateY(-2px);

    }


    .history-feature-card h5 {

        font-weight: 700;

        margin-bottom: 10px;

    }


    .history-feature-card p {

        margin-bottom: 0;

        font-size: 15px !important;

        line-height: 1.7 !important;

    }


    /* ===================================================== */
    /* TIMELINE */
    /* ===================================================== */

    .timeline {

        margin-top: 25px;

        padding: 10px 0;

    }


    .timeline-item {

        display: flex;

        align-items: flex-start;

        gap: 18px;

        padding: 20px;

        margin-bottom: 15px;

        background: #f8f9fa;

        border: 1px solid #e9ecef;

        border-radius: 10px;

    }


    .timeline-number {

        flex-shrink: 0;

        width: 38px;

        height: 38px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 50%;

        background: #e9ecef;

        font-weight: 700;

    }


    .timeline-item h5 {

        font-weight: 700;

        margin-bottom: 5px;

    }


    .timeline-item p {

        font-size: 15px !important;

        line-height: 1.6 !important;

    }


    /* ===================================================== */
    /* SUMMARY */
    /* ===================================================== */

    .summary-box {

        background: #cfe2ff;

        border-radius: 6px;

        padding: 18px 22px;

        margin-top: 20px;

    }


    .summary-box h3 {

        font-size: 20px;

        font-weight: 700;

        color: #084298;

        margin-bottom: 10px;

    }


    .summary-box p {

        font-size: 16px !important;

        line-height: 1.6 !important;

        color: #084298 !important;

        margin-bottom: 8px;

    }


    /* ===================================================== */
    /* MOBILE */
    /* ===================================================== */

    @@media (max-width: 768px) {

        .history-diagram {

            flex-direction: column;

            gap: 10px;

        }


        .history-box {

            width: 100%;

            max-width: 320px;

        }


        .history-arrow {

            transform: rotate(90deg);

            font-size: 28px;

        }


        .timeline-item {

            padding: 16px;

        }

    }


    @@media (max-width: 576px) {

        .history-feature-card {

            padding: 18px;

        }


        .timeline-item {

            gap: 12px;

        }

    }

</style>