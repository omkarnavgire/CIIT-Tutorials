@{
    ViewData["Title"] = "Angular InjectionToken";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">Angular InjectionToken</h1>

        <p class="lead text-muted">
            Angular <strong>InjectionToken</strong> is used to create a unique
            token that can represent a value, configuration object, interface,
            or other dependency that cannot be identified directly by a class.
        </p>

    </section>

    <!-- What is InjectionToken -->
    <section class="mb-4">

        <h2 class="fw-bold">What is InjectionToken?</h2>

        <p>
            Angular dependency injection normally uses a class type to identify
            a dependency. However, some dependencies are values or abstractions
            that do not have a runtime class representation.
        </p>

        <p>
            <strong>InjectionToken</strong> provides a unique token that Angular
            can use to identify and inject such dependencies.
        </p>

        <div class="info-card">

            <h5>Simple Definition</h5>

            <p>
                An <strong>InjectionToken</strong> is a unique key used by
                Angular's Dependency Injection system to identify a value or
                non-class dependency.
            </p>

        </div>

    </section>

    <!-- InjectionToken Flow -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">InjectionToken Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-key-fill"></i>

                <strong>InjectionToken</strong>

                <span>Creates unique token</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-gear-fill"></i>

                <strong>Provider</strong>

                <span>Associates value</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-diagram-3"></i>

                <strong>Injector</strong>

                <span>Resolves token</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-display"></i>

                <strong>Component</strong>

                <span>Receives value</span>

            </div>

        </div>

    </section>

    <!-- Why InjectionToken -->
    <section class="mb-4">

        <h2 class="fw-bold">Why Use InjectionToken?</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-key"></i>
                </div>

                <h5>Unique Identifier</h5>

                <p>
                    Provides a unique identifier for a dependency.
                </p>

                <code>new InjectionToken()</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-sliders"></i>
                </div>

                <h5>Configuration</h5>

                <p>
                    Useful for injecting application configuration values.
                </p>

                <code>API_URL</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-braces"></i>
                </div>

                <h5>Non-Class Values</h5>

                <p>
                    Can represent strings, objects, arrays, and other values.
                </p>

                <code>string | object</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-diagram-2"></i>
                </div>

                <h5>Abstraction</h5>

                <p>
                    Can represent dependencies that are not concrete classes.
                </p>

                <code>Token</code>

            </div>

        </div>

    </section>

    <!-- Basic Syntax -->
    <section class="mb-4">

        <h2 class="fw-bold">1. Basic InjectionToken Syntax</h2>

        <p>
            An InjectionToken can be created by importing
            <strong>InjectionToken</strong> from Angular core.
        </p>

        <div class="code-card">

            <div class="code-title">
                token.ts
            </div>

            <pre><code>import &#123; InjectionToken &#125; from '@@angular/core';

export const API_URL =
    new InjectionToken&lt;string&gt;('API_URL');</code></pre>

        </div>

        <div class="info-card">

            <h5>Important</h5>

            <p>
                The generic type <strong>&lt;string&gt;</strong> describes
                the type of value associated with the token.
            </p>

        </div>

    </section>

    <!-- Provider with Token -->
    <section class="mb-4">

        <h2 class="fw-bold">2. Providing a Value with InjectionToken</h2>

        <p>
            After creating a token, a provider can associate a value with it.
        </p>

        <div class="code-card">

            <div class="code-title">
                app.config.ts
            </div>

            <pre><code>import &#123; ApplicationConfig &#125; from '@@angular/core';

import &#123; API_URL &#125; from './tokens';

export const appConfig: ApplicationConfig = &#123;

    providers: [

        &#123;
            provide: API_URL,
            useValue: 'https://api.example.com'
        &#125;

    ]

&#125;;</code></pre>

        </div>

        <div class="binding-flow">

            <div class="binding-item">

                <strong>API_URL</strong>

                <span>
                    InjectionToken
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>provide</strong>

                <span>
                    Associates Token
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>useValue</strong>

                <span>
                    Provides String
                </span>

            </div>

        </div>

    </section>

    <!-- Injecting Token -->
    <section class="mb-4">

        <h2 class="fw-bold">3. Injecting an InjectionToken</h2>

        <p>
            Once a value is registered against a token, it can be injected
            into a component.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>import &#123;
    Component,
    Inject
&#125; from '@@angular/core';

import &#123; API_URL &#125; from './tokens';

@@Component(&#123;
    selector: 'app-dashboard',
    templateUrl: './dashboard.component.html'
&#125;)
export class DashboardComponent &#123;

    constructor(
        @@Inject(API_URL)
        private apiUrl: string
    ) &#123;

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                Angular uses the <strong>API_URL</strong> token to locate the
                value registered by the provider and supplies that value to
                the component.
            </p>

        </div>

    </section>

    <!-- Using inject with Token -->
    <section class="mb-4">

        <h2 class="fw-bold">4. Injecting a Token with inject()</h2>

        <p>
            An InjectionToken can also be obtained using Angular's
            <strong>inject()</strong> function.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>import &#123;
    Component,
    inject
&#125; from '@@angular/core';

import &#123; API_URL &#125; from './tokens';

@@Component(&#123;
    selector: 'app-dashboard',
    templateUrl: './dashboard.component.html'
&#125;)
export class DashboardComponent &#123;

    private apiUrl =
        inject(API_URL);

&#125;</code></pre>

        </div>

        <div class="output-box">

            <strong>Injected Value:</strong>

            <div class="output-preview">

                <strong>https://api.example.com</strong>

            </div>

        </div>

    </section>

    <!-- String Token -->
    <section class="mb-4">

        <h2 class="fw-bold">5. InjectionToken for String Values</h2>

        <p>
            A token can represent a simple string configuration value.
        </p>

        <div class="code-card">

            <div class="code-title">
                tokens.ts
            </div>

            <pre><code>export const APP_NAME =
    new InjectionToken&lt;string&gt;('APP_NAME');</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Provider
            </div>

            <pre><code>&#123;
    provide: APP_NAME,
    useValue: 'CIIT Training Institute'
&#125;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Value:</strong>

            <div class="output-preview">

                CIIT Training Institute

            </div>

        </div>

    </section>

    <!-- Object Token -->
    <section class="mb-4">

        <h2 class="fw-bold">6. InjectionToken for Configuration Objects</h2>

        <p>
            InjectionToken can also represent an object containing multiple
            configuration values.
        </p>

        <div class="code-card">

            <div class="code-title">
                app-config.ts
            </div>

            <pre><code>export interface AppConfig &#123;

    apiUrl: string;

    environment: string;

    enableLogging: boolean;

&#125;

export const APP_CONFIG =
    new InjectionToken&lt;AppConfig&gt;('APP_CONFIG');</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Provider
            </div>

            <pre><code>&#123;
    provide: APP_CONFIG,

    useValue: &#123;

        apiUrl: 'https://api.example.com',

        environment: 'production',

        enableLogging: true

    &#125;
&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>Benefit</h5>

            <p>
                A single token can represent a structured configuration object
                instead of creating separate dependencies for every setting.
            </p>

        </div>

    </section>

    <!-- Factory Provider -->
    <section class="mb-4">

        <h2 class="fw-bold">7. InjectionToken with Factory Provider</h2>

        <p>
            A factory provider can calculate or create the value associated
            with an InjectionToken.
        </p>

        <div class="code-card">

            <div class="code-title">
                Provider
            </div>

            <pre><code>export const CURRENT_ENVIRONMENT =
    new InjectionToken&lt;string&gt;('CURRENT_ENVIRONMENT');

&#123;
    provide: CURRENT_ENVIRONMENT,

    useFactory: () =&gt; &#123;

        return 'production';

    &#125;
&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                Instead of directly providing a fixed value, Angular calls the
                factory function to obtain the dependency value.
            </p>

        </div>

    </section>

    <!-- Optional Token -->
    <section class="mb-4">

        <h2 class="fw-bold">8. Optional Token Dependency</h2>

        <p>
            A dependency can be marked optional when the application should
            continue working even if no provider is found for that dependency.
        </p>

        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>import &#123;
    Component,
    inject
&#125; from '@@angular/core';

import &#123;
    APP_CONFIG
&#125; from './app-config';

@@Component(&#123;
    selector: 'app-config',
    templateUrl: './config.component.html'
&#125;)
export class ConfigComponent &#123;

    config = inject(
        APP_CONFIG,
        &#123; optional: true &#125;
    );

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>Use Case</h5>

            <p>
                Optional dependencies can be useful when a configuration or
                feature is not guaranteed to have a provider.
            </p>

        </div>

    </section>

    <!-- InjectionToken vs Service -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">9. InjectionToken vs Service</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>

                        <th>InjectionToken</th>
                        <th>Service</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            Represents a value, configuration, or abstraction.
                        </td>

                        <td>
                            Usually represents a class containing functionality.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Useful for non-class dependencies.
                        </td>

                        <td>
                            Useful for reusable application logic.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Example: API URL or application configuration.
                        </td>

                        <td>
                            Example: CourseService or TrainingService.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Uses a unique token as the DI key.
                        </td>

                        <td>
                            The class itself can act as the DI token.
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- InjectionToken Types -->
    <section class="mb-4">

        <h2 class="fw-bold">10. Common InjectionToken Use Cases</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-link-45deg"></i>
                </div>

                <h5>API URL</h5>

                <p>
                    Store a backend API endpoint as injectable configuration.
                </p>

                <code>API_URL</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-building"></i>
                </div>

                <h5>App Name</h5>

                <p>
                    Provide application-specific string configuration.
                </p>

                <code>APP_NAME</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-sliders"></i>
                </div>

                <h5>Configuration</h5>

                <p>
                    Provide structured application settings.
                </p>

                <code>APP_CONFIG</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-toggle-on"></i>
                </div>

                <h5>Feature Flag</h5>

                <p>
                    Provide feature configuration through dependency injection.
                </p>

                <code>ENABLE_FEATURE</code>

            </div>

        </div>

    </section>

    <!-- Token Resolution -->
    <section class="mb-4">

        <h2 class="fw-bold">11. How Angular Resolves an InjectionToken</h2>

        <div class="code-card">

            <div class="code-title">
                Resolution Flow
            </div>

            <pre><code>Component
    |
    ↓
Requests API_URL
    |
    ↓
Angular Injector
    |
    ↓
Searches Provider
    |
    ↓
API_URL Provider Found
    |
    ↓
Returns Registered Value
    |
    ↓
Component Receives Value</code></pre>

        </div>

        <div class="binding-flow">

            <div class="binding-item">

                <strong>Token</strong>

                <span>
                    API_URL
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Provider</strong>

                <span>
                    useValue
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Injector</strong>

                <span>
                    Resolves Token
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Component</strong>

                <span>
                    Receives Value
                </span>

            </div>

        </div>

    </section>

    <!-- Complete CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">Complete CIIT Training Institute Example</h2>

        <p>
            Suppose the CIIT Training Institute Angular application needs a
            configurable API URL and institute name. InjectionToken can be
            used to provide these values through Angular Dependency Injection.
        </p>

        <div class="code-card">

            <div class="code-title">
                tokens.ts
            </div>

            <pre><code>import &#123; InjectionToken &#125;
from '@@angular/core';

export const API_URL =
    new InjectionToken&lt;string&gt;('API_URL');

export const INSTITUTE_NAME =
    new InjectionToken&lt;string&gt;('INSTITUTE_NAME');</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                app.config.ts
            </div>

            <pre><code>export const appConfig: ApplicationConfig = &#123;

    providers: [

        &#123;
            provide: API_URL,
            useValue:
                'https://api.example.com'
        &#125;,

        &#123;
            provide: INSTITUTE_NAME,
            useValue:
                'CIIT Training Institute'
        &#125;

    ]

&#125;;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.ts
            </div>

            <pre><code>import &#123;
    Component,
    inject
&#125; from '@@angular/core';

import &#123;
    API_URL,
    INSTITUTE_NAME
&#125; from './tokens';

@@Component(&#123;
    selector: 'app-dashboard',
    templateUrl: './dashboard.component.html'
&#125;)
export class DashboardComponent &#123;

    apiUrl = inject(API_URL);

    instituteName =
        inject(INSTITUTE_NAME);

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.html
            </div>

            <pre><code>&lt;h2&gt;
    &#123;&#123; instituteName &#125;&#125;
&lt;/h2&gt;

&lt;p&gt;
    API URL:
    &#123;&#123; apiUrl &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>
                    CIIT Training Institute
                </h3>

                <p>
                    <strong>API URL:</strong>
                    https://api.example.com
                </p>

            </div>

        </div>

    </section>

    <!-- Quick Reference -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">InjectionToken Quick Reference</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>

                        <th>Concept</th>
                        <th>Purpose</th>
                        <th>Example</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            InjectionToken
                        </td>

                        <td>
                            Creates a unique DI identifier
                        </td>

                        <td>
                            <code>new InjectionToken&lt;string&gt;()</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            provide
                        </td>

                        <td>
                            Associates a provider with the token
                        </td>

                        <td>
                            <code>provide: API_URL</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            useValue
                        </td>

                        <td>
                            Provides a fixed value
                        </td>

                        <td>
                            <code>useValue: 'API'</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            useFactory
                        </td>

                        <td>
                            Creates the dependency using a factory
                        </td>

                        <td>
                            <code>useFactory</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            inject()
                        </td>

                        <td>
                            Retrieves the token value
                        </td>

                        <td>
                            <code>inject(API_URL)</code>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">Important Points About InjectionToken</h2>

        <ul class="best-practice-list">

            <li>
                InjectionToken creates a unique identifier for a dependency.
            </li>

            <li>
                It is useful for values and dependencies that do not have
                a class type at runtime.
            </li>

            <li>
                Tokens can represent strings, objects, configuration,
                and other values.
            </li>

            <li>
                Providers associate values or factories with the token.
            </li>

            <li>
                Components can retrieve token values through Dependency Injection.
            </li>

            <li>
                InjectionToken is especially useful for configurable
                application settings.
            </li>

        </ul>

    </section>

    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">InjectionToken Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Use clear and descriptive token names.
            </li>

            <li>
                Keep configuration tokens grouped in a meaningful file.
            </li>

            <li>
                Use appropriate generic types for token values.
            </li>

            <li>
                Avoid creating duplicate tokens for the same dependency.
            </li>

            <li>
                Keep provider configuration easy to understand and maintain.
            </li>

            <li>
                Use InjectionToken when a dependency cannot be represented
                naturally by a class.
            </li>

        </ul>

    </section>

    <!-- Summary -->
    <section class="summary-box">

        <h3>Summary</h3>

        <p>
            Angular <strong>InjectionToken</strong> provides a unique identifier
            that can be used by the Dependency Injection system for values,
            configuration objects, and other non-class dependencies.
        </p>

        <p>
            A token is associated with a provider using options such as
            <strong>useValue</strong> or <strong>useFactory</strong>, and the
            resulting dependency can then be injected into components or
            services.
        </p>

    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("InjectingDependencies", "DependencyInjection", new { area = "Angular" })">
            ← Injecting Dependencies
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("Providers", "DependencyInjection", new { area = "Angular" })">
            Provider Configuration →
        </a>

    </div>

</div>

