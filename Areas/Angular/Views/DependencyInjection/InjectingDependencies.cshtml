@{
    ViewData["Title"] = "Injecting Dependencies in Angular";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">Injecting Dependencies</h1>

        <p class="lead text-muted">
            Angular allows a component or service to receive the objects it
            needs through Dependency Injection. Instead of creating those
            objects manually, Angular provides them through its injector.
        </p>

    </section>

    <!-- What is Injecting Dependencies -->
    <section class="mb-4">

        <h2 class="fw-bold">What Does Injecting a Dependency Mean?</h2>

        <p>
            A dependency is an object required by another class to perform
            some operation.
        </p>

        <p>
            Injecting a dependency means asking Angular to provide that object
            instead of creating the object directly with <strong>new</strong>.
        </p>

        <div class="info-card">

            <h5>Simple Definition</h5>

            <p>
                Dependency Injection allows a class to
                <strong>receive the object it needs from Angular</strong>
                rather than creating that object itself.
            </p>

        </div>

    </section>

    <!-- Injection Flow -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Dependency Injection Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-display"></i>

                <strong>Component</strong>

                <span>Needs service</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-diagram-3"></i>

                <strong>Constructor</strong>

                <span>Declares dependency</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-gear-fill"></i>

                <strong>Injector</strong>

                <span>Resolves dependency</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-arrow-return-left"></i>

                <strong>Service Instance</strong>

                <span>Provided to component</span>

            </div>

        </div>

    </section>

    <!-- Main Ways -->
    <section class="mb-4">

        <h2 class="fw-bold">Common Dependency Injection Approaches</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-braces"></i>
                </div>

                <h5>Constructor Injection</h5>

                <p>
                    Declare the required dependency in the constructor.
                </p>

                <code>constructor(...)</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-arrow-down-circle"></i>
                </div>

                <h5>inject()</h5>

                <p>
                    Obtain a dependency using Angular's inject function.
                </p>

                <code>inject()</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-gear"></i>
                </div>

                <h5>Provider</h5>

                <p>
                    Defines how Angular should provide a dependency.
                </p>

                <code>providers</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-layers"></i>
                </div>

                <h5>Injector Hierarchy</h5>

                <p>
                    Angular resolves dependencies through its injector hierarchy.
                </p>

                <code>Injector</code>

            </div>

        </div>

    </section>

    <!-- Constructor Injection -->
    <section class="mb-4">

        <h2 class="fw-bold">1. Constructor Injection</h2>

        <p>
            Constructor injection is a common approach where a service is
            declared as a constructor parameter.
        </p>

        <div class="code-card">

            <div class="code-title">
                Service
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseService &#123;

    getCourseName(): string &#123;

        return 'Angular Full Stack';

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>import &#123; Component &#125; from '@@angular/core';
import &#123; CourseService &#125; from './course.service';

@@Component(&#123;
    selector: 'app-course',
    templateUrl: './course.component.html'
&#125;)
export class CourseComponent &#123;

    constructor(
        private courseService: CourseService
    ) &#123;

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                Angular sees that <strong>CourseComponent</strong> requires
                <strong>CourseService</strong> and asks the injector to
                resolve that dependency.
            </p>

        </div>

    </section>

    <!-- Using Injected Service -->
    <section class="mb-4">

        <h2 class="fw-bold">2. Using the Injected Dependency</h2>

        <p>
            Once a service has been injected, the component can call its
            methods through the injected property.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>courseName = '';

constructor(
    private courseService: CourseService
) &#123;

&#125;

loadCourse(): void &#123;

    this.courseName =
        this.courseService.getCourseName();

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;button
    class="btn btn-primary"
    (click)="loadCourse()"&gt;

    Load Course

&lt;/button&gt;

&lt;p&gt;
    Course:
    &#123;&#123; courseName &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <p>
                    Course:
                    <strong>Angular Full Stack</strong>
                </p>

            </div>

        </div>

    </section>

    <!-- Multiple Dependencies -->
    <section class="mb-4">

        <h2 class="fw-bold">3. Injecting Multiple Dependencies</h2>

        <p>
            A component can request multiple services when it needs
            functionality from different parts of the application.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>constructor(

    private courseService: CourseService,

    private trainingService: TrainingService,

    private notificationService:
        NotificationService

) &#123;

&#125;</code></pre>

        </div>

        <div class="binding-flow">

            <div class="binding-item">

                <strong>CourseService</strong>

                <span>
                    Course Data
                </span>

            </div>

            <div class="binding-item">

                <strong>TrainingService</strong>

                <span>
                    Training Data
                </span>

            </div>

            <div class="binding-item">

                <strong>NotificationService</strong>

                <span>
                    Messages
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Dashboard</strong>

                <span>
                    Uses Dependencies
                </span>

            </div>

        </div>

    </section>

    <!-- Inject Function -->
    <section class="mb-4">

        <h2 class="fw-bold">4. Using inject()</h2>

        <p>
            Angular also provides the <strong>inject()</strong> function for
            obtaining dependencies in supported injection contexts.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>import &#123; Component, inject &#125; from '@@angular/core';
import &#123; CourseService &#125; from './course.service';

@@Component(&#123;
    selector: 'app-course',
    templateUrl: './course.component.html'
&#125;)
export class CourseComponent &#123;

    private courseService =
        inject(CourseService);

    courseName = '';

    loadCourse(): void &#123;

        this.courseName =
            this.courseService.getCourseName();

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>Important</h5>

            <p>
                The <strong>inject()</strong> function retrieves a dependency
                from Angular's dependency injection system without declaring
                it as a constructor parameter.
            </p>

        </div>

    </section>

    <!-- Constructor vs inject -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">5. Constructor Injection vs inject()</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>

                        <th>Constructor Injection</th>
                        <th>inject()</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            Dependency is declared as a constructor parameter.
                        </td>

                        <td>
                            Dependency is obtained using the inject() function.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Common and easy to understand.
                        </td>

                        <td>
                            Useful in supported Angular injection contexts.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Works naturally with class dependencies.
                        </td>

                        <td>
                            Can reduce constructor parameters.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Example: <code>constructor(private service: Service)</code>
                        </td>

                        <td>
                            Example: <code>private service = inject(Service)</code>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Provider Dependency -->
    <section class="mb-4">

        <h2 class="fw-bold">6. Dependency and Provider</h2>

        <p>
            Angular needs to know how a dependency should be provided. This
            information is configured through providers or service metadata.
        </p>

        <div class="code-card">

            <div class="code-title">
                Root Provider
            </div>

            <pre><code>@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Component Provider
            </div>

            <pre><code>@@Component(&#123;

    selector: 'app-dashboard',

    providers: [
        TrainingService
    ],

    templateUrl: './dashboard.component.html'

&#125;)
export class DashboardComponent &#123;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>Key Idea</h5>

            <p>
                The provider determines how Angular can resolve the requested
                dependency in the appropriate injector hierarchy.
            </p>

        </div>

    </section>

    <!-- Injection Resolution -->
    <section class="mb-4">

        <h2 class="fw-bold">7. How Angular Resolves a Dependency</h2>

        <p>
            When a component requests a dependency, Angular looks for a
            matching provider in its injector hierarchy.
        </p>

        <div class="code-card">

            <div class="code-title">
                Resolution Flow
            </div>

            <pre><code>Component
    |
    ↓
Requests CourseService
    |
    ↓
Current Injector
    |
    ↓
Provider Found?
    |
    ├── Yes → Create / Reuse Service
    |
    └── No  → Look in Parent Injector
                    |
                    ↓
             Continue Hierarchy</code></pre>

        </div>

        <div class="info-card">

            <h5>Simple Idea</h5>

            <p>
                Angular follows its injector hierarchy to find a provider
                that can satisfy the dependency request.
            </p>

        </div>

    </section>

    <!-- Injected Service in OnInit -->
    <section class="mb-4">

        <h2 class="fw-bold">8. Using an Injected Service in ngOnInit()</h2>

        <p>
            After a service has been injected, it can be used during component
            initialization to load or prepare data.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>courses: string[] = [];

constructor(
    private courseService: CourseService
) &#123;

&#125;

ngOnInit(): void &#123;

    this.courses =
        this.courseService.getCourses();

&#125;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Behavior:</strong>

            <div class="output-preview">

                <p>
                    The injected service provides the course data during
                    component initialization.
                </p>

            </div>

        </div>

    </section>

    <!-- Service as Dependency of Service -->
    <section class="mb-4">

        <h2 class="fw-bold">9. Injecting a Service into Another Service</h2>

        <p>
            Angular services can also have dependencies on other services.
        </p>

        <div class="code-card">

            <div class="code-title">
                notification.service.ts
            </div>

            <pre><code>@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class NotificationService &#123;

    show(message: string): void &#123;

        console.log(message);

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                training.service.ts
            </div>

            <pre><code>@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

    constructor(
        private notificationService:
            NotificationService
    ) &#123;

    &#125;

    saveCourse(): void &#123;

        this.notificationService.show(
            'Course saved successfully'
        );

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>Important</h5>

            <p>
                Dependency Injection is not limited to components. Services
                can also receive dependencies through Angular's injector.
            </p>

        </div>

    </section>

    <!-- Interface Example -->
    <section class="mb-4">

        <h2 class="fw-bold">10. Dependency Through an Abstraction</h2>

        <p>
            Angular can also use injection tokens when the dependency is
            represented by an abstraction rather than a concrete class.
        </p>

        <div class="code-card">

            <div class="code-title">
                Concept Example
            </div>

            <pre><code>export const API_URL =
    new InjectionToken&lt;string&gt;('API_URL');</code></pre>

        </div>

        <div class="info-card">

            <h5>Why Use an Injection Token?</h5>

            <p>
                Injection tokens are useful when Angular needs to inject a
                value or dependency that cannot be represented directly by
                a class type.
            </p>

        </div>

    </section>

    <!-- Complete CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">Complete CIIT Training Institute Example</h2>

        <p>
            Suppose the CIIT Training Institute dashboard needs course
            information and notifications. Both services can be injected
            into the dashboard.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseService &#123;

    getCourses(): string[] &#123;

        return [

            'Java Full Stack',
            'Python Full Stack',
            'Full Stack .NET',
            'Data Analytics'

        ];

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                notification.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class NotificationService &#123;

    show(message: string): void &#123;

        console.log(message);

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.ts
            </div>

            <pre><code>import &#123;
    Component,
    OnInit
&#125; from '@@angular/core';

import &#123; CourseService &#125;
from './course.service';

import &#123; NotificationService &#125;
from './notification.service';

@@Component(&#123;
    selector: 'app-dashboard',
    templateUrl: './dashboard.component.html'
&#125;)
export class DashboardComponent
    implements OnInit &#123;

    courses: string[] = [];

    constructor(

        private courseService:
            CourseService,

        private notificationService:
            NotificationService

    ) &#123;

    &#125;

    ngOnInit(): void &#123;

        this.courses =
            this.courseService.getCourses();

        this.notificationService.show(
            'CIIT Dashboard Loaded'
        );

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.html
            </div>

            <pre><code>&lt;h2&gt;
    CIIT Training Institute
&lt;/h2&gt;

&lt;h4&gt;
    Available Courses
&lt;/h4&gt;

&lt;ul&gt;

    &lt;li *ngFor="let course of courses"&gt;
        &#123;&#123; course &#125;&#125;
    &lt;/li&gt;

&lt;/ul&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>
                    CIIT Training Institute
                </h3>

                <p>
                    Available Courses
                </p>

                <ul>

                    <li>Java Full Stack</li>
                    <li>Python Full Stack</li>
                    <li>Full Stack .NET</li>
                    <li>Data Analytics</li>

                </ul>

                <p>
                    Notification:
                    <strong>CIIT Dashboard Loaded</strong>
                </p>

            </div>

        </div>

    </section>

    <!-- DI Quick Reference -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Dependency Injection Quick Reference</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>

                        <th>Concept</th>
                        <th>Purpose</th>
                        <th>Example</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            Dependency
                        </td>

                        <td>
                            Object required by another class
                        </td>

                        <td>
                            <code>CourseService</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Constructor Injection
                        </td>

                        <td>
                            Receive dependency through constructor
                        </td>

                        <td>
                            <code>constructor(...)</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            inject()
                        </td>

                        <td>
                            Obtain dependency through Angular's inject function
                        </td>

                        <td>
                            <code>inject(Service)</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Provider
                        </td>

                        <td>
                            Defines how dependency is provided
                        </td>

                        <td>
                            <code>providedIn</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Injector
                        </td>

                        <td>
                            Resolves dependencies
                        </td>

                        <td>
                            <code>Injector</code>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">Important Points About Injecting Dependencies</h2>

        <ul class="best-practice-list">

            <li>
                A dependency is an object required by another class.
            </li>

            <li>
                Angular can provide dependencies through its injector.
            </li>

            <li>
                Constructor injection is a common way to receive services.
            </li>

            <li>
                The <strong>inject()</strong> function can obtain dependencies
                in supported injection contexts.
            </li>

            <li>
                Providers tell Angular how dependencies should be supplied.
            </li>

            <li>
                Services can themselves have dependencies.
            </li>

        </ul>

    </section>

    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">Dependency Injection Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Prefer Angular's Dependency Injection system instead of
                manually creating service objects.
            </li>

            <li>
                Keep constructor dependencies meaningful and focused.
            </li>

            <li>
                Use services for reusable application logic.
            </li>

            <li>
                Choose an appropriate provider scope for each dependency.
            </li>

            <li>
                Avoid injecting unnecessary services into a component.
            </li>

            <li>
                Use injection tokens when a value or abstraction requires one.
            </li>

        </ul>

    </section>

    <!-- Summary -->
    <section class="summary-box">

        <h3>Summary</h3>

        <p>
            Angular Dependency Injection allows a component or service to
            receive the objects it needs from Angular's injector.
        </p>

        <p>
            Dependencies can be injected using constructor injection or
            <strong>inject()</strong>, while providers define how Angular
            resolves those dependencies.
        </p>

    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", "DependencyInjection", new { area = "Angular" })">
            ← Dependency Injection
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("InjectionToken", "DependencyInjection", new { area = "Angular" })">
            Injection Token →
        </a>

    </div>

</div>

