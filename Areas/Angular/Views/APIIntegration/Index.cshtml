@{
    ViewData["Title"] = "Angular API Integration";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">
            Angular API Integration
        </h1>

        <p class="lead text-muted">
            Learn how Angular applications connect with backend APIs,
            send requests, receive responses and work with application data.
        </p>

    </section>


    <!-- Introduction -->
    <section class="mb-4">

        <h2 class="fw-bold">
            What is API Integration?
        </h2>

        <div class="info-card">

            <p>
                <strong>API Integration</strong> means connecting an Angular
                application with a backend service so that the application
                can send and receive data.
            </p>

            <p>
                Angular applications commonly communicate with REST APIs
                using <strong>HttpClient</strong>.
            </p>

            <p class="mb-0">
                API integration allows the frontend to work with real
                application data instead of depending only on static values.
            </p>

        </div>

    </section>


    <!-- API Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Angular API Communication Flow
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>Angular Component</strong>

                <span>
                    User Action
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Service</strong>

                <span>
                    HttpClient
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>REST API</strong>

                <span>
                    Backend Server
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Response</strong>

                <span>
                    JSON Data
                </span>

            </div>

        </div>

    </section>


    <!-- Why API -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Why Use APIs?
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    D
                </div>

                <h5>
                    Dynamic Data
                </h5>

                <p>
                    Load data from a backend instead of hard-coded values.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    C
                </div>

                <h5>
                    Centralized Data
                </h5>

                <p>
                    Frontend and backend can work with the same application data.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    R
                </div>

                <h5>
                    Real Applications
                </h5>

                <p>
                    Build applications that communicate with databases and
                    backend services.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    S
                </div>

                <h5>
                    Separation
                </h5>

                <p>
                    Frontend presentation and backend business logic can
                    remain separate.
                </p>

            </div>

        </div>

    </section>


    <!-- REST API -->
    <section class="mb-4">

        <h2 class="fw-bold">
            What is a REST API?
        </h2>

        <div class="info-card">

            <p>
                A <strong>REST API</strong> exposes backend resources through
                HTTP endpoints that clients can communicate with.
            </p>

            <p class="mb-0">
                Angular sends an HTTP request to an endpoint and receives
                a response from the backend service.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example Endpoint
            </div>

            <pre><code>GET /api/courses</code></pre>

        </div>

    </section>


    <!-- HttpClient -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Angular HttpClient
        </h2>

        <div class="info-card">

            <p>
                Angular provides <strong>HttpClient</strong> for making HTTP
                requests to backend services.
            </p>

            <p class="mb-0">
                HttpClient methods return Observable-based results that can
                be consumed by Angular components and services.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Import HttpClient
            </div>

            <pre><code>import {
    HttpClient
} from '@@angular/common/http';</code></pre>

        </div>

    </section>


    <!-- Service -->
    <section class="mb-4">

        <h2 class="fw-bold">
            API Integration Through a Service
        </h2>

        <div class="info-card">

            <p>
                API communication is commonly placed inside an Angular
                service instead of directly writing all HTTP logic inside
                the component.
            </p>

            <p class="mb-0">
                This keeps components focused on presentation and application
                interaction while the service handles communication.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Course Service
            </div>

            <pre><code>import { Injectable } from '@@angular/core';

import {
    HttpClient
} from '@@angular/common/http';

@@Injectable({
    providedIn: 'root'
})
export class CourseService {

    private apiUrl =
        '/api/courses';

    constructor(
        private http: HttpClient
    ) {
    }


    getCourses() {

        return this.http.get&lt;Course[]&gt;(
            this.apiUrl
        );

    }

}</code></pre>

        </div>

    </section>


    <!-- Component -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Consuming API Data in Component
        </h2>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>export class CoursesComponent {

    courses: Course[] = [];

    constructor(
        private courseService: CourseService
    ) {
    }


    loadCourses() {

        this.courseService
            .getCourses()
            .subscribe({

                next: courses =&gt; {

                    this.courses = courses;

                },

                error: error =&gt; {

                    console.error(error);

                }

            });

    }

}</code></pre>

        </div>

    </section>


    <!-- API Request Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Complete API Request Flow
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>User Action</strong>

                <span>
                    Load Courses
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Component</strong>

                <span>
                    Calls Service
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>HttpClient</strong>

                <span>
                    Sends GET
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>API</strong>

                <span>
                    Returns Data
                </span>

            </div>

        </div>

    </section>


    <!-- HTTP Methods -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Common HTTP Methods
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    G
                </div>

                <h5>
                    GET
                </h5>

                <p>
                    Retrieve data from the backend.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    P
                </div>

                <h5>
                    POST
                </h5>

                <p>
                    Send data to create a new resource.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    U
                </div>

                <h5>
                    PUT
                </h5>

                <p>
                    Update an existing resource.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    D
                </div>

                <h5>
                    DELETE
                </h5>

                <p>
                    Remove a resource from the backend.
                </p>

            </div>

        </div>

    </section>


    <!-- GET -->
    <section class="mb-4">

        <h2 class="fw-bold">
            GET Request
        </h2>

        <p>
            A GET request is used to retrieve data from an API endpoint.
        </p>


        <div class="code-card">

            <div class="code-title">
                HttpClient GET
            </div>

            <pre><code>getCourses() {

    return this.http.get&lt;Course[]&gt;(
        '/api/courses'
    );

}</code></pre>

        </div>

    </section>


    <!-- POST -->
    <section class="mb-4">

        <h2 class="fw-bold">
            POST Request
        </h2>

        <p>
            POST is commonly used when the frontend needs to send data
            to the backend to create a new resource.
        </p>


        <div class="code-card">

            <div class="code-title">
                HttpClient POST
            </div>

            <pre><code>addCourse(course: Course) {

    return this.http.post&lt;Course&gt;(
        '/api/courses',
        course
    );

}</code></pre>

        </div>

    </section>


    <!-- PUT -->
    <section class="mb-4">

        <h2 class="fw-bold">
            PUT Request
        </h2>

        <p>
            PUT can be used to send updated data for an existing resource.
        </p>


        <div class="code-card">

            <div class="code-title">
                HttpClient PUT
            </div>

            <pre><code>updateCourse(
    id: number,
    course: Course
) {

    return this.http.put&lt;Course&gt;(
        '/api/courses/' + id,
        course
    );

}</code></pre>

        </div>

    </section>


    <!-- DELETE -->
    <section class="mb-4">

        <h2 class="fw-bold">
            DELETE Request
        </h2>

        <p>
            DELETE can be used to remove a resource through an API endpoint.
        </p>


        <div class="code-card">

            <div class="code-title">
                HttpClient DELETE
            </div>

            <pre><code>deleteCourse(id: number) {

    return this.http.delete(
        '/api/courses/' + id
    );

}</code></pre>

        </div>

    </section>


    <!-- API Response -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Working with API Responses
        </h2>

        <div class="info-card">

            <p>
                The backend commonly sends structured data such as JSON.
            </p>

            <p class="mb-0">
                Angular can assign the received response to component
                properties and use it to update the user interface.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example Response
            </div>

            <pre><code>[
    {
        "id": 1,
        "name": "Java Full Stack"
    },
    {
        "id": 2,
        "name": ".NET Full Stack"
    }
]</code></pre>

        </div>

    </section>


    <!-- Error Handling -->
    <section class="mb-4">

        <h2 class="fw-bold">
            API Error Handling
        </h2>

        <div class="info-card">

            <p>
                API communication can fail because of network problems,
                invalid requests, server errors or other backend conditions.
            </p>

            <p class="mb-0">
                Angular applications should handle failed requests and
                provide an appropriate user experience.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>this.courseService
    .getCourses()
    .subscribe({

        next: courses =&gt; {

            this.courses = courses;

        },

        error: error =&gt; {

            console.error(
                'API Error:',
                error
            );

        }

    });</code></pre>

        </div>

    </section>


    <!-- Loading -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Loading State
        </h2>

        <div class="info-card">

            <p>
                API requests may take time to complete. A component can
                maintain a loading state while waiting for the response.
            </p>

            <p class="mb-0">
                This allows the interface to show the user that data is
                currently being loaded.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>loading = false;


loadCourses() {

    this.loading = true;

    this.courseService
        .getCourses()
        .subscribe({

            next: courses =&gt; {

                this.courses = courses;
                this.loading = false;

            },

            error: error =&gt; {

                console.error(error);
                this.loading = false;

            }

        });

}</code></pre>

        </div>

    </section>


    <!-- CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">
            CIIT Training Institute Example
        </h2>

        <div class="info-card">

            <p>
                Suppose the CIIT Training Institute website displays the
                available training courses from a backend API.
            </p>

            <p class="mb-0">
                The Angular component calls a service, the service sends
                an HTTP request, and the API returns the course data.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                API Service
            </div>

            <pre><code>@@Injectable({
    providedIn: 'root'
})
export class CourseService {

    private apiUrl =
        '/api/courses';


    constructor(
        private http: HttpClient
    ) {
    }


    getCourses() {

        return this.http.get&lt;Course[]&gt;(
            this.apiUrl
        );

    }

}</code></pre>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Component
            </div>

            <pre><code>courses: Course[] = [];


loadCourses() {

    this.courseService
        .getCourses()
        .subscribe({

            next: courses =&gt; {

                this.courses = courses;

            },

            error: error =&gt; {

                console.error(error);

            }

        });

}</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    CIIT Training Institute Courses
                </h4>

                <p>
                    Java Full Stack
                </p>

                <p>
                    .NET Full Stack
                </p>

                <p>
                    Python Full Stack
                </p>

                <p class="mb-0">
                    Course data loaded from API.
                </p>

            </div>

        </div>

    </section>


    <!-- API Architecture -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Frontend and Backend Architecture
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>Angular UI</strong>

                <span>
                    Frontend
                </span>

            </div>


            <div class="syntax-arrow">
                ↔
            </div>


            <div class="syntax-box">

                <strong>REST API</strong>

                <span>
                    Backend
                </span>

            </div>


            <div class="syntax-arrow">
                ↔
            </div>


            <div class="syntax-box">

                <strong>Database</strong>

                <span>
                    Persistent Data
                </span>

            </div>

        </div>

    </section>


    <!-- API Table -->
    <section class="mb-4">

        <h2 class="fw-bold">
            API Request Overview
        </h2>

        <div class="table-responsive">

            <table class="table syntax-table">

                <thead>

                    <tr>

                        <th>
                            HTTP Method
                        </th>

                        <th>
                            Purpose
                        </th>

                        <th>
                            HttpClient Method
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            GET
                        </td>

                        <td>
                            Retrieve data
                        </td>

                        <td>
                            <code>http.get()</code>
                        </td>

                    </tr>


                    <tr>

                        <td>
                            POST
                        </td>

                        <td>
                            Create data
                        </td>

                        <td>
                            <code>http.post()</code>
                        </td>

                    </tr>


                    <tr>

                        <td>
                            PUT
                        </td>

                        <td>
                            Update data
                        </td>

                        <td>
                            <code>http.put()</code>
                        </td>

                    </tr>


                    <tr>

                        <td>
                            DELETE
                        </td>

                        <td>
                            Delete data
                        </td>

                        <td>
                            <code>http.delete()</code>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- API Integration Steps -->
    <section class="mb-4">

        <h2 class="fw-bold">
            API Integration Steps
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    1
                </div>

                <h5>
                    Create Service
                </h5>

                <p>
                    Create an Angular service for API communication.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    2
                </div>

                <h5>
                    Inject HttpClient
                </h5>

                <p>
                    Use HttpClient to communicate with the backend.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    3
                </div>

                <h5>
                    Call API
                </h5>

                <p>
                    Use GET, POST, PUT or DELETE according to the requirement.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    4
                </div>

                <h5>
                    Handle Response
                </h5>

                <p>
                    Subscribe to the result and update the application state.
                </p>

            </div>

        </div>

    </section>


    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Important Points
        </h2>

        <div class="best-practice-list">

            <div class="info-card mb-3">

                <strong>
                    1. Keep API Logic in Services
                </strong>

                <p class="mb-0">
                    Services provide a central place for backend communication.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>
                    2. Use HttpClient
                </strong>

                <p class="mb-0">
                    HttpClient provides Angular APIs for making HTTP requests.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>
                    3. Handle API Results
                </strong>

                <p class="mb-0">
                    Process successful responses and handle failures
                    appropriately.
                </p>

            </div>


            <div class="info-card">

                <strong>
                    4. Keep Data Flow Organized
                </strong>

                <p class="mb-0">
                    A clear Component → Service → API flow makes applications
                    easier to maintain.
                </p>

            </div>

        </div>

    </section>


    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">
            API Integration Best Practices
        </h2>

        <ul class="best-practice-list">

            <li>
                Keep HTTP communication inside dedicated services where
                practical.
            </li>

            <li>
                Use meaningful API endpoint and service method names.
            </li>

            <li>
                Handle loading, success and error states appropriately.
            </li>

            <li>
                Define suitable TypeScript types for API responses.
            </li>

            <li>
                Avoid duplicating the same API communication logic in
                multiple components.
            </li>

            <li>
                Keep components focused on UI and application interaction.
            </li>

        </ul>

    </section>


    <!-- Summary -->
    <section class="mb-4">

        <div class="summary-box">

            <h4 class="fw-bold">
                Summary
            </h4>

            <p>
                API integration connects an Angular frontend with a backend
                service so that the application can work with dynamic data.
            </p>

            <p>
                Angular commonly uses <strong>HttpClient</strong> for HTTP
                communication, while services can organize API-related logic.
            </p>

            <p class="mb-0">
                The basic flow is
                <strong>
                    Component → Service → HttpClient → REST API →
                    Response
                </strong>.
                In the next topic, we will learn about
                <strong>Connecting API</strong>.
            </p>

        </div>

    </section>


    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Unsubscribe", "Observables", new { area = "Angular" })">

            ← Unsubscribe

        </a>


        <a class="btn btn-primary"
           href="@Url.Action("ConnectingAPI", "APIIntegration", new { area = "Angular" })">

            Connecting API →

        </a>

    </div>

</div>


<style>

