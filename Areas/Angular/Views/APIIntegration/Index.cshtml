            font-weight: 700;
        }


        .student-preview p {
            color: #64748b;
        }


    .syntax-table {
        width: 100%;
        margin-bottom: 0;
        border: 1px solid #e2e8f0;
    }


        .syntax-table thead th {
            background: #2e1065;
            color: white;
            padding: 14px;
            border-color: #4c1d95;
        }


        .syntax-table tbody td {
            padding: 14px;
            vertical-align: middle;
