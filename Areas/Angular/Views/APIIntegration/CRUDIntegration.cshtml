        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>import {
    Injectable
} from '@@angular/core';

import {
    HttpClient
} from '@@angular/common/http';


@@Injectable({
    providedIn: 'root'
})
export class CourseService {

    private apiUrl =
        '/api/courses';


    constructor(
        private http: HttpClient
    ) {
    }


    // CREATE

    addCourse(course: Course) {

        return this.http.post&lt;Course&gt;(
            this.apiUrl,
            course
        );

    }


    // READ

    getCourses() {

        return this.http.get&lt;Course[]&gt;(
            this.apiUrl
        );

    }


    // READ SINGLE

    getCourse(id: number) {

        return this.http.get&lt;Course&gt;(
            this.apiUrl + '/' + id
        );

    }


    // UPDATE

    updateCourse(
        id: number,
        course: Course
    ) {

        return this.http.put&lt;Course&gt;(
            this.apiUrl + '/' + id,
            course
        );

    }


    // DELETE

    deleteCourse(id: number) {

        return this.http.delete(
            this.apiUrl + '/' + id
        );

    }

}</code></pre>

        </div>

