    <!-- CRUD Component -->
    <section class="mb-4">

        <h2 class="fw-bold">
            CRUD Component Example
        </h2>

        <div class="code-card">

            <div class="code-title">
                courses.component.ts
            </div>

            <pre><code>export class CoursesComponent {

    courses: Course[] = [];

    loading = false;

    errorMessage = '';


    loadCourses() {

        this.loading = true;
        this.errorMessage = '';

        this.courseService
            .getCourses()
            .subscribe({

                next: courses =&gt; {

                    this.courses = courses;
                    this.loading = false;

                },

                error: error =&gt; {

                    console.error(error);

                    this.errorMessage =
                        'Unable to load courses.';

                    this.loading = false;

                }

            });

    }


    addCourse(course: Course) {

        this.courseService
            .addCourse(course)
            .subscribe({

                next: createdCourse =&gt; {

                    this.courses = [
                        ...this.courses,
                        createdCourse
                    ];

                },

                error: error =&gt; {

                    console.error(error);

                }

            });

    }


    updateCourse(course: Course) {

        this.courseService
            .updateCourse(
                course.id,
                course
            )
            .subscribe({

                next: updatedCourse =&gt; {

                    this.courses =
                        this.courses.map(
                            item =&gt;
                                item.id ===
                                updatedCourse.id
                                    ? updatedCourse
                                    : item
                        );

                },

                error: error =&gt; {

                    console.error(error);

                }

            });

    }


    deleteCourse(id: number) {

        this.courseService
            .deleteCourse(id)
            .subscribe({

                next: () =&gt; {

                    this.courses =
                        this.courses.filter(
                            course =&gt;
                                course.id !== id
                        );

                },

                error: error =&gt; {

                    console.error(error);

                }

            });

    }

}</code></pre>

        </div>

    </section>


