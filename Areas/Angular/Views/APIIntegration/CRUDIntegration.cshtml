    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">
            CRUD Integration Best Practices
        </h2>

        <ul class="best-practice-list">

            <li>
                Keep CRUD API calls inside dedicated Angular services.
            </li>

            <li>
                Use TypeScript interfaces or types for request and response data.
            </li>

            <li>
                Handle loading, success and error states appropriately.
            </li>

            <li>
                Update the UI after successful create, update or delete
                operations.
            </li>

            <li>
                Keep API endpoints centralized instead of duplicating URLs.
            </li>

            <li>
                Validate user input before sending create or update requests.
            </li>

        </ul>

    </section>


