@{
    ViewData["Title"] = "Custom Directives";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Custom Directives</h1>
        <p class="lead text-muted">
            Learn how to create reusable Angular directives for custom
            behavior and interaction with HTML elements.
        </p>
    </section>

    <!-- What are Custom Directives -->
    <section class="mb-4">
        <h2 class="fw-bold">What are Custom Directives?</h2>

        <div class="info-card">
            <p>
                Custom directives are developer-created Angular directives
                used to add reusable behavior to HTML elements.
            </p>

            <p class="mb-0">
                They are useful when the same DOM behavior or UI interaction
                needs to be used in multiple places in an application.
            </p>
        </div>
    </section>

    <!-- Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Custom Directive Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <div class="syntax-icon">1</div>
                <h5>Create</h5>
                <p>Create a directive using the Angular CLI.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">2</div>
                <h5>Define</h5>
                <p>Define the required directive behavior.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">3</div>
                <h5>Apply</h5>
                <p>Apply the directive to an HTML element.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">4</div>
                <h5>Reuse</h5>
                <p>Reuse the behavior wherever it is required.</p>
            </div>

        </div>
    </section>

    <!-- Why Custom Directives -->
    <section class="mb-4">
        <h2 class="fw-bold">Why Create Custom Directives?</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">R</div>
                <h5>Reusable</h5>
                <p>
                    The same behavior can be reused on multiple elements.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">C</div>
                <h5>Custom Behavior</h5>
                <p>
                    Implement behavior specific to your application.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">M</div>
                <h5>Maintainable</h5>
                <p>
                    Keep common DOM behavior in one place.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">U</div>
                <h5>UI Enhancement</h5>
                <p>
                    Improve the interaction and appearance of UI elements.
                </p>
            </div>

        </div>
    </section>

    <!-- Generate Directive -->
    <section class="mb-4">
        <h2 class="fw-bold">Creating a Custom Directive</h2>

        <p>
            Angular CLI can generate a directive automatically.
        </p>

        <div class="code-card">
            <div class="code-title">CLI Command</div>

            <pre><code>ng generate directive highlight</code></pre>
        </div>

        <p>
            Short form:
        </p>

        <div class="code-card">
            <div class="code-title">CLI</div>

            <pre><code>ng g directive highlight</code></pre>
        </div>
    </section>

    <!-- Generated Directive -->
    <section class="mb-4">
        <h2 class="fw-bold">Generated Directive</h2>

        <div class="code-card">
            <div class="code-title">highlight.directive.ts</div>

            <pre><code>import { Directive } from '@@angular/core';

@@Directive({
    selector: '[appHighlight]'
})
export class HighlightDirective {

}</code></pre>
        </div>

        <div class="output-box">
            <strong>Explanation:</strong>

            <div class="output-preview">
                The <code>@@Directive</code> decorator tells Angular that
                this class represents a directive.
            </div>
        </div>
    </section>

    <!-- Selector -->
    <section class="mb-4">
        <h2 class="fw-bold">Directive Selector</h2>

        <p>
            The selector defines how the custom directive is applied
            in the HTML template.
        </p>

        <div class="code-card">
            <div class="code-title">Directive</div>

            <pre><code>@@Directive({
    selector: '[appHighlight]'
})</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;p appHighlight&gt;
    Angular Training
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Result:</strong>

            <div class="output-preview">
                Angular applies the directive to the paragraph because
                it contains the <code>appHighlight</code> attribute.
            </div>
        </div>
    </section>

    <!-- Host Element -->
    <section class="mb-4">
        <h2 class="fw-bold">Using ElementRef</h2>

        <p>
            <code>ElementRef</code> provides access to the native element
            on which the directive is applied.
        </p>

        <div class="code-card">
            <div class="code-title">highlight.directive.ts</div>

            <pre><code>import { Directive, ElementRef } from '@@angular/core';

@@Directive({
    selector: '[appHighlight]'
})
export class HighlightDirective {

    constructor(private element: ElementRef) {

        this.element.nativeElement.style.backgroundColor = 'yellow';

    }

}</code></pre>
        </div>

        <div class="output-box">
            <strong>Result:</strong>

            <div class="output-preview">
                The element using <code>appHighlight</code> receives
                a yellow background.
            </div>
        </div>
    </section>

    <!-- HostListener -->
    <section class="mb-4">
        <h2 class="fw-bold">Using HostListener</h2>

        <p>
            <code>HostListener</code> allows a directive to respond to
            events generated by its host element.
        </p>

        <div class="code-card">
            <div class="code-title">Directive</div>

            <pre><code>import {
    Directive,
    ElementRef,
    HostListener
} from '@@angular/core';

@@Directive({
    selector: '[appHighlight]'
})
export class HighlightDirective {

    constructor(private element: ElementRef) {
    }

    @@HostListener('mouseenter')
    onMouseEnter() {
        this.element.nativeElement.style.backgroundColor = 'yellow';
    }

    @@HostListener('mouseleave')
    onMouseLeave() {
        this.element.nativeElement.style.backgroundColor = '';
    }

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;p appHighlight&gt;
    Move the mouse over this text
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Result:</strong>

            <div class="output-preview">
                The background changes when the mouse enters the element
                and returns to normal when the mouse leaves.
            </div>
        </div>
    </section>

    <!-- Input -->
    <section class="mb-4">
        <h2 class="fw-bold">Passing Data to a Directive</h2>

        <p>
            A custom directive can receive values from the component
            using an input property.
        </p>

        <div class="code-card">
            <div class="code-title">Directive</div>

            <pre><code>import { Directive, Input, ElementRef } from '@@angular/core';

@@Directive({
    selector: '[appHighlight]'
})
export class HighlightDirective {

    @@Input() appHighlight = '';

    constructor(private element: ElementRef) {
    }

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;p [appHighlight]="'lightblue'"&gt;
    Angular Training
&lt;/p&gt;</code></pre>
        </div>
    </section>

    <!-- Complete Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete Highlight Directive Example</h2>

        <div class="code-card">
            <div class="code-title">highlight.directive.ts</div>

            <pre><code>import {
    Directive,
    ElementRef,
    HostListener
} from '@@angular/core';

@@Directive({
    selector: '[appHighlight]'
})
export class HighlightDirective {

    constructor(private element: ElementRef) {
    }

    @@HostListener('mouseenter')
    onMouseEnter() {
        this.element.nativeElement.style.backgroundColor = 'lightblue';
    }

    @@HostListener('mouseleave')
    onMouseLeave() {
        this.element.nativeElement.style.backgroundColor = '';
    }

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">student.component.html</div>

            <pre><code>&lt;h3 appHighlight&gt;
    Pradnya
&lt;/h3&gt;

&lt;p appHighlight&gt;
    Angular Full Stack Student
&lt;/p&gt;</code></pre>
        </div>

        <div class="student-preview">
            <h4>Pradnya</h4>

            <p class="mb-0">
                Angular Full Stack Student
            </p>

            <small>
                Move the mouse over an element to see the directive behavior.
            </small>
        </div>
    </section>

    <!-- Common Use Cases -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Use Cases</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">H</div>
                <h5>Highlighting</h5>
                <p>
                    Highlight elements on hover or based on conditions.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">F</div>
                <h5>Focus</h5>
                <p>
                    Automatically focus an input element.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">A</div>
                <h5>Animation</h5>
                <p>
                    Add reusable interaction or animation behavior.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">V</div>
                <h5>Validation</h5>
                <p>
                    Add reusable UI behavior around validation.
                </p>
            </div>

        </div>
    </section>

    <!-- Directive Comparison -->
    <section class="mb-4">
        <h2 class="fw-bold">Built-in vs Custom Directives</h2>

        <div class="table-responsive">

            <table class="table syntax-table">

                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Purpose</th>
                        <th>Example</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>Built-in</td>
                        <td>Provided by Angular</td>
                        <td><code>ngClass</code></td>
                    </tr>

                    <tr>
                        <td>Built-in</td>
                        <td>Controls DOM structure</td>
                        <td><code>*ngIf</code></td>
                    </tr>

                    <tr>
                        <td>Custom</td>
                        <td>Application-specific behavior</td>
                        <td><code>appHighlight</code></td>
                    </tr>

                </tbody>

            </table>

        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Best Practices</h2>

        <ul class="best-practice-list">
            <li>Give custom directives clear and meaningful names.</li>
            <li>Keep a directive focused on one reusable behavior.</li>
            <li>Use <code>HostListener</code> for host element events.</li>
            <li>Use inputs when the directive needs configurable values.</li>
            <li>Avoid putting large business logic inside directives.</li>
            <li>Reuse directives when the same UI behavior appears in multiple places.</li>
        </ul>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <h2 class="fw-bold">Summary</h2>

        <div class="summary-box">
            <ul class="mb-0">
                <li>Custom directives provide reusable application-specific behavior.</li>
                <li>Use the Angular CLI to generate directives quickly.</li>
                <li><code>@@Directive</code> defines a custom directive.</li>
                <li><code>ElementRef</code> provides access to the host element.</li>
                <li><code>HostListener</code> allows the directive to respond to events.</li>
                <li>Inputs can be used to pass values into a directive.</li>
                <li>Custom directives help keep UI behavior reusable and maintainable.</li>
            </ul>
        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("StructuralDirectives", "Directives", new { area = "Angular" })">
            ← Structural Directives
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("Index", "Pipes", new { area = "Angular" })">
            Pipes Introduction →
        </a>

    </div>

</div>

<style>

