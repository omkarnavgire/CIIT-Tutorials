        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .syntax-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        width: 190px;
        min-height: 160px;
    }

    .syntax-icon {
        width: 45px;
        height: 45px;
