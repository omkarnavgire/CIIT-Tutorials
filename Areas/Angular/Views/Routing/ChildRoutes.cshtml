@{
    ViewData["Title"] = "Angular Child Routes";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Angular Child Routes</h1>

        <p class="lead text-muted">
            Learn how to create nested routes in Angular using
            <strong>children</strong> and display child components with
            <strong>router-outlet</strong>.
        </p>
    </section>


    <!-- Introduction -->
    <section class="mb-4">

        <h2 class="fw-bold">What are Child Routes?</h2>

        <div class="info-card">

            <p>
                Child routes are routes defined inside another route.
                They are also called <strong>nested routes</strong>.
            </p>

            <p>
                They are useful when one main page contains multiple related
                sections or views.
            </p>

            <p class="mb-0">
                For example, a course dashboard can contain child pages such as
                <strong>Overview</strong>, <strong>Topics</strong> and
                <strong>Assignments</strong>.
            </p>

        </div>

    </section>


    <!-- Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">Child Route Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <strong>Parent Route</strong>
                <span>/courses</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>Child Route</strong>
                <span>overview</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>Router Outlet</strong>
                <span>Displays Child</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>Child Component</strong>
                <span>OverviewComponent</span>
            </div>

        </div>

    </section>


    <!-- Main Concepts -->
    <section class="mb-4">

        <h2 class="fw-bold">Important Concepts</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">1</div>

                <h5>Parent Route</h5>

                <p>
                    The main route that contains one or more child routes.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">2</div>

                <h5>Children</h5>

                <p>
                    The <code>children</code> property defines nested routes.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">3</div>

                <h5>router-outlet</h5>

                <p>
                    It provides the location where the child component is displayed.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">4</div>

                <h5>Nested URL</h5>

                <p>
                    A child route becomes part of the parent route URL.
                </p>

            </div>

        </div>

    </section>


    <!-- Route Configuration -->
    <section class="mb-4">

        <h2 class="fw-bold">Defining Child Routes</h2>

        <div class="info-card">

            <p>
                Angular allows child routes to be defined using the
                <strong>children</strong> property of a route.
            </p>

            <p class="mb-0">
                Each child route contains its own path and component.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Route Configuration
            </div>

            <pre><code>const routes: Routes = [

    {
        path: 'courses',
        component: CoursesComponent,

        children: [
            {
                path: 'overview',
                component: OverviewComponent
            },
            {
                path: 'topics',
                component: TopicsComponent
            }
        ]
    }

];</code></pre>

        </div>

    </section>


    <!-- URL Structure -->
    <section class="mb-4">

        <h2 class="fw-bold">Nested URL Structure</h2>

        <div class="code-card">

            <div class="code-title">
                Example URLs
            </div>

            <pre><code>/courses/overview

/courses/topics</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>Route Structure</h4>

                <p>
                    Parent Route:
                    <strong>/courses</strong>
                </p>

                <p>
                    Child Route:
                    <strong>/overview</strong>
                </p>

                <p class="mb-0">
                    Complete URL:
                    <strong>/courses/overview</strong>
                </p>

            </div>

        </div>

    </section>


    <!-- Router Outlet -->
    <section class="mb-4">

        <h2 class="fw-bold">Using router-outlet</h2>

        <div class="info-card">

            <p>
                The parent component needs a
                <strong>router-outlet</strong> where Angular can display
                the selected child component.
            </p>

            <p class="mb-0">
                Without the outlet, the child route has no location
                in the parent template where it can be rendered.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Parent Component HTML
            </div>

            <pre><code>&lt;h2&gt;
    CIIT Training Institute Courses
&lt;/h2&gt;

&lt;nav&gt;

    &lt;a routerLink="overview"&gt;
        Overview
    &lt;/a&gt;

    &lt;a routerLink="topics"&gt;
        Topics
    &lt;/a&gt;

&lt;/nav&gt;

&lt;router-outlet&gt;&lt;/router-outlet&gt;</code></pre>

        </div>

    </section>


    <!-- Parent Child Relationship -->
    <section class="mb-4">

        <h2 class="fw-bold">Parent and Child Relationship</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <strong>CoursesComponent</strong>
                <span>Parent</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>router-outlet</strong>
                <span>Child Location</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>OverviewComponent</strong>
                <span>Child</span>
            </div>

        </div>

    </section>


    <!-- Child Navigation -->
    <section class="mb-4">

        <h2 class="fw-bold">Navigating to Child Routes</h2>

        <div class="info-card">

            <p>
                Child routes can be accessed from the parent component using
                relative route links.
            </p>

            <p class="mb-0">
                The child path is written without repeating the complete
                parent URL.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Template Navigation
            </div>

            <pre><code>&lt;a routerLink="overview"&gt;
    Course Overview
&lt;/a&gt;

&lt;a routerLink="topics"&gt;
    Course Topics
&lt;/a&gt;</code></pre>

        </div>

    </section>


    <!-- Relative Navigation -->
    <section class="mb-4">

        <h2 class="fw-bold">Programmatic Child Navigation</h2>

        <div class="info-card">

            <p>
                Child routes can also be opened programmatically using
                the Angular Router.
            </p>

            <p class="mb-0">
                Relative navigation is useful when the current component
                is already inside the parent route.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Component Example
            </div>

            <pre><code>import { Component } from '@@angular/core';
import { ActivatedRoute, Router } from '@@angular/router';

@@Component({
    selector: 'app-courses',
    templateUrl: './courses.component.html'
})
export class CoursesComponent {

    constructor(
        private router: Router,
        private route: ActivatedRoute
    ) {
    }

    openTopics() {

        this.router.navigate(
            ['topics'],
            {
                relativeTo: this.route
            }
        );

    }

}</code></pre>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Button
            </div>

            <pre><code>&lt;button
    type="button"
    (click)="openTopics()"&gt;

    View Topics

&lt;/button&gt;</code></pre>

        </div>

    </section>


    <!-- CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">CIIT Training Institute Example</h2>

        <div class="code-card">

            <div class="code-title">
                Course Routes
            </div>

            <pre><code>const routes: Routes = [

    {
        path: 'courses',
        component: CoursesComponent,

        children: [
            {
                path: 'overview',
                component: CourseOverviewComponent
            },
            {
                path: 'topics',
                component: CourseTopicsComponent
            },
            {
                path: 'contact',
                component: CourseContactComponent
            }
        ]
    }

];</code></pre>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Parent Template
            </div>

            <pre><code>&lt;h2&gt;
    CIIT Training Institute
&lt;/h2&gt;

&lt;nav&gt;

    &lt;a routerLink="overview"&gt;
        Course Overview
    &lt;/a&gt;

    &lt;a routerLink="topics"&gt;
        Course Topics
    &lt;/a&gt;

    &lt;a routerLink="contact"&gt;
        Course Contact
    &lt;/a&gt;

&lt;/nav&gt;

&lt;router-outlet&gt;&lt;/router-outlet&gt;</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>CIIT Training Institute</h4>

                <p>
                    <strong>/courses/overview</strong>
                    → Course Overview
                </p>

                <p>
                    <strong>/courses/topics</strong>
                    → Course Topics
                </p>

                <p class="mb-0">
                    <strong>/courses/contact</strong>
                    → Course Contact
                </p>

            </div>

        </div>

    </section>


    <!-- Multiple Levels -->
    <section class="mb-4">

        <h2 class="fw-bold">Nested Child Routes</h2>

        <div class="info-card">

            <p>
                Child routes can themselves contain additional child routes.
            </p>

            <p class="mb-0">
                This creates multiple levels of routing when an application
                has a more complex structure.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const routes: Routes = [

    {
        path: 'courses',
        component: CoursesComponent,

        children: [
            {
                path: 'fullstack',
                component: FullStackComponent,

                children: [
                    {
                        path: 'topics',
                        component: TopicsComponent
                    }
                ]
            }
        ]
    }

];</code></pre>

        </div>

    </section>


    <!-- Route Comparison -->
    <section class="mb-4">

        <h2 class="fw-bold">Parent Routes vs Child Routes</h2>

        <div class="table-responsive">

            <table class="table syntax-table">

                <thead>
                    <tr>
                        <th>Feature</th>
                        <th>Parent Route</th>
                        <th>Child Route</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>Location</td>
                        <td>Top-level route</td>
                        <td>Inside a parent route</td>
                    </tr>

                    <tr>
                        <td>Configuration</td>
                        <td>Defined directly in routes</td>
                        <td>Defined inside <code>children</code></td>
                    </tr>

                    <tr>
                        <td>URL Example</td>
                        <td><code>/courses</code></td>
                        <td><code>/courses/topics</code></td>
                    </tr>

                    <tr>
                        <td>Rendering</td>
                        <td>Application outlet</td>
                        <td>Parent's <code>router-outlet</code></td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">Important Points</h2>

        <div class="best-practice-list">

            <div class="info-card mb-3">

                <strong>1. Use children Property</strong>

                <p class="mb-0">
                    Define nested routes using the
                    <strong>children</strong> property.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>2. Add router-outlet</strong>

                <p class="mb-0">
                    The parent component should contain
                    <strong>router-outlet</strong> for displaying child views.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>3. Keep Related Pages Together</strong>

                <p class="mb-0">
                    Child routes are useful for grouping pages that belong
                    to the same parent feature.
                </p>

            </div>


            <div class="info-card">

                <strong>4. Use Relative Navigation</strong>

                <p class="mb-0">
                    Relative links and navigation can make nested route
                    navigation easier to maintain.
                </p>

            </div>

        </div>

    </section>


    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">Child Route Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Use child routes for logically related pages.
            </li>

            <li>
                Keep route hierarchy simple and meaningful.
            </li>

            <li>
                Place <code>router-outlet</code> in the parent component
                where child content should appear.
            </li>

            <li>
                Use relative navigation when working inside nested routes.
            </li>

            <li>
                Avoid creating unnecessary levels of nested routes.
            </li>

            <li>
                Use clear and descriptive child route names.
            </li>

        </ul>

    </section>


    <!-- Summary -->
    <section class="mb-4">

        <div class="summary-box">

            <h4 class="fw-bold">
                Summary
            </h4>

            <p>
                Angular child routes allow an application to create
                nested navigation structures.
            </p>

            <p>
                The <strong>children</strong> property defines nested routes,
                while <strong>router-outlet</strong> provides the location
                where the child component is rendered.
            </p>

            <p class="mb-0">
                Child routes are useful for organizing related sections
                such as course overview, topics and contact pages.
                In the next topic, we will learn about
                <strong>Route Guards</strong>.
            </p>

        </div>

    </section>


    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("RouteParameters", "Routing", new { area = "Angular" })">
            ← Route Parameters
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("RouteGuards", "Routing", new { area = "Angular" })">
            Route Guards →
        </a>

    </div>

</div>


<style>

    .info-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        line-height: 1.7;
        color: #334155;
    }


    .syntax-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        margin: 25px 0;
    }


    .syntax-box {
        background: linear-gradient(135deg, #2e1065, #4c1d95);
        color: white;
        padding: 18px 25px;
        border-radius: 12px;
        text-align: center;
        min-width: 180px;
        box-shadow: 0 5px 15px rgba(76, 29, 149, 0.15);
    }


        .syntax-box strong {
            display: block;
            font-size: 16px;
        }


        .syntax-box span {
            display: block;
            margin-top: 5px;
            color: #d8c9f5;
            font-size: 14px;
        }


    .syntax-arrow {
        font-size: 28px;
        font-weight: bold;
        color: #4c1d95;
    }


    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }


    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }


        .syntax-card h5 {
            margin-top: 15px;
            font-weight: 700;
            color: #2e1065;
        }


        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
        }


    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 auto;
    }


    .code-card {
        background: #0f172a;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.10);
    }


    .code-title {
        background: #1e293b;
        color: #ffffff;
        padding: 12px 18px;
        font-weight: 700;
        font-size: 14px;
    }


    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }


    .code-card code {
        color: #f8fafc;
        font-size: 14px;
        line-height: 1.7;
    }


    .output-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 20px;
    }


    .student-preview {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
    }


        .student-preview h4 {
            color: #2e1065;
            font-weight: 700;
        }


        .student-preview p {
            color: #64748b;
        }


    .syntax-table {
        width: 100%;
        margin-bottom: 0;
        border: 1px solid #e2e8f0;
    }


        .syntax-table thead th {
            background: #2e1065;
            color: white;
            padding: 14px;
            border-color: #4c1d95;
        }


        .syntax-table tbody td {
            padding: 14px;
            vertical-align: middle;
            color: #334155;
            border-color: #e2e8f0;
        }


        .syntax-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }


        .syntax-table code {
            color: #4c1d95;
            font-weight: 600;
        }


    .best-practice-list {
        margin: 0;
        padding-left: 20px;
    }


        .best-practice-list li {
            margin-bottom: 10px;
            color: #334155;
            line-height: 1.6;
        }


    .summary-box {
        background: #cfe2ff;
        color: #084298;
        border-radius: 10px;
        padding: 22px;
        border: 1px solid #b6d4fe;
    }


        .summary-box h4 {
            margin-bottom: 12px;
        }


    @@media (max-width: 991px) {

        .syntax-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syntax-flow {
            gap: 12px;
        }

        .syntax-box {
            min-width: 160px;
        }
    }


    @@media (max-width: 576px) {

        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-flow {
            flex-direction: column;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }

        .syntax-box {
            width: 100%;
            max-width: 300px;
        }

        .code-card pre {
            padding: 15px;
        }

        .code-card code {
            font-size: 13px;
        }
    }

</style>