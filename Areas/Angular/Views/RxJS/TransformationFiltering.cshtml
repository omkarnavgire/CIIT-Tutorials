@{
    ViewData["Title"] = "RxJS Transformation and Filtering";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">
            RxJS Transformation &amp; Filtering
        </h1>

        <p class="lead text-muted">
            Learn how RxJS operators transform Observable values and filter
            unwanted data before it reaches the subscriber.
        </p>

    </section>


    <!-- Introduction -->
    <section class="mb-4">

        <h2 class="fw-bold">
            What are Transformation and Filtering?
        </h2>

        <div class="info-card">

            <p>
                <strong>Transformation</strong> means changing each emitted
                value into another value or format.
            </p>

            <p>
                <strong>Filtering</strong> means allowing only those values
                that satisfy a specific condition to continue through the stream.
            </p>

            <p class="mb-0">
                RxJS provides operators such as
                <strong>map()</strong> for transformation and
                <strong>filter()</strong> for filtering.
            </p>

        </div>

    </section>


    <!-- Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Transformation and Filtering Flow
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>Source</strong>

                <span>
                    Original Values
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>map()</strong>

                <span>
                    Transform Values
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>filter()</strong>

                <span>
                    Keep Required Values
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Subscriber</strong>

                <span>
                    Receives Result
                </span>

            </div>

        </div>

    </section>


    <!-- Transformation -->
    <section class="mb-4">

        <h2 class="fw-bold">
            What is Transformation?
        </h2>

        <div class="info-card">

            <p>
                Transformation changes the data emitted by the source
                Observable into another form.
            </p>

            <p class="mb-0">
                For example, numbers can be multiplied, strings can be
                formatted, or objects can be converted into another
                structure.
            </p>

        </div>

    </section>


    <!-- map -->
    <section class="mb-4">

        <h2 class="fw-bold">
            map() Operator
        </h2>

        <div class="info-card">

            <p>
                The <strong>map()</strong> operator applies a transformation
                function to every value emitted by the source Observable.
            </p>

            <p class="mb-0">
                The transformed value is emitted by the resulting Observable.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Basic Example
            </div>

            <pre><code>const numbers$ = of(
    10,
    20,
    30
);

const result$ = numbers$.pipe(

    map(value =&gt; value * 2)

);

result$.subscribe({

    next: value =&gt; {

        console.log(value);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Output
                </h4>

                <p>
                    20
                </p>

                <p>
                    40
                </p>

                <p class="mb-0">
                    60
                </p>

            </div>

        </div>

    </section>


    <!-- Transformation Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">
            map() Transformation Flow
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>10</strong>

                <span>
                    Original
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>× 2</strong>

                <span>
                    map()
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>20</strong>

                <span>
                    Transformed
                </span>

            </div>

        </div>

    </section>


    <!-- String Transformation -->
    <section class="mb-4">

        <h2 class="fw-bold">
            String Transformation
        </h2>

        <p>
            map() can also transform strings into another format.
        </p>


        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>const courses$ = of(
    'Java',
    '.NET',
    'Python'
);

const fullStackCourses$ =
    courses$.pipe(

        map(course =&gt;
            course + ' Full Stack'
        )

    );

fullStackCourses$.subscribe({

    next: course =&gt; {

        console.log(course);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Output
                </h4>

                <p>
                    Java Full Stack
                </p>

                <p>
                    .NET Full Stack
                </p>

                <p class="mb-0">
                    Python Full Stack
                </p>

            </div>

        </div>

    </section>


    <!-- Object Transformation -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Object Transformation
        </h2>

        <div class="info-card">

            <p>
                map() can also extract or create a different value from
                an object emitted by an Observable.
            </p>

            <p class="mb-0">
                This is useful when the application needs only a specific
                property from a larger object.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const courses$ = of(

    {
        name: 'Java Full Stack',
        duration: '6 Months'
    },

    {
        name: '.NET Full Stack',
        duration: '6 Months'
    }

);

const names$ = courses$.pipe(

    map(course =&gt; course.name)

);

names$.subscribe({

    next: name =&gt; {

        console.log(name);

    }

});</code></pre>

        </div>

    </section>


    <!-- Filtering -->
    <section class="mb-4">

        <h2 class="fw-bold">
            What is Filtering?
        </h2>

        <div class="info-card">

            <p>
                Filtering means selecting only the values that match
                a specified condition.
            </p>

            <p class="mb-0">
                RxJS provides the <strong>filter()</strong> operator for
                this purpose.
            </p>

        </div>

    </section>


    <!-- filter -->
    <section class="mb-4">

        <h2 class="fw-bold">
            filter() Operator
        </h2>

        <div class="info-card">

            <p>
                The <strong>filter()</strong> operator checks every emitted
                value against a condition.
            </p>

            <p class="mb-0">
                Only values for which the condition is true continue through
                the resulting Observable.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Basic Example
            </div>

            <pre><code>const numbers$ = of(
    10,
    15,
    20,
    25,
    30
);

const evenNumbers$ =
    numbers$.pipe(

        filter(value =&gt;
            value % 2 === 0
        )

    );

evenNumbers$.subscribe({

    next: value =&gt; {

        console.log(value);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Filtered Output
                </h4>

                <p>
                    10
                </p>

                <p>
                    20
                </p>

                <p class="mb-0">
                    30
                </p>

            </div>

        </div>

    </section>


    <!-- Filter Strings -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Filtering Strings
        </h2>

        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>const courses$ = of(
    'Java',
    '.NET',
    'Python',
    'Angular'
);

const angularCourses$ =
    courses$.pipe(

        filter(course =&gt;
            course === 'Angular'
        )

    );

angularCourses$.subscribe({

    next: course =&gt; {

        console.log(course);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Output
                </h4>

                <p class="mb-0">
                    Angular
                </p>

            </div>

        </div>

    </section>


    <!-- Filter Objects -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Filtering Objects
        </h2>

        <div class="info-card">

            <p>
                Objects can be filtered using one or more of their
                properties.
            </p>

            <p class="mb-0">
                This is useful when the application wants to display
                only matching records.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const courses$ = of(

    {
        name: 'Java Full Stack',
        active: true
    },

    {
        name: '.NET Full Stack',
        active: false
    },

    {
        name: 'Python Full Stack',
        active: true
    }

);

const activeCourses$ =
    courses$.pipe(

        filter(course =&gt;
            course.active
        )

    );</code></pre>

        </div>

    </section>


    <!-- Combining map and filter -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Combining map() and filter()
        </h2>

        <div class="info-card">

            <p>
                Transformation and filtering can be combined in the same
                RxJS pipeline.
            </p>

            <p class="mb-0">
                The order of operators matters because each stage processes
                the output from the previous stage.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const numbers$ = of(
    1,
    2,
    3,
    4,
    5
);

const result$ = numbers$.pipe(

    map(value =&gt; value * 10),

    filter(value =&gt;
        value &gt;= 30
    )

);

result$.subscribe({

    next: value =&gt; {

        console.log(value);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Output
                </h4>

                <p>
                    30
                </p>

                <p>
                    40
                </p>

                <p class="mb-0">
                    50
                </p>

            </div>

        </div>

    </section>


    <!-- Order -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Operator Order Matters
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>1 2 3 4 5</strong>

                <span>
                    Source
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>map()</strong>

                <span>
                    × 10
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>10 20 30 40 50</strong>

                <span>
                    Transformed
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>filter()</strong>

                <span>
                    ≥ 30
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>30 40 50</strong>

                <span>
                    Result
                </span>

            </div>

        </div>

    </section>


    <!-- Filter Then Transform -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Filtering Before Transformation
        </h2>

        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>const numbers$ = of(
    10,
    20,
    30,
    40,
    50
);

const result$ = numbers$.pipe(

    filter(value =&gt;
        value &gt;= 30
    ),

    map(value =&gt;
        value / 10
    )

);

result$.subscribe({

    next: value =&gt; {

        console.log(value);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Output
                </h4>

                <p>
                    3
                </p>

                <p>
                    4
                </p>

                <p class="mb-0">
                    5
                </p>

            </div>

        </div>

    </section>


    <!-- Difference -->
    <section class="mb-4">

        <h2 class="fw-bold">
            map() vs filter()
        </h2>

        <div class="table-responsive">

            <table class="table syntax-table">

                <thead>

                    <tr>

                        <th>
                            Feature
                        </th>

                        <th>
                            map()
                        </th>

                        <th>
                            filter()
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            Purpose
                        </td>

                        <td>
                            Transform values
                        </td>

                        <td>
                            Select values
                        </td>

                    </tr>


                    <tr>

                        <td>
                            Output
                        </td>

                        <td>
                            Transformed value
                        </td>

                        <td>
                            Original matching value
                        </td>

                    </tr>


                    <tr>

                        <td>
                            Condition
                        </td>

                        <td>
                            Not required
                        </td>

                        <td>
                            Usually required
                        </td>

                    </tr>


                    <tr>

                        <td>
                            Example
                        </td>

                        <td>
                            value * 2
                        </td>

                        <td>
                            value &gt; 10
                        </td>

                    </tr>


                    <tr>

                        <td>
                            Main Use
                        </td>

                        <td>
                            Change data
                        </td>

                        <td>
                            Keep required data
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">
            CIIT Training Institute Example
        </h2>

        <div class="info-card">

            <p>
                Suppose CIIT Training Institute has a stream of course
                information containing course name and fees.
            </p>

            <p class="mb-0">
                We can first select courses above a particular fee and then
                transform the matching objects into display-friendly text.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Course Data
            </div>

            <pre><code>const courses$ = of(

    {
        name: 'Java Full Stack',
        fees: 25000
    },

    {
        name: '.NET Full Stack',
        fees: 35000
    },

    {
        name: 'Python Full Stack',
        fees: 40000
    }

);</code></pre>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Transform and Filter
            </div>

            <pre><code>const premiumCourses$ =
    courses$.pipe(

        filter(course =&gt;
            course.fees &gt;= 35000
        ),

        map(course =&gt;
            course.name +
            ' - ₹' +
            course.fees
        )

    );

premiumCourses$.subscribe({

    next: course =&gt; {

        console.log(course);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    CIIT Training Institute
                </h4>

                <p>
                    .NET Full Stack - ₹35000
                </p>

                <p class="mb-0">
                    Python Full Stack - ₹40000
                </p>

            </div>

        </div>

    </section>


    <!-- Practical Example -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Practical Search Example
        </h2>

        <div class="info-card">

            <p>
                A common use case is filtering search results and then
                transforming the selected data for display.
            </p>

            <p class="mb-0">
                For example, a course search can keep only matching courses
                and then return their names.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const courses$ = of(
    'Java Full Stack',
    '.NET Full Stack',
    'Python Full Stack',
    'Data Analytics'
);

const result$ = courses$.pipe(

    filter(course =&gt;
        course.includes('Full Stack')
    ),

    map(course =&gt;
        course.toUpperCase()
    )

);

result$.subscribe({

    next: course =&gt; {

        console.log(course);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Search Result
                </h4>

                <p>
                    JAVA FULL STACK
                </p>

                <p>
                    .NET FULL STACK
                </p>

                <p class="mb-0">
                    PYTHON FULL STACK
                </p>

            </div>

        </div>

    </section>


    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Transformation &amp; Filtering Best Practices
        </h2>

        <ul class="best-practice-list">

            <li>
                Use <code>map()</code> when the emitted value needs to be
                transformed.
            </li>

            <li>
                Use <code>filter()</code> when only values matching a
                condition should continue.
            </li>

            <li>
                Keep transformation functions simple and readable.
            </li>

            <li>
                Consider the order of operators when multiple operators
                are chained.
            </li>

            <li>
                Avoid unnecessary transformations when the source data
                is already in the required format.
            </li>

            <li>
                Keep complex business rules outside the presentation layer
                where practical.
            </li>

        </ul>

    </section>


    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Important Points
        </h2>

        <div class="best-practice-list">

            <div class="info-card mb-3">

                <strong>
                    1. map() Changes Values
                </strong>

                <p class="mb-0">
                    map() transforms each emitted value into another value.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>
                    2. filter() Selects Values
                </strong>

                <p class="mb-0">
                    filter() allows only values that satisfy its condition.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>
                    3. Operators Can Be Chained
                </strong>

                <p class="mb-0">
                    map() and filter() can be combined in a single
                    pipe() pipeline.
                </p>

            </div>


            <div class="info-card">

                <strong>
                    4. Operator Order Matters
                </strong>

                <p class="mb-0">
                    Each operator receives the output produced by the
                    previous stage in the pipeline.
                </p>

            </div>

        </div>

    </section>


    <!-- Summary -->
    <section class="mb-4">

        <div class="summary-box">

            <h4 class="fw-bold">
                Summary
            </h4>

            <p>
                RxJS transformation changes emitted values into another
                form using operators such as <strong>map()</strong>.
            </p>

            <p>
                Filtering selects only the values that satisfy a condition
                using <strong>filter()</strong>.
            </p>

            <p class="mb-0">
                These operators can be combined inside
                <strong>pipe()</strong> to create a useful data-processing
                pipeline. In the next topic, we will learn about
                <strong>Combining Observables</strong>.
            </p>

        </div>

    </section>


    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Operators", "RxJS", new { area = "Angular" })">

            ← Operators

        </a>


        <a class="btn btn-primary"
           href="@Url.Action("CombiningObservables", "RxJS", new { area = "Angular" })">

            Combining Observables →

        </a>

    </div>

</div>


<style>

    .info-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        line-height: 1.7;
        color: #334155;
    }


