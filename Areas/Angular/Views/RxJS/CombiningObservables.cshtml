@{
    ViewData["Title"] = "RxJS Combining Observables";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">
            RxJS Combining Observables
        </h1>

        <p class="lead text-muted">
            Learn how RxJS can combine multiple Observable streams and produce
            useful results from different data sources.
        </p>

    </section>


    <!-- Introduction -->
    <section class="mb-4">

        <h2 class="fw-bold">
            What is Combining Observables?
        </h2>

        <div class="info-card">

            <p>
                In real applications, data often comes from more than one
                Observable source.
            </p>

            <p>
                RxJS provides combination operators that allow multiple
                Observables to work together and produce a new Observable.
            </p>

            <p class="mb-0">
                Common combination operators include
                <strong>combineLatest()</strong>,
                <strong>forkJoin()</strong>,
                <strong>merge()</strong> and
                <strong>concat()</strong>.
            </p>

        </div>

    </section>


    <!-- Combination Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Combining Observable Flow
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>Observable A</strong>

                <span>
                    First Data Source
                </span>

            </div>


            <div class="syntax-arrow">
                +
            </div>


            <div class="syntax-box">

                <strong>Observable B</strong>

                <span>
                    Second Data Source
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Combination Operator</strong>

                <span>
                    Combines Streams
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Result</strong>

                <span>
                    New Observable
                </span>

            </div>

        </div>

    </section>


    <!-- Why Combine -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Why Combine Observables?
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    D
                </div>

                <h5>
                    Multiple Data Sources
                </h5>

                <p>
                    Work with data coming from different Observables.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    C
                </div>

                <h5>
                    Coordinated Data
                </h5>

                <p>
                    Produce results based on multiple streams.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    A
                </div>

                <h5>
                    API Coordination
                </h5>

                <p>
                    Coordinate multiple asynchronous API operations.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    U
                </div>

                <h5>
                    Unified Result
                </h5>

                <p>
                    Create one stream from multiple related sources.
                </p>

            </div>

        </div>

    </section>


    <!-- combineLatest -->
    <section class="mb-4">

        <h2 class="fw-bold">
            combineLatest()
        </h2>

        <div class="info-card">

            <p>
                <strong>combineLatest()</strong> combines the latest values
                emitted by multiple Observables.
            </p>

            <p class="mb-0">
                After each source has emitted at least one value, a new
                combined value can be emitted whenever any source emits again.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const course$ = of(
    'Java',
    '.NET'
);

const mode$ = of(
    'Online',
    'Offline'
);

const result$ =
    combineLatest([
        course$,
        mode$
    ]);

result$.subscribe({

    next: result =&gt; {

        console.log(result);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Combined Result
                </h4>

                <p>
                    Course: Java
                </p>

                <p>
                    Mode: Online
                </p>

                <p class="mb-0">
                    Result is represented as a combined value.
                </p>

            </div>

        </div>

    </section>


    <!-- combineLatest Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">
            combineLatest() Flow
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>Course</strong>

                <span>
                    Java
                </span>

            </div>


            <div class="syntax-arrow">
                +
            </div>


            <div class="syntax-box">

                <strong>Mode</strong>

                <span>
                    Online
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Latest Combination</strong>

                <span>
                    [Java, Online]
                </span>

            </div>

        </div>

    </section>


    <!-- forkJoin -->
    <section class="mb-4">

        <h2 class="fw-bold">
            forkJoin()
        </h2>

        <div class="info-card">

            <p>
                <strong>forkJoin()</strong> is useful when multiple
                Observables need to complete and the application wants
                their final emitted values together.
            </p>

            <p class="mb-0">
                It is commonly useful for coordinating multiple finite
                asynchronous operations such as independent API requests.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const courses$ =
    this.courseService.getCourses();

const trainers$ =
    this.trainerService.getTrainers();

forkJoin({

    courses: courses$,

    trainers: trainers$

}).subscribe({

    next: result =&gt; {

        console.log(
            result.courses
        );

        console.log(
            result.trainers
        );

    },

    error: error =&gt; {

        console.error(error);

    }

});</code></pre>

        </div>

    </section>


    <!-- forkJoin Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">
            forkJoin() Flow
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>Courses API</strong>

                <span>
                    Complete
                </span>

            </div>


            <div class="syntax-arrow">
                +
            </div>


            <div class="syntax-box">

                <strong>Trainers API</strong>

                <span>
                    Complete
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>forkJoin()</strong>

                <span>
                    Final Values
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Dashboard</strong>

                <span>
                    Combined Data
                </span>

            </div>

        </div>

    </section>


    <!-- merge -->
    <section class="mb-4">

        <h2 class="fw-bold">
            merge()
        </h2>

        <div class="info-card">

            <p>
                <strong>merge()</strong> combines multiple Observables into
                one Observable by forwarding their emissions into the
                resulting stream.
            </p>

            <p class="mb-0">
                Values are emitted as the source Observables produce them,
                so the resulting order depends on the timing of emissions.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const java$ = of(
    'Java'
);

const dotnet$ = of(
    '.NET'
);

const merged$ =
    merge(
        java$,
        dotnet$
    );

merged$.subscribe({

    next: course =&gt; {

        console.log(course);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Output
                </h4>

                <p>
                    Java
                </p>

                <p class="mb-0">
                    .NET
                </p>

            </div>

        </div>

    </section>


    <!-- concat -->
    <section class="mb-4">

        <h2 class="fw-bold">
            concat()
        </h2>

        <div class="info-card">

            <p>
                <strong>concat()</strong> subscribes to Observables in
                sequence.
            </p>

            <p class="mb-0">
                The next Observable starts after the previous Observable
                completes.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const first$ = of(
    'Introduction',
    'Components'
);

const second$ = of(
    'Services',
    'Routing'
);

const topics$ =
    concat(
        first$,
        second$
    );

topics$.subscribe({

    next: topic =&gt; {

        console.log(topic);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Output Order
                </h4>

                <p>
                    Introduction
                </p>

                <p>
                    Components
                </p>

                <p>
                    Services
                </p>

                <p class="mb-0">
                    Routing
                </p>

            </div>

        </div>

    </section>


    <!-- Comparison -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Combining Operators Comparison
        </h2>

        <div class="table-responsive">

            <table class="table syntax-table">

                <thead>

                    <tr>

                        <th>
                            Operator
                        </th>

                        <th>
                            Main Purpose
                        </th>

                        <th>
                            Behavior
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            <code>combineLatest()</code>
                        </td>

                        <td>
                            Combine latest values
                        </td>

                        <td>
                            Emits when source values change after all
                            sources have emitted
                        </td>

                    </tr>


                    <tr>

                        <td>
                            <code>forkJoin()</code>
                        </td>

                        <td>
                            Combine final values
                        </td>

                        <td>
                            Emits when all source Observables complete
                        </td>

                    </tr>


                    <tr>

                        <td>
                            <code>merge()</code>
                        </td>

                        <td>
                            Merge emissions
                        </td>

                        <td>
                            Forwards values as they are emitted
                        </td>

                    </tr>


                    <tr>

                        <td>
                            <code>concat()</code>
                        </td>

                        <td>
                            Sequential combination
                        </td>

                        <td>
                            Subscribes to the next source after the previous
                            one completes
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- combineLatest Detailed -->
    <section class="mb-4">

        <h2 class="fw-bold">
            When to Use combineLatest()
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    F
                </div>

                <h5>
                    Form Values
                </h5>

                <p>
                    Combine the latest values from multiple form-related streams.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    S
                </div>

                <h5>
                    Search Filters
                </h5>

                <p>
                    Combine values from different filter controls.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    D
                </div>

                <h5>
                    Dashboard Data
                </h5>

                <p>
                    Work with the latest values from related streams.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    R
                </div>

                <h5>
                    Reactive UI
                </h5>

                <p>
                    React to changes in multiple Observable sources.
                </p>

            </div>

        </div>

    </section>


    <!-- forkJoin Detailed -->
    <section class="mb-4">

        <h2 class="fw-bold">
            When to Use forkJoin()
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    A
                </div>

                <h5>
                    Multiple APIs
                </h5>

                <p>
                    Wait for several finite API operations to complete.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    R
                </div>

                <h5>
                    Reports
                </h5>

                <p>
                    Collect final results from several independent requests.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    D
                </div>

                <h5>
                    Initial Data
                </h5>

                <p>
                    Load multiple independent datasets before continuing.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    F
                </div>

                <h5>
                    Final Results
                </h5>

                <p>
                    Use when only the final values are required.
                </p>

            </div>

        </div>

    </section>


    <!-- CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">
            CIIT Training Institute Example
        </h2>

        <div class="info-card">

            <p>
                Suppose the CIIT Training Institute dashboard needs three
                independent pieces of information:
                <strong>courses</strong>,
                <strong>trainers</strong> and
                <strong>enquiries</strong>.
            </p>

            <p class="mb-0">
                The dashboard can coordinate these Observables and prepare
                a combined result for display.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Dashboard Data
            </div>

            <pre><code>const courses$ =
    courseService.getCourses();

const trainers$ =
    trainerService.getTrainers();

const enquiries$ =
    enquiryService.getEnquiries();

forkJoin({

    courses: courses$,

    trainers: trainers$,

    enquiries: enquiries$

}).subscribe({

    next: dashboard =&gt; {

        console.log(
            dashboard
        );

    },

    error: error =&gt; {

        console.error(
            error
        );

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    CIIT Training Institute Dashboard
                </h4>

                <p>
                    Courses: Loaded
                </p>

                <p>
                    Trainers: Loaded
                </p>

                <p>
                    Enquiries: Loaded
                </p>

                <p class="mb-0">
                    Dashboard data is ready after the required streams
                    complete.
                </p>

            </div>

        </div>

    </section>


    <!-- Different Combination Strategies -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Choosing the Right Combination Strategy
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>Latest Values</strong>

                <span>
                    combineLatest()
                </span>

            </div>


            <div class="syntax-arrow">
                |
            </div>


            <div class="syntax-box">

                <strong>Final Values</strong>

                <span>
                    forkJoin()
                </span>

            </div>


            <div class="syntax-arrow">
                |
            </div>


            <div class="syntax-box">

                <strong>Concurrent Emissions</strong>

                <span>
                    merge()
                </span>

            </div>


            <div class="syntax-arrow">
                |
            </div>


            <div class="syntax-box">

                <strong>Sequential</strong>

                <span>
                    concat()
                </span>

            </div>

        </div>

    </section>


    <!-- Nested Combination -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Combining and Transforming
        </h2>

        <div class="info-card">

            <p>
                Combination operators can also be followed by other RxJS
                operators.
            </p>

            <p class="mb-0">
                This allows the application to combine streams first and then
                transform or filter the combined result.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const course$ = of(
    'Java'
);

const mode$ = of(
    'Online'
);

const result$ =
    combineLatest([
        course$,
        mode$
    ]).pipe(

        map(([course, mode]) =&gt; {

            return course +
                ' - ' +
                mode;

        })

    );

result$.subscribe({

    next: result =&gt; {

        console.log(result);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Output
                </h4>

                <p class="mb-0">
                    Java - Online
                </p>

            </div>

        </div>

    </section>


    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Important Points
        </h2>

        <div class="best-practice-list">

            <div class="info-card mb-3">

                <strong>
                    1. Combination Creates a New Observable
                </strong>

                <p class="mb-0">
                    Combination operators produce an Observable based on
                    multiple source Observables.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>
                    2. Choose Based on Stream Behavior
                </strong>

                <p class="mb-0">
                    combineLatest(), forkJoin(), merge() and concat()
                    have different timing and completion behavior.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>
                    3. Completion Matters
                </strong>

                <p class="mb-0">
                    Some combination strategies depend on source Observables
                    completing before producing their final result.
                </p>

            </div>


            <div class="info-card">

                <strong>
                    4. Combination Can Be Followed by Other Operators
                </strong>

                <p class="mb-0">
                    A combined stream can be transformed or filtered using
                    additional RxJS operators.
                </p>

            </div>

        </div>

    </section>


    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Combining Observable Best Practices
        </h2>

        <ul class="best-practice-list">

            <li>
                Choose the combination operator according to the required
                emission and completion behavior.
            </li>

            <li>
                Use combineLatest() when the latest values from multiple
                sources are required.
            </li>

            <li>
                Use forkJoin() when final values from finite sources are
                required after completion.
            </li>

            <li>
                Use merge() when source emissions should flow into one stream.
            </li>

            <li>
                Use concat() when sources should be processed sequentially.
            </li>

            <li>
                Keep combined stream logic readable and avoid unnecessary
                combinations.
            </li>

        </ul>

    </section>


    <!-- Summary -->
    <section class="mb-4">

        <div class="summary-box">

            <h4 class="fw-bold">
                Summary
            </h4>

            <p>
                RxJS provides several operators for combining multiple
                Observable streams.
            </p>

            <p>
                <strong>combineLatest()</strong> works with the latest
                values, <strong>forkJoin()</strong> works with final values
                after completion, <strong>merge()</strong> combines emissions,
                and <strong>concat()</strong> processes sources sequentially.
            </p>

            <p class="mb-0">
                In the next topic, we will learn about
                <strong>Higher Order Mapping</strong>.
            </p>

        </div>

    </section>


    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("TransformationFiltering", "RxJS", new { area = "Angular" })">

            ← Transformation &amp; Filtering

        </a>


        <a class="btn btn-primary"
           href="@Url.Action("HigherOrderMapping", "RxJS", new { area = "Angular" })">

            Higher Order Mapping →

        </a>

    </div>

</div>


<style>

    .info-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        line-height: 1.7;
        color: #334155;
    }


    .syntax-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        margin: 25px 0;
    }


    .syntax-box {
        background: linear-gradient( 135deg, #2e1065, #4c1d95 );
        color: white;
        padding: 18px 25px;
        border-radius: 12px;
        text-align: center;
        min-width: 180px;
        box-shadow: 0 5px 15px rgba(76, 29, 149, 0.15);
    }


        .syntax-box strong {
            display: block;
            font-size: 16px;
        }


        .syntax-box span {
            display: block;
            margin-top: 5px;
            color: #d8c9f5;
            font-size: 14px;
        }


    .syntax-arrow {
        font-size: 28px;
        font-weight: bold;
        color: #4c1d95;
    }


    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }


    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }


        .syntax-card h5 {
            margin-top: 15px;
            font-weight: 700;
            color: #2e1065;
        }


        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
            line-height: 1.6;
        }


    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 auto;
    }


    .code-card {
        background: #0f172a;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.10);
    }


    .code-title {
        background: #1e293b;
        color: #ffffff;
        padding: 12px 18px;
        font-weight: 700;
        font-size: 14px;
    }


    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }


    .code-card code {
        color: #f8fafc;
        font-size: 14px;
        line-height: 1.7;
    }


    .output-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 20px;
    }


    .student-preview {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
    }


        .student-preview h4 {
            color: #2e1065;
            font-weight: 700;
        }


        .student-preview p {
            color: #64748b;
        }


    .syntax-table {
        width: 100%;
        margin-bottom: 0;
        border: 1px solid #e2e8f0;
    }


        .syntax-table thead th {
            background: #2e1065;
            color: white;
            padding: 14px;
            border-color: #4c1d95;
        }


        .syntax-table tbody td {
            padding: 14px;
            vertical-align: middle;
            color: #334155;
            border-color: #e2e8f0;
        }


        .syntax-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }


        .syntax-table code {
            color: #4c1d95;
            font-weight: 600;
        }


    .best-practice-list {
        margin: 0;
        padding-left: 20px;
    }


        .best-practice-list li {
            margin-bottom: 10px;
            color: #334155;
