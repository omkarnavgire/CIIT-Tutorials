@{
    ViewData["Title"] = "Angular OnChanges";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">Angular OnChanges</h1>

        <p class="lead text-muted">
            Angular <strong>@@OnChanges</strong> is a lifecycle hook used to
            detect changes in input-bound properties of a component.
            It is useful when a child component needs to react whenever
            data received from its parent changes.
        </p>

    </section>

    <!-- What is OnChanges -->
    <section class="mb-4">

        <h2 class="fw-bold">What is @@OnChanges?</h2>

        <p>
            The <strong>ngOnChanges()</strong> lifecycle hook is called when
            one or more data-bound input properties of a component change.
        </p>

        <p>
            It receives a <strong>SimpleChanges</strong> object containing
            information about the previous value and the current value of
            the changed input property.
        </p>

        <div class="info-card">

            <h5>Simple Definition</h5>

            <p>
                <strong>ngOnChanges()</strong> allows a component to respond
                when data received through <strong>@@Input</strong> changes.
            </p>

        </div>

    </section>

    <!-- Lifecycle Flow -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">How @@OnChanges Works</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-box-arrow-up"></i>

                <strong>Parent Component</strong>

                <span>Sends data</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-arrow-down-circle"></i>

                <strong>@@Input</strong>

                <span>Receives value</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-arrow-repeat"></i>

                <strong>ngOnChanges()</strong>

                <span>Detects change</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-display"></i>

                <strong>Component UI</strong>

                <span>Updates accordingly</span>

            </div>

        </div>

    </section>

    <!-- Basic Syntax -->
    <section class="mb-4">

        <h2 class="fw-bold">Basic Syntax</h2>

        <p>
            A component can implement the <strong>OnChanges</strong>
            interface and define the <strong>ngOnChanges()</strong> method.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>import &#123; Component, Input, OnChanges, SimpleChanges &#125;
from '@@angular/core';

@@Component(&#123;
    selector: 'app-course',
    templateUrl: './course.component.html'
&#125;)
export class CourseComponent implements OnChanges &#123;

    @@Input() courseName = '';

    ngOnChanges(changes: SimpleChanges): void &#123;

        console.log(changes);

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>Important</h5>

            <p>
                Angular automatically calls <strong>ngOnChanges()</strong>
                whenever an input-bound property receives a changed value.
            </p>

        </div>

    </section>

    <!-- SimpleChanges -->
    <section class="mb-4">

        <h2 class="fw-bold">What is SimpleChanges?</h2>

        <p>
            The <strong>SimpleChanges</strong> object contains information
            about the input properties that changed.
        </p>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-arrow-left"></i>
                </div>

                <h5>Previous Value</h5>

                <p>
                    Contains the value of the input before the change.
                </p>

                <code>previousValue</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-arrow-right"></i>
                </div>

                <h5>Current Value</h5>

                <p>
                    Contains the latest value received by the component.
                </p>

                <code>currentValue</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-123"></i>
                </div>

                <h5>First Change</h5>

                <p>
                    Indicates whether this is the first detected change.
                </p>

                <code>firstChange</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-braces"></i>
                </div>

                <h5>Changes Object</h5>

                <p>
                    Gives access to all changed input properties.
                </p>

                <code>SimpleChanges</code>

            </div>

        </div>

    </section>

    <!-- Simple Example -->
    <section class="mb-4">

        <h2 class="fw-bold">1. Simple OnChanges Example</h2>

        <p>
            In this example, the child component receives a course name
            through <strong>@@Input</strong> and reacts when that value changes.
        </p>

        <div class="code-card">

            <div class="code-title">
                Child Component
            </div>

            <pre><code>import &#123; Component, Input, OnChanges, SimpleChanges &#125;
from '@@angular/core';

@@Component(&#123;
    selector: 'app-course',
    templateUrl: './course.component.html'
&#125;)
export class CourseComponent implements OnChanges &#123;

    @@Input() courseName = '';

    ngOnChanges(changes: SimpleChanges): void &#123;

        if (changes['courseName']) &#123;

            console.log(
                'Course changed to:',
                changes['courseName'].currentValue
            );

        &#125;

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Parent Template
            </div>

            <pre><code>&lt;app-course
    [courseName]="selectedCourse"&gt;
&lt;/app-course&gt;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Parent Component
            </div>

            <pre><code>selectedCourse = 'Java Full Stack';</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Behavior:</strong>

            <div class="output-preview">

                <p>
                    Initial Course:
                    <strong>Java Full Stack</strong>
                </p>

                <p>
                    When the parent changes the course value,
                    <strong>ngOnChanges()</strong> detects the change.
                </p>

            </div>

        </div>

    </section>

    <!-- Previous and Current Value -->
    <section class="mb-4">

        <h2 class="fw-bold">2. Previous Value and Current Value</h2>

        <p>
            Angular provides both the previous and current values through the
            <strong>SimpleChange</strong> object.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>@@Input() courseName = '';

ngOnChanges(changes: SimpleChanges): void &#123;

    const change = changes['courseName'];

    if (change) &#123;

        console.log(
            'Previous:',
            change.previousValue
        );

        console.log(
            'Current:',
            change.currentValue
        );

    &#125;

&#125;</code></pre>

        </div>

        <div class="binding-flow">

            <div class="binding-item">

                <strong>Previous Value</strong>

                <span>
                    Java Full Stack
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Input Change</strong>

                <span>
                    Parent updates value
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Current Value</strong>

                <span>
                    Python Full Stack
                </span>

            </div>

        </div>

    </section>

    <!-- First Change -->
    <section class="mb-4">

        <h2 class="fw-bold">3. Checking First Change</h2>

        <p>
            The <strong>firstChange</strong> property can be used to determine
            whether the current change is the first change detected for an
            input property.
        </p>

        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>@@Input() courseName = '';

ngOnChanges(changes: SimpleChanges): void &#123;

    const change = changes['courseName'];

    if (change) &#123;

        if (change.firstChange) &#123;

            console.log('First course value received');

        &#125; else &#123;

            console.log('Course value changed');

        &#125;

    &#125;

&#125;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Behavior:</strong>

            <div class="output-preview">

                <p>
                    First value:
                    <strong>firstChange = true</strong>
                </p>

                <p>
                    Later updates:
                    <strong>firstChange = false</strong>
                </p>

            </div>

        </div>

    </section>

    <!-- Multiple Inputs -->
    <section class="mb-4">

        <h2 class="fw-bold">4. Detecting Multiple Input Changes</h2>

        <p>
            A component can have multiple input properties. The
            <strong>SimpleChanges</strong> object can contain information
            about each property that changed.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>@@Input() courseName = '';

@@Input() trainingMode = '';

ngOnChanges(changes: SimpleChanges): void &#123;

    if (changes['courseName']) &#123;

        console.log(
            'Course:',
            changes['courseName'].currentValue
        );

    &#125;

    if (changes['trainingMode']) &#123;

        console.log(
            'Mode:',
            changes['trainingMode'].currentValue
        );

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Parent Template
            </div>

            <pre><code>&lt;app-course
    [courseName]="course"
    [trainingMode]="mode"&gt;
&lt;/app-course&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Example Values:</strong>

            <div class="student-preview">

                <p>
                    <strong>Course:</strong>
                    .NET Full Stack
                </p>

                <p>
                    <strong>Training Mode:</strong>
                    Offline
                </p>

            </div>

        </div>

    </section>

    <!-- Reacting to Input Change -->
    <section class="mb-4">

        <h2 class="fw-bold">5. Reacting to Input Changes</h2>

        <p>
            One of the important uses of ngOnChanges() is to perform some
            action whenever an input value changes.
        </p>

        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>@@Input() searchText = '';

message = '';

ngOnChanges(changes: SimpleChanges): void &#123;

    if (changes['searchText']) &#123;

        const value =
            changes['searchText'].currentValue;

        this.message =
            'Searching for: ' + value;

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;p&gt;
    &#123;&#123; message &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                Searching for:
                <strong>Angular</strong>

            </div>

        </div>

    </section>

    <!-- OnChanges vs OnInit -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">@@OnChanges vs @@OnInit</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>

                        <th>ngOnChanges()</th>

                        <th>ngOnInit()</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            Responds to changes in input-bound properties.
                        </td>

                        <td>
                            Performs component initialization.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Can run whenever an input value changes.
                        </td>

                        <td>
                            Normally runs once during initialization.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Receives a SimpleChanges object.
                        </td>

                        <td>
                            Does not receive SimpleChanges.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Useful for reacting to parent-to-child data changes.
                        </td>

                        <td>
                            Useful for setting up initial component state.
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Complete CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">Complete CIIT Training Institute Example</h2>

        <p>
            Suppose the CIIT Training Institute course dashboard sends a
            selected course and training mode to a child component.
            The child component can react whenever these values change.
        </p>

        <div class="code-card">

            <div class="code-title">
                course-details.component.ts
            </div>

            <pre><code>import &#123;
    Component,
    Input,
    OnChanges,
    SimpleChanges
&#125; from '@@angular/core';

@@Component(&#123;
    selector: 'app-course-details',
    templateUrl: './course-details.component.html'
&#125;)
export class CourseDetailsComponent
    implements OnChanges &#123;

    @@Input() courseName = '';

    @@Input() trainingMode = '';

    courseMessage = '';

    ngOnChanges(changes: SimpleChanges): void &#123;

        if (
            changes['courseName'] ||
            changes['trainingMode']
        ) &#123;

            this.courseMessage =
                this.courseName +
                ' - ' +
                this.trainingMode;

        &#125;

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Parent Template
            </div>

            <pre><code>&lt;app-course-details
    [courseName]="selectedCourse"
    [trainingMode]="selectedMode"&gt;
&lt;/app-course-details&gt;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Parent Component
            </div>

            <pre><code>selectedCourse = 'Java Full Stack';

selectedMode = 'Offline';</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>
                    Selected Course
                </h3>

                <p>
                    <strong>Course:</strong>
                    Java Full Stack
                </p>

                <p>
                    <strong>Training Mode:</strong>
                    Offline
                </p>

                <p>
                    <strong>Message:</strong>
                    Java Full Stack - Offline
                </p>

            </div>

        </div>

    </section>

    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">Important Points About @@OnChanges</h2>

        <ul class="best-practice-list">

            <li>
                ngOnChanges() is related to input-bound properties.
            </li>

            <li>
                It receives a SimpleChanges object.
            </li>

            <li>
                previousValue provides the earlier value.
            </li>

            <li>
                currentValue provides the latest value.
            </li>

            <li>
                firstChange indicates whether it is the first detected change.
            </li>

            <li>
                It is especially useful for reacting to parent-to-child
                data updates.
            </li>

        </ul>

    </section>

    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">@@OnChanges Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Use ngOnChanges when component behavior depends on input changes.
            </li>

            <li>
                Check the required property before processing its change.
            </li>

            <li>
                Use currentValue and previousValue when comparison is needed.
            </li>

            <li>
                Keep change-handling logic simple and readable.
            </li>

            <li>
                Move reusable business logic into services when appropriate.
            </li>

            <li>
                Avoid unnecessary processing when unrelated inputs change.
            </li>

        </ul>

    </section>

    <!-- Summary -->
    <section class="summary-box">

        <h3>Summary</h3>

        <p>
            Angular <strong>@@OnChanges</strong> provides the
            <strong>ngOnChanges()</strong> lifecycle method for responding to
            changes in input-bound properties.
        </p>

        <p>
            The <strong>SimpleChanges</strong> object provides useful
            information such as <strong>previousValue</strong>,
            <strong>currentValue</strong>, and <strong>firstChange</strong>.
        </p>

    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("OnInit", "LifecycleHooks", new { area = "Angular" })">
            ← ngOnInit
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("AfterViewInit", "LifecycleHooks", new { area = "Angular" })">
            ngAfterViewInit →
        </a>

    </div>

</div>

