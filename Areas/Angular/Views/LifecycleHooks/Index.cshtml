@{
    ViewData["Title"] = "Angular Lifecycle Hooks";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Angular Lifecycle Hooks</h1>
        <p class="lead text-muted">
            Learn how Angular lifecycle hooks allow you to execute code at specific stages
            of a component's lifecycle.
        </p>
    </section>

    <!-- Introduction -->
    <section class="mb-4">
        <h2 class="fw-bold">What are Lifecycle Hooks?</h2>

        <div class="info-card">
            <p>
                Angular components go through different stages from creation to destruction.
                These stages are called the <strong>component lifecycle</strong>.
            </p>

            <p>
                Angular provides lifecycle hook methods that allow developers to execute
                custom code when a particular lifecycle stage occurs.
            </p>

            <p class="mb-0">
                Lifecycle hooks are useful for initialization, responding to changes,
                working with the view, and performing cleanup operations.
            </p>
        </div>
    </section>

    <!-- Lifecycle Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Angular Component Lifecycle</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <strong>Component Created</strong>
                <span>Creation</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>@@OnChanges</strong>
                <span>Input Changes</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>@@OnInit</strong>
                <span>Initialization</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>@@AfterViewInit</strong>
                <span>View Ready</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>@@OnDestroy</strong>
                <span>Cleanup</span>
            </div>

        </div>
    </section>

    <!-- Lifecycle Hooks -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Lifecycle Hooks</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">1</div>
                <h5>@@OnChanges</h5>
                <p>
                    Runs when an Input property receives a new value.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">2</div>
                <h5>@@OnInit</h5>
                <p>
                    Runs once after Angular initializes the component.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">3</div>
                <h5>@@AfterViewInit</h5>
                <p>
                    Runs after Angular initializes the component view.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">4</div>
                <h5>@@OnDestroy</h5>
                <p>
                    Runs just before Angular destroys the component.
                </p>
            </div>

        </div>
    </section>

    <!-- OnInit -->
    <section class="mb-4">
        <h2 class="fw-bold">@@OnInit</h2>

        <div class="info-card">
            <p>
                The <strong>@@OnInit</strong> lifecycle hook runs once after Angular has
                initialized the component's data-bound properties.
            </p>

            <p class="mb-0">
                It is commonly used for initialization tasks such as loading course data,
                calling services, or preparing component properties.
            </p>
        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>import {
    Component,
    OnInit
} from '@@angular/core';

@@Component({
    selector: 'app-courses',
    templateUrl: './courses.component.html'
})
export class CoursesComponent
    implements OnInit {

    courses: string[] = [];

    ngOnInit() {

        this.courses = [
            'Java Full Stack',
            'Python Full Stack',
            'Full Stack .NET'
        ];

    }

}</code></pre>

        </div>
    </section>

    <!-- OnChanges -->
    <section class="mb-4">
        <h2 class="fw-bold">@@OnChanges</h2>

        <div class="info-card">
            <p>
                The <strong>@@OnChanges</strong> hook runs when one or more
                <strong>@@Input</strong> properties change.
            </p>

            <p class="mb-0">
                It is useful when a child component needs to respond to new data
                received from its parent.
            </p>
        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>import {
    Component,
    Input,
    OnChanges,
    SimpleChanges
} from '@@angular/core';

@@Component({
    selector: 'app-course-details',
    templateUrl: './course-details.component.html'
})
export class CourseDetailsComponent
    implements OnChanges {

    @@Input() courseName = '';

    ngOnChanges(changes: SimpleChanges) {

        console.log(
            'Course changed:',
            changes['courseName']
        );

    }

}</code></pre>

        </div>
    </section>

    <!-- AfterViewInit -->
    <section class="mb-4">
        <h2 class="fw-bold">@@AfterViewInit</h2>

        <div class="info-card">
            <p>
                The <strong>@@AfterViewInit</strong> hook runs after Angular has
                completely initialized the component's view.
            </p>

            <p class="mb-0">
                It can be useful when code needs to work with elements that are
                available after the view has been initialized.
            </p>
        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>import {
    Component,
    AfterViewInit
} from '@@angular/core';

@@Component({
    selector: 'app-course',
    templateUrl: './course.component.html'
})
export class CourseComponent
    implements AfterViewInit {

    ngAfterViewInit() {

        console.log(
            'Course view initialized'
        );

    }

}</code></pre>

        </div>
    </section>

    <!-- OnDestroy -->
    <section class="mb-4">
        <h2 class="fw-bold">@@OnDestroy</h2>

        <div class="info-card">
            <p>
                The <strong>@@OnDestroy</strong> hook runs immediately before Angular
                destroys a component.
            </p>

            <p class="mb-0">
                It is commonly used for cleanup tasks such as unsubscribing from
                Observables, removing event listeners, or stopping timers.
            </p>
        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>import {
    Component,
    OnDestroy
} from '@@angular/core';

@@Component({
    selector: 'app-course',
    templateUrl: './course.component.html'
})
export class CourseComponent
    implements OnDestroy {

    ngOnDestroy() {

        console.log(
            'Course component destroyed'
        );

    }

}</code></pre>

        </div>
    </section>

    <!-- Lifecycle Table -->
    <section class="mb-4">
        <h2 class="fw-bold">Lifecycle Hooks Comparison</h2>

        <div class="table-responsive">

            <table class="syntax-table">

                <thead>
                    <tr>
                        <th>Hook</th>
                        <th>When It Runs</th>
                        <th>Common Use</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>@@OnChanges</td>
                        <td>When Input values change</td>
                        <td>React to new Input data</td>
                    </tr>

                    <tr>
                        <td>@@OnInit</td>
                        <td>After component initialization</td>
                        <td>Initialize data</td>
                    </tr>

                    <tr>
                        <td>@@AfterViewInit</td>
                        <td>After view initialization</td>
                        <td>Work with initialized view</td>
                    </tr>

                    <tr>
                        <td>@@OnDestroy</td>
                        <td>Before component destruction</td>
                        <td>Cleanup operations</td>
                    </tr>

                </tbody>

            </table>

        </div>
    </section>

    <!-- CIIT Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete CIIT Training Institute Example</h2>

        <div class="info-card">

            <p>
                Suppose CIIT Training Institute has a course details component.
                When the selected course changes, the component receives the new value
                through @@Input.
            </p>

            <p class="mb-0">
                The component can use lifecycle hooks to initialize course information,
                respond to changes, work with its view, and perform cleanup.
            </p>

        </div>

        <div class="code-card mt-3">

            <div class="code-title">
                Course Details Component
            </div>

            <pre><code>import {
    Component,
    Input,
    OnChanges,
    OnInit,
    AfterViewInit,
    OnDestroy,
    SimpleChanges
} from '@@angular/core';

@@Component({
    selector: 'app-course-details',
    templateUrl: './course-details.component.html'
})
export class CourseDetailsComponent
    implements
        OnChanges,
        OnInit,
        AfterViewInit,
        OnDestroy {

    @@Input() courseName = '';

    ngOnChanges(changes: SimpleChanges) {

        console.log('Course changed');

    }

    ngOnInit() {

        console.log('Component initialized');

    }

    ngAfterViewInit() {

        console.log('View initialized');

    }

    ngOnDestroy() {

        console.log('Component destroyed');

    }

}</code></pre>

        </div>
    </section>

    <!-- Lifecycle Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Lifecycle Execution Flow</h2>

        <div class="binding-flow">

            <div class="binding-item">
                <strong>@@OnChanges</strong>
                <span>Input Changes</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>@@OnInit</strong>
                <span>Initialize</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>@@AfterViewInit</strong>
                <span>View Ready</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <strong>@@OnDestroy</strong>
                <span>Cleanup</span>
            </div>

        </div>
    </section>

    <!-- Important Points -->
    <section class="mb-4">
        <h2 class="fw-bold">Important Points</h2>

        <div class="best-practice-list">

            <div class="info-card mb-3">
                <strong>1. Initialization</strong>
                <p class="mb-0">
                    Use @@OnInit for component initialization tasks.
                </p>
            </div>

            <div class="info-card mb-3">
                <strong>2. Input Changes</strong>
                <p class="mb-0">
                    Use @@OnChanges when an @@Input property changes.
                </p>
            </div>

            <div class="info-card mb-3">
                <strong>3. View Initialization</strong>
                <p class="mb-0">
                    Use @@AfterViewInit when the component view has been initialized.
                </p>
            </div>

            <div class="info-card">
                <strong>4. Cleanup</strong>
                <p class="mb-0">
                    Use @@OnDestroy for cleanup operations before the component is removed.
                </p>
            </div>

        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Lifecycle Hooks Best Practices</h2>

        <ul class="best-practice-list">
            <li>Use the appropriate lifecycle hook for each task.</li>
            <li>Keep initialization logic inside @@OnInit.</li>
            <li>Use @@OnChanges when responding to Input changes.</li>
            <li>Use @@AfterViewInit only when the initialized view is required.</li>
            <li>Perform cleanup operations inside @@OnDestroy.</li>
            <li>Keep lifecycle methods short and focused.</li>
        </ul>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <div class="summary-box">

            <h4 class="fw-bold">Summary</h4>

            <p class="mb-0">
                Angular lifecycle hooks allow developers to execute code at important
                stages of a component's lifecycle. <strong>@@OnChanges</strong> handles
                Input changes, <strong>@@OnInit</strong> handles initialization,
                <strong>@@AfterViewInit</strong> handles view initialization, and
                <strong>@@OnDestroy</strong> is used for cleanup before a component
                is destroyed.
            </p>

        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("InputOutputCommunication", "InputOutput", new { area = "Angular" })">
            ← Input & Output
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("OnInit", "LifecycleHooks", new { area = "Angular" })">
            OnInit →
        </a>

    </div>

</div>

