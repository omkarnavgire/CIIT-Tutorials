@{
    ViewData["Title"] = "Angular AfterViewInit";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">Angular AfterViewInit</h1>

        <p class="lead text-muted">
            Angular <strong>@@AfterViewInit</strong> is a lifecycle hook that
            runs after Angular has completely initialized the component's
            view and its child views.
        </p>

    </section>

    <!-- What is AfterViewInit -->
    <section class="mb-4">

        <h2 class="fw-bold">What is @@AfterViewInit?</h2>

        <p>
            The <strong>ngAfterViewInit()</strong> lifecycle hook is called
            after Angular finishes initializing the component view.
        </p>

        <p>
            It is useful when code needs to work with elements or child
            components after the view has been created.
        </p>

        <div class="info-card">

            <h5>Simple Definition</h5>

            <p>
                <strong>ngAfterViewInit()</strong> is used when you need to
                perform an operation after the component's view and child
                views are initialized.
            </p>

        </div>

    </section>

    <!-- Lifecycle Flow -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Where @@AfterViewInit Fits in Angular Lifecycle</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-box"></i>

                <strong>Component Created</strong>

                <span>Angular creates component</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-code-square"></i>

                <strong>View Initialized</strong>

                <span>Component template is initialized</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-play-circle"></i>

                <strong>ngAfterViewInit()</strong>

                <span>View initialization logic runs</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-display"></i>

                <strong>View Ready</strong>

                <span>Child views are available</span>

            </div>

        </div>

    </section>

    <!-- Basic Syntax -->
    <section class="mb-4">

        <h2 class="fw-bold">Basic Syntax</h2>

        <p>
            To use this lifecycle hook, implement the
            <strong>AfterViewInit</strong> interface and define the
            <strong>ngAfterViewInit()</strong> method.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>import &#123; Component, AfterViewInit &#125; from '@@angular/core';

@@Component(&#123;
    selector: 'app-dashboard',
    templateUrl: './dashboard.component.html'
&#125;)
export class DashboardComponent implements AfterViewInit &#123;

    ngAfterViewInit(): void &#123;

        console.log('View initialized');

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>Important</h5>

            <p>
                Angular automatically calls
                <strong>ngAfterViewInit()</strong> after the component view
                has been initialized.
            </p>

        </div>

    </section>

    <!-- Why use AfterViewInit -->
    <section class="mb-4">

        <h2 class="fw-bold">Why Use @@AfterViewInit?</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-eye"></i>
                </div>

                <h5>View Access</h5>

                <p>
                    Perform operations after the component view is initialized.
                </p>

                <code>ngAfterViewInit()</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-diagram-3"></i>
                </div>

                <h5>Child Components</h5>

                <p>
                    Work with initialized child component views.
                </p>

                <code>ViewChild</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-input-cursor-text"></i>
                </div>

                <h5>Element References</h5>

                <p>
                    Access elements referenced from the component view.
                </p>

                <code>ElementRef</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>

                <h5>UI Initialization</h5>

                <p>
                    Perform view-related initialization after rendering starts.
                </p>

                <code>initializeView()</code>

            </div>

        </div>

    </section>

    <!-- Simple Example -->
    <section class="mb-4">

        <h2 class="fw-bold">1. Simple AfterViewInit Example</h2>

        <p>
            The following example displays a message after the component view
            has been initialized.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>import &#123; Component, AfterViewInit &#125; from '@@angular/core';

@@Component(&#123;
    selector: 'app-welcome',
    templateUrl: './welcome.component.html'
&#125;)
export class WelcomeComponent implements AfterViewInit &#123;

    message = '';

    ngAfterViewInit(): void &#123;

        this.message = 'CIIT Training Institute View Ready';

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;h2&gt;
    &#123;&#123; message &#125;&#125;
&lt;/h2&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <h3>
                    CIIT Training Institute View Ready
                </h3>

            </div>

        </div>

    </section>

    <!-- ViewChild Example -->
    <section class="mb-4">

        <h2 class="fw-bold">2. Using @@ViewChild with @@AfterViewInit</h2>

        <p>
            <strong>@@ViewChild</strong> can be used to obtain a reference to
            an element or child component after the view has been initialized.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>import &#123;
    Component,
    AfterViewInit,
    ElementRef,
    ViewChild
&#125; from '@@angular/core';

@@Component(&#123;
    selector: 'app-course',
    templateUrl: './course.component.html'
&#125;)
export class CourseComponent implements AfterViewInit &#123;

    @@ViewChild('courseTitle')
    courseTitle!: ElementRef;

    ngAfterViewInit(): void &#123;

        console.log(
            this.courseTitle.nativeElement.textContent
        );

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;h2 #courseTitle&gt;
    Angular Full Stack
&lt;/h2&gt;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                The template reference <strong>#courseTitle</strong> is
                connected to <strong>@@ViewChild</strong>. After the view is
                initialized, the element reference can be accessed inside
                <strong>ngAfterViewInit()</strong>.
            </p>

        </div>

    </section>

    <!-- Child Component Example -->
    <section class="mb-4">

        <h2 class="fw-bold">3. Accessing a Child Component</h2>

        <p>
            A parent component can use <strong>@@ViewChild</strong> to access
            a child component after its view has been initialized.
        </p>

        <div class="code-card">

            <div class="code-title">
                Child Component
            </div>

            <pre><code>export class CourseCardComponent &#123;

    courseName = 'Java Full Stack';

    showCourse(): void &#123;

        console.log(this.courseName);

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Parent Component
            </div>

            <pre><code>import &#123;
    Component,
    AfterViewInit,
    ViewChild
&#125; from '@@angular/core';

@@Component(&#123;
    selector: 'app-dashboard',
    templateUrl: './dashboard.component.html'
&#125;)
export class DashboardComponent implements AfterViewInit &#123;

    @@ViewChild(CourseCardComponent)
    courseCard!: CourseCardComponent;

    ngAfterViewInit(): void &#123;

        this.courseCard.showCourse();

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Parent Template
            </div>

            <pre><code>&lt;app-course-card&gt;
&lt;/app-course-card&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Result:</strong>

            <div class="output-preview">

                Parent component can access the initialized child component.

            </div>

        </div>

    </section>

    <!-- ViewChild Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">4. @@ViewChild and View Initialization Flow</h2>

        <div class="binding-flow">

            <div class="binding-item">

                <strong>Template</strong>

                <span>
                    Element / Child Component
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>@@ViewChild</strong>

                <span>
                    Creates Reference
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>ngAfterViewInit()</strong>

                <span>
                    View becomes initialized
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Access View</strong>

                <span>
                    Use the reference
                </span>

            </div>

        </div>

    </section>

    <!-- Multiple View References -->
    <section class="mb-4">

        <h2 class="fw-bold">5. Working with View References</h2>

        <p>
            A component may use view references to access different elements
            that are required after view initialization.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>@@ViewChild('courseTitle')
courseTitle!: ElementRef;

@@ViewChild('courseButton')
courseButton!: ElementRef;

ngAfterViewInit(): void &#123;

    console.log(
        this.courseTitle.nativeElement.textContent
    );

    console.log(
        this.courseButton.nativeElement.textContent
    );

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;h2 #courseTitle&gt;
    Python Full Stack
&lt;/h2&gt;

&lt;button #courseButton&gt;
    Enquire Now
&lt;/button&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected View:</strong>

            <div class="student-preview">

                <h3>
                    Python Full Stack
                </h3>

                <button class="btn btn-primary btn-sm">
                    Enquire Now
                </button>

            </div>

        </div>

    </section>

    <!-- OnInit vs AfterViewInit -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">@@OnInit vs @@AfterViewInit</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>
                        <th>ngOnInit()</th>
                        <th>ngAfterViewInit()</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            Used for component initialization logic.
                        </td>

                        <td>
                            Used for view initialization logic.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Runs before the component view is fully initialized.
                        </td>

                        <td>
                            Runs after the component view is initialized.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Commonly used for preparing data.
                        </td>

                        <td>
                            Useful when working with view references.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Suitable for initial service or API operations.
                        </td>

                        <td>
                            Suitable for view and child-component access.
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Complete CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">Complete CIIT Training Institute Example</h2>

        <p>
            Suppose CIIT Training Institute has a course enquiry component.
            After the course view is initialized, the component can access
            a course heading and enquiry button using
            <strong>@@ViewChild</strong>.
        </p>

        <div class="code-card">

            <div class="code-title">
                course-enquiry.component.ts
            </div>

            <pre><code>import &#123;
    Component,
    AfterViewInit,
    ElementRef,
    ViewChild
&#125; from '@@angular/core';

@@Component(&#123;
    selector: 'app-course-enquiry',
    templateUrl: './course-enquiry.component.html'
&#125;)
export class CourseEnquiryComponent
    implements AfterViewInit &#123;

    @@ViewChild('courseHeading')
    courseHeading!: ElementRef;

    @@ViewChild('enquiryButton')
    enquiryButton!: ElementRef;

    ngAfterViewInit(): void &#123;

        console.log(
            'Course:',
            this.courseHeading.nativeElement.textContent
        );

        console.log(
            'Button:',
            this.enquiryButton.nativeElement.textContent
        );

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                course-enquiry.component.html
            </div>

            <pre><code>&lt;div&gt;

    &lt;h2 #courseHeading&gt;
        Full Stack .NET
    &lt;/h2&gt;

    &lt;p&gt;
        Learn Full Stack .NET at CIIT Training Institute.
    &lt;/p&gt;

    &lt;button
        #enquiryButton
        class="btn btn-primary"&gt;
        Enquire Now
    &lt;/button&gt;

&lt;/div&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>
                    Full Stack .NET
                </h3>

                <p>
                    Learn Full Stack .NET at CIIT Training Institute.
                </p>

                <button class="btn btn-primary btn-sm">
                    Enquire Now
                </button>

            </div>

        </div>

    </section>

    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">Important Points About @@AfterViewInit</h2>

        <ul class="best-practice-list">

            <li>
                ngAfterViewInit() runs after the component view is initialized.
            </li>

            <li>
                It is useful when code depends on the initialized view.
            </li>

            <li>
                @@ViewChild references can be accessed after view initialization.
            </li>

            <li>
                It can be used for accessing child component instances.
            </li>

            <li>
                Avoid unnecessary DOM manipulation.
            </li>

            <li>
                Keep view-related initialization logic simple and organized.
            </li>

        </ul>

    </section>

    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">@@AfterViewInit Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Use ngAfterViewInit only when logic depends on the initialized view.
            </li>

            <li>
                Use @@ViewChild carefully for view references.
            </li>

            <li>
                Prefer Angular bindings and component logic over unnecessary
                direct DOM manipulation.
            </li>

            <li>
                Keep view initialization code readable.
            </li>

            <li>
                Avoid performing expensive operations unnecessarily.
            </li>

            <li>
                Keep reusable application logic inside services or components.
            </li>

        </ul>

    </section>

    <!-- Summary -->
    <section class="summary-box">

        <h3>Summary</h3>

        <p>
            Angular <strong>@@AfterViewInit</strong> provides the
            <strong>ngAfterViewInit()</strong> lifecycle method for performing
            operations after the component view and child views have been
            initialized.
        </p>

        <p>
            It is especially useful when working with
            <strong>@@ViewChild</strong>, element references, and initialized
            child components.
        </p>

    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("OnChanges", "LifecycleHooks", new { area = "Angular" })">
            ← ngOnChanges
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("OnDestroy", "LifecycleHooks", new { area = "Angular" })">
            ngOnDestroy →
        </a>

    </div>

</div>

