@{
    ViewData["Title"] = "Data Binding Introduction";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Data Binding Introduction</h1>
        <p class="lead text-muted">
            Learn how Angular connects component data with the HTML template
            using different types of data binding.
        </p>
    </section>

    <!-- What is Data Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">What is Data Binding?</h2>

        <div class="info-card">
            <p>
                Data binding is the mechanism Angular uses to connect the
                component class with the template.
            </p>

            <p class="mb-0">
                It allows data to move between the component and the user
                interface so that the displayed content can update dynamically.
            </p>
        </div>
    </section>

    <!-- Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Data Binding Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <div class="syntax-icon">1</div>
                <h5>Component</h5>
                <p>Component contains application data and logic.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">2</div>
                <h5>Binding</h5>
                <p>Angular connects the component with the template.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">3</div>
                <h5>Template</h5>
                <p>Template displays or sends data through bindings.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">4</div>
                <h5>UI</h5>
                <p>The user interacts with the rendered interface.</p>
            </div>

        </div>
    </section>

    <!-- Main Concepts -->
    <section class="mb-4">
        <h2 class="fw-bold">Main Types of Data Binding</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">I</div>
                <h5>Interpolation</h5>
                <p>
                    Displays component data inside the HTML template.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">P</div>
                <h5>Property Binding</h5>
                <p>
                    Binds component data to an element property.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">E</div>
                <h5>Event Binding</h5>
                <p>
                    Sends user events from the template to the component.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">T</div>
                <h5>Two-Way Binding</h5>
                <p>
                    Synchronizes component data and user input.
                </p>
            </div>

        </div>
    </section>

    <!-- Component to Template -->
    <section class="mb-4">
        <h2 class="fw-bold">Component to Template</h2>

        <p>
            Data can move from the component class to the template using
            interpolation and property binding.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>export class StudentComponent {

    studentName = 'Sam';
    course = 'Angular Full Stack';

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;h2&gt;
    Hello &#123;&#123; studentName &#125;&#125;
&lt;/h2&gt;

&lt;p&gt;
    Course: &#123;&#123; course &#125;&#125;
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <h5>Hello Sam</h5>
                <p class="mb-0">
                    Course: Angular Full Stack
                </p>
            </div>
        </div>
    </section>

    <!-- Interpolation -->
    <section class="mb-4">
        <h2 class="fw-bold">Interpolation Binding</h2>

        <p>
            Interpolation uses double curly braces to display component
            properties inside the template.
        </p>

        <div class="code-card">
            <div class="code-title">Interpolation Example</div>

            <pre><code>&lt;h2&gt;
    Welcome &#123;&#123; studentName &#125;&#125;
&lt;/h2&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    Welcome Sam
                </p>
            </div>
        </div>
    </section>

    <!-- Property Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">Property Binding</h2>

        <p>
            Property binding connects a component property with an HTML
            element property.
        </p>

        <div class="code-card">
            <div class="code-title">Property Binding Example</div>

            <pre><code>&lt;button [disabled]="isDisabled"&gt;
    Submit
&lt;/button&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                Here Angular evaluates <code>isDisabled</code> from the
                component and assigns the result to the button's
                <code>disabled</code> property.
            </p>
        </div>
    </section>

    <!-- Event Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">Event Binding</h2>

        <p>
            Event binding allows the template to respond to user actions
            such as button clicks.
        </p>

        <div class="code-card">
            <div class="code-title">Event Binding Example</div>

            <pre><code>&lt;button (click)="showMessage()"&gt;
    Click Me
&lt;/button&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Component Method</div>

            <pre><code>showMessage() {

    console.log('Button clicked');

}</code></pre>
        </div>
    </section>

    <!-- Two Way -->
    <section class="mb-4">
        <h2 class="fw-bold">Two-Way Data Binding</h2>

        <p>
            Two-way data binding keeps the component property and the form
            control value synchronized.
        </p>

        <div class="code-card">
            <div class="code-title">Two-Way Binding Example</div>

            <pre><code>&lt;input
    [(ngModel)]="studentName"
    placeholder="Enter student name"&gt;</code></pre>
        </div>

        <div class="binding-flow">

            <div class="binding-item">
                <h5>Component</h5>
                <code>studentName</code>
            </div>

            <div class="syntax-arrow">↔</div>

            <div class="binding-item">
                <h5>Template</h5>
                <code>input</code>
            </div>

            <div class="syntax-arrow">↔</div>

            <div class="binding-item">
                <h5>User</h5>
                <code>Types Name</code>
            </div>

        </div>
    </section>

    <!-- One Way -->
    <section class="mb-4">
        <h2 class="fw-bold">One-Way Data Binding</h2>

        <p>
            In one-way binding, data moves in one direction between the
            component and template.
        </p>

        <div class="binding-flow">

            <div class="binding-item">
                <h5>Component</h5>
                <code>studentName</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Template</h5>
                <code>&#123;&#123; studentName &#125;&#125;</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>UI</h5>
                <code>Sam</code>
            </div>

        </div>
    </section>

    <!-- Binding Comparison -->
    <section class="mb-4">
        <h2 class="fw-bold">Data Binding Types</h2>

        <div class="syntax-table">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Binding Type</th>
                        <th>Syntax</th>
                        <th>Data Direction</th>
                        <th>Purpose</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Interpolation</td>
                        <td><code>&#123;&#123; value &#125;&#125;</code></td>
                        <td>Component → Template</td>
                        <td>Display data</td>
                    </tr>

                    <tr>
                        <td>Property Binding</td>
                        <td><code>[property]</code></td>
                        <td>Component → Template</td>
                        <td>Set element properties</td>
                    </tr>

                    <tr>
                        <td>Event Binding</td>
                        <td><code>(event)</code></td>
                        <td>Template → Component</td>
                        <td>Handle user events</td>
                    </tr>

                    <tr>
                        <td>Two-Way Binding</td>
                        <td><code>[(ngModel)]</code></td>
                        <td>Both directions</td>
                        <td>Synchronize data</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Common Uses -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Uses of Data Binding</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">1</div>
                <h5>Display Data</h5>
                <p>
                    Show component values dynamically in the UI.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">2</div>
                <h5>Update Properties</h5>
                <p>
                    Bind values to HTML element properties.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">3</div>
                <h5>Handle Events</h5>
                <p>
                    Respond to user interactions.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">4</div>
                <h5>Form Input</h5>
                <p>
                    Synchronize user input with component data.
                </p>
            </div>

        </div>
    </section>

    <!-- Complete Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete Data Binding Example</h2>

        <div class="code-card">
            <div class="code-title">Student Component</div>

            <pre><code>export class StudentComponent {

    studentName = 'Sam';
    course = 'Angular Full Stack';

    showMessage() {

        console.log(
            'Student: ' + this.studentName
        );

    }

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Student Template</div>

            <pre><code>&lt;h2&gt;
    Student: &#123;&#123; studentName &#125;&#125;
&lt;/h2&gt;

&lt;p&gt;
    Course: &#123;&#123; course &#125;&#125;
&lt;/p&gt;

&lt;button
    (click)="showMessage()"&gt;

    Show Student

&lt;/button&gt;</code></pre>
        </div>

        <div class="student-preview">
            <h5>Student Details</h5>

            <p>
                <strong>Student:</strong> Sam
            </p>

            <p>
                <strong>Course:</strong> Angular Full Stack
            </p>

            <button class="btn btn-primary">
                Show Student
            </button>
        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Best Practices</h2>

        <div class="best-practice-list">

            <div>
                <strong>1. Understand the direction of data</strong>
                <p>
                    Know whether data is moving from component to template,
                    template to component, or in both directions.
                </p>
            </div>

            <div>
                <strong>2. Use the correct binding syntax</strong>
                <p>
                    Use interpolation, property binding, event binding,
                    and two-way binding for their appropriate purposes.
                </p>
            </div>

            <div>
                <strong>3. Keep template expressions simple</strong>
                <p>
                    Complex application logic should remain inside the
                    component or service.
                </p>
            </div>

            <div>
                <strong>4. Use two-way binding when synchronization is required</strong>
                <p>
                    Use two-way binding for scenarios where input changes
                    should update component data.
                </p>
            </div>

            <div>
                <strong>5. Use meaningful property and event names</strong>
                <p>
                    Clear names make Angular templates easier to understand
                    and maintain.
                </p>
            </div>

        </div>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <div class="summary-box">
            <h4 class="fw-bold">Summary</h4>

            <ul class="mb-0">
                <li>Data binding connects Angular components with templates.</li>
                <li>Interpolation displays component data.</li>
                <li>Property binding updates element properties.</li>
                <li>Event binding handles user interactions.</li>
                <li>Two-way binding synchronizes component and template data.</li>
                <li>Data binding makes Angular applications dynamic and interactive.</li>
            </ul>
        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("ControlFlow", "Templates", new { area = "Angular" })">
            ← Control Flow
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("Interpolation", "DataBinding", new { area = "Angular" })">
            Interpolation Binding →
        </a>

    </div>

</div>

