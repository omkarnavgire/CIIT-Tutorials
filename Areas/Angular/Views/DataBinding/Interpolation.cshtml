@{
    ViewData["Title"] = "Interpolation Binding";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Interpolation Binding</h1>
        <p class="lead text-muted">
            Learn how Angular uses interpolation to display component data
            dynamically inside an HTML template.
        </p>
    </section>

    <!-- What is Interpolation -->
    <section class="mb-4">
        <h2 class="fw-bold">What is Interpolation?</h2>

        <div class="info-card">
            <p>
                Interpolation is an Angular data binding technique used to
                display component values inside the HTML template.
            </p>

            <p class="mb-0">
                It uses double curly braces
                <code>&#123;&#123; &#125;&#125;</code>
                to evaluate an expression and display its result.
            </p>
        </div>
    </section>

    <!-- Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Interpolation Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <div class="syntax-icon">1</div>
                <h5>Component Data</h5>
                <p>Define a property inside the component class.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">2</div>
                <h5>Expression</h5>
                <p>Place the property inside interpolation syntax.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">3</div>
                <h5>Angular</h5>
                <p>Angular evaluates the interpolation expression.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">4</div>
                <h5>UI</h5>
                <p>The evaluated value appears in the template.</p>
            </div>

        </div>
    </section>

    <!-- Main Concepts -->
    <section class="mb-4">
        <h2 class="fw-bold">Main Interpolation Concepts</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">V</div>
                <h5>Property Value</h5>
                <p>
                    Display a component property inside the template.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">E</div>
                <h5>Expression</h5>
                <p>
                    Evaluate a simple expression and display its result.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">M</div>
                <h5>Method Call</h5>
                <p>
                    Call a component method and display its returned value.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">O</div>
                <h5>Object Property</h5>
                <p>
                    Access a property from an object stored in the component.
                </p>
            </div>

        </div>
    </section>

    <!-- Basic Syntax -->
    <section class="mb-4">
        <h2 class="fw-bold">Interpolation Syntax</h2>

        <p>
            The basic interpolation syntax uses double curly braces.
        </p>

        <div class="code-card">
            <div class="code-title">Basic Syntax</div>

            <pre><code>&#123;&#123; expression &#125;&#125;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                Angular evaluates the expression between
                <code>&#123;&#123;</code> and <code>&#125;&#125;</code>
                and displays the resulting value in the template.
            </p>
        </div>
    </section>

    <!-- Property -->
    <section class="mb-4">
        <h2 class="fw-bold">Displaying a Property</h2>

        <p>
            The most common use of interpolation is displaying a component
            property.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>export class StudentComponent {

    studentName = 'Sam';

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;h2&gt;
    Student Name: &#123;&#123; studentName &#125;&#125;
&lt;/h2&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <h5 class="mb-0">
                    Student Name: Sam
                </h5>
            </div>
        </div>
    </section>

    <!-- Multiple Properties -->
    <section class="mb-4">
        <h2 class="fw-bold">Displaying Multiple Properties</h2>

        <p>
            Multiple component properties can be displayed using interpolation.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>export class StudentComponent {

    studentName = 'Sam';
    course = 'Angular Full Stack';
    city = 'Pune';

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    Name: &#123;&#123; studentName &#125;&#125;
&lt;/p&gt;

&lt;p&gt;
    Course: &#123;&#123; course &#125;&#125;
&lt;/p&gt;

&lt;p&gt;
    City: &#123;&#123; city &#125;&#125;
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <p>Name: Sam</p>
                <p>Course: Angular Full Stack</p>
                <p class="mb-0">City: Pune</p>
            </div>
        </div>
    </section>

    <!-- Expression -->
    <section class="mb-4">
        <h2 class="fw-bold">Interpolation with Expressions</h2>

        <p>
            Angular can evaluate simple expressions inside interpolation.
        </p>

        <div class="code-card">
            <div class="code-title">Expression Example</div>

            <pre><code>export class StudentComponent {

    firstName = 'Sam';
    lastName = 'Patil';

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    Full Name:
    &#123;&#123; firstName + ' ' + lastName &#125;&#125;
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    Full Name: Sam Patil
                </p>
            </div>
        </div>
    </section>

    <!-- Arithmetic -->
    <section class="mb-4">
        <h2 class="fw-bold">Arithmetic Expressions</h2>

        <p>
            Simple arithmetic expressions can also be evaluated inside
            interpolation.
        </p>

        <div class="code-card">
            <div class="code-title">Arithmetic Example</div>

            <pre><code>export class StudentComponent {

    marks1 = 80;
    marks2 = 90;

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    Total Marks:
    &#123;&#123; marks1 + marks2 &#125;&#125;
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    Total Marks: 170
                </p>
            </div>
        </div>
    </section>

    <!-- Method -->
    <section class="mb-4">
        <h2 class="fw-bold">Calling a Method</h2>

        <p>
            A component method that returns a value can be called from
            interpolation.
        </p>

        <div class="code-card">
            <div class="code-title">Component Method</div>

            <pre><code>getWelcomeMessage() {

    return 'Welcome to CIIT Training Institute!';

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;h3&gt;
    &#123;&#123; getWelcomeMessage() &#125;&#125;
&lt;/h3&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    Welcome to CIIT Training Institute!
                </p>
            </div>
        </div>
    </section>

    <!-- Object Property -->
    <section class="mb-4">
        <h2 class="fw-bold">Object Property Interpolation</h2>

        <p>
            Interpolation can access properties from an object.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>student = {

    name: 'Sam',
    course: 'Angular Full Stack',
    city: 'Pune'

};</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    Student:
    &#123;&#123; student.name &#125;&#125;
&lt;/p&gt;

&lt;p&gt;
    Course:
    &#123;&#123; student.course &#125;&#125;
&lt;/p&gt;

&lt;p&gt;
    City:
    &#123;&#123; student.city &#125;&#125;
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <p>Student: Sam</p>
                <p>Course: Angular Full Stack</p>
                <p class="mb-0">City: Pune</p>
            </div>
        </div>
    </section>

    <!-- Binding Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Interpolation Data Flow</h2>

        <div class="binding-flow">

            <div class="binding-item">
                <h5>Component</h5>
                <code>studentName = 'Sam'</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Interpolation</h5>
                <code>&#123;&#123; studentName &#125;&#125;</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Angular</h5>
                <code>Evaluate</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>UI</h5>
                <code>Sam</code>
            </div>

        </div>
    </section>

    <!-- Interpolation vs Property Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">Interpolation vs Property Binding</h2>

        <div class="syntax-table">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Feature</th>
                        <th>Interpolation</th>
                        <th>Property Binding</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Syntax</td>
                        <td><code>&#123;&#123; value &#125;&#125;</code></td>
                        <td><code>[property]="value"</code></td>
                    </tr>

                    <tr>
                        <td>Purpose</td>
                        <td>Display values</td>
                        <td>Bind element properties</td>
                    </tr>

                    <tr>
                        <td>Direction</td>
                        <td>Component → Template</td>
                        <td>Component → Element</td>
                    </tr>

                    <tr>
                        <td>Common Usage</td>
                        <td>Text content</td>
                        <td>HTML properties</td>
                    </tr>

                    <tr>
                        <td>Example</td>
                        <td><code>&#123;&#123; studentName &#125;&#125;</code></td>
                        <td><code>[disabled]="isDisabled"</code></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Common Uses -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Uses of Interpolation</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">1</div>
                <h5>Display Text</h5>
                <p>
                    Display component values inside headings and paragraphs.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">2</div>
                <h5>Display Object Data</h5>
                <p>
                    Access and display properties from component objects.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">3</div>
                <h5>Calculate Values</h5>
                <p>
                    Evaluate simple expressions and display the result.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">4</div>
                <h5>Method Results</h5>
                <p>
                    Display values returned from component methods.
                </p>
            </div>

        </div>
    </section>

    <!-- Complete Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete Interpolation Example</h2>

        <div class="code-card">
            <div class="code-title">Student Component</div>

            <pre><code>export class StudentComponent {

    student = {
        name: 'Sam',
        course: 'Angular Full Stack',
        city: 'Pune'
    };

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Student Template</div>

            <pre><code>&lt;div&gt;

    &lt;h2&gt;
        &#123;&#123; student.name &#125;&#125;
    &lt;/h2&gt;

    &lt;p&gt;
        Course:
        &#123;&#123; student.course &#125;&#125;
    &lt;/p&gt;

    &lt;p&gt;
        City:
        &#123;&#123; student.city &#125;&#125;
    &lt;/p&gt;

&lt;/div&gt;</code></pre>
        </div>

        <div class="student-preview">
            <h5>Student Details</h5>

            <p>
                <strong>Name:</strong> Sam
            </p>

            <p>
                <strong>Course:</strong> Angular Full Stack
            </p>

            <p class="mb-0">
                <strong>City:</strong> Pune
            </p>
        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Best Practices</h2>

        <div class="best-practice-list">

            <div>
                <strong>1. Keep expressions simple</strong>
                <p>
                    Use simple expressions and avoid complex application logic
                    inside interpolation.
                </p>
            </div>

            <div>
                <strong>2. Use interpolation for displaying values</strong>
                <p>
                    Use interpolation primarily when the result needs to appear
                    as text inside the template.
                </p>
            </div>

            <div>
                <strong>3. Avoid expensive method calls</strong>
                <p>
                    Avoid methods that perform heavy processing inside
                    interpolation.
                </p>
            </div>

            <div>
                <strong>4. Use meaningful property names</strong>
                <p>
                    Clear property names make templates easier to read and
                    maintain.
                </p>
            </div>

            <div>
                <strong>5. Use property binding when appropriate</strong>
                <p>
                    Use property binding when you need to bind an actual
                    HTML element property.
                </p>
            </div>

        </div>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <div class="summary-box">
            <h4 class="fw-bold">Summary</h4>

            <ul class="mb-0">
                <li>Interpolation displays component data inside a template.</li>
                <li>It uses double curly braces.</li>
                <li>Simple expressions can be evaluated using interpolation.</li>
                <li>Object properties can be accessed through interpolation.</li>
                <li>Methods that return values can be used when appropriate.</li>
                <li>Interpolation is mainly used for displaying text values.</li>
            </ul>
        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", "DataBinding", new { area = "Angular" })">
            ← Data Binding Introduction
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("PropertyBinding", "DataBinding", new { area = "Angular" })">
            Property Binding →
        </a>

    </div>

</div>

<style>
    .info-card {
        background: #f8fafc;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        color: #334155;
    }

    .syntax-flow {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .syntax-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        width: 190px;
    }

        .syntax-box h5 {
            color: #2e1065;
            font-weight: 700;
            margin-top: 12px;
        }

        .syntax-box p {
            color: #64748b;
            margin-bottom: 0;
            font-size: 14px;
        }

    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 auto 12px;
    }

    .syntax-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4c1d95;
        font-size: 28px;
        font-weight: 700;
    }

    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        transition: all 0.2s ease;
    }

        .syntax-card:hover {
            transform: translateY(-3px);
            border-color: #c4b5fd;
            box-shadow: 0 8px 20px rgba(76, 29, 149, 0.08);
        }

        .syntax-card h5 {
            color: #2e1065;
            font-weight: 700;
        }

        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
        }

    .code-card {
        margin-top: 20px;
        border-radius: 12px;
        overflow: hidden;
        background: #0f172a;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.12);
    }

    .code-title {
        background: #1e293b;
        color: #ffffff;
        padding: 12px 18px;
        font-weight: 600;
        border-bottom: 1px solid #334155;
    }

    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }

    .code-card code {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.7;
    }

    .output-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 10px;
        padding: 18px;
        margin-top: 20px;
        color: #334155;
    }

    .output-preview {
        background: #ffffff;
        border: 1px dashed #c4b5fd;
        border-radius: 8px;
        padding: 16px;
        margin-top: 12px;
    }

    .binding-flow {
        display: flex;
        justify-content: center;
        align-items: stretch;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .binding-item {
        min-width: 180px;
        padding: 18px;
        border: 1px solid #ddd6fe;
        background: #f8fafc;
        border-radius: 10px;
        text-align: center;
    }

        .binding-item h5 {
            color: #2e1065;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .binding-item code {
            color: #4c1d95;
            font-weight: 600;
        }

    .syntax-table {
        margin-top: 20px;
        overflow-x: auto;
    }

        .syntax-table table {
            min-width: 700px;
        }

        .syntax-table th {
            background: #4c1d95;
            color: #ffffff;
            font-weight: 600;
            padding: 14px;
        }

        .syntax-table td {
            padding: 13px;
            vertical-align: middle;
            color: #334155;
        }

        .syntax-table tr:nth-child(even) {
            background: #f8fafc;
        }

    .student-preview {
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #ddd6fe;
    }

        .student-preview h5 {
            color: #2e1065;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .student-preview strong {
            color: #4c1d95;
        }

    .best-practice-list {
        display: grid;
        gap: 15px;
        margin-top: 20px;
    }

        .best-practice-list > div {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 18px 20px;
        }

        .best-practice-list strong {
            color: #2e1065;
        }

        .best-practice-list p {
            color: #64748b;
