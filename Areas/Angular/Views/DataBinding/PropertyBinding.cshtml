@{
    ViewData["Title"] = "Property Binding";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Property Binding</h1>
        <p class="lead text-muted">
            Learn how Angular uses property binding to connect component data
            with HTML element properties dynamically.
        </p>
    </section>

    <!-- What is Property Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">What is Property Binding?</h2>

        <div class="info-card">
            <p>
                Property binding is an Angular data binding technique used to
                set the properties of HTML elements, components, or directives
                using values from the component.
            </p>

            <p class="mb-0">
                Property binding uses square brackets
                <code>[property]</code> to bind a component value to an
                element property.
            </p>
        </div>
    </section>

    <!-- Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Property Binding Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <div class="syntax-icon">1</div>
                <h5>Component</h5>
                <p>Component contains the value.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">2</div>
                <h5>Property</h5>
                <p>HTML property is selected for binding.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">3</div>
                <h5>Binding</h5>
                <p>Angular connects the value with the property.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">4</div>
                <h5>UI</h5>
                <p>The element reflects the bound value.</p>
            </div>

        </div>
    </section>

    <!-- Main Concepts -->
    <section class="mb-4">
        <h2 class="fw-bold">Main Property Binding Concepts</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">A</div>
                <h5>Attribute Properties</h5>
                <p>
                    Bind values to common HTML element properties.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">D</div>
                <h5>Disabled State</h5>
                <p>
                    Dynamically enable or disable an element.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">I</div>
                <h5>Image Source</h5>
                <p>
                    Dynamically set an image source using component data.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">C</div>
                <h5>Class Binding</h5>
                <p>
                    Dynamically apply CSS classes to elements.
                </p>
            </div>

        </div>
    </section>

    <!-- Basic Syntax -->
    <section class="mb-4">
        <h2 class="fw-bold">Property Binding Syntax</h2>

        <p>
            Property binding uses square brackets around the property name.
        </p>

        <div class="code-card">
            <div class="code-title">Basic Syntax</div>

            <pre><code>&lt;element [property]="expression"&gt;
&lt;/element&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                Angular evaluates the expression on the right side and assigns
                the result to the specified property.
            </p>
        </div>
    </section>

    <!-- Disabled -->
    <section class="mb-4">
        <h2 class="fw-bold">Binding the Disabled Property</h2>

        <p>
            Property binding can dynamically control whether a button is enabled
            or disabled.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>export class StudentComponent {

    isDisabled = true;

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;button [disabled]="isDisabled"&gt;
    Submit
&lt;/button&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <button class="btn btn-secondary" disabled>
                    Submit
                </button>
            </div>
        </div>
    </section>

    <!-- Image Source -->
    <section class="mb-4">
        <h2 class="fw-bold">Binding the Image Source</h2>

        <p>
            An image source can be dynamically assigned using property binding.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>export class StudentComponent {

    imageUrl = 'assets/images/student.png';

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;img
    [src]="imageUrl"
    alt="Student"&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                Angular reads the value of <code>imageUrl</code> and assigns it
                to the image element's <code>src</code> property.
            </p>
        </div>
    </section>

    <!-- Input Value -->
    <section class="mb-4">
        <h2 class="fw-bold">Binding the Input Value</h2>

        <p>
            Property binding can set the initial value of an input element.
        </p>

        <div class="code-card">
            <div class="code-title">Example</div>

            <pre><code>studentName = 'Sam';</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;input
    [value]="studentName"
    type="text"&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <input class="form-control"
                       type="text"
                       value="Sam"
                       readonly />
            </div>
        </div>
    </section>

    <!-- Class Property -->
    <section class="mb-4">
        <h2 class="fw-bold">Class Property Binding</h2>

        <p>
            A CSS class can be dynamically applied using class property binding.
        </p>

        <div class="code-card">
            <div class="code-title">Example</div>

            <pre><code>isActive = true;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;div [class.active]="isActive"&gt;
    Student Profile
&lt;/div&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                When <code>isActive</code> is true, Angular applies the
                <code>active</code> CSS class to the element.
            </p>
        </div>
    </section>

    <!-- Style Property -->
    <section class="mb-4">
        <h2 class="fw-bold">Style Property Binding</h2>

        <p>
            Individual CSS properties can also be dynamically bound.
        </p>

        <div class="code-card">
            <div class="code-title">Example</div>

            <pre><code>fontSize = '20px';</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p [style.font-size]="fontSize"&gt;
    Angular Full Stack
&lt;/p&gt;</code></pre>
        </div>
    </section>

    <!-- Component Property -->
    <section class="mb-4">
        <h2 class="fw-bold">Binding to Component Properties</h2>

        <p>
            Property binding can also be used with custom component properties.
        </p>

        <div class="code-card">
            <div class="code-title">Parent Component</div>

            <pre><code>studentName = 'Sam';
studentCourse = 'Angular Full Stack';</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;app-student
    [name]="studentName"
    [course]="studentCourse"&gt;
&lt;/app-student&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                Here the parent component sends values to the child component
                through property binding.
            </p>
        </div>
    </section>

    <!-- Property Binding Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Property Binding Data Flow</h2>

        <div class="binding-flow">

            <div class="binding-item">
                <h5>Component</h5>
                <code>isDisabled = true</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Binding</h5>
                <code>[disabled]</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Angular</h5>
                <code>Evaluate</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Element</h5>
                <code>disabled</code>
            </div>

        </div>
    </section>

    <!-- Interpolation vs Property -->
    <section class="mb-4">
        <h2 class="fw-bold">Interpolation vs Property Binding</h2>

        <div class="syntax-table">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Feature</th>
                        <th>Interpolation</th>
                        <th>Property Binding</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Syntax</td>
                        <td><code>&#123;&#123; value &#125;&#125;</code></td>
                        <td><code>[property]="value"</code></td>
                    </tr>

                    <tr>
                        <td>Purpose</td>
                        <td>Display text</td>
                        <td>Set element properties</td>
                    </tr>

                    <tr>
                        <td>Direction</td>
                        <td>Component → Template</td>
                        <td>Component → Element</td>
                    </tr>

                    <tr>
                        <td>Example</td>
                        <td><code>&#123;&#123; studentName &#125;&#125;</code></td>
                        <td><code>[disabled]="isDisabled"</code></td>
                    </tr>

                    <tr>
                        <td>Common Usage</td>
                        <td>Text content</td>
                        <td>Element behavior and properties</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Common Uses -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Uses of Property Binding</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">1</div>
                <h5>Button State</h5>
                <p>
                    Enable or disable buttons dynamically.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">2</div>
                <h5>Images</h5>
                <p>
                    Dynamically assign image source values.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">3</div>
                <h5>Form Controls</h5>
                <p>
                    Bind values and states of form elements.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">4</div>
                <h5>CSS Classes</h5>
                <p>
                    Dynamically apply classes and styles.
                </p>
            </div>

        </div>
    </section>

    <!-- Complete Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete Property Binding Example</h2>

        <div class="code-card">
            <div class="code-title">Student Component</div>

            <pre><code>export class StudentComponent {

    studentName = 'Sam';
    isDisabled = false;
    imageUrl = 'assets/images/student.png';

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Student Template</div>

            <pre><code>&lt;div&gt;

    &lt;h2&gt;
        &#123;&#123; studentName &#125;&#125;
    &lt;/h2&gt;

    &lt;input
        [value]="studentName"
        type="text"&gt;

    &lt;button
        [disabled]="isDisabled"&gt;

        Submit

    &lt;/button&gt;

    &lt;img
        [src]="imageUrl"
        alt="Student"&gt;

&lt;/div&gt;</code></pre>
        </div>

        <div class="student-preview">
            <h5>Student Profile</h5>

            <p>
                <strong>Name:</strong> Sam
            </p>

            <input class="form-control mb-3"
                   type="text"
                   value="Sam"
                   readonly />

            <button class="btn btn-primary">
                Submit
            </button>
        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Best Practices</h2>

        <div class="best-practice-list">

            <div>
                <strong>1. Use property binding for element properties</strong>
                <p>
                    Use square bracket syntax when dynamically setting an
                    element property.
                </p>
            </div>

            <div>
                <strong>2. Keep binding expressions simple</strong>
                <p>
                    Avoid complex logic directly inside property bindings.
                </p>
            </div>

            <div>
                <strong>3. Use interpolation for text</strong>
                <p>
                    When you only need to display text, interpolation is often
                    the clearer choice.
                </p>
            </div>

            <div>
                <strong>4. Use meaningful property names</strong>
                <p>
                    Clear component property names make bindings easier to
                    understand.
                </p>
            </div>

            <div>
                <strong>5. Avoid unnecessary bindings</strong>
                <p>
                    Add bindings only where the UI actually depends on
                    component data.
                </p>
            </div>

        </div>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <div class="summary-box">
            <h4 class="fw-bold">Summary</h4>

            <ul class="mb-0">
                <li>Property binding connects component data with element properties.</li>
                <li>It uses square bracket syntax such as <code>[disabled]</code>.</li>
                <li>It can dynamically control element states and values.</li>
                <li>Property binding can be used with HTML elements and components.</li>
                <li>Class and style properties can also be dynamically bound.</li>
                <li>Property binding is a one-way data binding technique.</li>
            </ul>
        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Interpolation", "DataBinding", new { area = "Angular" })">
            ← Interpolation Binding
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("EventBinding", "DataBinding", new { area = "Angular" })">
            Event Binding →
        </a>

    </div>

</div>

<style>
    .info-card {
        background: #f8fafc;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        color: #334155;
    }

    .syntax-flow {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .syntax-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        width: 190px;
    }

        .syntax-box h5 {
            color: #2e1065;
            font-weight: 700;
            margin-top: 12px;
        }

        .syntax-box p {
            color: #64748b;
            margin-bottom: 0;
            font-size: 14px;
        }

    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 auto 12px;
    }

    .syntax-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4c1d95;
        font-size: 28px;
        font-weight: 700;
    }

    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        transition: all 0.2s ease;
    }

        .syntax-card:hover {
            transform: translateY(-3px);
            border-color: #c4b5fd;
            box-shadow: 0 8px 20px rgba(76, 29, 149, 0.08);
        }

        .syntax-card h5 {
            color: #2e1065;
            font-weight: 700;
        }

        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
        }

    .code-card {
        margin-top: 20px;
        border-radius: 12px;
        overflow: hidden;
        background: #0f172a;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.12);
    }

    .code-title {
        background: #1e293b;
        color: #ffffff;
        padding: 12px 18px;
        font-weight: 600;
        border-bottom: 1px solid #334155;
    }

    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }

    .code-card code {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.7;
    }

    .output-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 10px;
        padding: 18px;
        margin-top: 20px;
        color: #334155;
    }

    .output-preview {
        background: #ffffff;
        border: 1px dashed #c4b5fd;
        border-radius: 8px;
        padding: 16px;
        margin-top: 12px;
    }

    .binding-flow {
        display: flex;
        justify-content: center;
