        }

    @@media (max-width: 991px) {
        .syntax-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syntax-flow {
            flex-direction: column;
            align-items: center;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }
    }

    @@media (max-width: 576px) {
        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-box {
            width: 100%;
        }

        .binding-flow {
            flex-direction: column;
        }

        .binding-item {
            width: 100%;
        }

        .syntax-table {
            font-size: 14px;
        }

        .code-card code {
            font-size: 13px;
        }
    }
</style>