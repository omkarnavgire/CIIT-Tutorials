@{
    ViewData["Title"] = "Event Binding";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Event Binding</h1>
        <p class="lead text-muted">
            Learn how Angular uses event binding to respond to user actions
            and send event information from the template to the component.
        </p>
    </section>

    <!-- What is Event Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">What is Event Binding?</h2>

        <div class="info-card">
            <p>
                Event binding is an Angular data binding technique used to
                listen for user actions such as clicks, typing, mouse events,
                and keyboard events.
            </p>

            <p class="mb-0">
                It uses parentheses <code>(event)</code> around the event name
                to connect an HTML event with a component method.
            </p>
        </div>
    </section>

    <!-- Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Event Binding Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <div class="syntax-icon">1</div>
                <h5>User Action</h5>
                <p>The user performs an action on the UI.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">2</div>
                <h5>Event</h5>
                <p>Browser generates an event.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">3</div>
                <h5>Binding</h5>
                <p>Angular connects the event to a handler.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">4</div>
                <h5>Component</h5>
                <p>The component method handles the event.</p>
            </div>

        </div>
    </section>

    <!-- Main Concepts -->
    <section class="mb-4">
        <h2 class="fw-bold">Main Event Binding Concepts</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">C</div>
                <h5>Click Event</h5>
                <p>
                    Respond to button and element click actions.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">I</div>
                <h5>Input Event</h5>
                <p>
                    Respond when the value of an input changes.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">K</div>
                <h5>Keyboard Event</h5>
                <p>
                    Handle keyboard actions such as key presses.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">M</div>
                <h5>Mouse Event</h5>
                <p>
                    Respond to mouse interactions with elements.
                </p>
            </div>

        </div>
    </section>

    <!-- Basic Syntax -->
    <section class="mb-4">
        <h2 class="fw-bold">Event Binding Syntax</h2>

        <p>
            Event binding uses parentheses around the event name.
        </p>

        <div class="code-card">
            <div class="code-title">Basic Syntax</div>

            <pre><code>&lt;element (event)="handler()"&gt;
&lt;/element&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                When the specified event occurs, Angular executes the
                expression or method written inside the event binding.
            </p>
        </div>
    </section>

    <!-- Click -->
    <section class="mb-4">
        <h2 class="fw-bold">Click Event</h2>

        <p>
            The <code>click</code> event is commonly used to respond to
            button clicks.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>export class StudentComponent {

    showMessage() {

        console.log('Button clicked');

    }

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;button (click)="showMessage()"&gt;
    Show Message
&lt;/button&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <button class="btn btn-primary">
                    Show Message
                </button>
            </div>
        </div>
    </section>

    <!-- Inline Statement -->
    <section class="mb-4">
        <h2 class="fw-bold">Event Binding with an Expression</h2>

        <p>
            A simple statement can also be written directly inside the
            event binding.
        </p>

        <div class="code-card">
            <div class="code-title">Example</div>

            <pre><code>&lt;button
    (click)="message = 'Hello Sam!'"&gt;

    Click Me

&lt;/button&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                When the button is clicked, Angular updates the component
                property <code>message</code>.
            </p>
        </div>
    </section>

    <!-- Input -->
    <section class="mb-4">
        <h2 class="fw-bold">Input Event</h2>

        <p>
            The <code>input</code> event occurs whenever the value entered
            in an input control changes.
        </p>

        <div class="code-card">
            <div class="code-title">Example</div>

            <pre><code>&lt;input
    (input)="onInput($event)"
    placeholder="Enter student name"&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>onInput(event: Event) {

    console.log(
        (event.target as HTMLInputElement).value
    );

}</code></pre>
        </div>
    </section>

    <!-- Event Object -->
    <section class="mb-4">
        <h2 class="fw-bold">Event Object</h2>

        <p>
            Angular provides the browser event object through the special
            <code>$event</code> variable.
        </p>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;button (click)="handleClick($event)"&gt;
    Click Me
&lt;/button&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>handleClick(event: MouseEvent) {

    console.log(event);

}</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                The <code>$event</code> object contains information about
                the event that occurred.
            </p>
        </div>
    </section>

    <!-- Keyboard -->
    <section class="mb-4">
        <h2 class="fw-bold">Keyboard Events</h2>

        <p>
            Angular can listen to keyboard events such as
            <code>keyup</code> and <code>keydown</code>.
        </p>

        <div class="code-card">
            <div class="code-title">Keyup Example</div>

            <pre><code>&lt;input
    (keyup)="onKeyUp($event)"
    placeholder="Type something"&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>onKeyUp(event: KeyboardEvent) {

    console.log(event.key);

}</code></pre>
        </div>
    </section>

    <!-- Mouse -->
    <section class="mb-4">
        <h2 class="fw-bold">Mouse Events</h2>

        <p>
            Mouse events can be used to respond to user interactions such as
            entering or leaving an element.
        </p>

        <div class="code-card">
            <div class="code-title">Mouse Event Example</div>

            <pre><code>&lt;div
    (mouseenter)="showMessage()"
    (mouseleave)="hideMessage()"&gt;

    Student Profile

&lt;/div&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                Common mouse events include
                <code>click</code>, <code>mouseenter</code>,
                <code>mouseleave</code>, <code>mousedown</code>,
                and <code>mouseup</code>.
            </p>
        </div>
    </section>

    <!-- Passing Parameters -->
    <section class="mb-4">
        <h2 class="fw-bold">Passing Parameters to Methods</h2>

        <p>
            Event binding can call a method and pass additional values.
        </p>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;button
    (click)="selectStudent('Sam')"&gt;

    Select Student

&lt;/button&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>selectStudent(name: string) {

    console.log(
        'Selected: ' + name
    );

}</code></pre>
        </div>

        <div class="output-box">
            <strong>Example Output:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    Selected: Sam
                </p>
            </div>
        </div>
    </section>

    <!-- Event Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Event Data Flow</h2>

        <div class="binding-flow">

            <div class="binding-item">
                <h5>User</h5>
                <code>Click Button</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Browser</h5>
                <code>click event</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Angular</h5>
                <code>(click)</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Component</h5>
                <code>showMessage()</code>
            </div>

        </div>
    </section>

    <!-- Event Types -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Angular Events</h2>

        <div class="syntax-table">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Syntax</th>
                        <th>Common Usage</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Click</td>
                        <td><code>(click)</code></td>
                        <td>Button and element clicks</td>
                    </tr>

                    <tr>
                        <td>Input</td>
                        <td><code>(input)</code></td>
                        <td>Input value changes</td>
                    </tr>

                    <tr>
                        <td>Change</td>
                        <td><code>(change)</code></td>
                        <td>Control value changes</td>
                    </tr>

                    <tr>
                        <td>Keyup</td>
                        <td><code>(keyup)</code></td>
                        <td>Keyboard release</td>
                    </tr>

                    <tr>
                        <td>Keydown</td>
                        <td><code>(keydown)</code></td>
                        <td>Keyboard press</td>
                    </tr>

                    <tr>
                        <td>Mouse Enter</td>
                        <td><code>(mouseenter)</code></td>
                        <td>Mouse enters element</td>
                    </tr>

                    <tr>
                        <td>Mouse Leave</td>
                        <td><code>(mouseleave)</code></td>
                        <td>Mouse leaves element</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Event Binding vs Property Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">Property Binding vs Event Binding</h2>

        <div class="syntax-table">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Feature</th>
                        <th>Property Binding</th>
                        <th>Event Binding</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Syntax</td>
                        <td><code>[property]</code></td>
                        <td><code>(event)</code></td>
                    </tr>

                    <tr>
                        <td>Direction</td>
                        <td>Component → Template</td>
                        <td>Template → Component</td>
                    </tr>

                    <tr>
                        <td>Purpose</td>
                        <td>Set element properties</td>
                        <td>Handle user events</td>
                    </tr>

                    <tr>
                        <td>Example</td>
                        <td><code>[disabled]="isDisabled"</code></td>
                        <td><code>(click)="showMessage()"</code></td>
                    </tr>

                    <tr>
                        <td>Common Usage</td>
                        <td>Dynamic element state</td>
                        <td>User interaction</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Common Uses -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Uses of Event Binding</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">1</div>
                <h5>Button Actions</h5>
                <p>
                    Execute component methods when buttons are clicked.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">2</div>
                <h5>Form Input</h5>
                <p>
                    Respond to changes in input controls.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">3</div>
                <h5>Keyboard Actions</h5>
                <p>
                    Handle keyboard events from users.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">4</div>
                <h5>Mouse Actions</h5>
                <p>
                    Respond to mouse interactions.
                </p>
            </div>

        </div>
    </section>

    <!-- Complete Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete Event Binding Example</h2>

        <div class="code-card">
            <div class="code-title">Student Component</div>

            <pre><code>export class StudentComponent {

    studentName = 'Sam';
    message = '';

    showStudent() {

        this.message =
            'Student: ' + this.studentName;

    }

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Student Template</div>

            <pre><code>&lt;h2&gt;
    &#123;&#123; studentName &#125;&#125;
&lt;/h2&gt;

&lt;button
    (click)="showStudent()"&gt;

    Show Student

&lt;/button&gt;

&lt;p&gt;
    &#123;&#123; message &#125;&#125;
&lt;/p&gt;</code></pre>
        </div>

        <div class="student-preview">
            <h5>Student Details</h5>

            <p>
                <strong>Name:</strong> Sam
            </p>

            <button class="btn btn-primary">
                Show Student
            </button>

            <p class="mt-3 mb-0">
                Student: Sam
            </p>
        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Best Practices</h2>

        <div class="best-practice-list">

            <div>
                <strong>1. Use meaningful event handlers</strong>
                <p>
                    Use clear method names such as
                    <code>showStudent()</code> or <code>submitForm()</code>.
                </p>
            </div>

            <div>
                <strong>2. Keep event handlers simple</strong>
                <p>
                    Avoid putting large amounts of business logic directly
                    inside template event expressions.
                </p>
            </div>

            <div>
                <strong>3. Use $event when event information is required</strong>
                <p>
                    Pass <code>$event</code> when the component needs details
                    about the browser event.
                </p>
            </div>

            <div>
                <strong>4. Avoid unnecessary event handlers</strong>
                <p>
                    Add event bindings only when the UI needs to respond to
                    that particular user action.
                </p>
            </div>

            <div>
                <strong>5. Keep component methods reusable</strong>
                <p>
                    Move reusable application logic into component methods or
                    services instead of duplicating it in templates.
                </p>
            </div>

        </div>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <div class="summary-box">
            <h4 class="fw-bold">Summary</h4>

            <ul class="mb-0">
                <li>Event binding connects user actions with component logic.</li>
                <li>It uses parentheses such as <code>(click)</code>.</li>
                <li>Angular supports mouse, keyboard, input, and other browser events.</li>
                <li><code>$event</code> provides access to the event object.</li>
                <li>Event binding generally moves information from the template to the component.</li>
                <li>Event binding makes Angular applications interactive.</li>
            </ul>
        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("PropertyBinding", "DataBinding", new { area = "Angular" })">
            ← Property Binding
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("TwoWayBinding", "DataBinding", new { area = "Angular" })">
            Two-Way Data Binding →
        </a>

    </div>

</div>

<style>
    .info-card {
        background: #f8fafc;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        color: #334155;
    }

    .syntax-flow {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .syntax-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        width: 190px;
    }

        .syntax-box h5 {
            color: #2e1065;
            font-weight: 700;
            margin-top: 12px;
        }

        .syntax-box p {
            color: #64748b;
            margin-bottom: 0;
            font-size: 14px;
        }

    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 auto 12px;
    }

    .syntax-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4c1d95;
        font-size: 28px;
        font-weight: 700;
    }

    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        transition: all 0.2s ease;
    }

        .syntax-card:hover {
            transform: translateY(-3px);
            border-color: #c4b5fd;
            box-shadow: 0 8px 20px rgba(76, 29, 149, 0.08);
        }

        .syntax-card h5 {
            color: #2e1065;
            font-weight: 700;
        }

        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
        }

    .code-card {
        margin-top: 20px;
        border-radius: 12px;
        overflow: hidden;
        background: #0f172a;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.12);
    }

    .code-title {
        background: #1e293b;
        color: #ffffff;
        padding: 12px 18px;
        font-weight: 600;
        border-bottom: 1px solid #334155;
    }

    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }

    .code-card code {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.7;
    }

    .output-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 10px;
        padding: 18px;
        margin-top: 20px;
        color: #334155;
    }

    .output-preview {
        background: #ffffff;
        border: 1px dashed #c4b5fd;
        border-radius: 8px;
        padding: 16px;
        margin-top: 12px;
    }

    .binding-flow {
        display: flex;
        justify-content: center;
        align-items: stretch;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .binding-item {
        min-width: 180px;
        padding: 18px;
        border: 1px solid #ddd6fe;
        background: #f8fafc;
        border-radius: 10px;
        text-align: center;
    }

        .binding-item h5 {
            color: #2e1065;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .binding-item code {
            color: #4c1d95;
            font-weight: 600;
        }

    .syntax-table {
        margin-top: 20px;
        overflow-x: auto;
    }

        .syntax-table table {
            min-width: 700px;
        }

        .syntax-table th {
            background: #4c1d95;
            color: #ffffff;
            font-weight: 600;
            padding: 14px;
        }

        .syntax-table td {
            padding: 13px;
            vertical-align: middle;
            color: #334155;
        }

        .syntax-table tr:nth-child(even) {
            background: #f8fafc;
        }

    .student-preview {
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #ddd6fe;
    }

        .student-preview h5 {
            color: #2e1065;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .student-preview strong {
            color: #4c1d95;
        }

    .best-practice-list {
        display: grid;
        gap: 15px;
        margin-top: 20px;
    }

        .best-practice-list > div {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 18px 20px;
        }

        .best-practice-list strong {
            color: #2e1065;
        }

        .best-practice-list p {
            color: #64748b;
            margin: 8px 0 0;
        }

    .summary-box {
        background: #cfe2ff;
        color: #084298;
        border-radius: 10px;
        padding: 22px;
    }

        .summary-box h4 {
            color: #084298;
        }

        .summary-box li {
            margin-bottom: 8px;
        }

    @@media (max-width: 991px) {
        .syntax-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syntax-flow {
            flex-direction: column;
            align-items: center;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }
    }

    @@media (max-width: 576px) {
        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-box {
            width: 100%;
        }

        .binding-flow {
            flex-direction: column;
        }

        .binding-item {
            width: 100%;
        }

        .syntax-table {
            font-size: 14px;
        }

        .code-card code {
            font-size: 13px;
        }
    }
</style>