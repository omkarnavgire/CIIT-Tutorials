@{
    ViewData["Title"] = "Class & Style Binding";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Class &amp; Style Binding</h1>
        <p class="lead text-muted">
            Learn how Angular dynamically applies CSS classes and styles
            to HTML elements using class and style binding.
        </p>
    </section>

    <!-- What is Class & Style Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">What is Class &amp; Style Binding?</h2>

        <div class="info-card">
            <p>
                Class and style binding allow Angular to dynamically change
                the appearance of an HTML element based on component data.
            </p>

            <p class="mb-0">
                You can add or remove CSS classes, change individual styles,
                or apply multiple classes and styles dynamically.
            </p>
        </div>
    </section>

    <!-- Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Class &amp; Style Binding Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <div class="syntax-icon">1</div>
                <h5>Component Data</h5>
                <p>Define the value that controls the appearance.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">2</div>
                <h5>Binding</h5>
                <p>Bind class or style to the HTML element.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">3</div>
                <h5>Angular</h5>
                <p>Angular evaluates the binding expression.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">4</div>
                <h5>UI Update</h5>
                <p>The element appearance changes dynamically.</p>
            </div>

        </div>
    </section>

    <!-- Main Concepts -->
    <section class="mb-4">
        <h2 class="fw-bold">Main Concepts</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">C</div>
                <h5>Class Binding</h5>
                <p>
                    Dynamically add or remove a CSS class from an element.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">A</div>
                <h5>Conditional Class</h5>
                <p>
                    Apply a class when a condition is true.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">S</div>
                <h5>Style Binding</h5>
                <p>
                    Dynamically change an individual CSS style property.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">M</div>
                <h5>Multiple Styles</h5>
                <p>
                    Apply multiple dynamic styles to an element.
                </p>
            </div>

        </div>
    </section>

    <!-- Basic Class Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">Basic Class Binding</h2>

        <p>
            Use <code>[class.className]</code> to conditionally apply
            a CSS class.
        </p>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;div [class.active]="isActive"&gt;
    Student Profile
&lt;/div&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>How it works:</strong>

            <div class="output-preview">
                If <code>isActive</code> is true, Angular adds the
                <code>active</code> class to the element.
            </div>
        </div>
    </section>

    <!-- Conditional Class -->
    <section class="mb-4">
        <h2 class="fw-bold">Conditional Class Binding</h2>

        <p>
            Class binding is useful when the UI appearance depends on
            component data.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>isActive = true;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;div [class.active]="isActive"&gt;
    Active Student
&lt;/div&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Result:</strong>

            <div class="output-preview">
                When <code>isActive</code> is true, the
                <code>active</code> CSS class is applied.
            </div>
        </div>
    </section>

    <!-- Multiple Classes -->
    <section class="mb-4">
        <h2 class="fw-bold">Multiple Class Binding</h2>

        <p>
            The complete <code>class</code> attribute can also be
            dynamically generated.
        </p>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;div [class]="'student-card ' + cardClass"&gt;
    Student Information
&lt;/div&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>cardClass = 'premium';</code></pre>
        </div>

        <div class="output-box">
            <strong>Result:</strong>

            <div class="output-preview">
                Angular combines <code>student-card</code> and
                <code>premium</code> classes.
            </div>
        </div>
    </section>

    <!-- ngClass -->
    <section class="mb-4">
        <h2 class="fw-bold">Using ngClass</h2>

        <p>
            <code>ngClass</code> is useful when multiple CSS classes
            depend on different conditions.
        </p>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;div [ngClass]="{
    active: isActive,
    premium: isPremium
}"&gt;
    Student Profile
&lt;/div&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>isActive = true;
isPremium = false;</code></pre>
        </div>

        <div class="output-box">
            <strong>Result:</strong>

            <div class="output-preview">
                Angular applies <code>active</code> because
                <code>isActive</code> is true.
            </div>
        </div>
    </section>

    <!-- Style Binding -->
    <section class="mb-4">
        <h2 class="fw-bold">Style Binding</h2>

        <p>
            Style binding allows you to dynamically change an individual
            CSS property.
        </p>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;p [style.color]="textColor"&gt;
    Angular Full Stack
&lt;/p&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>textColor = 'purple';</code></pre>
        </div>

        <div class="output-box">
            <strong>Result:</strong>

            <div class="output-preview">
                The text color is controlled by the
                <code>textColor</code> property.
            </div>
        </div>
    </section>

    <!-- Style with Unit -->
    <section class="mb-4">
        <h2 class="fw-bold">Style Binding with Units</h2>

        <p>
            Angular also supports CSS units such as pixels using
            property binding syntax.
        </p>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;div [style.font-size.px]="fontSize"&gt;
    Angular Training
&lt;/div&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>fontSize = 22;</code></pre>
        </div>

        <div class="output-box">
            <strong>Result:</strong>

            <div class="output-preview">
                The font size becomes <code>22px</code>.
            </div>
        </div>
    </section>

    <!-- ngStyle -->
    <section class="mb-4">
        <h2 class="fw-bold">Using ngStyle</h2>

        <p>
            <code>ngStyle</code> can be used when several style values
            need to be supplied dynamically.
        </p>

        <div class="code-card">
            <div class="code-title">HTML</div>

            <pre><code>&lt;div [ngStyle]="{
    color: textColor,
    'font-size.px': fontSize
}"&gt;
    Angular Full Stack
&lt;/div&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Result:</strong>

            <div class="output-preview">
                Both color and font size are controlled by component values.
            </div>
        </div>
    </section>

    <!-- Binding Comparison -->
    <section class="mb-4">
        <h2 class="fw-bold">Class Binding vs Style Binding</h2>

        <div class="table-responsive">
            <table class="table syntax-table">
                <thead>
                    <tr>
                        <th>Binding</th>
                        <th>Purpose</th>
                        <th>Example</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td><code>[class.active]</code></td>
                        <td>Apply one class conditionally</td>
                        <td><code>[class.active]="isActive"</code></td>
                    </tr>

                    <tr>
                        <td><code>[class]</code></td>
                        <td>Set multiple classes</td>
                        <td><code>[class]="cardClass"</code></td>
                    </tr>

                    <tr>
                        <td><code>[ngClass]</code></td>
                        <td>Apply multiple conditional classes</td>
                        <td><code>[ngClass]="classes"</code></td>
                    </tr>

                    <tr>
                        <td><code>[style.color]</code></td>
                        <td>Set one style property</td>
                        <td><code>[style.color]="textColor"</code></td>
                    </tr>

                    <tr>
                        <td><code>[style.font-size.px]</code></td>
                        <td>Set style with unit</td>
                        <td><code>[style.font-size.px]="fontSize"</code></td>
                    </tr>

                    <tr>
                        <td><code>[ngStyle]</code></td>
                        <td>Apply multiple styles</td>
                        <td><code>[ngStyle]="styles"</code></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Complete Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete Student Example</h2>

        <div class="code-card">
            <div class="code-title">student.component.ts</div>

            <pre><code>export class StudentComponent {

    studentName = 'Pradnya';

    isActive = true;

    isPremium = true;

    textColor = 'purple';

    fontSize = 20;

    cardClass = 'student-card';

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">student.component.html</div>

            <pre><code>&lt;div
    [class.active]="isActive"
    [ngClass]="{
        premium: isPremium
    }"
    [style.color]="textColor"
    [style.font-size.px]="fontSize"&gt;

    &lt;h3&gt;{{studentName}}&lt;/h3&gt;

    &lt;p&gt;Angular Full Stack Student&lt;/p&gt;

&lt;/div&gt;</code></pre>
        </div>

        <div class="student-preview">
            <h4>Pradnya</h4>
            <p class="mb-0">
                Angular Full Stack Student
            </p>
        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Best Practices</h2>

        <ul class="best-practice-list">
            <li>Use class binding for reusable CSS styles.</li>
            <li>Use style binding for individual dynamic style properties.</li>
            <li>Keep complex styling logic inside the component when possible.</li>
            <li>Use meaningful CSS class names.</li>
            <li>Use <code>ngClass</code> when multiple conditional classes are required.</li>
            <li>Use <code>ngStyle</code> when multiple dynamic styles are required.</li>
            <li>Avoid putting unnecessary complex expressions directly in templates.</li>
        </ul>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <h2 class="fw-bold">Summary</h2>

        <div class="summary-box">
            <ul class="mb-0">
                <li>Class binding dynamically controls CSS classes.</li>
                <li><code>[class.className]</code> applies a class conditionally.</li>
                <li><code>[ngClass]</code> supports multiple conditional classes.</li>
                <li>Style binding dynamically controls CSS properties.</li>
                <li><code>[style.property]</code> binds an individual style.</li>
                <li><code>[style.property.unit]</code> supports CSS units.</li>
                <li><code>[ngStyle]</code> supports multiple dynamic styles.</li>
            </ul>
        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("TwoWayBinding", "DataBinding", new { area = "Angular" })">
            ← Previous
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("Index", "Directives", new { area = "Angular" })">
            Directives Introduction →
        </a>

    </div>

</div>

<style>

    .info-card {
        background: #f8fafc;
        border-left: 5px solid #4c1d95;
        padding: 20px;
        border-radius: 10px;
    }

    .syntax-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .syntax-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        width: 190px;
        min-height: 160px;
    }

    .syntax-icon {
        width: 45px;
        height: 45px;
        background: #4c1d95;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        font-weight: bold;
    }

    .syntax-arrow {
        font-size: 28px;
        font-weight: bold;
        color: #4c1d95;
    }

    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .syntax-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
