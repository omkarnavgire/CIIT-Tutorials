@{
    ViewData["Title"] = "Template Reference Variables";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Template Reference Variables</h1>

        <p class="lead text-muted">
            Angular Template Reference Variables provide a convenient way to
            create a reference to an HTML element, component, or directive
            inside an Angular template.
        </p>
    </section>

    <!-- What is Template Reference Variable -->
    <section class="mb-4">

        <h2 class="fw-bold">What is a Template Reference Variable?</h2>

        <p>
            A template reference variable is a variable created directly inside
            an Angular template using the <strong>#</strong> symbol.
        </p>

        <p>
            It provides a reference to an element or directive instance and
            allows other parts of the same template to access it.
        </p>

        <div class="info-card">

            <h5>Simple Definition</h5>

            <p>
                A Template Reference Variable gives a name to an element so
                that the template can access that element and its properties.
            </p>

        </div>

    </section>

    <!-- Reference Variable Flow -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Template Reference Variable Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-code-slash"></i>

                <strong>HTML Element</strong>

                <span>Input / Button</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-hash"></i>

                <strong>Reference</strong>

                <span>#studentInput</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-arrow-right-circle"></i>

                <strong>Template</strong>

                <span>Access Value</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-display"></i>

                <strong>UI</strong>

                <span>Display Result</span>

            </div>

        </div>

    </section>

    <!-- Main Concept -->
    <section class="mb-4">

        <h2 class="fw-bold">Template Reference Variable Syntax</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-input-cursor-text"></i>
                </div>

                <h5>Input Reference</h5>

                <p>
                    Creates a reference to an input element.
                </p>

                <code>#studentInput</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-file-text"></i>
                </div>

                <h5>Read Value</h5>

                <p>
                    Reads the current value of an input.
                </p>

                <code>studentInput.value</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-mouse-fill"></i>
                </div>

                <h5>Use in Event</h5>

                <p>
                    Passes the reference value to a method.
                </p>

                <code>(click)="showName(studentInput.value)"</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-eye"></i>
                </div>

                <h5>Display Data</h5>

                <p>
                    Displays the referenced value in the template.
                </p>

                <code>&#123;&#123; studentInput.value &#125;&#125;</code>

            </div>

        </div>

    </section>

    <!-- Basic Reference -->
    <section class="mb-4">

        <h2 class="fw-bold">1. Creating a Template Reference Variable</h2>

        <p>
            A template reference variable is created by adding the
            <strong>#</strong> symbol followed by a variable name.
        </p>

        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>&lt;input #studentInput placeholder="Enter student name"&gt;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                The <code>#studentInput</code> variable creates a reference to
                the input element. The template can then access properties of
                that input using <code>studentInput</code>.
            </p>

        </div>

    </section>

    <!-- Access Value -->
    <section class="mb-4">

        <h2 class="fw-bold">2. Accessing Input Value</h2>

        <p>
            Once a reference variable is created, the template can access
            the current value of the referenced input element.
        </p>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;input #studentInput placeholder="Enter student name"&gt;

&lt;p&gt;
    Student Name:
    &#123;&#123; studentInput.value &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Behavior:</strong>

            <div class="output-preview">

                <p>
                    If the user enters <strong>Sam</strong>:
                </p>

                <p>
                    Student Name: Sam
                </p>

            </div>

        </div>

    </section>

    <!-- Button -->
    <section class="mb-4">

        <h2 class="fw-bold">3. Using Reference Variable with Button</h2>

        <p>
            A template reference variable can be used inside an event
            statement to pass the current input value to a method.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>export class StudentComponent {

    message = '';

    showName(name: string) {
        this.message = 'Welcome ' + name;
    }

}</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;input #studentInput placeholder="Enter student name"&gt;

&lt;button (click)="showName(studentInput.value)"&gt;
    Show Name
&lt;/button&gt;

&lt;p&gt;
    &#123;&#123; message &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Behavior:</strong>

            <div class="output-preview">

                <p>
                    Enter:
                    <strong>Sam</strong>
                </p>

                <p>
                    After clicking the button:
                    <strong>Welcome Sam</strong>
                </p>

            </div>

        </div>

    </section>

    <!-- Multiple References -->
    <section class="mb-4">

        <h2 class="fw-bold">4. Multiple Template Reference Variables</h2>

        <p>
            Multiple elements in the same template can have their own
            reference variables.
        </p>

        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>&lt;input #studentName placeholder="Student Name"&gt;

&lt;input #studentCourse placeholder="Course"&gt;

&lt;button
    (click)="
        showStudent(
            studentName.value,
            studentCourse.value
        )
    "&gt;
    Show Student
&lt;/button&gt;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                The template creates two references:
                <code>#studentName</code> and
                <code>#studentCourse</code>.
                Their values can be passed to a component method.
            </p>

        </div>

    </section>

    <!-- Form Example -->
    <section class="mb-4">

        <h2 class="fw-bold">5. Template Reference Variable with Form</h2>

        <p>
            Template reference variables are also commonly used with forms
            and form controls.
        </p>

        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>&lt;form #studentForm="ngForm"&gt;

    &lt;input
        name="studentName"
        ngModel
        placeholder="Enter student name"&gt;

    &lt;button
        type="submit"
        [disabled]="studentForm.invalid"&gt;
        Submit
    &lt;/button&gt;

&lt;/form&gt;</code></pre>

        </div>

        <div class="info-card">

            <h5>Important</h5>

            <p>
                When a reference variable is assigned to a directive such as
                <code>ngForm</code>, the reference can provide access to the
                directive instance and its properties.
            </p>

        </div>

    </section>

    <!-- Component Reference -->
    <section class="mb-4">

        <h2 class="fw-bold">6. Referencing an Angular Component</h2>

        <p>
            A template reference variable can also be used to reference an
            Angular component instance.
        </p>

        <div class="code-card">

            <div class="code-title">
                Parent Template
            </div>

            <pre><code>&lt;app-student #studentComponent&gt;
&lt;/app-student&gt;

&lt;button (click)="studentComponent.showStudent()"&gt;
    Show Student
&lt;/button&gt;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                The <code>#studentComponent</code> reference points to the
                component instance, allowing the template to access its
                available public members.
            </p>

        </div>

    </section>

    <!-- Reference vs Component Property -->
    <section class="mb-4">

        <h2 class="fw-bold">Template Reference Variable vs Component Property</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>
                        <th>Feature</th>
                        <th>Template Reference Variable</th>
                        <th>Component Property</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>Created Where?</td>
                        <td>Inside template</td>
                        <td>Inside component class</td>
                    </tr>

                    <tr>
                        <td>Syntax</td>
                        <td><code>#studentInput</code></td>
                        <td><code>studentName = 'Sam'</code></td>
                    </tr>

                    <tr>
                        <td>Purpose</td>
                        <td>Reference an element or directive</td>
                        <td>Store application data</td>
                    </tr>

                    <tr>
                        <td>Access</td>
                        <td>Template</td>
                        <td>Component and template</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Common Examples -->
    <section class="mb-4">

        <h2 class="fw-bold">Common Template Reference Examples</h2>

        <div class="control-flow-grid">

            <div class="control-card">

                <h5>Input Element</h5>

                <div class="code-small">

                    <pre><code>&lt;input #studentInput&gt;</code></pre>

                </div>

            </div>

            <div class="control-card">

                <h5>Read Value</h5>

                <div class="code-small">

                    <pre><code>studentInput.value</code></pre>

                </div>

            </div>

            <div class="control-card">

                <h5>Button Event</h5>

                <div class="code-small">

                    <pre><code>(click)="show(studentInput.value)"</code></pre>

                </div>

            </div>

            <div class="control-card">

                <h5>Form Reference</h5>

                <div class="code-small">

                    <pre><code>&lt;form #studentForm="ngForm"&gt;</code></pre>

                </div>

            </div>

        </div>

    </section>

    <!-- Complete Example -->
    <section class="mb-4">

        <h2 class="fw-bold">Complete Template Reference Variable Example</h2>

        <div class="code-card">

            <div class="code-title">
                student.component.ts
            </div>

            <pre><code>export class StudentComponent {

    message = '';

    showStudent(name: string) {
        this.message = 'Welcome ' + name;
    }

}</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                student.component.html
            </div>

            <pre><code>&lt;h2&gt;
    Student Information
&lt;/h2&gt;

&lt;input
    #studentInput
    placeholder="Enter student name"&gt;

&lt;button
    (click)="showStudent(studentInput.value)"&gt;
    Show Student
&lt;/button&gt;

&lt;p&gt;
    &#123;&#123; message &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>Student Information</h3>

                <p>
                    Enter:
                    <strong>Sam</strong>
                </p>

                <button class="btn btn-primary btn-sm">
                    Show Student
                </button>

                <p class="mt-3">
                    <strong>Welcome Sam</strong>
                </p>

            </div>

        </div>

    </section>

    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">Template Reference Variable Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Use meaningful names for template reference variables.
            </li>

            <li>
                Use reference variables when template-level access is required.
            </li>

            <li>
                Avoid creating unnecessary references.
            </li>

            <li>
                Use component properties for application-level data.
            </li>

            <li>
                Keep template logic simple and readable.
            </li>

            <li>
                Use reference variables carefully when working with forms
                and component instances.
            </li>

        </ul>

    </section>

    <!-- Summary -->
    <section class="summary-box">

        <h3>Summary</h3>

        <p>
            Angular Template Reference Variables provide a convenient way to
            reference HTML elements, directives, forms, and component instances
            directly inside a template.
        </p>

        <p>
            They are created using the
            <strong>#</strong>
            symbol and can be used to access values and call available
            functionality from the referenced object.
        </p>

        <p>
            Template reference variables are especially useful for
            <strong>input elements</strong>,
            <strong>forms</strong>,
            <strong>event handling</strong> and
            <strong>component references</strong>.
        </p>

    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("TemplateStatements", "Templates", new { area = "Angular" })">
            ← Template Statements
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("NgTemplate", "Templates", new { area = "Angular" })">
            NgTemplate →
        </a>

    </div>

</div>

<style>

