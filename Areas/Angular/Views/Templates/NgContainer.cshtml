@{
    ViewData["Title"] = "ng-container";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">ng-container</h1>
        <p class="lead text-muted">
            Learn how Angular uses <code>ng-container</code> to group elements
            without adding an extra element to the DOM.
        </p>
    </section>

    <!-- What is ng-container -->
    <section class="mb-4">
        <h2 class="fw-bold">What is ng-container?</h2>

        <div class="info-card">
            <p>
                <code>ng-container</code> is an Angular element used to group
                multiple elements logically without creating an actual HTML
                element in the DOM.
            </p>

            <p class="mb-0">
                It is especially useful when Angular structural logic needs to
                be applied to multiple elements without adding an unnecessary
                wrapper such as <code>div</code>.
            </p>
        </div>
    </section>

    <!-- Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">ng-container Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <div class="syntax-icon">1</div>
                <h5>Group Elements</h5>
                <p>Place related elements inside an ng-container.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">2</div>
                <h5>Angular Processes</h5>
                <p>Angular evaluates the template logic.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">3</div>
                <h5>No Extra Element</h5>
                <p>The container itself is not added to the DOM.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">4</div>
                <h5>Rendered Content</h5>
                <p>Only the required child elements appear in the DOM.</p>
            </div>

        </div>
    </section>

    <!-- Main Concepts -->
    <section class="mb-4">
        <h2 class="fw-bold">Main Concepts</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">G</div>
                <h5>Logical Grouping</h5>
                <p>
                    Groups multiple elements without adding a wrapper element.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">D</div>
                <h5>No DOM Element</h5>
                <p>
                    The ng-container itself does not appear as an HTML element.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">C</div>
                <h5>Conditional Content</h5>
                <p>
                    Useful for applying Angular conditions to multiple elements.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">T</div>
                <h5>Template Control</h5>
                <p>
                    Helps organize Angular template logic cleanly.
                </p>
            </div>

        </div>
    </section>

    <!-- Basic Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Basic ng-container Example</h2>

        <p>
            The following example groups two paragraphs without adding an extra
            <code>div</code> element.
        </p>

        <div class="code-card">
            <div class="code-title">HTML Template</div>

            <pre><code>&lt;ng-container&gt;
    &lt;p&gt;Student Name: Sam&lt;/p&gt;
    &lt;p&gt;Course: Angular Full Stack&lt;/p&gt;
&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Result:</strong>

            <div class="output-preview">
                <p>Student Name: Sam</p>
                <p class="mb-0">Course: Angular Full Stack</p>
            </div>
        </div>
    </section>

    <!-- No Extra DOM Element -->
    <section class="mb-4">
        <h2 class="fw-bold">No Extra DOM Element</h2>

        <p>
            Unlike a normal <code>div</code>, the
            <code>ng-container</code> does not create an additional element
            in the rendered DOM.
        </p>

        <div class="code-card">
            <div class="code-title">Normal div</div>

            <pre><code>&lt;div&gt;
    &lt;p&gt;Hello Sam&lt;/p&gt;
&lt;/div&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">ng-container</div>

            <pre><code>&lt;ng-container&gt;
    &lt;p&gt;Hello Sam&lt;/p&gt;
&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                The <code>div</code> creates an actual DOM element, while
                <code>ng-container</code> acts as a logical grouping mechanism.
            </p>
        </div>
    </section>

    <!-- Conditional Rendering -->
    <section class="mb-4">
        <h2 class="fw-bold">ng-container with Conditional Rendering</h2>

        <p>
            One of the most useful scenarios is applying a condition to
            multiple elements.
        </p>

        <div class="code-card">
            <div class="code-title">Conditional Example</div>

            <pre><code>&lt;ng-container *ngIf="isStudent"&gt;
    &lt;h3&gt;Student Details&lt;/h3&gt;
    &lt;p&gt;Name: Sam&lt;/p&gt;
    &lt;p&gt;Course: Angular Full Stack&lt;/p&gt;
&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>When isStudent = true:</strong>

            <div class="output-preview">
                <h5 class="mb-2">Student Details</h5>
                <p>Name: Sam</p>
                <p class="mb-0">Course: Angular Full Stack</p>
            </div>
        </div>
    </section>

    <!-- Why ng-container -->
    <section class="mb-4">
        <h2 class="fw-bold">Why Use ng-container?</h2>

        <div class="binding-flow">

            <div class="binding-item">
                <h5>Problem</h5>
                <code>Extra div</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Solution</h5>
                <code>ng-container</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Result</h5>
                <code>Clean DOM</code>
            </div>

        </div>
    </section>

    <!-- Multiple Elements -->
    <section class="mb-4">
        <h2 class="fw-bold">Grouping Multiple Elements</h2>

        <p>
            A single condition can control multiple related elements.
        </p>

        <div class="code-card">
            <div class="code-title">Example</div>

            <pre><code>&lt;ng-container *ngIf="isLoggedIn"&gt;

    &lt;h3&gt;Welcome Sam&lt;/h3&gt;

    &lt;p&gt;You are successfully logged in.&lt;/p&gt;

    &lt;button class="btn btn-primary"&gt;
        View Profile
    &lt;/button&gt;

&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Concept:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    All three elements are controlled by the same condition
                    without requiring an additional wrapper element.
                </p>
            </div>
        </div>
    </section>

    <!-- ng-container and CSS -->
    <section class="mb-4">
        <h2 class="fw-bold">ng-container and CSS</h2>

        <p>
            Since <code>ng-container</code> does not create a normal DOM element,
            CSS styles cannot be applied to it like a regular HTML element.
        </p>

        <div class="code-card">
            <div class="code-title">Example</div>

            <pre><code>&lt;ng-container class="student-box"&gt;
    &lt;p&gt;Student: Sam&lt;/p&gt;
&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                The class <code>student-box</code> does not create a normal
                wrapper element. Apply styling to the actual HTML elements
                inside the container when needed.
            </p>
        </div>
    </section>

    <!-- ng-container vs div -->
    <section class="mb-4">
        <h2 class="fw-bold">ng-container vs div</h2>

        <div class="syntax-table">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Feature</th>
                        <th>ng-container</th>
                        <th>div</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Creates DOM element</td>
                        <td>No</td>
                        <td>Yes</td>
                    </tr>

                    <tr>
                        <td>Groups content</td>
                        <td>Yes</td>
                        <td>Yes</td>
                    </tr>

                    <tr>
                        <td>Can contain multiple elements</td>
                        <td>Yes</td>
                        <td>Yes</td>
                    </tr>

                    <tr>
                        <td>Useful for Angular template logic</td>
                        <td>Yes</td>
                        <td>Limited</td>
                    </tr>

                    <tr>
                        <td>Direct CSS styling</td>
                        <td>No</td>
                        <td>Yes</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Common Uses -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Uses of ng-container</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">1</div>
                <h5>Conditional Groups</h5>
                <p>
                    Apply one condition to multiple elements.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">2</div>
                <h5>Clean DOM</h5>
                <p>
                    Avoid unnecessary wrapper elements.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">3</div>
                <h5>Template Logic</h5>
                <p>
                    Organize Angular template conditions cleanly.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">4</div>
                <h5>Structural Directives</h5>
                <p>
                    Provide a logical host for Angular template operations.
                </p>
            </div>

        </div>
    </section>

    <!-- Complete Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete ng-container Example</h2>

        <div class="code-card">
            <div class="code-title">Student Dashboard</div>

            <pre><code>&lt;ng-container *ngIf="isLoggedIn"&gt;

    &lt;h2&gt;Student Dashboard&lt;/h2&gt;

    &lt;p&gt;
        Welcome Sam!
    &lt;/p&gt;

    &lt;p&gt;
        Course: Angular Full Stack
    &lt;/p&gt;

    &lt;button class="btn btn-primary"&gt;
        View Course
    &lt;/button&gt;

&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="student-preview">
            <h5>Student Dashboard</h5>

            <p>
                <strong>Welcome:</strong> Sam
            </p>

            <p>
                <strong>Course:</strong> Angular Full Stack
            </p>

            <button class="btn btn-primary">
                View Course
            </button>
        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Best Practices</h2>

        <div class="best-practice-list">

            <div>
                <strong>1. Use ng-container for logical grouping</strong>
                <p>
                    Use it when multiple elements need the same Angular template
                    logic.
                </p>
            </div>

            <div>
                <strong>2. Avoid unnecessary wrapper elements</strong>
                <p>
                    Use <code>ng-container</code> when an additional
                    <code>div</code> is not required.
                </p>
            </div>

            <div>
                <strong>3. Do not depend on ng-container for styling</strong>
                <p>
                    Style the actual HTML elements inside the container.
                </p>
            </div>

            <div>
                <strong>4. Keep template logic readable</strong>
                <p>
                    Use meaningful conditions and keep complex logic in the
                    component class.
                </p>
            </div>

            <div>
                <strong>5. Understand template rendering</strong>
                <p>
                    Remember that <code>ng-container</code> is a logical
                    Angular construct and not a visible HTML element.
                </p>
            </div>

        </div>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <div class="summary-box">
            <h4 class="fw-bold">Summary</h4>

            <ul class="mb-0">
                <li><code>ng-container</code> groups multiple elements logically.</li>
                <li>It does not create an additional DOM element.</li>
                <li>It is useful for conditional template rendering.</li>
                <li>It helps avoid unnecessary wrapper elements.</li>
                <li>It is useful when Angular template logic applies to multiple elements.</li>
                <li>CSS should be applied to the actual elements inside the container.</li>
            </ul>
        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("NgTemplate", "Templates", new { area = "Angular" })">
            ← NgTemplate
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("NgTemplateOutlet", "Templates", new { area = "Angular" })">
            NgTemplateOutlet →
        </a>

    </div>

</div>

<style>
    .info-card {
        background: #f8fafc;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        color: #334155;
    }

    .syntax-flow {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .syntax-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        width: 190px;
    }

        .syntax-box h5 {
            color: #2e1065;
            font-weight: 700;
            margin-top: 12px;
        }

        .syntax-box p {
            color: #64748b;
            margin-bottom: 0;
            font-size: 14px;
        }

    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 auto 12px;
    }

    .syntax-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4c1d95;
        font-size: 28px;
        font-weight: 700;
    }

    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        transition: all 0.2s ease;
    }

        .syntax-card:hover {
            transform: translateY(-3px);
            border-color: #c4b5fd;
            box-shadow: 0 8px 20px rgba(76, 29, 149, 0.08);
        }

        .syntax-card h5 {
            color: #2e1065;
            font-weight: 700;
        }

        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
        }

    .code-card {
        margin-top: 20px;
        border-radius: 12px;
        overflow: hidden;
        background: #0f172a;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.12);
    }

    .code-title {
        background: #1e293b;
        color: #ffffff;
        padding: 12px 18px;
        font-weight: 600;
        border-bottom: 1px solid #334155;
    }

    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }

    .code-card code {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.7;
    }

    .output-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 10px;
        padding: 18px;
        margin-top: 20px;
        color: #334155;
    }

    .output-preview {
        background: #ffffff;
        border: 1px dashed #c4b5fd;
        border-radius: 8px;
        padding: 16px;
        margin-top: 12px;
    }

    .binding-flow {
        display: flex;
        justify-content: center;
        align-items: stretch;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .binding-item {
        min-width: 180px;
        padding: 18px;
        border: 1px solid #ddd6fe;
        background: #f8fafc;
        border-radius: 10px;
        text-align: center;
    }

        .binding-item h5 {
            color: #2e1065;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .binding-item code {
            color: #4c1d95;
            font-weight: 600;
        }

    .syntax-table {
        margin-top: 20px;
        overflow-x: auto;
    }

        .syntax-table table {
            min-width: 700px;
        }

        .syntax-table th {
            background: #4c1d95;
            color: #ffffff;
            font-weight: 600;
            padding: 14px;
        }

        .syntax-table td {
            padding: 13px;
            vertical-align: middle;
            color: #334155;
        }

        .syntax-table tr:nth-child(even) {
            background: #f8fafc;
        }

    .student-preview {
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #ddd6fe;
    }

        .student-preview h5 {
            color: #2e1065;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .student-preview strong {
            color: #4c1d95;
        }

    .best-practice-list {
        display: grid;
        gap: 15px;
        margin-top: 20px;
    }

        .best-practice-list > div {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 18px 20px;
        }

        .best-practice-list strong {
            color: #2e1065;
        }

        .best-practice-list p {
            color: #64748b;
            margin: 8px 0 0;
        }

    .summary-box {
        background: #cfe2ff;
        color: #084298;
        border-radius: 10px;
        padding: 22px;
    }

        .summary-box h4 {
            color: #084298;
        }

        .summary-box li {
            margin-bottom: 8px;
        }

    @@media (max-width: 991px) {
        .syntax-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syntax-flow {
            flex-direction: column;
            align-items: center;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }
    }

    @@media (max-width: 576px) {
        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-box {
            width: 100%;
        }

        .binding-flow {
            flex-direction: column;
        }

        .binding-item {
            width: 100%;
        }

        .syntax-table {
            font-size: 14px;
        }

        .code-card code {
            font-size: 13px;
        }
    }
</style>