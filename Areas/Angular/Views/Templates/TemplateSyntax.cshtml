    }

    .style-preview {
        margin-top: 12px;
        font-size: 20px;
        font-weight: 600;
        color: #4c1d95;
    }

    .control-flow-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .control-card {
        padding: 20px;
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 8px;
    }

        .control-card h5 {
            color: #4c1d95;
            font-weight: 700;
            margin-bottom: 15px;
        }

    .code-small {
        background: #0f172a;
        border-radius: 7px;
        overflow: hidden;
    }

        .code-small pre {
            margin: 0;
            padding: 15px;
            overflow-x: auto;
        }

        .code-small code {
            color: #e2e8f0;
            font-size: 13px;
            line-height: 1.6;
        }

    .syntax-table {
        background: #ffffff;
    }

        .syntax-table thead th {
            background: #4c1d95;
            color: #ffffff;
            font-weight: 600;
        }

        .syntax-table td {
