    }

        .binding-item strong {
            display: block;
            color: #4c1d95;
            font-weight: 700;
        }

        .binding-item span {
            display: block;
            color: #64748b;
            font-size: 13px;
            margin-top: 5px;
        }

    .binding-arrow {
        color: #4c1d95;
        font-size: 25px;
        font-weight: 700;
    }

    .active-preview {
        margin-top: 12px;
