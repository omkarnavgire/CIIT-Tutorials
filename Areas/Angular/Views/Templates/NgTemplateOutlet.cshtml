@{
    ViewData["Title"] = "ngTemplateOutlet";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">ngTemplateOutlet</h1>
        <p class="lead text-muted">
            Learn how Angular uses <code>ngTemplateOutlet</code> to render a
            template dynamically and pass data into that template.
        </p>
    </section>

    <!-- What is ngTemplateOutlet -->
    <section class="mb-4">
        <h2 class="fw-bold">What is ngTemplateOutlet?</h2>

        <div class="info-card">
            <p>
                <code>ngTemplateOutlet</code> is an Angular directive used to
                display an existing <code>ng-template</code> dynamically.
            </p>

            <p class="mb-0">
                It is useful when the same template needs to be rendered in
                different places or when different data needs to be supplied
                to the same template.
            </p>
        </div>
    </section>

    <!-- Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">ngTemplateOutlet Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <div class="syntax-icon">1</div>
                <h5>Create Template</h5>
                <p>Define the reusable content inside ng-template.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">2</div>
                <h5>Reference Template</h5>
                <p>Give the template a reference variable.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">3</div>
                <h5>Outlet</h5>
                <p>Use ngTemplateOutlet to render the template.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">4</div>
                <h5>Display</h5>
                <p>Angular creates the template content in the page.</p>
            </div>

        </div>
    </section>

    <!-- Main Concepts -->
    <section class="mb-4">
        <h2 class="fw-bold">Main Concepts</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">T</div>
                <h5>Template</h5>
                <p>
                    Defines the HTML structure that can be rendered later.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">R</div>
                <h5>Reference</h5>
                <p>
                    Identifies the template using a reference variable.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">O</div>
                <h5>Outlet</h5>
                <p>
                    Renders the referenced template dynamically.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">C</div>
                <h5>Context</h5>
                <p>
                    Allows data to be passed into the template.
                </p>
            </div>

        </div>
    </section>

    <!-- Basic Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Basic ngTemplateOutlet Example</h2>

        <p>
            First, create a template and give it a reference.
        </p>

        <div class="code-card">
            <div class="code-title">Template Definition</div>

            <pre><code>&lt;ng-template #welcomeTemplate&gt;
    &lt;p&gt;Welcome to CIIT Training Institute!&lt;/p&gt;
&lt;/ng-template&gt;</code></pre>
        </div>

        <p class="mt-4">
            Now render the template using <code>ngTemplateOutlet</code>.
        </p>

        <div class="code-card">
            <div class="code-title">Template Outlet</div>

            <pre><code>&lt;ng-container
    *ngTemplateOutlet="welcomeTemplate"&gt;
&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    Welcome to CIIT Training Institute!
                </p>
            </div>
        </div>
    </section>

    <!-- Why ng-container -->
    <section class="mb-4">
        <h2 class="fw-bold">Why Use ng-container with ngTemplateOutlet?</h2>

        <p>
            <code>ng-container</code> provides a logical location where the
            template can be rendered without adding another HTML wrapper.
        </p>

        <div class="code-card">
            <div class="code-title">Example</div>

            <pre><code>&lt;ng-container
    *ngTemplateOutlet="studentTemplate"&gt;
&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                Angular renders the content of
                <code>studentTemplate</code> at the location of the
                <code>ng-container</code>.
            </p>
        </div>
    </section>

    <!-- Reusable Template -->
    <section class="mb-4">
        <h2 class="fw-bold">Reusable Template</h2>

        <p>
            The same template can be rendered more than once.
        </p>

        <div class="code-card">
            <div class="code-title">Reusable Template</div>

            <pre><code>&lt;ng-template #messageTemplate&gt;
    &lt;p&gt;Welcome to Angular!&lt;/p&gt;
&lt;/ng-template&gt;

&lt;ng-container
    *ngTemplateOutlet="messageTemplate"&gt;
&lt;/ng-container&gt;

&lt;ng-container
    *ngTemplateOutlet="messageTemplate"&gt;
&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <p>Welcome to Angular!</p>
                <p class="mb-0">Welcome to Angular!</p>
            </div>
        </div>
    </section>

    <!-- Template Context -->
    <section class="mb-4">
        <h2 class="fw-bold">ngTemplateOutlet with Context</h2>

        <p>
            A context object can be passed to the template using
            <code>ngTemplateOutletContext</code>.
        </p>

        <div class="code-card">
            <div class="code-title">Template with Context</div>

            <pre><code>&lt;ng-template
    #studentTemplate
    let-name="studentName"&gt;

    &lt;p&gt;
        Student: &#123;&#123; name &#125;&#125;
    &lt;/p&gt;

&lt;/ng-template&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Passing Context</div>

            <pre><code>&lt;ng-container
    *ngTemplateOutlet="
        studentTemplate;
        context: &#123; studentName: 'Sam' &#125;
    "&gt;
&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    Student: Sam
                </p>
            </div>
        </div>
    </section>

    <!-- Multiple Context Values -->
    <section class="mb-4">
        <h2 class="fw-bold">Passing Multiple Context Values</h2>

        <p>
            More than one value can be passed to a template.
        </p>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;ng-template
    #studentTemplate
    let-name="name"
    let-course="course"&gt;

    &lt;p&gt;
        Name: &#123;&#123; name &#125;&#125;
    &lt;/p&gt;

    &lt;p&gt;
        Course: &#123;&#123; course &#125;&#125;
    &lt;/p&gt;

&lt;/ng-template&gt;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Context</div>

            <pre><code>&lt;ng-container
    *ngTemplateOutlet="
        studentTemplate;
        context: &#123;
            name: 'Sam',
            course: 'Angular Full Stack'
        &#125;
    "&gt;
&lt;/ng-container&gt;</code></pre>
        </div>
    </section>

    <!-- Rendering Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Template Rendering Flow</h2>

        <div class="binding-flow">

            <div class="binding-item">
                <h5>Template</h5>
                <code>#studentTemplate</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Outlet</h5>
                <code>ngTemplateOutlet</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Context</h5>
                <code>studentName</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>UI</h5>
                <code>Student: Sam</code>
            </div>

        </div>
    </section>

    <!-- Template vs Outlet -->
    <section class="mb-4">
        <h2 class="fw-bold">ng-template vs ngTemplateOutlet</h2>

        <div class="syntax-table">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Feature</th>
                        <th>ng-template</th>
                        <th>ngTemplateOutlet</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Purpose</td>
                        <td>Defines a template</td>
                        <td>Renders a template</td>
                    </tr>

                    <tr>
                        <td>Creates UI directly</td>
                        <td>No</td>
                        <td>Yes</td>
                    </tr>

                    <tr>
                        <td>Reference variable</td>
                        <td>Commonly used</td>
                        <td>Uses a template reference</td>
                    </tr>

                    <tr>
                        <td>Context support</td>
                        <td>Defines local variables</td>
                        <td>Can pass context</td>
                    </tr>

                    <tr>
                        <td>Dynamic rendering</td>
                        <td>Defines the content</td>
                        <td>Performs the rendering</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Common Uses -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Uses of ngTemplateOutlet</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">1</div>
                <h5>Reusable UI</h5>
                <p>
                    Render the same template in multiple locations.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">2</div>
                <h5>Dynamic Templates</h5>
                <p>
                    Select and render templates dynamically.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">3</div>
                <h5>Template Context</h5>
                <p>
                    Pass different data to the same template.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">4</div>
                <h5>Clean DOM</h5>
                <p>
                    Combine template rendering with ng-container.
                </p>
            </div>

        </div>
    </section>

    <!-- Complete Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete ngTemplateOutlet Example</h2>

        <div class="code-card">
            <div class="code-title">Student Card Template</div>

            <pre><code>&lt;ng-template
    #studentCard
    let-name="name"
    let-course="course"&gt;

    &lt;div class="student-card"&gt;

        &lt;h3&gt;&#123;&#123; name &#125;&#125;&lt;/h3&gt;

        &lt;p&gt;
            Course: &#123;&#123; course &#125;&#125;
        &lt;/p&gt;

    &lt;/div&gt;

&lt;/ng-template&gt;

&lt;ng-container
    *ngTemplateOutlet="
        studentCard;
        context: &#123;
            name: 'Sam',
            course: 'Angular Full Stack'
        &#125;
    "&gt;
&lt;/ng-container&gt;</code></pre>
        </div>

        <div class="student-preview">
            <h5>Student Card</h5>

            <p>
                <strong>Student:</strong> Sam
            </p>

            <p class="mb-0">
                <strong>Course:</strong> Angular Full Stack
            </p>
        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Best Practices</h2>

        <div class="best-practice-list">

            <div>
                <strong>1. Keep reusable templates focused</strong>
                <p>
                    Each template should have a clear and specific purpose.
                </p>
            </div>

            <div>
                <strong>2. Use meaningful template references</strong>
                <p>
                    Names such as <code>#studentCard</code> and
                    <code>#loginTemplate</code> make templates easier to understand.
                </p>
            </div>

            <div>
                <strong>3. Use context for dynamic data</strong>
                <p>
                    Pass data through <code>ngTemplateOutletContext</code> when
                    the same template needs different values.
                </p>
            </div>

            <div>
                <strong>4. Use ng-container when a wrapper is unnecessary</strong>
                <p>
                    This keeps the rendered DOM cleaner.
                </p>
            </div>

            <div>
                <strong>5. Avoid unnecessary template complexity</strong>
                <p>
                    Keep business logic inside components or services instead of
                    placing complex logic inside templates.
                </p>
            </div>

        </div>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <div class="summary-box">
            <h4 class="fw-bold">Summary</h4>

            <ul class="mb-0">
                <li><code>ng-template</code> defines a template fragment.</li>
                <li><code>ngTemplateOutlet</code> renders an existing template.</li>
                <li>A template reference identifies the template to render.</li>
                <li><code>ngTemplateOutletContext</code> can pass data to a template.</li>
                <li>The same template can be rendered multiple times.</li>
                <li><code>ng-container</code> can provide a clean rendering location.</li>
            </ul>
        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("NgContainer", "Templates", new { area = "Angular" })">
            ← NgContainer
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("ControlFlow", "Templates", new { area = "Angular" })">
            Control Flow →
        </a>

    </div>

</div>

