            color: #2e1065;
            font-weight: 700;
            margin-top: 12px;
        }

        .syntax-box p {
            color: #64748b;
            margin-bottom: 0;
            font-size: 14px;
        }

    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
