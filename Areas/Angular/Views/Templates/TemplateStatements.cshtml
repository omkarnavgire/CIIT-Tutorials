        }

        .syntax-table td {
            vertical-align: middle;
        }

        .syntax-table code {
            color: #4c1d95;
            font-weight: 600;
        }

    .student-preview {
        margin-top: 12px;
        padding: 20px;
        background: #ffffff;
        border: 1px solid #ddd6fe;
        border-radius: 8px;
    }

