    .code-title {
        background: #1e293b;
        color: #d8c9f5;
        padding: 10px 15px;
        font-weight: 600;
        border-bottom: 1px solid #334155;
    }

    .code-card pre {
        margin: 0;
        padding: 18px;
        overflow-x: auto;
    }

    .code-card code {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.7;
    }

    .output-box {
        margin-top: 15px;
        padding: 18px;
        background: #f1f5f9;
        border-left: 5px solid #4c1d95;
        border-radius: 6px;
    }

    .output-preview {
        margin-top: 12px;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
    }

        .output-preview h3 {
            color: #2e1065;
            font-weight: 700;
            margin-bottom: 8px;
        }

