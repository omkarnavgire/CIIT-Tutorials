        .syntax-grid,
        .control-flow-grid {
            grid-template-columns: 1fr;
        }

        .syntax-flow {
            flex-direction: column;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }

        .syntax-box {
            width: 100%;
            max-width: 280px;
        }

        .code-card code,
        .code-small code {
            font-size: 13px;
        }

        .d-flex.justify-content-between {
            gap: 10px;
        }

            .d-flex.justify-content-between .btn {
                font-size: 13px;
                padding: 8px 12px;
            }
    }

</style>