@{
    ViewData["Title"] = "Template Expressions";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Template Expressions</h1>

        <p class="lead text-muted">
            Angular Template Expressions are used to evaluate component data,
            perform simple calculations, access properties, and display dynamic
            values inside an Angular template.
        </p>
    </section>

    <!-- What are Template Expressions -->
    <section class="mb-4">

        <h2 class="fw-bold">What are Template Expressions?</h2>

        <p>
            A template expression is an expression written inside an Angular
            template that Angular evaluates and uses to display a value or
            provide a value for a binding.
        </p>

        <p>
            Template expressions usually work with component properties,
            object properties, simple calculations, method calls, and
            conditional expressions.
        </p>

        <div class="info-card">

            <h5>Simple Definition</h5>

            <p>
                Angular Template Expressions allow the template to read and
                calculate values from the component and display them in the UI.
            </p>

        </div>

    </section>

    <!-- Expression Flow -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Template Expression Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-code-slash"></i>

                <strong>Component</strong>

                <span>Properties &amp; Methods</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-filetype-html"></i>

                <strong>Template</strong>

                <span>Expression</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-gear-fill"></i>

                <strong>Angular</strong>

                <span>Evaluates Expression</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-display"></i>

                <strong>Browser</strong>

                <span>Displays Result</span>

            </div>

        </div>

    </section>

    <!-- Main Expression Types -->
    <section class="mb-4">

        <h2 class="fw-bold">Common Template Expressions</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-braces"></i>
                </div>

                <h5>Property</h5>

                <p>
                    Displays a property from the component.
                </p>

                <code>&#123;&#123; studentName &#125;&#125;</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-calculator"></i>
                </div>

                <h5>Arithmetic</h5>

                <p>
                    Performs simple calculations.
                </p>

                <code>&#123;&#123; marks + bonus &#125;&#125;</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-play-circle"></i>
                </div>

                <h5>Method Call</h5>

                <p>
                    Calls a component method.
                </p>

                <code>&#123;&#123; getStatus() &#125;&#125;</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-question-circle"></i>
                </div>

                <h5>Conditional</h5>

                <p>
                    Produces a value based on a condition.
                </p>

                <code>marks &gt;= 40 ? 'Pass' : 'Fail'</code>

            </div>

        </div>

    </section>

    <!-- Property Expression -->
    <section class="mb-4">

        <h2 class="fw-bold">1. Property Expression</h2>

        <p>
            A property expression reads a value from the component class and
            displays it inside the Angular template.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>export class StudentComponent {

    studentName = 'Sam';

}</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;h2&gt;
    Student Name: &#123;&#123; studentName &#125;&#125;
&lt;/h2&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <h3>
                    Student Name: Sam
                </h3>

            </div>

        </div>

    </section>

    <!-- Arithmetic Expression -->
    <section class="mb-4">

        <h2 class="fw-bold">2. Arithmetic Expressions</h2>

        <p>
            Angular template expressions can perform simple arithmetic
            calculations such as addition, subtraction, multiplication,
            and division.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>export class StudentComponent {

    marks = 80;
    bonus = 5;

}</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;p&gt;
    Total Marks:
    &#123;&#123; marks + bonus &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <p>
                    Total Marks: 85
                </p>

            </div>

        </div>

    </section>

    <!-- Method Call -->
    <section class="mb-4">

        <h2 class="fw-bold">3. Method Call Expression</h2>

        <p>
            A template expression can call a component method and display
            the value returned by that method.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>export class StudentComponent {

    studentName = 'Sam';

    getStudentLabel() {
        return 'Student: ' + this.studentName;
    }

}</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;p&gt;
    &#123;&#123; getStudentLabel() &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <p>
                    Student: Sam
                </p>

            </div>

        </div>

    </section>

    <!-- Object Property -->
    <section class="mb-4">

        <h2 class="fw-bold">4. Object Property Expression</h2>

        <p>
            Template expressions can access properties inside an object
            defined in the component.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>export class StudentComponent {

    student = {
        name: 'Sam',
        course: 'Angular',
        marks: 90
    };

}</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;p&gt;
    Name: &#123;&#123; student.name &#125;&#125;
&lt;/p&gt;

&lt;p&gt;
    Course: &#123;&#123; student.course &#125;&#125;
&lt;/p&gt;

&lt;p&gt;
    Marks: &#123;&#123; student.marks &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <p>
                    <strong>Name:</strong> Sam
                </p>

                <p>
                    <strong>Course:</strong> Angular
                </p>

                <p>
                    <strong>Marks:</strong> 90
                </p>

            </div>

        </div>

    </section>

    <!-- Conditional Expression -->
    <section class="mb-4">

        <h2 class="fw-bold">5. Conditional Expression</h2>

        <p>
            A conditional expression can be used to choose between two
            values depending on whether a condition is true or false.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>export class StudentComponent {

    marks = 85;

}</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;p&gt;
    Result:
    &#123;&#123; marks &gt;= 40 ? 'Pass' : 'Fail' &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <p>
                    Result: Pass
                </p>

            </div>

        </div>

    </section>

    <!-- Logical Expression -->
    <section class="mb-4">

        <h2 class="fw-bold">6. Logical Expressions</h2>

        <p>
            Logical operators can be used inside simple template expressions
            when multiple conditions need to be evaluated.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>export class StudentComponent {

    marks = 85;
    attendance = 90;

}</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;p&gt;
    Eligible:
    &#123;&#123; marks &gt;= 40 &amp;&amp; attendance &gt;= 75 ? 'Yes' : 'No' &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <p>
                    Eligible: Yes
                </p>

            </div>

        </div>

    </section>

    <!-- Simple Expressions -->
    <section class="mb-4">

        <h2 class="fw-bold">7. Keeping Expressions Simple</h2>

        <p>
            Template expressions should be simple and focused on displaying
            or calculating values required by the user interface.
        </p>

        <div class="control-flow-grid">

            <div class="control-card">

                <h5>Good Example</h5>

                <div class="code-small">

                    <pre><code>&lt;p&gt;
    Total:
    &#123;&#123; marks + bonus &#125;&#125;
&lt;/p&gt;</code></pre>

                </div>

            </div>

            <div class="control-card">

                <h5>Better Approach for Complex Logic</h5>

                <div class="code-small">

                    <pre><code>getStudentStatus() {
    // Complex logic
    return 'Pass';
}</code></pre>

                </div>

            </div>

        </div>

        <div class="info-card">

            <h5>Important</h5>

            <p>
                Avoid putting large business logic or complicated calculations
                directly inside the template. Keep complex logic inside the
                component or appropriate service.
            </p>

        </div>

    </section>

    <!-- What Can Be Used -->
    <section class="mb-4">

        <h2 class="fw-bold">Template Expression Examples</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>
                        <th>Expression</th>
                        <th>Example</th>
                        <th>Purpose</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>Property</td>
                        <td>
                            <code>&#123;&#123; studentName &#125;&#125;</code>
                        </td>
                        <td>
                            Display component data
                        </td>
                    </tr>

                    <tr>
                        <td>Arithmetic</td>
                        <td>
                            <code>&#123;&#123; marks + bonus &#125;&#125;</code>
                        </td>
                        <td>
                            Calculate values
                        </td>
                    </tr>

                    <tr>
                        <td>Object Property</td>
                        <td>
                            <code>&#123;&#123; student.name &#125;&#125;</code>
                        </td>
                        <td>
                            Access object data
                        </td>
                    </tr>

                    <tr>
                        <td>Method Call</td>
                        <td>
                            <code>&#123;&#123; getStatus() &#125;&#125;</code>
                        </td>
                        <td>
                            Get calculated value
                        </td>
                    </tr>

                    <tr>
                        <td>Conditional</td>
                        <td>
                            <code>marks &gt;= 40 ? 'Pass' : 'Fail'</code>
                        </td>
                        <td>
                            Display conditional value
                        </td>
                    </tr>

                    <tr>
                        <td>Logical</td>
                        <td>
                            <code>marks &gt;= 40 &amp;&amp; attendance &gt;= 75</code>
                        </td>
                        <td>
                            Evaluate multiple conditions
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Complete Example -->
    <section class="mb-4">

        <h2 class="fw-bold">Complete Template Expression Example</h2>

        <div class="code-card">

            <div class="code-title">
                student.component.ts
            </div>

            <pre><code>export class StudentComponent {

    studentName = 'Sam';

    marks = 85;

    bonus = 5;

    student = {
        course: 'Angular Full Stack',
        city: 'Pune'
    };

    getStatus() {
        return this.marks &gt;= 40 ? 'Pass' : 'Fail';
    }

}</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                student.component.html
            </div>

            <pre><code>&lt;div&gt;

    &lt;h2&gt;
        Student Profile
    &lt;/h2&gt;

    &lt;p&gt;
        Name: &#123;&#123; studentName &#125;&#125;
    &lt;/p&gt;

    &lt;p&gt;
        Course: &#123;&#123; student.course &#125;&#125;
    &lt;/p&gt;

    &lt;p&gt;
        City: &#123;&#123; student.city &#125;&#125;
    &lt;/p&gt;

    &lt;p&gt;
        Marks: &#123;&#123; marks &#125;&#125;
    &lt;/p&gt;

    &lt;p&gt;
        Total Marks:
        &#123;&#123; marks + bonus &#125;&#125;
    &lt;/p&gt;

    &lt;p&gt;
        Result:
        &#123;&#123; marks &gt;= 40 ? 'Pass' : 'Fail' &#125;&#125;
    &lt;/p&gt;

    &lt;p&gt;
        Status: &#123;&#123; getStatus() &#125;&#125;
    &lt;/p&gt;

&lt;/div&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>Student Profile</h3>

                <p>
                    <strong>Name:</strong> Sam
                </p>

                <p>
                    <strong>Course:</strong> Angular Full Stack
                </p>

                <p>
                    <strong>City:</strong> Pune
                </p>

                <p>
                    <strong>Marks:</strong> 85
                </p>

                <p>
                    <strong>Total Marks:</strong> 90
                </p>

                <p>
                    <strong>Result:</strong> Pass
                </p>

                <p>
                    <strong>Status:</strong> Pass
                </p>

            </div>

        </div>

    </section>

    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">Template Expression Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Keep template expressions simple and readable.
            </li>

            <li>
                Use expressions mainly for UI-related values.
            </li>

            <li>
                Use component properties to display dynamic data.
            </li>

            <li>
                Move complex business logic into the component or service.
            </li>

            <li>
                Avoid unnecessary calculations inside templates.
            </li>

            <li>
                Use meaningful property and method names.
            </li>

        </ul>

    </section>

    <!-- Summary -->
    <section class="summary-box">

        <h3>Summary</h3>

        <p>
            Angular Template Expressions allow templates to evaluate component
            data and display dynamic values in the user interface.
        </p>

        <p>
            Common expressions include
            <strong>Property Expressions</strong>,
            <strong>Arithmetic Expressions</strong>,
            <strong>Object Property Expressions</strong>,
            <strong>Method Calls</strong> and
            <strong>Conditional Expressions</strong>.
        </p>

        <p>
            Template expressions should remain simple, readable and focused
            on UI-related operations.
        </p>

    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("TemplateSyntax", "Templates", new { area = "Angular" })">
            ← Template Syntax
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("TemplateStatements", "Templates", new { area = "Angular" })">
            Template Statements →
        </a>

    </div>

</div>

<style>

