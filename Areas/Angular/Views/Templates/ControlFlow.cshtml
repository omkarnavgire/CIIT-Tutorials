@{
    ViewData["Title"] = "Control Flow";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Control Flow</h1>
        <p class="lead text-muted">
            Learn how Angular uses control flow to conditionally display,
            repeat, and switch between different template sections.
        </p>
    </section>

    <!-- What is Control Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">What is Control Flow?</h2>

        <div class="info-card">
            <p>
                Angular control flow determines which parts of a template
                should be displayed based on conditions, collections, or values.
            </p>

            <p class="mb-0">
                Modern Angular provides built-in control flow blocks such as
                <code>@@if</code>, <code>@@for</code>, and <code>@@switch</code>
                for creating dynamic user interfaces.
            </p>
        </div>
    </section>

    <!-- Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Control Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <div class="syntax-icon">1</div>
                <h5>Data</h5>
                <p>Component provides the data used by the template.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">2</div>
                <h5>Condition</h5>
                <p>Angular evaluates a condition or collection.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">3</div>
                <h5>Control Block</h5>
                <p>Angular selects the required template content.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">4</div>
                <h5>Rendered UI</h5>
                <p>The selected content appears on the page.</p>
            </div>

        </div>
    </section>

    <!-- Main Concepts -->
    <section class="mb-4">
        <h2 class="fw-bold">Main Control Flow Concepts</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">IF</div>
                <h5>@@if</h5>
                <p>
                    Displays content when a condition is true.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">EL</div>
                <h5>@@else</h5>
                <p>
                    Displays alternative content when the condition is false.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">FR</div>
                <h5>@@for</h5>
                <p>
                    Repeats template content for each item in a collection.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">SW</div>
                <h5>@@switch</h5>
                <p>
                    Selects content based on different possible values.
                </p>
            </div>

        </div>
    </section>

    <!-- If -->
    <section class="mb-4">
        <h2 class="fw-bold">@@if Control Flow</h2>

        <p>
            The <code>@@if</code> block displays template content only when
            the specified condition evaluates to true.
        </p>

        <div class="code-card">
            <div class="code-title">Basic @@if Example</div>

            <pre><code>@@if (isLoggedIn) {
    &lt;p&gt;Welcome Sam!&lt;/p&gt;
}</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    Welcome Sam!
                </p>
            </div>
        </div>
    </section>

    <!-- If Else -->
    <section class="mb-4">
        <h2 class="fw-bold">@@if with @@else</h2>

        <p>
            Use <code>@@else</code> when you want to display alternative
            content when the condition is false.
        </p>

        <div class="code-card">
            <div class="code-title">@@if and @@else Example</div>

            <pre><code>@@if (isLoggedIn) {
    &lt;p&gt;Welcome Sam!&lt;/p&gt;
} @@else {
    &lt;p&gt;Please login to continue.&lt;/p&gt;
}</code></pre>
        </div>

        <div class="binding-flow">

            <div class="binding-item">
                <h5>Condition True</h5>
                <code>Welcome Sam!</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Condition False</h5>
                <code>Please login</code>
            </div>

        </div>
    </section>

    <!-- Else If -->
    <section class="mb-4">
        <h2 class="fw-bold">@@else if</h2>

        <p>
            Multiple conditions can be checked using
            <code>@@else if</code>.
        </p>

        <div class="code-card">
            <div class="code-title">@@else if Example</div>

            <pre><code>@@if (marks &gt;= 75) {
    &lt;p&gt;Grade: A&lt;/p&gt;
} @@else if (marks &gt;= 60) {
    &lt;p&gt;Grade: B&lt;/p&gt;
} @@else {
    &lt;p&gt;Grade: C&lt;/p&gt;
}</code></pre>
        </div>

        <div class="output-box">
            <strong>Example Output:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    Grade: A
                </p>
            </div>
        </div>
    </section>

    <!-- For -->
    <section class="mb-4">
        <h2 class="fw-bold">@@for Control Flow</h2>

        <p>
            The <code>@@for</code> block repeats template content for every
            item in a collection.
        </p>

        <div class="code-card">
            <div class="code-title">Basic @@for Example</div>

            <pre><code>@@for (student of students; track student.id) {
    &lt;p&gt;
        &#123;&#123; student.name &#125;&#125;
    &lt;/p&gt;
}</code></pre>
        </div>

        <div class="output-box">
            <strong>Example Output:</strong>

            <div class="output-preview">
                <p>Sam</p>
                <p>Pradnya</p>
                <p class="mb-0">Rahul</p>
            </div>
        </div>
    </section>

    <!-- Track -->
    <section class="mb-4">
        <h2 class="fw-bold">Tracking Items with @@for</h2>

        <p>
            The <code>track</code> expression helps Angular identify each item
            when the collection changes.
        </p>

        <div class="code-card">
            <div class="code-title">Track Example</div>

            <pre><code>@@for (student of students; track student.id) {
    &lt;div&gt;
        &lt;strong&gt;
            &#123;&#123; student.name &#125;&#125;
        &lt;/strong&gt;
    &lt;/div&gt;
}</code></pre>
        </div>

        <div class="info-card">
            <p class="mb-0">
                Using a stable identifier such as <code>student.id</code>
                helps Angular efficiently update the rendered list.
            </p>
        </div>
    </section>

    <!-- Empty -->
    <section class="mb-4">
        <h2 class="fw-bold">@@empty Block</h2>

        <p>
            The <code>@@empty</code> block provides alternative content when
            the collection used by <code>@@for</code> contains no items.
        </p>

        <div class="code-card">
            <div class="code-title">@@for with @@empty</div>

            <pre><code>@@for (student of students; track student.id) {
    &lt;p&gt;
        &#123;&#123; student.name &#125;&#125;
    &lt;/p&gt;
} @@empty {
    &lt;p&gt;No students found.&lt;/p&gt;
}</code></pre>
        </div>

        <div class="output-box">
            <strong>When the collection is empty:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    No students found.
                </p>
            </div>
        </div>
    </section>

    <!-- Switch -->
    <section class="mb-4">
        <h2 class="fw-bold">@@switch Control Flow</h2>

        <p>
            The <code>@@switch</code> block is useful when different UI
            content should be displayed for different values.
        </p>

        <div class="code-card">
            <div class="code-title">@@switch Example</div>

            <pre><code>@@switch (course) {

    @@case ('Angular') {
        &lt;p&gt;Angular Full Stack&lt;/p&gt;
    }

    @@case ('Java') {
        &lt;p&gt;Java Full Stack&lt;/p&gt;
    }

    @@case ('Dot Net') {
        &lt;p&gt;.NET Full Stack&lt;/p&gt;
    }

    @@default {
        &lt;p&gt;Course not available.&lt;/p&gt;
    }
}</code></pre>
        </div>

        <div class="output-box">
            <strong>Example Output:</strong>

            <div class="output-preview">
                <p class="mb-0">
                    Angular Full Stack
                </p>
            </div>
        </div>
    </section>

    <!-- Switch Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Switch Flow</h2>

        <div class="binding-flow">

            <div class="binding-item">
                <h5>Value</h5>
                <code>course</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Case</h5>
                <code>Angular</code>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="binding-item">
                <h5>Template</h5>
                <code>Angular Full Stack</code>
            </div>

        </div>
    </section>

    <!-- Traditional and Modern -->
    <section class="mb-4">
        <h2 class="fw-bold">Traditional vs Modern Control Flow</h2>

        <div class="syntax-table">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Purpose</th>
                        <th>Traditional Angular</th>
                        <th>Modern Angular</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Conditional rendering</td>
                        <td><code>*ngIf</code></td>
                        <td><code>@@if</code></td>
                    </tr>

                    <tr>
                        <td>Alternative content</td>
                        <td><code>ng-template</code></td>
                        <td><code>@@else</code></td>
                    </tr>

                    <tr>
                        <td>Looping</td>
                        <td><code>*ngFor</code></td>
                        <td><code>@@for</code></td>
                    </tr>

                    <tr>
                        <td>Empty collection</td>
                        <td>Separate condition</td>
                        <td><code>@@empty</code></td>
                    </tr>

                    <tr>
                        <td>Multiple cases</td>
                        <td><code>ngSwitch</code></td>
                        <td><code>@@switch</code></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Common Uses -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Uses of Control Flow</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">1</div>
                <h5>Conditional UI</h5>
                <p>
                    Show or hide content based on application state.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">2</div>
                <h5>Lists</h5>
                <p>
                    Display multiple records from a collection.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">3</div>
                <h5>Empty States</h5>
                <p>
                    Display useful content when no records are available.
                </p>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">4</div>
                <h5>Multiple Cases</h5>
                <p>
                    Display different UI based on a selected value.
                </p>
            </div>

        </div>
    </section>

    <!-- Complete Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete Control Flow Example</h2>

        <div class="code-card">
            <div class="code-title">Student Dashboard</div>

            <pre><code>@@if (students.length &gt; 0) {

    &lt;h3&gt;Students&lt;/h3&gt;

    @@for (student of students; track student.id) {

        &lt;div&gt;

            &lt;h4&gt;
                &#123;&#123; student.name &#125;&#125;
            &lt;/h4&gt;

            &lt;p&gt;
                Course: &#123;&#123; student.course &#125;&#125;
            &lt;/p&gt;

        &lt;/div&gt;
    }

} @@else {

    &lt;p&gt;No students found.&lt;/p&gt;

}</code></pre>
        </div>

        <div class="student-preview">
            <h5>Student Dashboard</h5>

            <p>
                <strong>Student:</strong> Sam
            </p>

            <p>
                <strong>Course:</strong> Angular Full Stack
            </p>

            <hr />

            <p>
                <strong>Student:</strong> Pradnya
            </p>

            <p class="mb-0">
                <strong>Course:</strong> Java Full Stack
            </p>
        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Best Practices</h2>

        <div class="best-practice-list">

            <div>
                <strong>1. Keep conditions simple</strong>
                <p>
                    Avoid putting complex business logic directly inside
                    control flow expressions.
                </p>
            </div>

            <div>
                <strong>2. Use modern control flow for new Angular code</strong>
                <p>
                    Use <code>@@if</code>, <code>@@for</code>, and
                    <code>@@switch</code> when building modern Angular
                    applications.
                </p>
            </div>

            <div>
                <strong>3. Use track with @@for</strong>
                <p>
                    Use a stable unique identifier such as
                    <code>student.id</code> when rendering collections.
                </p>
            </div>

            <div>
                <strong>4. Handle empty collections</strong>
                <p>
                    Use <code>@@empty</code> to provide meaningful feedback
                    when there are no records.
                </p>
            </div>

            <div>
                <strong>5. Keep template logic readable</strong>
                <p>
                    Avoid deeply nested control flow and move complex logic
                    into components or services.
                </p>
            </div>

        </div>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <div class="summary-box">
            <h4 class="fw-bold">Summary</h4>

            <ul class="mb-0">
                <li><code>@@if</code> is used for conditional rendering.</li>
                <li><code>@@else</code> provides alternative content.</li>
                <li><code>@@for</code> repeats content for collection items.</li>
                <li><code>@@empty</code> handles an empty collection.</li>
                <li><code>@@switch</code> handles multiple possible cases.</li>
                <li>The <code>track</code> expression helps Angular identify list items efficiently.</li>
                <li>Control flow makes Angular templates dynamic and data-driven.</li>
            </ul>
        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("NgTemplateOutlet", "Templates", new { area = "Angular" })">
            ← NgTemplateOutlet
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("Index", "DataBinding", new { area = "Angular" })">
            Data Binding Introduction →
        </a>

    </div>

</div>

<style>
    .info-card {
        background: #f8fafc;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        color: #334155;
    }

    .syntax-flow {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .syntax-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        width: 190px;
    }

        .syntax-box h5 {
            color: #2e1065;
            font-weight: 700;
            margin-top: 12px;
        }

        .syntax-box p {
            color: #64748b;
            margin-bottom: 0;
            font-size: 14px;
        }

    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 auto 12px;
    }

    .syntax-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4c1d95;
        font-size: 28px;
        font-weight: 700;
    }

    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        transition: all 0.2s ease;
    }

        .syntax-card:hover {
            transform: translateY(-3px);
            border-color: #c4b5fd;
            box-shadow: 0 8px 20px rgba(76, 29, 149, 0.08);
        }

        .syntax-card h5 {
            color: #2e1065;
            font-weight: 700;
        }

        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
        }

    .code-card {
        margin-top: 20px;
        border-radius: 12px;
        overflow: hidden;
        background: #0f172a;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.12);
    }

    .code-title {
        background: #1e293b;
        color: #ffffff;
        padding: 12px 18px;
        font-weight: 600;
        border-bottom: 1px solid #334155;
    }

    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }

    .code-card code {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.7;
    }

    .output-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 10px;
        padding: 18px;
        margin-top: 20px;
        color: #334155;
    }

    .output-preview {
        background: #ffffff;
        border: 1px dashed #c4b5fd;
        border-radius: 8px;
        padding: 16px;
        margin-top: 12px;
    }

    .binding-flow {
        display: flex;
        justify-content: center;
        align-items: stretch;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .binding-item {
        min-width: 180px;
        padding: 18px;
        border: 1px solid #ddd6fe;
        background: #f8fafc;
        border-radius: 10px;
        text-align: center;
    }

        .binding-item h5 {
            color: #2e1065;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .binding-item code {
            color: #4c1d95;
            font-weight: 600;
        }

    .syntax-table {
        margin-top: 20px;
        overflow-x: auto;
    }

        .syntax-table table {
            min-width: 700px;
        }

        .syntax-table th {
            background: #4c1d95;
            color: #ffffff;
            font-weight: 600;
            padding: 14px;
        }

        .syntax-table td {
            padding: 13px;
            vertical-align: middle;
            color: #334155;
        }

        .syntax-table tr:nth-child(even) {
            background: #f8fafc;
        }

    .student-preview {
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #ddd6fe;
    }

        .student-preview h5 {
            color: #2e1065;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .student-preview strong {
            color: #4c1d95;
        }

    .best-practice-list {
        display: grid;
        gap: 15px;
        margin-top: 20px;
    }

        .best-practice-list > div {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 18px 20px;
        }

        .best-practice-list strong {
            color: #2e1065;
        }

        .best-practice-list p {
            color: #64748b;
            margin: 8px 0 0;
        }

    .summary-box {
        background: #cfe2ff;
        color: #084298;
        border-radius: 10px;
        padding: 22px;
    }

        .summary-box h4 {
            color: #084298;
        }

        .summary-box li {
            margin-bottom: 8px;
        }

    @@media (max-width: 991px) {
        .syntax-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syntax-flow {
            flex-direction: column;
            align-items: center;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }
    }

    @@media (max-width: 576px) {
        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-box {
            width: 100%;
        }

        .binding-flow {
            flex-direction: column;
        }

        .binding-item {
            width: 100%;
        }

        .syntax-table {
            font-size: 14px;
        }

        .code-card code {
            font-size: 13px;
        }
    }
</style>