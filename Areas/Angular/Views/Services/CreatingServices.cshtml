@{
    ViewData["Title"] = "Creating Angular Services";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">Creating Angular Services</h1>

        <p class="lead text-muted">
            Angular services are reusable TypeScript classes that can be created
            to organize application logic, manage data, communicate with APIs,
            and provide common functionality to components.
        </p>

    </section>

    <!-- What is Creating Service -->
    <section class="mb-4">

        <h2 class="fw-bold">What Does Creating a Service Mean?</h2>

        <p>
            Creating an Angular service means defining a reusable TypeScript
            class and registering it with Angular's dependency injection system.
        </p>

        <p>
            Once created, the service can be injected into components and other
            Angular classes wherever its functionality is required.
        </p>

        <div class="info-card">

            <h5>Simple Definition</h5>

            <p>
                A service is a reusable class that contains functionality which
                can be shared across different parts of an Angular application.
            </p>

        </div>

    </section>

    <!-- Service Creation Flow -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Service Creation Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-terminal"></i>

                <strong>Angular CLI</strong>

                <span>Generate service</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-file-earmark-code"></i>

                <strong>Service Class</strong>

                <span>Write reusable logic</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-diagram-3"></i>

                <strong>Dependency Injection</strong>

                <span>Provide service</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-display"></i>

                <strong>Component</strong>

                <span>Use the service</span>

            </div>

        </div>

    </section>

    <!-- Angular CLI -->
    <section class="mb-4">

        <h2 class="fw-bold">1. Create a Service Using Angular CLI</h2>

        <p>
            Angular CLI provides a command for generating a service quickly
            inside an Angular project.
        </p>

        <div class="code-card">

            <div class="code-title">
                Angular CLI Command
            </div>

            <pre><code>ng generate service course</code></pre>

        </div>

        <p>
            The shorter version of the same command is:
        </p>

        <div class="code-card">

            <div class="code-title">
                Short Command
            </div>

            <pre><code>ng g service course</code></pre>

        </div>

        <div class="info-card">

            <h5>Result</h5>

            <p>
                Angular CLI creates the service file and prepares the class
                for dependency injection.
            </p>

        </div>

    </section>

    <!-- Generated Files -->
    <section class="mb-4">

        <h2 class="fw-bold">2. Files Generated by CLI</h2>

        <p>
            When a service is generated, Angular CLI normally creates a
            TypeScript service file.
        </p>

        <div class="code-card">

            <div class="code-title">
                Example Project Structure
            </div>

            <pre><code>src/
└── app/
    └── course.service.ts</code></pre>

        </div>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-filetype-ts"></i>
                </div>

                <h5>course.service.ts</h5>

                <p>
                    Contains the service class and its methods.
                </p>

                <code>Service Class</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-code-slash"></i>
                </div>

                <h5>TypeScript</h5>

                <p>
                    Service logic is written in TypeScript.
                </p>

                <code>class</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-diagram-3"></i>
                </div>

                <h5>Injectable</h5>

                <p>
                    Angular can provide the service through dependency injection.
                </p>

                <code>@@Injectable()</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <h5>Reusable</h5>

                <p>
                    The service can be used by multiple components.
                </p>

                <code>Reuse</code>

            </div>

        </div>

    </section>

    <!-- Basic Service -->
    <section class="mb-4">

        <h2 class="fw-bold">3. Basic Service Structure</h2>

        <p>
            A basic Angular service contains the
            <strong>@@Injectable()</strong> decorator and a TypeScript class.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseService &#123;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>What is @@Injectable?</h5>

            <p>
                The <strong>@@Injectable()</strong> decorator tells Angular
                that the class can participate in dependency injection.
            </p>

        </div>

    </section>

    <!-- Service Method -->
    <section class="mb-4">

        <h2 class="fw-bold">4. Adding Methods to a Service</h2>

        <p>
            After creating a service, reusable methods can be added to provide
            functionality to components.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseService &#123;

    getCourseName(): string &#123;

        return 'Angular Full Stack';

    &#125;

    getDuration(): string &#123;

        return '5 Months';

    &#125;

&#125;</code></pre>

        </div>

        <div class="output-box">

            <strong>Service Methods:</strong>

            <div class="output-preview">

                <p>
                    <strong>Course:</strong>
                    Angular Full Stack
                </p>

                <p>
                    <strong>Duration:</strong>
                    5 Months
                </p>

            </div>

        </div>

    </section>

    <!-- Service in Component -->
    <section class="mb-4">

        <h2 class="fw-bold">5. Using the Created Service in a Component</h2>

        <p>
            After creating a service, it can be injected into a component
            through the constructor.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.component.ts
            </div>

            <pre><code>import &#123; Component &#125; from '@@angular/core';
import &#123; CourseService &#125; from './course.service';

@@Component(&#123;
    selector: 'app-course',
    templateUrl: './course.component.html'
&#125;)
export class CourseComponent &#123;

    courseName = '';

    constructor(
        private courseService: CourseService
    ) &#123;

    &#125;

    loadCourse(): void &#123;

        this.courseName =
            this.courseService.getCourseName();

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                course.component.html
            </div>

            <pre><code>&lt;button
    class="btn btn-primary"
    (click)="loadCourse()"&gt;

    Load Course

&lt;/button&gt;

&lt;p&gt;
    Course:
    &#123;&#123; courseName &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <p>
                    Course:
                    <strong>Angular Full Stack</strong>
                </p>

            </div>

        </div>

    </section>

    <!-- Service with Data -->
    <section class="mb-4">

        <h2 class="fw-bold">6. Creating a Service with Data</h2>

        <p>
            A service can store application data and expose methods for
            accessing that data.
        </p>

        <div class="code-card">

            <div class="code-title">
                training.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

    private courses: string[] = [

        'Java Full Stack',
        'Python Full Stack',
        'Full Stack .NET',
        'Data Analytics'

    ];

    getCourses(): string[] &#123;

        return this.courses;

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>Why Keep Data in the Service?</h5>

            <p>
                Multiple components can use the same service method instead of
                storing duplicate course data in every component.
            </p>

        </div>

    </section>

    <!-- Service Creation Commands -->
    <section class="mb-4">

        <h2 class="fw-bold">7. Useful Service Creation Commands</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>

                        <th>Command</th>
                        <th>Purpose</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            <code>ng generate service course</code>
                        </td>

                        <td>
                            Creates a service named CourseService.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            <code>ng g service course</code>
                        </td>

                        <td>
                            Short form of the generate service command.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            <code>ng generate service services/course</code>
                        </td>

                        <td>
                            Creates a service inside a services folder.
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Service Folder -->
    <section class="mb-4">

        <h2 class="fw-bold">8. Organizing Services in a Project</h2>

        <p>
            In a larger Angular application, services can be organized inside
            a dedicated folder.
        </p>

        <div class="code-card">

            <div class="code-title">
                Suggested Structure
            </div>

            <pre><code>src/
└── app/
    ├── components/
    ├── services/
    │   ├── course.service.ts
    │   ├── training.service.ts
    │   └── notification.service.ts
    └── app.component.ts</code></pre>

        </div>

        <div class="info-card">

            <h5>Benefit</h5>

            <p>
                Keeping related services organized makes the project easier
                to navigate and maintain.
            </p>

        </div>

    </section>

    <!-- Root Provider -->
    <section class="mb-4">

        <h2 class="fw-bold">9. providedIn: 'root'</h2>

        <p>
            A commonly used service configuration is
            <strong>providedIn: 'root'</strong>.
        </p>

        <div class="code-card">

            <div class="code-title">
                Service
            </div>

            <pre><code>@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

    getInstituteName(): string &#123;

        return 'CIIT Training Institute';

    &#125;

&#125;</code></pre>

        </div>

        <div class="binding-flow">

            <div class="binding-item">

                <strong>Service</strong>

                <span>
                    TrainingService
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Root Provider</strong>

                <span>
                    Application Scope
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Components</strong>

                <span>
                    Can Inject Service
                </span>

            </div>

        </div>

    </section>

    <!-- Complete CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">Complete CIIT Training Institute Example</h2>

        <p>
            Let's create a service for CIIT Training Institute that provides
            the institute name and available courses.
        </p>

        <div class="code-card">

            <div class="code-title">
                training.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

    private courses: string[] = [

        'Java Full Stack',
        'Python Full Stack',
        'Full Stack .NET',
        'Data Analytics'

    ];

    getInstituteName(): string &#123;

        return 'CIIT Training Institute';

    &#125;

    getCourses(): string[] &#123;

        return this.courses;

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.ts
            </div>

            <pre><code>import &#123; Component, OnInit &#125; from '@@angular/core';
import &#123; TrainingService &#125; from './training.service';

@@Component(&#123;
    selector: 'app-dashboard',
    templateUrl: './dashboard.component.html'
&#125;)
export class DashboardComponent implements OnInit &#123;

    instituteName = '';

    courses: string[] = [];

    constructor(
        private trainingService: TrainingService
    ) &#123;

    &#125;

    ngOnInit(): void &#123;

        this.instituteName =
            this.trainingService.getInstituteName();

        this.courses =
            this.trainingService.getCourses();

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.html
            </div>

            <pre><code>&lt;h2&gt;
    &#123;&#123; instituteName &#125;&#125;
&lt;/h2&gt;

&lt;h4&gt;
    Available Courses
&lt;/h4&gt;

&lt;ul&gt;

    &lt;li *ngFor="let course of courses"&gt;
        &#123;&#123; course &#125;&#125;
    &lt;/li&gt;

&lt;/ul&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>
                    CIIT Training Institute
                </h3>

                <p>
                    <strong>Available Courses</strong>
                </p>

                <ul>

                    <li>Java Full Stack</li>
                    <li>Python Full Stack</li>
                    <li>Full Stack .NET</li>
                    <li>Data Analytics</li>

                </ul>

            </div>

        </div>

    </section>

    <!-- Service Creation Checklist -->
    <section class="mb-4">

        <h2 class="fw-bold">Service Creation Checklist</h2>

        <ul class="best-practice-list">

            <li>
                Generate the service using Angular CLI.
            </li>

            <li>
                Create meaningful methods inside the service.
            </li>

            <li>
                Use <strong>@@Injectable()</strong> for dependency injection.
            </li>

            <li>
                Use <strong>providedIn: 'root'</strong> when an application-wide
                service is appropriate.
            </li>

            <li>
                Inject the service into components that need it.
            </li>

            <li>
                Keep reusable logic inside services instead of duplicating it
                across components.
            </li>

        </ul>

    </section>

    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">Creating Services Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Use descriptive service names such as CourseService or
                TrainingService.
            </li>

            <li>
                Keep one service focused on a related responsibility.
            </li>

            <li>
                Keep API communication and reusable data logic inside services.
            </li>

            <li>
                Avoid placing unnecessary UI logic inside services.
            </li>

            <li>
                Organize services into folders in larger projects.
            </li>

            <li>
                Use dependency injection instead of manually creating service
                instances.
            </li>

        </ul>

    </section>

    <!-- Summary -->
    <section class="summary-box">

        <h3>Summary</h3>

        <p>
            Angular services can be created using the Angular CLI and implemented
            as reusable TypeScript classes with the <strong>@@Injectable()</strong>
            decorator.
        </p>

        <p>
            After creation, services can expose methods and data that components
            can access through Angular's dependency injection system.
        </p>

    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", "Services", new { area = "Angular" })">
            ← Services
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("UsingServices", "Services", new { area = "Angular" })">
            Using Services →
        </a>

    </div>

</div>

