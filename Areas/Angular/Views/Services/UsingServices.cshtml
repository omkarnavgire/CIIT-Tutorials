@{
    ViewData["Title"] = "Using Angular Services";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">Using Angular Services</h1>

        <p class="lead text-muted">
            Angular Services can be injected into components and other Angular
            classes to provide reusable functionality such as data access,
            business logic, API communication, and shared application state.
        </p>

    </section>

    <!-- What does Using a Service Mean -->
    <section class="mb-4">

        <h2 class="fw-bold">What Does Using a Service Mean?</h2>

        <p>
            After creating a service, a component can request that service
            through Angular's dependency injection system.
        </p>

        <p>
            The component can then call service methods and use the data or
            functionality provided by the service.
        </p>

        <div class="info-card">

            <h5>Simple Definition</h5>

            <p>
                Using a service means injecting the service into a component
                and calling its methods whenever the component needs its
                functionality.
            </p>

        </div>

    </section>

    <!-- Service Usage Flow -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Using a Service Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-gear-fill"></i>

                <strong>Service</strong>

                <span>Reusable functionality</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-diagram-3"></i>

                <strong>Dependency Injection</strong>

                <span>Provides service</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-display"></i>

                <strong>Component</strong>

                <span>Uses service</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-window"></i>

                <strong>Template</strong>

                <span>Displays result</span>

            </div>

        </div>

    </section>

    <!-- Injecting Service -->
    <section class="mb-4">

        <h2 class="fw-bold">1. Injecting a Service into a Component</h2>

        <p>
            A service can be injected into a component constructor.
            Angular's dependency injection system provides the service instance.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseService &#123;

    getCourseName(): string &#123;

        return 'Angular Full Stack';

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                course.component.ts
            </div>

            <pre><code>import &#123; Component &#125; from '@@angular/core';
import &#123; CourseService &#125; from './course.service';

@@Component(&#123;
    selector: 'app-course',
    templateUrl: './course.component.html'
&#125;)
export class CourseComponent &#123;

    constructor(
        private courseService: CourseService
    ) &#123;

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                Angular detects that the component requires
                <strong>CourseService</strong> and provides its available
                service instance through dependency injection.
            </p>

        </div>

    </section>

    <!-- Calling Service Method -->
    <section class="mb-4">

        <h2 class="fw-bold">2. Calling a Service Method</h2>

        <p>
            After injecting the service, the component can call the methods
            provided by that service.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>courseName = '';

constructor(
    private courseService: CourseService
) &#123;

&#125;

loadCourse(): void &#123;

    this.courseName =
        this.courseService.getCourseName();

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;button
    class="btn btn-primary"
    (click)="loadCourse()"&gt;

    Load Course

&lt;/button&gt;

&lt;p&gt;
    Course:
    &#123;&#123; courseName &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <p>
                    Course:
                    <strong>Angular Full Stack</strong>
                </p>

            </div>

        </div>

    </section>

    <!-- Service Returns Multiple Values -->
    <section class="mb-4">

        <h2 class="fw-bold">3. Using Multiple Service Methods</h2>

        <p>
            A component can use multiple methods from the same service.
        </p>

        <div class="code-card">

            <div class="code-title">
                training.service.ts
            </div>

            <pre><code>@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

    getCourseName(): string &#123;

        return 'Python Full Stack';

    &#125;

    getDuration(): string &#123;

        return '5 Months';

    &#125;

    getMode(): string &#123;

        return 'Online + Offline';

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>courseName = '';

duration = '';

mode = '';

constructor(
    private trainingService: TrainingService
) &#123;

&#125;

loadCourseDetails(): void &#123;

    this.courseName =
        this.trainingService.getCourseName();

    this.duration =
        this.trainingService.getDuration();

    this.mode =
        this.trainingService.getMode();

&#125;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <p>
                    <strong>Course:</strong>
                    Python Full Stack
                </p>

                <p>
                    <strong>Duration:</strong>
                    5 Months
                </p>

                <p>
                    <strong>Mode:</strong>
                    Online + Offline
                </p>

            </div>

        </div>

    </section>

    <!-- Using Service in OnInit -->
    <section class="mb-4">

        <h2 class="fw-bold">4. Using a Service in ngOnInit()</h2>

        <p>
            A service is often used during component initialization to load
            initial application data.
        </p>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>import &#123; Component, OnInit &#125; from '@@angular/core';
import &#123; TrainingService &#125; from './training.service';

@@Component(&#123;
    selector: 'app-dashboard',
    templateUrl: './dashboard.component.html'
&#125;)
export class DashboardComponent implements OnInit &#123;

    courses: string[] = [];

    constructor(
        private trainingService: TrainingService
    ) &#123;

    &#125;

    ngOnInit(): void &#123;

        this.courses =
            this.trainingService.getCourses();

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;h3&gt;
    Available Courses
&lt;/h3&gt;

&lt;ul&gt;

    &lt;li *ngFor="let course of courses"&gt;
        &#123;&#123; course &#125;&#125;
    &lt;/li&gt;

&lt;/ul&gt;</code></pre>

        </div>

        <div class="info-card">

            <h5>Typical Pattern</h5>

            <p>
                The component receives the service through dependency
                injection and calls the service method from
                <strong>ngOnInit()</strong> to prepare the initial data.
            </p>

        </div>

    </section>

    <!-- Service Returning Array -->
    <section class="mb-4">

        <h2 class="fw-bold">5. Using a Service That Returns an Array</h2>

        <p>
            Services can return arrays that can be displayed by components.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseService &#123;

    private courses: string[] = [

        'Java Full Stack',
        'Python Full Stack',
        'Full Stack .NET',
        'Data Analytics',
        'Data Science'

    ];

    getCourses(): string[] &#123;

        return this.courses;

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>courses: string[] = [];

constructor(
    private courseService: CourseService
) &#123;

&#125;

ngOnInit(): void &#123;

    this.courses =
        this.courseService.getCourses();

&#125;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <ul>

                    <li>Java Full Stack</li>
                    <li>Python Full Stack</li>
                    <li>Full Stack .NET</li>
                    <li>Data Analytics</li>
                    <li>Data Science</li>

                </ul>

            </div>

        </div>

    </section>

    <!-- Service with Parameters -->
    <section class="mb-4">

        <h2 class="fw-bold">6. Passing Parameters to Service Methods</h2>

        <p>
            Service methods can accept parameters when a component needs
            dynamic functionality.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>getCourseMessage(courseName: string): string &#123;

    return 'Selected Course: ' + courseName;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>message = '';

constructor(
    private courseService: CourseService
) &#123;

&#125;

selectCourse(course: string): void &#123;

    this.message =
        this.courseService
            .getCourseMessage(course);

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;button
    class="btn btn-primary"
    (click)="selectCourse('Full Stack .NET')"&gt;

    Select Course

&lt;/button&gt;

&lt;p&gt;
    &#123;&#123; message &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                Selected Course:
                <strong>Full Stack .NET</strong>

            </div>

        </div>

    </section>

    <!-- API Service -->
    <section class="mb-4">

        <h2 class="fw-bold">7. Using an API Service</h2>

        <p>
            A service can use HttpClient to communicate with a backend API.
            Components can then subscribe to the returned Observable.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';
import &#123; HttpClient &#125; from '@@angular/common/http';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseService &#123;

    private apiUrl =
        'https://api.example.com/courses';

    constructor(
        private http: HttpClient
    ) &#123;

    &#125;

    getCourses() &#123;

        return this.http.get(this.apiUrl);

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>courses: any[] = [];

constructor(
    private courseService: CourseService
) &#123;

&#125;

ngOnInit(): void &#123;

    this.courseService
        .getCourses()
        .subscribe(data =&gt; &#123;

            this.courses = data;

        &#125;);

&#125;</code></pre>

        </div>

        <div class="binding-flow">

            <div class="binding-item">

                <strong>Component</strong>

                <span>
                    Requests Data
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Service</strong>

                <span>
                    Calls API
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Backend API</strong>

                <span>
                    Returns Data
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Component</strong>

                <span>
                    Displays Data
                </span>

            </div>

        </div>

    </section>

    <!-- Sharing a Service -->
    <section class="mb-4">

        <h2 class="fw-bold">8. Using the Same Service in Multiple Components</h2>

        <p>
            A service can be injected into more than one component when those
            components need the same functionality.
        </p>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-gear-fill"></i>

                <strong>CourseService</strong>

                <span>Shared functionality</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-window"></i>

                <strong>CourseList</strong>

                <span>Uses service</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-speedometer2"></i>

                <strong>Dashboard</strong>

                <span>Uses service</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-bell"></i>

                <strong>Notification</strong>

                <span>Uses service</span>

            </div>

        </div>

    </section>

    <!-- Service Method Categories -->
    <section class="mb-4">

        <h2 class="fw-bold">9. Common Service Responsibilities</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-database"></i>
                </div>

                <h5>Get Data</h5>

                <p>
                    Retrieve application data from local or remote sources.
                </p>

                <code>getCourses()</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-plus-circle"></i>
                </div>

                <h5>Create Data</h5>

                <p>
                    Send or prepare new application data.
                </p>

                <code>addCourse()</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>

                <h5>Update Data</h5>

                <p>
                    Update existing application information.
                </p>

                <code>updateCourse()</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-trash3"></i>
                </div>

                <h5>Delete Data</h5>

                <p>
                    Remove application data through reusable service methods.
                </p>

                <code>deleteCourse()</code>

            </div>

        </div>

    </section>

    <!-- Complete CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">Complete CIIT Training Institute Example</h2>

        <p>
            Suppose the CIIT Training Institute dashboard needs to display
            available courses and training modes. The component can obtain
            this information from a reusable service.
        </p>

        <div class="code-card">

            <div class="code-title">
                training.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

    getInstituteName(): string &#123;

        return 'CIIT Training Institute';

    &#125;

    getCourses(): string[] &#123;

        return [
            'Java Full Stack',
            'Python Full Stack',
            'Full Stack .NET',
            'Data Analytics'
        ];

    &#125;

    getTrainingModes(): string[] &#123;

        return [
            'Online',
            'Offline'
        ];

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.ts
            </div>

            <pre><code>import &#123; Component, OnInit &#125; from '@@angular/core';
import &#123; TrainingService &#125; from './training.service';

@@Component(&#123;
    selector: 'app-dashboard',
    templateUrl: './dashboard.component.html'
&#125;)
export class DashboardComponent implements OnInit &#123;

    instituteName = '';

    courses: string[] = [];

    modes: string[] = [];

    constructor(
        private trainingService: TrainingService
    ) &#123;

    &#125;

    ngOnInit(): void &#123;

        this.instituteName =
            this.trainingService.getInstituteName();

        this.courses =
            this.trainingService.getCourses();

        this.modes =
            this.trainingService.getTrainingModes();

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.html
            </div>

            <pre><code>&lt;h2&gt;
    &#123;&#123; instituteName &#125;&#125;
&lt;/h2&gt;

&lt;h4&gt;
    Available Courses
&lt;/h4&gt;

&lt;ul&gt;

    &lt;li *ngFor="let course of courses"&gt;
        &#123;&#123; course &#125;&#125;
    &lt;/li&gt;

&lt;/ul&gt;

&lt;h4&gt;
    Training Modes
&lt;/h4&gt;

&lt;ul&gt;

    &lt;li *ngFor="let mode of modes"&gt;
        &#123;&#123; mode &#125;&#125;
    &lt;/li&gt;

&lt;/ul&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>
                    CIIT Training Institute
                </h3>

                <p>
                    <strong>Available Courses</strong>
                </p>

                <ul>

                    <li>Java Full Stack</li>
                    <li>Python Full Stack</li>
                    <li>Full Stack .NET</li>
                    <li>Data Analytics</li>

                </ul>

                <p>
                    <strong>Training Modes</strong>
                </p>

                <ul>

                    <li>Online</li>
                    <li>Offline</li>

                </ul>

            </div>

        </div>

    </section>

    <!-- Service Usage Checklist -->
    <section class="mb-4">

        <h2 class="fw-bold">Service Usage Checklist</h2>

        <ul class="best-practice-list">

            <li>
                Inject the required service into the component.
            </li>

            <li>
                Store the injected service in a private property.
            </li>

            <li>
                Call service methods instead of duplicating reusable logic.
            </li>

            <li>
                Use ngOnInit() when initial service data needs to be loaded.
            </li>

            <li>
                Subscribe to Observable results when using API-based services.
            </li>

            <li>
                Keep UI-specific logic in the component and reusable logic in
                the service.
            </li>

        </ul>

    </section>

    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">Using Services Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Inject services instead of creating service objects manually.
            </li>

            <li>
                Keep service responsibilities focused and meaningful.
            </li>

            <li>
                Do not duplicate the same business logic across components.
            </li>

            <li>
                Keep API communication inside dedicated services.
            </li>

            <li>
                Use meaningful method names such as getCourses() and
                getInstituteName().
            </li>

            <li>
                Keep components simple by delegating reusable operations to
                services.
            </li>

        </ul>

    </section>

    <!-- Summary -->
    <section class="summary-box">

        <h3>Summary</h3>

        <p>
            Angular Services are used by injecting them into components through
            Angular's dependency injection system.
        </p>

        <p>
            Once injected, components can call service methods to access data,
            business logic, API functionality, and other reusable operations.
        </p>

    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("CreatingServices", "Services", new { area = "Angular" })">
            ← Creating Services
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("SharingData", "Services", new { area = "Angular" })">
            Sharing Data →
        </a>

    </div>

</div>

