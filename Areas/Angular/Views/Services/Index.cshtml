@{
    ViewData["Title"] = "Angular Services";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">Angular Services</h1>

        <p class="lead text-muted">
            Angular Services are reusable classes used to organize business
            logic, share data, perform API operations, and provide common
            functionality across components.
        </p>

    </section>

    <!-- What is Service -->
    <section class="mb-4">

        <h2 class="fw-bold">What is an Angular Service?</h2>

        <p>
            A service is a reusable TypeScript class that contains logic which
            can be shared by multiple Angular components.
        </p>

        <p>
            Services help keep components simple by moving reusable logic,
            data operations, API calls, and other common functionality into
            separate classes.
        </p>

        <div class="info-card">

            <h5>Simple Definition</h5>

            <p>
                An Angular Service is a reusable class that provides
                functionality to one or more components.
            </p>

        </div>

    </section>

    <!-- Service Flow -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Angular Service Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-display"></i>

                <strong>Component</strong>

                <span>Requests functionality</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-gear-fill"></i>

                <strong>Service</strong>

                <span>Contains reusable logic</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-database"></i>

                <strong>Data / API</strong>

                <span>Processes information</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-arrow-return-left"></i>

                <strong>Component</strong>

                <span>Receives result</span>

            </div>

        </div>

    </section>

    <!-- Why Services -->
    <section class="mb-4">

        <h2 class="fw-bold">Why Use Angular Services?</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <h5>Reusable Logic</h5>

                <p>
                    Write functionality once and reuse it in multiple components.
                </p>

                <code>Reusable Code</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-share"></i>
                </div>

                <h5>Share Data</h5>

                <p>
                    Share application data between different components.
                </p>

                <code>Shared Data</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-cloud-arrow-down"></i>
                </div>

                <h5>API Calls</h5>

                <p>
                    Keep HTTP and API-related operations outside components.
                </p>

                <code>HttpClient</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-code-square"></i>
                </div>

                <h5>Clean Components</h5>

                <p>
                    Keep components focused on UI and user interaction.
                </p>

                <code>Separation</code>

            </div>

        </div>

    </section>

    <!-- Service Structure -->
    <section class="mb-4">

        <h2 class="fw-bold">Basic Service Structure</h2>

        <p>
            An Angular service is normally created as a TypeScript class and
            can be provided using Angular dependency injection.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseService &#123;

    getCourseName(): string &#123;

        return 'Angular Full Stack';

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>Important</h5>

            <p>
                The <strong>@@Injectable()</strong> decorator marks the class
                as available for Angular's dependency injection system.
            </p>

        </div>

    </section>

    <!-- Component and Service -->
    <section class="mb-4">

        <h2 class="fw-bold">Component Using a Service</h2>

        <p>
            A component can receive a service through its constructor and then
            use the service methods.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.component.ts
            </div>

            <pre><code>import &#123; Component &#125; from '@@angular/core';
import &#123; CourseService &#125; from './course.service';

@@Component(&#123;
    selector: 'app-course',
    templateUrl: './course.component.html'
&#125;)
export class CourseComponent &#123;

    courseName = '';

    constructor(
        private courseService: CourseService
    ) &#123;

    &#125;

    loadCourse(): void &#123;

        this.courseName =
            this.courseService.getCourseName();

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                course.component.html
            </div>

            <pre><code>&lt;button
    (click)="loadCourse()"
    class="btn btn-primary"&gt;

    Load Course

&lt;/button&gt;

&lt;p&gt;
    Course:
    &#123;&#123; courseName &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                <p>
                    Course:
                    <strong>Angular Full Stack</strong>
                </p>

            </div>

        </div>

    </section>

    <!-- Service Responsibilities -->
    <section class="mb-4">

        <h2 class="fw-bold">What Can a Service Do?</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-database-check"></i>
                </div>

                <h5>Data Management</h5>

                <p>
                    Store and manage application-related data.
                </p>

                <code>getCourses()</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-cloud"></i>
                </div>

                <h5>API Communication</h5>

                <p>
                    Communicate with backend APIs using HttpClient.
                </p>

                <code>http.get()</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-calculator"></i>
                </div>

                <h5>Business Logic</h5>

                <p>
                    Keep reusable calculations and application rules.
                </p>

                <code>calculateFee()</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-diagram-3"></i>
                </div>

                <h5>Shared State</h5>

                <p>
                    Share information between components when required.
                </p>

                <code>BehaviorSubject</code>

            </div>

        </div>

    </section>

    <!-- Reusable Service -->
    <section class="mb-4">

        <h2 class="fw-bold">1. Reusable Service Example</h2>

        <p>
            The same service can be injected into different components,
            allowing the application to reuse the same logic.
        </p>

        <div class="code-card">

            <div class="code-title">
                notification.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class NotificationService &#123;

    showMessage(message: string): void &#123;

        console.log(message);

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.ts
            </div>

            <pre><code>constructor(
    private notificationService: NotificationService
) &#123;

&#125;

showWelcome(): void &#123;

    this.notificationService.showMessage(
        'Welcome to Angular'
    );

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                The notification logic remains in the service, while the
                component simply calls the required service method.
            </p>

        </div>

    </section>

    <!-- Service Data -->
    <section class="mb-4">

        <h2 class="fw-bold">2. Service for Course Data</h2>

        <p>
            A course service can centralize course-related data and allow
            multiple components to access the same information.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseService &#123;

    private courses: string[] = [
        'Java Full Stack',
        'Python Full Stack',
        'Full Stack .NET',
        'Data Analytics'
    ];

    getCourses(): string[] &#123;

        return this.courses;

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>courses: string[] = [];

constructor(
    private courseService: CourseService
) &#123;

&#125;

ngOnInit(): void &#123;

    this.courses =
        this.courseService.getCourses();

&#125;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>
                    Available Courses
                </h3>

                <ul>

                    <li>Java Full Stack</li>
                    <li>Python Full Stack</li>
                    <li>Full Stack .NET</li>
                    <li>Data Analytics</li>

                </ul>

            </div>

        </div>

    </section>

    <!-- Service and API -->
    <section class="mb-4">

        <h2 class="fw-bold">3. Service for API Communication</h2>

        <p>
            API communication is commonly placed inside a service rather than
            directly inside a component.
        </p>

        <div class="code-card">

            <div class="code-title">
                course.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';
import &#123; HttpClient &#125; from '@@angular/common/http';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseService &#123;

    private apiUrl =
        'https://api.example.com/courses';

    constructor(
        private http: HttpClient
    ) &#123;

    &#125;

    getCourses() &#123;

        return this.http.get(this.apiUrl);

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>ngOnInit(): void &#123;

    this.courseService
        .getCourses()
        .subscribe(data =&gt; &#123;

            this.courses = data;

        &#125;);

&#125;</code></pre>

        </div>

        <div class="binding-flow">

            <div class="binding-item">

                <strong>Component</strong>

                <span>
                    Requests Courses
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>CourseService</strong>

                <span>
                    Performs HTTP Request
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>API</strong>

                <span>
                    Returns Data
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Component</strong>

                <span>
                    Displays Data
                </span>

            </div>

        </div>

    </section>

    <!-- Shared Data -->
    <section class="mb-4">

        <h2 class="fw-bold">4. Sharing Data Between Components</h2>

        <p>
            A service can maintain shared data so that multiple components
            can access the same information.
        </p>

        <div class="code-card">

            <div class="code-title">
                shared-course.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class SharedCourseService &#123;

    selectedCourse = '';

    setCourse(course: string): void &#123;

        this.selectedCourse = course;

    &#125;

    getCourse(): string &#123;

        return this.selectedCourse;

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>Simple Idea</h5>

            <p>
                One component can update shared information through the
                service, while another component can read the same information
                from that service.
            </p>

        </div>

    </section>

    <!-- Service Scope -->
    <section class="mb-4">

        <h2 class="fw-bold">5. Service Scope</h2>

        <p>
            Angular services can be provided at different levels depending on
            how widely the service should be available.
        </p>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>

                        <th>Provider</th>
                        <th>Scope</th>
                        <th>Purpose</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            <code>providedIn: 'root'</code>
                        </td>

                        <td>
                            Application-wide
                        </td>

                        <td>
                            Shared service available throughout the application.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Component Provider
                        </td>

                        <td>
                            Component-level
                        </td>

                        <td>
                            Service instance associated with a component scope.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Module / Injector Scope
                        </td>

                        <td>
                            Specific application scope
                        </td>

                        <td>
                            Used when service availability needs to be restricted.
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Service Injection Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">6. Dependency Injection with Services</h2>

        <p>
            Angular's dependency injection system creates and provides service
            instances to components that request them.
        </p>

        <div class="code-card">

            <div class="code-title">
                Example
            </div>

            <pre><code>constructor(
    private courseService: CourseService
) &#123;

&#125;</code></pre>

        </div>

        <div class="binding-flow">

            <div class="binding-item">

                <strong>Service</strong>

                <span>
                    CourseService
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Injector</strong>

                <span>
                    Resolves Dependency
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Component</strong>

                <span>
                    Receives Service
                </span>

            </div>

        </div>

    </section>

    <!-- Complete CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">Complete CIIT Training Institute Example</h2>

        <p>
            Suppose CIIT Training Institute has a course dashboard that needs
            to display available courses. Instead of keeping course data and
            related logic inside the component, we can place it in a service.
        </p>

        <div class="code-card">

            <div class="code-title">
                training.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

    private courses: string[] = [
        'Java Full Stack',
        'Python Full Stack',
        'Full Stack .NET',
        'Data Analytics'
    ];

    getCourses(): string[] &#123;

        return this.courses;

    &#125;

    getInstituteName(): string &#123;

        return 'CIIT Training Institute';

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.ts
            </div>

            <pre><code>import &#123; Component, OnInit &#125; from '@@angular/core';
import &#123; TrainingService &#125; from './training.service';

@@Component(&#123;
    selector: 'app-dashboard',
    templateUrl: './dashboard.component.html'
&#125;)
export class DashboardComponent
    implements OnInit &#123;

    instituteName = '';

    courses: string[] = [];

    constructor(
        private trainingService: TrainingService
    ) &#123;

    &#125;

    ngOnInit(): void &#123;

        this.instituteName =
            this.trainingService.getInstituteName();

        this.courses =
            this.trainingService.getCourses();

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                dashboard.component.html
            </div>

            <pre><code>&lt;h2&gt;
    &#123;&#123; instituteName &#125;&#125;
&lt;/h2&gt;

&lt;h4&gt;
    Available Courses
&lt;/h4&gt;

&lt;ul&gt;

    &lt;li *ngFor="let course of courses"&gt;
        &#123;&#123; course &#125;&#125;
    &lt;/li&gt;

&lt;/ul&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>
                    CIIT Training Institute
                </h3>

                <p>
                    <strong>Available Courses</strong>
                </p>

                <ul>

                    <li>Java Full Stack</li>
                    <li>Python Full Stack</li>
                    <li>Full Stack .NET</li>
                    <li>Data Analytics</li>

                </ul>

            </div>

        </div>

    </section>

    <!-- Component vs Service -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Component vs Service</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>

                        <th>Component</th>
                        <th>Service</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            Mainly manages UI and user interaction.
                        </td>

                        <td>
                            Mainly manages reusable application logic.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Contains template-related behavior.
                        </td>

                        <td>
                            Can contain data and business logic.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Uses services when functionality is needed.
                        </td>

                        <td>
                            Can be injected into multiple components.
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Should avoid unnecessary reusable logic.
                        </td>

                        <td>
                            Helps keep reusable logic centralized.
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">Important Points About Angular Services</h2>

        <ul class="best-practice-list">

            <li>
                Services are reusable TypeScript classes.
            </li>

            <li>
                Services help separate application logic from UI code.
            </li>

            <li>
                Services can be used for data management and API communication.
            </li>

            <li>
                Multiple components can use the same service.
            </li>

            <li>
                Angular dependency injection provides required services.
            </li>

            <li>
                Services can be used to share data between components.
            </li>

        </ul>

    </section>

    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">Angular Service Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Keep reusable logic inside services instead of duplicating it
                across components.
            </li>

            <li>
                Keep components focused mainly on presentation and interaction.
            </li>

            <li>
                Use meaningful service names such as CourseService or
                TrainingService.
            </li>

            <li>
                Keep API communication inside dedicated services.
            </li>

            <li>
                Avoid putting unrelated responsibilities into one large service.
            </li>

            <li>
                Use dependency injection instead of manually creating service
                instances.
            </li>

        </ul>

    </section>

    <!-- Summary -->
    <section class="summary-box">

        <h3>Summary</h3>

        <p>
            Angular Services are reusable classes that help organize
            application logic, data operations, API communication, and
            shared functionality.
        </p>

        <p>
            By using services with Angular dependency injection, applications
            become more reusable, maintainable, and easier to organize.
        </p>

    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("OnDestroy", "LifecycleHooks", new { area = "Angular" })">
            ← ngOnDestroy
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("CreatingServices", "Services", new { area = "Angular" })">
            Creating Services →
        </a>

    </div>

</div>

<style>

