@{
    ViewData["Title"] = "Sharing Data Between Angular Components";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">Sharing Data Between Components</h1>

        <p class="lead text-muted">
            Angular Services can be used to share data between different
            components. A shared service can store information and provide
            methods that multiple components can use.
        </p>

    </section>

    <!-- What is Sharing Data -->
    <section class="mb-4">

        <h2 class="fw-bold">What Does Sharing Data Mean?</h2>

        <p>
            In Angular applications, different components may need access to
            the same information.
        </p>

        <p>
            Instead of keeping duplicate copies of the same data in multiple
            components, a service can maintain the shared information and
            provide methods for reading and updating it.
        </p>

        <div class="info-card">

            <h5>Simple Definition</h5>

            <p>
                Data sharing through a service means storing common information
                in a reusable service so that multiple components can access it.
            </p>

        </div>

    </section>

    <!-- Sharing Data Flow -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Sharing Data Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-window"></i>

                <strong>Component A</strong>

                <span>Updates data</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-gear-fill"></i>

                <strong>Shared Service</strong>

                <span>Stores data</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-window-stack"></i>

                <strong>Component B</strong>

                <span>Reads data</span>

            </div>

        </div>

    </section>

    <!-- Why Share Data -->
    <section class="mb-4">

        <h2 class="fw-bold">Why Share Data Through a Service?</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-share"></i>
                </div>

                <h5>Common Data</h5>

                <p>
                    Keep information that is required by multiple components
                    in one place.
                </p>

                <code>Shared State</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <h5>Reusable</h5>

                <p>
                    Different components can reuse the same service.
                </p>

                <code>Reuse</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-database"></i>
                </div>

                <h5>Centralized Data</h5>

                <p>
                    Keep related data management inside a single service.
                </p>

                <code>Centralized</code>

            </div>

            <div class="syntax-card">

                <div class="syntax-icon">
                    <i class="bi bi-code-square"></i>
                </div>

                <h5>Clean Components</h5>

                <p>
                    Components can focus on their own UI responsibilities.
                </p>

                <code>Separation</code>

            </div>

        </div>

    </section>

    <!-- Basic Shared Service -->
    <section class="mb-4">

        <h2 class="fw-bold">1. Creating a Shared Data Service</h2>

        <p>
            First, create a service that contains the data which needs to be
            shared.
        </p>

        <div class="code-card">

            <div class="code-title">
                shared-course.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class SharedCourseService &#123;

    selectedCourse = '';

    setCourse(course: string): void &#123;

        this.selectedCourse = course;

    &#125;

    getCourse(): string &#123;

        return this.selectedCourse;

    &#125;

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                The service keeps the selected course in one common property.
                One component can update it using <strong>setCourse()</strong>
                and another component can read it using
                <strong>getCourse()</strong>.
            </p>

        </div>

    </section>

    <!-- Component A -->
    <section class="mb-4">

        <h2 class="fw-bold">2. Updating Shared Data from Component A</h2>

        <p>
            The first component can update the shared data through the service.
        </p>

        <div class="code-card">

            <div class="code-title">
                course-list.component.ts
            </div>

            <pre><code>import &#123; Component &#125; from '@@angular/core';
import &#123; SharedCourseService &#125;
from './shared-course.service';

@@Component(&#123;
    selector: 'app-course-list',
    templateUrl: './course-list.component.html'
&#125;)
export class CourseListComponent &#123;

    constructor(
        private sharedCourseService: SharedCourseService
    ) &#123;

    &#125;

    selectCourse(course: string): void &#123;

        this.sharedCourseService.setCourse(course);

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                course-list.component.html
            </div>

            <pre><code>&lt;button
    class="btn btn-primary"
    (click)="selectCourse('Java Full Stack')"&gt;

    Select Java Full Stack

&lt;/button&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Behavior:</strong>

            <div class="output-preview">

                <p>
                    The selected course is stored inside the shared service.
                </p>

            </div>

        </div>

    </section>

    <!-- Component B -->
    <section class="mb-4">

        <h2 class="fw-bold">3. Reading Shared Data in Component B</h2>

        <p>
            Another component can use the same service to read the shared data.
        </p>

        <div class="code-card">

            <div class="code-title">
                course-details.component.ts
            </div>

            <pre><code>import &#123; Component, OnInit &#125; from '@@angular/core';
import &#123; SharedCourseService &#125;
from './shared-course.service';

@@Component(&#123;
    selector: 'app-course-details',
    templateUrl: './course-details.component.html'
&#125;)
export class CourseDetailsComponent implements OnInit &#123;

    selectedCourse = '';

    constructor(
        private sharedCourseService: SharedCourseService
    ) &#123;

    &#125;

    ngOnInit(): void &#123;

        this.selectedCourse =
            this.sharedCourseService.getCourse();

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                course-details.component.html
            </div>

            <pre><code>&lt;h3&gt;
    Selected Course
&lt;/h3&gt;

&lt;p&gt;
    &#123;&#123; selectedCourse &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="output-preview">

                Selected Course:
                <strong>Java Full Stack</strong>

            </div>

        </div>

    </section>

    <!-- Shared Data Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">4. Complete Shared Data Flow</h2>

        <div class="binding-flow">

            <div class="binding-item">

                <strong>Course List</strong>

                <span>
                    Select Course
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Shared Service</strong>

                <span>
                    Store Course
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Course Details</strong>

                <span>
                    Read Course
                </span>

            </div>

            <div class="binding-arrow">→</div>

            <div class="binding-item">

                <strong>Template</strong>

                <span>
                    Display Course
                </span>

            </div>

        </div>

    </section>

    <!-- Multiple Components -->
    <section class="mb-4">

        <h2 class="fw-bold">5. Sharing Data with Multiple Components</h2>

        <p>
            The same shared service can be injected into multiple components.
        </p>

        <div class="code-card">

            <div class="code-title">
                Shared Service
            </div>

            <pre><code>@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

    selectedCourse = '';

    setCourse(course: string): void &#123;

        this.selectedCourse = course;

    &#125;

    getCourse(): string &#123;

        return this.selectedCourse;

    &#125;

&#125;</code></pre>

        </div>

        <div class="syntax-flow">

            <div class="syntax-box">

                <i class="bi bi-list-ul"></i>

                <strong>Course List</strong>

                <span>Updates course</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-gear"></i>

                <strong>TrainingService</strong>

                <span>Shared data</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-speedometer2"></i>

                <strong>Dashboard</strong>

                <span>Reads course</span>

            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">

                <i class="bi bi-bell"></i>

                <strong>Notification</strong>

                <span>Uses course</span>

            </div>

        </div>

    </section>

    <!-- Sharing Multiple Values -->
    <section class="mb-4">

        <h2 class="fw-bold">6. Sharing Multiple Values</h2>

        <p>
            A service can store more than one value when multiple pieces of
            application information need to be shared.
        </p>

        <div class="code-card">

            <div class="code-title">
                training.service.ts
            </div>

            <pre><code>@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

    selectedCourse = '';

    trainingMode = '';

    trainerName = '';

    setDetails(
        course: string,
        mode: string,
        trainer: string
    ): void &#123;

        this.selectedCourse = course;

        this.trainingMode = mode;

        this.trainerName = trainer;

    &#125;

    getDetails(): any &#123;

        return &#123;

            course: this.selectedCourse,

            mode: this.trainingMode,

            trainer: this.trainerName

        &#125;;

    &#125;

&#125;</code></pre>

        </div>

        <div class="output-box">

            <strong>Example Shared Information:</strong>

            <div class="student-preview">

                <p>
                    <strong>Course:</strong>
                    Full Stack .NET
                </p>

                <p>
                    <strong>Training Mode:</strong>
                    Offline
                </p>

                <p>
                    <strong>Trainer:</strong>
                    CIIT Trainer
                </p>

            </div>

        </div>

    </section>

    <!-- Shared Data with BehaviorSubject -->
    <section class="mb-4">

        <h2 class="fw-bold">7. Sharing Data Dynamically</h2>

        <p>
            When components need to react when shared data changes, a service
            can expose an Observable-based value.
        </p>

        <div class="code-card">

            <div class="code-title">
                training.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';
import &#123; BehaviorSubject &#125; from 'rxjs';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class TrainingService &#123;

    private courseSubject =
        new BehaviorSubject&lt;string&gt;('');

    course$ =
        this.courseSubject.asObservable();

    setCourse(course: string): void &#123;

        this.courseSubject.next(course);

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                Component
            </div>

            <pre><code>ngOnInit(): void &#123;

    this.trainingService.course$
        .subscribe(course =&gt; &#123;

            this.selectedCourse = course;

        &#125;);

&#125;</code></pre>

        </div>

        <div class="info-card">

            <h5>How it works</h5>

            <p>
                The service publishes the latest selected course. Components
                subscribed to that shared value can receive updated data.
            </p>

        </div>

    </section>

    <!-- Data Sharing Comparison -->
    <section class="mb-4">

        <h2 class="fw-bold mb-3">Data Sharing Approaches</h2>

        <div class="table-responsive">

            <table class="table table-bordered syntax-table">

                <thead>

                    <tr>

                        <th>Approach</th>
                        <th>Use</th>
                        <th>Example</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            Service Property
                        </td>

                        <td>
                            Store common data
                        </td>

                        <td>
                            <code>selectedCourse</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Service Methods
                        </td>

                        <td>
                            Update or retrieve shared data
                        </td>

                        <td>
                            <code>setCourse()</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            Observable
                        </td>

                        <td>
                            Notify components about data changes
                        </td>

                        <td>
                            <code>course$</code>
                        </td>

                    </tr>

                    <tr>

                        <td>
                            BehaviorSubject
                        </td>

                        <td>
                            Maintain and emit the latest value
                        </td>

                        <td>
                            <code>BehaviorSubject</code>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

    <!-- Complete CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">Complete CIIT Training Institute Example</h2>

        <p>
            Suppose the CIIT Training Institute website has a course selection
            page and a course summary section. When a user selects a course,
            another component should be able to read the selected course.
        </p>

        <div class="code-card">

            <div class="code-title">
                course-selection.service.ts
            </div>

            <pre><code>import &#123; Injectable &#125; from '@@angular/core';

@@Injectable(&#123;
    providedIn: 'root'
&#125;)
export class CourseSelectionService &#123;

    private selectedCourse = '';

    setSelectedCourse(course: string): void &#123;

        this.selectedCourse = course;

    &#125;

    getSelectedCourse(): string &#123;

        return this.selectedCourse;

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                course-selection.component.ts
            </div>

            <pre><code>import &#123; Component &#125; from '@@angular/core';
import &#123; CourseSelectionService &#125;
from './course-selection.service';

@@Component(&#123;
    selector: 'app-course-selection',
    templateUrl: './course-selection.component.html'
&#125;)
export class CourseSelectionComponent &#123;

    constructor(
        private courseSelectionService:
            CourseSelectionService
    ) &#123;

    &#125;

    selectCourse(course: string): void &#123;

        this.courseSelectionService
            .setSelectedCourse(course);

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                course-selection.component.html
            </div>

            <pre><code>&lt;h3&gt;
    Select a Course
&lt;/h3&gt;

&lt;button
    class="btn btn-primary me-2"
    (click)="selectCourse('Java Full Stack')"&gt;

    Java Full Stack

&lt;/button&gt;

&lt;button
    class="btn btn-primary"
    (click)="selectCourse('Python Full Stack')"&gt;

    Python Full Stack

&lt;/button&gt;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                course-summary.component.ts
            </div>

            <pre><code>import &#123; Component, OnInit &#125; from '@@angular/core';
import &#123; CourseSelectionService &#125;
from './course-selection.service';

@@Component(&#123;
    selector: 'app-course-summary',
    templateUrl: './course-summary.component.html'
&#125;)
export class CourseSummaryComponent implements OnInit &#123;

    selectedCourse = '';

    constructor(
        private courseSelectionService:
            CourseSelectionService
    ) &#123;

    &#125;

    ngOnInit(): void &#123;

        this.selectedCourse =
            this.courseSelectionService
                .getSelectedCourse();

    &#125;

&#125;</code></pre>

        </div>

        <div class="code-card">

            <div class="code-title">
                course-summary.component.html
            </div>

            <pre><code>&lt;h3&gt;
    Course Summary
&lt;/h3&gt;

&lt;p&gt;
    Selected Course:
    &#123;&#123; selectedCourse &#125;&#125;
&lt;/p&gt;</code></pre>

        </div>

        <div class="output-box">

            <strong>Expected Output:</strong>

            <div class="student-preview">

                <h3>
                    Course Summary
                </h3>

                <p>
                    Selected Course:
                    <strong>Java Full Stack</strong>
                </p>

            </div>

        </div>

    </section>

    <!-- Advantages -->
    <section class="mb-4">

        <h2 class="fw-bold">Advantages of Sharing Data Through Services</h2>

        <ul class="best-practice-list">

            <li>
                Multiple components can access common information.
            </li>

            <li>
                Data management can be centralized in one service.
            </li>

            <li>
                Components become simpler and more focused.
            </li>

            <li>
                Repeated data logic can be avoided.
            </li>

            <li>
                Services can provide reusable methods for reading and updating data.
            </li>

            <li>
                Observable-based services can notify components about changes.
            </li>

        </ul>

    </section>

    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">Sharing Data Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Keep shared data related to a clear application responsibility.
            </li>

            <li>
                Use meaningful service and property names.
            </li>

            <li>
                Avoid unnecessary duplication of the same data across components.
            </li>

            <li>
                Use service methods to control how shared data is updated.
            </li>

            <li>
                Use Observable-based patterns when components need to react to
                changing shared data.
            </li>

            <li>
                Keep business logic inside services instead of spreading it
                across multiple components.
            </li>

        </ul>

    </section>

    <!-- Summary -->
    <section class="summary-box">

        <h3>Summary</h3>

        <p>
            Angular Services provide a convenient way to share data between
            different components by keeping common information inside a
            reusable service.
        </p>

        <p>
            Components can update and read shared data through service methods,
            while Observable-based approaches can be used when components need
            to react to data changes.
        </p>

    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("UsingServices", "Services", new { area = "Angular" })">
            ← Using Services
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("ServiceScope", "Services", new { area = "Angular" })">
            Service Scope →
        </a>

    </div>

</div>

