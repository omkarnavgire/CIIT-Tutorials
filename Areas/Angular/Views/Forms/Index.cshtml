@{
    ViewData["Title"] = "Angular Forms";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Angular Forms</h1>

        <p class="lead text-muted">
            Learn how Angular forms collect user input, track form state,
            validate data and submit information in an application.
        </p>
    </section>


    <!-- Introduction -->
    <section class="mb-4">

        <h2 class="fw-bold">What are Angular Forms?</h2>

        <div class="info-card">

            <p>
                Forms are used when an application needs to collect information
                from users.
            </p>

            <p>
                Examples include course enquiries, registration forms,
                login forms, contact forms and application forms.
            </p>

            <p class="mb-0">
                Angular provides two major approaches for working with forms:
                <strong>Template-driven Forms</strong> and
                <strong>Reactive Forms</strong>.
            </p>

        </div>

    </section>


    <!-- Forms Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">Angular Forms Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <strong>User</strong>
                <span>Enters Data</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>Angular Form</strong>
                <span>Tracks Input</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>Validation</strong>
                <span>Checks Data</span>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <strong>Submit</strong>
                <span>Process Data</span>
            </div>

        </div>

    </section>


    <!-- Main Concepts -->
    <section class="mb-4">

        <h2 class="fw-bold">Main Angular Form Concepts</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">1</div>

                <h5>Form Controls</h5>

                <p>
                    Represent individual fields such as name, email or course.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">2</div>

                <h5>Form State</h5>

                <p>
                    Angular tracks whether a form is valid, dirty, touched or submitted.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">3</div>

                <h5>Validation</h5>

                <p>
                    Validation checks whether entered values satisfy requirements.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">4</div>

                <h5>Submission</h5>

                <p>
                    Valid form data can be processed when the user submits the form.
                </p>

            </div>

        </div>

    </section>


    <!-- Two Approaches -->
    <section class="mb-4">

        <h2 class="fw-bold">Two Approaches to Angular Forms</h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>Template-driven</strong>

                <span>
                    Form logic is primarily defined in the template.
                </span>

            </div>

            <div class="syntax-arrow">VS</div>

            <div class="syntax-box">

                <strong>Reactive Forms</strong>

                <span>
                    Form structure and logic are defined in TypeScript.
                </span>

            </div>

        </div>

    </section>


    <!-- Template Driven -->
    <section class="mb-4">

        <h2 class="fw-bold">Template-driven Forms</h2>

        <div class="info-card">

            <p>
                Template-driven forms use Angular directives inside the HTML
                template to create and manage the form.
            </p>

            <p class="mb-0">
                They are useful for simple forms where most of the form behavior
                can be described directly in the template.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Template Example
            </div>

            <pre><code>&lt;form #enquiryForm="ngForm"&gt;

    &lt;input
        type="text"
        name="name"
        ngModel&gt;

    &lt;input
        type="email"
        name="email"
        ngModel&gt;

    &lt;button type="submit"&gt;
        Submit
    &lt;/button&gt;

&lt;/form&gt;</code></pre>

        </div>

    </section>


    <!-- Reactive Forms -->
    <section class="mb-4">

        <h2 class="fw-bold">Reactive Forms</h2>

        <div class="info-card">

            <p>
                Reactive forms create the form model in TypeScript using
                objects such as <strong>FormControl</strong> and
                <strong>FormGroup</strong>.
            </p>

            <p class="mb-0">
                They provide a programmatic approach that is useful for
                complex forms and dynamic validation requirements.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Component Example
            </div>

            <pre><code>import { Component } from '@@angular/core';
import { FormControl, FormGroup } from '@@angular/forms';

@@Component({
    selector: 'app-enquiry',
    templateUrl: './enquiry.component.html'
})
export class EnquiryComponent {

    enquiryForm = new FormGroup({

        name: new FormControl(''),

        email: new FormControl(''),

        course: new FormControl('')

    });

}</code></pre>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;form [formGroup]="enquiryForm"&gt;

    &lt;input
        type="text"
        formControlName="name"&gt;

    &lt;input
        type="email"
        formControlName="email"&gt;

    &lt;input
        type="text"
        formControlName="course"&gt;

&lt;/form&gt;</code></pre>

        </div>

    </section>


    <!-- FormControl -->
    <section class="mb-4">

        <h2 class="fw-bold">FormControl</h2>

        <div class="info-card">

            <p>
                <strong>FormControl</strong> represents a single form field
                and keeps track of its current value and state.
            </p>

            <p class="mb-0">
                For example, an email field can be represented by one
                FormControl.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>email = new FormControl('');</code></pre>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Reading Value
            </div>

            <pre><code>console.log(
    this.email.value
);</code></pre>

        </div>

    </section>


    <!-- FormGroup -->
    <section class="mb-4">

        <h2 class="fw-bold">FormGroup</h2>

        <div class="info-card">

            <p>
                <strong>FormGroup</strong> groups multiple form controls
                into a single form model.
            </p>

            <p class="mb-0">
                It allows the application to manage related fields together.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>registrationForm = new FormGroup({

    name: new FormControl(''),

    email: new FormControl(''),

    mobile: new FormControl(''),

    course: new FormControl('')

});</code></pre>

        </div>

    </section>


    <!-- CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">CIIT Training Institute Example</h2>

        <div class="info-card">

            <p>
                Suppose CIIT Training Institute has an online enquiry form
                where visitors enter their name, email and preferred course.
            </p>

            <p class="mb-0">
                Angular can collect this information and validate it before
                sending the data to the backend.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Enquiry Form
            </div>

            <pre><code>&lt;form&gt;

    &lt;label&gt;
        Name
    &lt;/label&gt;

    &lt;input
        type="text"
        placeholder="Enter your name"&gt;


    &lt;label&gt;
        Email
    &lt;/label&gt;

    &lt;input
        type="email"
        placeholder="Enter your email"&gt;


    &lt;label&gt;
        Course
    &lt;/label&gt;

    &lt;select&gt;

        &lt;option&gt;
            Java Full Stack
        &lt;/option&gt;

        &lt;option&gt;
            .NET Full Stack
        &lt;/option&gt;

        &lt;option&gt;
            Python Full Stack
        &lt;/option&gt;

    &lt;/select&gt;


    &lt;button type="submit"&gt;
        Send Enquiry
    &lt;/button&gt;

&lt;/form&gt;</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>CIIT Training Institute Enquiry</h4>

                <p>
                    Name:
                    <strong>Enter your name</strong>
                </p>

                <p>
                    Email:
                    <strong>Enter your email</strong>
                </p>

                <p class="mb-0">
                    Course:
                    <strong>Select Course</strong>
                </p>

            </div>

        </div>

    </section>


    <!-- Form State -->
    <section class="mb-4">

        <h2 class="fw-bold">Form State</h2>

        <div class="info-card">

            <p>
                Angular tracks the state of form controls and forms.
                This information can be used to decide when to show
                validation messages or enable actions.
            </p>

            <p class="mb-0">
                Common states include <strong>valid</strong>,
                <strong>invalid</strong>, <strong>touched</strong>,
                <strong>untouched</strong>, <strong>dirty</strong> and
                <strong>pristine</strong>.
            </p>

        </div>


        <div class="syntax-grid mt-3">

            <div class="syntax-card">

                <div class="syntax-icon">V</div>

                <h5>Valid</h5>

                <p>
                    Field or form satisfies its validation rules.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">I</div>

                <h5>Invalid</h5>

                <p>
                    One or more validation rules are not satisfied.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">T</div>

                <h5>Touched</h5>

                <p>
                    The user has interacted with the field and left it.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">D</div>

                <h5>Dirty</h5>

                <p>
                    The field value has been changed by the user.
                </p>

            </div>

        </div>

    </section>


    <!-- Validation -->
    <section class="mb-4">

        <h2 class="fw-bold">Form Validation</h2>

        <div class="info-card">

            <p>
                Validation ensures that the entered data satisfies the
                application's requirements before the form is processed.
            </p>

            <p class="mb-0">
                Angular provides built-in validators for common requirements
                such as required fields and email values.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Reactive Form Validation
            </div>

            <pre><code>import { Validators } from '@@angular/forms';

email = new FormControl(
    '',
    [
        Validators.required,
        Validators.email
    ]
);</code></pre>

        </div>

    </section>


    <!-- Validation Message -->
    <section class="mb-4">

        <h2 class="fw-bold">Displaying Validation Message</h2>

        <div class="code-card">

            <div class="code-title">
                Template
            </div>

            <pre><code>&lt;input
    type="email"
    [formControl]="email"&gt;

&lt;div
    *ngIf="email.invalid &amp;&amp; email.touched"&gt;

    Please enter a valid email address.

&lt;/div&gt;</code></pre>

        </div>

    </section>


    <!-- Submission -->
    <section class="mb-4">

        <h2 class="fw-bold">Form Submission</h2>

        <div class="info-card">

            <p>
                When the user submits a form, Angular can collect the
                current form values and send them for further processing.
            </p>

            <p class="mb-0">
                The application should normally validate the form before
                processing or sending its data.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Submit Method
            </div>

            <pre><code>submitForm() {

    if (this.enquiryForm.valid) {

        console.log(
            this.enquiryForm.value
        );

    }

}</code></pre>

        </div>

    </section>


    <!-- Comparison -->
    <section class="mb-4">

        <h2 class="fw-bold">Template-driven vs Reactive Forms</h2>

        <div class="table-responsive">

            <table class="table syntax-table">

                <thead>
                    <tr>
                        <th>Feature</th>
                        <th>Template-driven</th>
                        <th>Reactive</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>Form Definition</td>
                        <td>
                            Mainly in template
                        </td>
                        <td>
                            Mainly in TypeScript
                        </td>
                    </tr>

                    <tr>
                        <td>Form Model</td>
                        <td>
                            Created through directives
                        </td>
                        <td>
                            Explicitly created
                        </td>
                    </tr>

                    <tr>
                        <td>Complexity</td>
                        <td>
                            Good for simpler forms
                        </td>
                        <td>
                            Good for complex forms
                        </td>
                    </tr>

                    <tr>
                        <td>Validation</td>
                        <td>
                            Template-based validators
                        </td>
                        <td>
                            Programmatic validators
                        </td>
                    </tr>

                    <tr>
                        <td>Testing</td>
                        <td>
                            More template-oriented
                        </td>
                        <td>
                            Form model is easier to test independently
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- Common Form Use Cases -->
    <section class="mb-4">

        <h2 class="fw-bold">Common Uses of Angular Forms</h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">L</div>

                <h5>Login</h5>

                <p>
                    Collect username or email and password.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">E</div>

                <h5>Enquiry</h5>

                <p>
                    Collect course and contact information.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">R</div>

                <h5>Registration</h5>

                <p>
                    Capture user registration information.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">C</div>

                <h5>Contact</h5>

                <p>
                    Collect messages and contact details.
                </p>

            </div>

        </div>

    </section>


    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">Important Points</h2>

        <div class="best-practice-list">

            <div class="info-card mb-3">

                <strong>1. Choose the Right Form Approach</strong>

                <p class="mb-0">
                    Use template-driven forms for simpler scenarios and
                    reactive forms when more control is required.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>2. Validate User Input</strong>

                <p class="mb-0">
                    Validate important fields before processing form data.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>3. Track Form State</strong>

                <p class="mb-0">
                    Use form state such as valid, invalid, touched and dirty
                    to control the user experience.
                </p>

            </div>


            <div class="info-card">

                <strong>4. Keep Forms Easy to Understand</strong>

                <p class="mb-0">
                    Use meaningful field names and clear validation messages.
                </p>

            </div>

        </div>

    </section>


    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">Angular Forms Best Practices</h2>

        <ul class="best-practice-list">

            <li>
                Use meaningful names for controls and form fields.
            </li>

            <li>
                Validate user input before processing form data.
            </li>

            <li>
                Display clear and useful validation messages.
            </li>

            <li>
                Keep complex form logic inside the component rather than
                putting unnecessary logic into the template.
            </li>

            <li>
                Use reactive forms when the form has complex validation
                or dynamic controls.
            </li>

            <li>
                Do not submit invalid or incomplete data to the backend.
            </li>

        </ul>

    </section>


    <!-- Summary -->
    <section class="mb-4">

        <div class="summary-box">

            <h4 class="fw-bold">
                Summary
            </h4>

            <p>
                Angular Forms are used to collect, track, validate and submit
                user input.
            </p>

            <p>
                Angular provides two main approaches:
                <strong>Template-driven Forms</strong> and
                <strong>Reactive Forms</strong>.
            </p>

            <p class="mb-0">
                Forms can use controls, validation and form state to create
                reliable user-input workflows.
                In the next topic, we will learn about
                <strong>Template-driven Forms</strong>.
            </p>

        </div>

    </section>


    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("RouteGuards", "Routing", new { area = "Angular" })">
            ← Route Guards
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("TemplateDrivenForms", "Forms", new { area = "Angular" })">
            Template-driven Forms →
        </a>

    </div>

</div>


<style>

    .info-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        line-height: 1.7;
        color: #334155;
    }


    .syntax-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        margin: 25px 0;
    }


    .syntax-box {
        background: linear-gradient(135deg, #2e1065, #4c1d95);
        color: white;
        padding: 18px 25px;
        border-radius: 12px;
        text-align: center;
        min-width: 180px;
        box-shadow: 0 5px 15px rgba(76, 29, 149, 0.15);
    }


        .syntax-box strong {
            display: block;
            font-size: 16px;
        }


        .syntax-box span {
            display: block;
            margin-top: 5px;
            color: #d8c9f5;
            font-size: 14px;
        }


    .syntax-arrow {
        font-size: 28px;
        font-weight: bold;
        color: #4c1d95;
    }


    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }


    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }


        .syntax-card h5 {
            margin-top: 15px;
            font-weight: 700;
            color: #2e1065;
        }


        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
        }


    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 auto;
    }


    .code-card {
        background: #0f172a;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.10);
    }


    .code-title {
        background: #1e293b;
        color: #ffffff;
        padding: 12px 18px;
        font-weight: 700;
        font-size: 14px;
    }


    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }


    .code-card code {
        color: #f8fafc;
        font-size: 14px;
        line-height: 1.7;
    }


    .output-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 20px;
    }


    .student-preview {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
    }


        .student-preview h4 {
            color: #2e1065;
            font-weight: 700;
        }


        .student-preview p {
            color: #64748b;
        }


    .syntax-table {
        width: 100%;
        margin-bottom: 0;
        border: 1px solid #e2e8f0;
    }


        .syntax-table thead th {
            background: #2e1065;
            color: white;
            padding: 14px;
            border-color: #4c1d95;
        }


        .syntax-table tbody td {
            padding: 14px;
            vertical-align: middle;
            color: #334155;
            border-color: #e2e8f0;
        }


        .syntax-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }


        .syntax-table code {
            color: #4c1d95;
            font-weight: 600;
        }


    .best-practice-list {
        margin: 0;
        padding-left: 20px;
    }


        .best-practice-list li {
            margin-bottom: 10px;
            color: #334155;
            line-height: 1.6;
        }


    .summary-box {
        background: #cfe2ff;
        color: #084298;
        border-radius: 10px;
        padding: 22px;
        border: 1px solid #b6d4fe;
    }


        .summary-box h4 {
            margin-bottom: 12px;
        }


    @@media (max-width: 991px) {

        .syntax-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syntax-flow {
            gap: 12px;
        }

        .syntax-box {
            min-width: 160px;
        }
    }


    @@media (max-width: 576px) {

        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-flow {
            flex-direction: column;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }

        .syntax-box {
            width: 100%;
            max-width: 300px;
        }

        .code-card pre {
            padding: 15px;
        }

        .code-card code {
            font-size: 13px;
        }
    }

</style>