@{
    ViewData["Title"] = "Angular Observables";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">
            Angular Observables
        </h1>

        <p class="lead text-muted">
            Learn how Angular uses Observables to work with asynchronous data,
            events, HTTP responses and continuous data streams.
        </p>

    </section>


    <!-- Introduction -->
    <section class="mb-4">

        <h2 class="fw-bold">
            What is an Observable?
        </h2>

        <div class="info-card">

            <p>
                An <strong>Observable</strong> represents a stream of values
                that can arrive over time.
            </p>

            <p>
                Instead of receiving only one value immediately, an Observable
                can emit multiple values during its lifetime.
            </p>

            <p class="mb-0">
                Angular applications commonly use Observables for
                <strong>HTTP requests</strong>, user events, asynchronous
                operations and communication between different parts
                of an application.
            </p>

        </div>

    </section>


    <!-- Observable Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Observable Flow
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>Observable</strong>

                <span>
                    Creates Data Stream
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Subscribe</strong>

                <span>
                    Listen for Values
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Next Value</strong>

                <span>
                    Receive Data
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Complete</strong>

                <span>
                    Stream Ends
                </span>

            </div>

        </div>

    </section>


    <!-- Main Concepts -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Main Observable Concepts
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    O
                </div>

                <h5>
                    Observable
                </h5>

                <p>
                    Represents a sequence of values over time.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    S
                </div>

                <h5>
                    Subscribe
                </h5>

                <p>
                    Starts listening to values emitted by an Observable.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    N
                </div>

                <h5>
                    next
                </h5>

                <p>
                    Handles values emitted by the Observable.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    C
                </div>

                <h5>
                    complete
                </h5>

                <p>
                    Runs when the Observable finishes emitting values.
                </p>

            </div>

        </div>

    </section>


    <!-- RxJS -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Observables and RxJS
        </h2>

        <div class="info-card">

            <p>
                Angular commonly works with Observables through
                <strong>RxJS</strong>, a library for reactive programming
                using Observables and operators.
            </p>

            <p class="mb-0">
                RxJS provides the tools used to create, transform, combine
                and subscribe to Observable streams.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Import Observable
            </div>

            <pre><code>import { Observable }
    from '@@rxjs';</code></pre>

        </div>

    </section>


    <!-- Simple Observable -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Creating a Simple Observable
        </h2>

        <div class="info-card">

            <p>
                An Observable can be created using the
                <strong>Observable</strong> class.
            </p>

            <p class="mb-0">
                The subscriber receives values through the
                <strong>next()</strong> method.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>import { Observable }
    from '@@rxjs';

const numbers$ =
    new Observable&lt;number&gt;(subscriber =&gt; {

        subscriber.next(10);
        subscriber.next(20);
        subscriber.next(30);

    });</code></pre>

        </div>

    </section>


    <!-- Subscribe -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Subscribing to an Observable
        </h2>

        <div class="info-card">

            <p>
                To receive values emitted by an Observable, a component
                or service can subscribe to it.
            </p>

            <p class="mb-0">
                The subscription receives each value when it is emitted.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>numbers$.subscribe({

    next: value =&gt; {

        console.log(value);

    },

    complete: () =&gt; {

        console.log('Completed');

    }

});</code></pre>

        </div>

    </section>


    <!-- Data Stream -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Observable as a Data Stream
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>10</strong>

                <span>
                    First Value
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>20</strong>

                <span>
                    Second Value
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>30</strong>

                <span>
                    Third Value
                </span>

            </div>

        </div>


        <div class="output-box">

            <div class="student-preview">

                <h4>
                    Data Stream
                </h4>

                <p>
                    Value 1:
                    <strong>10</strong>
                </p>

                <p>
                    Value 2:
                    <strong>20</strong>
                </p>

                <p class="mb-0">
                    Value 3:
                    <strong>30</strong>
                </p>

            </div>

        </div>

    </section>


    <!-- next -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Handling next Values
        </h2>

        <div class="info-card">

            <p>
                The <strong>next</strong> callback receives each value
                emitted by the Observable.
            </p>

            <p class="mb-0">
                This is where the application can update its state,
                display data or perform another operation.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>data$.subscribe({

    next: value =&gt; {

        console.log(
            'Received:',
            value
        );

    }

});</code></pre>

        </div>

    </section>


    <!-- Error -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Handling Observable Errors
        </h2>

        <div class="info-card">

            <p>
                An Observable can also report an error.
            </p>

            <p class="mb-0">
                The <strong>error</strong> callback can be used to handle
                an error emitted by the Observable.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>data$.subscribe({

    next: value =&gt; {

        console.log(value);

    },

    error: error =&gt; {

        console.error(
            'Error:',
            error
        );

    }

});</code></pre>

        </div>

    </section>


    <!-- Complete -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Handling complete
        </h2>

        <div class="info-card">

            <p>
                The <strong>complete</strong> callback runs when the
                Observable finishes successfully.
            </p>

            <p class="mb-0">
                It is useful when the application needs to perform some
                action after the stream has ended.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>data$.subscribe({

    next: value =&gt; {

        console.log(value);

    },

    complete: () =&gt; {

        console.log(
            'Observable completed'
        );

    }

});</code></pre>

        </div>

    </section>


    <!-- CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">
            CIIT Training Institute Example
        </h2>

        <div class="info-card">

            <p>
                Suppose the CIIT Training Institute website receives a stream
                of course enquiry updates.
            </p>

            <p class="mb-0">
                An Observable can represent this stream and a component can
                subscribe to receive each new enquiry.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Enquiry Observable
            </div>

            <pre><code>import { Observable }
    from '@@rxjs';

const enquiry$ =
    new Observable&lt;string&gt;(subscriber =&gt; {

        subscriber.next(
            'New Java Full Stack enquiry'
        );

        subscriber.next(
            'New .NET Full Stack enquiry'
        );

        subscriber.next(
            'New Python Full Stack enquiry'
        );

    });</code></pre>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Subscribe
            </div>

            <pre><code>enquiry$.subscribe({

    next: enquiry =&gt; {

        console.log(
            enquiry
        );

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    CIIT Training Institute
                </h4>

                <p>
                    New Java Full Stack enquiry
                </p>

                <p>
                    New .NET Full Stack enquiry
                </p>

                <p class="mb-0">
                    New Python Full Stack enquiry
                </p>

            </div>

        </div>

    </section>


    <!-- HTTP -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Observables with HttpClient
        </h2>

        <div class="info-card">

            <p>
                Angular's <strong>HttpClient</strong> commonly returns
                Observables for HTTP operations.
            </p>

            <p class="mb-0">
                A component or service can subscribe to the returned
                Observable to receive the response.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Service Example
            </div>

            <pre><code>getCourses() {

    return this.http.get&lt;Course[]&gt;(
        '/api/courses'
    );

}</code></pre>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Component
            </div>

            <pre><code>this.courseService
    .getCourses()
    .subscribe({

        next: courses =&gt; {

            console.log(courses);

        },

        error: error =&gt; {

            console.error(error);

        }

    });</code></pre>

        </div>

    </section>


    <!-- Observable vs Normal Value -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Observable vs Normal Value
        </h2>

        <div class="table-responsive">

            <table class="table syntax-table">

                <thead>

                    <tr>

                        <th>
                            Feature
                        </th>

                        <th>
                            Normal Value
                        </th>

                        <th>
                            Observable
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <tr>

                        <td>
                            Values
                        </td>

                        <td>
                            Usually one current value
                        </td>

                        <td>
                            Can emit values over time
                        </td>

                    </tr>


                    <tr>

                        <td>
                            Asynchronous Work
                        </td>

                        <td>
                            Not designed specifically for streams
                        </td>

                        <td>
                            Commonly used for asynchronous streams
                        </td>

                    </tr>


                    <tr>

                        <td>
                            Subscription
                        </td>

                        <td>
                            Not required
                        </td>

                        <td>
                            Commonly consumed through subscription
                        </td>

                    </tr>


                    <tr>

                        <td>
                            Multiple Values
                        </td>

                        <td>
                            Not represented as a stream
                        </td>

                        <td>
                            Can emit multiple values
                        </td>

                    </tr>


                    <tr>

                        <td>
                            RxJS Operators
                        </td>

                        <td>
                            Not applicable
                        </td>

                        <td>
                            Can be used to transform streams
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- Observable Lifecycle -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Observable Lifecycle
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    1
                </div>

                <h5>
                    Create
                </h5>

                <p>
                    An Observable is created or obtained from a source.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    2
                </div>

                <h5>
                    Subscribe
                </h5>

                <p>
                    A consumer subscribes to receive emitted values.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    3
                </div>

                <h5>
                    Emit
                </h5>

                <p>
                    The Observable emits zero or more values.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    4
                </div>

                <h5>
                    Complete / Error
                </h5>

                <p>
                    The stream can complete or report an error.
                </p>

            </div>

        </div>

    </section>


    <!-- Cold Observable -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Observable Execution
        </h2>

        <div class="info-card">

            <p>
                An Observable describes how a stream of values can be
                produced and consumed.
            </p>

            <p class="mb-0">
                The behavior of a particular Observable depends on how
                it is created and what source it represents.
            </p>

        </div>

    </section>


    <!-- Subscription -->
    <section class="mb-4">

        <h2 class="fw-bold">
            What is a Subscription?
        </h2>

        <div class="info-card">

            <p>
                A <strong>Subscription</strong> represents an active
                execution of an Observable.
            </p>

            <p class="mb-0">
                A subscription can also be used to stop that execution
                when it is no longer needed.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const subscription =
    data$.subscribe({

        next: value =&gt; {

            console.log(value);

        }

    });</code></pre>

        </div>

    </section>


    <!-- Best Use Cases -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Common Uses of Observables
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    H
                </div>

                <h5>
                    HTTP
                </h5>

                <p>
                    Handle asynchronous HTTP responses.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    E
                </div>

                <h5>
                    Events
                </h5>

                <p>
                    Represent values from event-based sources.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    D
                </div>

                <h5>
                    Data Streams
                </h5>

                <p>
                    Work with values arriving continuously over time.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    R
                </div>

                <h5>
                    Reactive Logic
                </h5>

                <p>
                    Transform and combine asynchronous data streams.
                </p>

            </div>

        </div>

    </section>


    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Important Points
        </h2>

        <div class="best-practice-list">

            <div class="info-card mb-3">

                <strong>
                    1. Observable Represents a Stream
                </strong>

                <p class="mb-0">
                    An Observable can emit values over time rather than
                    representing only one immediate value.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>
                    2. Subscribe to Receive Values
                </strong>

                <p class="mb-0">
                    A consumer generally subscribes to an Observable
                    to receive its emitted values.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>
                    3. Handle Errors
                </strong>

                <p class="mb-0">
                    Use the error callback when the Observable reports
                    an error.
                </p>

            </div>


            <div class="info-card">

                <strong>
                    4. Manage Subscriptions
                </strong>

                <p class="mb-0">
                    Long-lived subscriptions should be managed carefully
                    so they do not remain active unnecessarily.
                </p>

            </div>

        </div>

    </section>


    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Observable Best Practices
        </h2>

        <ul class="best-practice-list">

            <li>
                Understand whether the Observable emits one value or
                multiple values over time.
            </li>

            <li>
                Handle the <code>next</code>, <code>error</code> and
                <code>complete</code> callbacks when appropriate.
            </li>

            <li>
                Keep data-stream transformations separate from UI-specific
                logic where practical.
            </li>

            <li>
                Manage long-lived subscriptions carefully.
            </li>

            <li>
                Use RxJS operators when data needs to be transformed,
                filtered or combined.
            </li>

            <li>
                Avoid unnecessary subscriptions when Angular template
                features can manage the stream for the required scenario.
            </li>

        </ul>

    </section>


    <!-- Summary -->
    <section class="mb-4">

        <div class="summary-box">

            <h4 class="fw-bold">
                Summary
            </h4>

            <p>
                An Observable represents a stream of values that can be
                emitted over time.
            </p>

            <p>
                In Angular applications, Observables are commonly used
                for asynchronous data such as HTTP responses and
                event-based streams.
            </p>

            <p class="mb-0">
                Important concepts include
                <strong>Observable</strong>,
                <strong>Subscription</strong>,
                <strong>next</strong>,
                <strong>error</strong> and
                <strong>complete</strong>.
                In the next topic, we will learn about
                <strong>Subscription</strong>.
            </p>

        </div>

    </section>


    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("FormSubmission", "Forms", new { area = "Angular" })">

            ← Form Submission

        </a>


        <a class="btn btn-primary"
           href="@Url.Action("Subscription", "Observables", new { area = "Angular" })">

            Subscription →

        </a>

    </div>

</div>


<style>

    .info-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        line-height: 1.7;
        color: #334155;
    }


    .syntax-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        margin: 25px 0;
    }


    .syntax-box {
        background: linear-gradient( 135deg, #2e1065, #4c1d95 );
        color: white;
        padding: 18px 25px;
        border-radius: 12px;
        text-align: center;
        min-width: 180px;
        box-shadow: 0 5px 15px rgba(76, 29, 149, 0.15);
    }


        .syntax-box strong {
            display: block;
            font-size: 16px;
        }


        .syntax-box span {
            display: block;
            margin-top: 5px;
            color: #d8c9f5;
            font-size: 14px;
        }


    .syntax-arrow {
        font-size: 28px;
        font-weight: bold;
        color: #4c1d95;
    }


    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }


    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }


        .syntax-card h5 {
            margin-top: 15px;
            font-weight: 700;
            color: #2e1065;
        }


        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
        }


    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 auto;
    }


    .code-card {
        background: #0f172a;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.10);
    }


    .code-title {
        background: #1e293b;
        color: #ffffff;
        padding: 12px 18px;
        font-weight: 700;
        font-size: 14px;
    }


    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }


    .code-card code {
        color: #f8fafc;
        font-size: 14px;
        line-height: 1.7;
    }


    .output-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 20px;
    }


    .student-preview {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
    }


        .student-preview h4 {
            color: #2e1065;
            font-weight: 700;
        }


        .student-preview p {
            color: #64748b;
        }


    .syntax-table {
        width: 100%;
        margin-bottom: 0;
        border: 1px solid #e2e8f0;
    }


        .syntax-table thead th {
            background: #2e1065;
            color: white;
            padding: 14px;
            border-color: #4c1d95;
        }


        .syntax-table tbody td {
            padding: 14px;
            vertical-align: middle;
            color: #334155;
            border-color: #e2e8f0;
        }


        .syntax-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }


        .syntax-table code {
            color: #4c1d95;
            font-weight: 600;
        }


    .best-practice-list {
        margin: 0;
        padding-left: 20px;
    }


        .best-practice-list li {
            margin-bottom: 10px;
            color: #334155;
            line-height: 1.6;
        }


    .summary-box {
        background: #cfe2ff;
        color: #084298;
        border-radius: 10px;
        padding: 22px;
        border: 1px solid #b6d4fe;
    }


        .summary-box h4 {
            margin-bottom: 12px;
        }


    @@media (max-width: 991px) {

        .syntax-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syntax-flow {
            gap: 12px;
        }

        .syntax-box {
            min-width: 160px;
        }
    }


    @@media (max-width: 576px) {

        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-flow {
            flex-direction: column;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }

