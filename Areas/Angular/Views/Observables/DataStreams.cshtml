@{
    ViewData["Title"] = "Angular Data Streams";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">

        <h1 class="fw-bold text-dark">
            Angular Data Streams
        </h1>

        <p class="lead text-muted">
            Learn how data can flow through an Observable over time and how
            Angular applications can work with synchronous and asynchronous
            data streams.
        </p>

    </section>


    <!-- Introduction -->
    <section class="mb-4">

        <h2 class="fw-bold">
            What is a Data Stream?
        </h2>

        <div class="info-card">

            <p>
                A <strong>data stream</strong> is a sequence of values that
                can become available one after another.
            </p>

            <p>
                An Observable can represent that stream and emit values
                whenever they become available.
            </p>

            <p class="mb-0">
                The values may represent numbers, strings, objects,
                HTTP responses, events or other application data.
            </p>

        </div>

    </section>


    <!-- Data Stream Flow -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Data Stream Flow
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>Data Source</strong>

                <span>
                    Produces Data
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Observable</strong>

                <span>
                    Represents Stream
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Subscriber</strong>

                <span>
                    Receives Values
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>Application</strong>

                <span>
                    Uses Data
                </span>

            </div>

        </div>

    </section>


    <!-- Types -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Types of Data Streams
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    S
                </div>

                <h5>
                    Synchronous
                </h5>

                <p>
                    Values can be emitted immediately during execution.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    A
                </div>

                <h5>
                    Asynchronous
                </h5>

                <p>
                    Values can arrive later as asynchronous work completes.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    M
                </div>

                <h5>
                    Multiple Values
                </h5>

                <p>
                    A stream can emit multiple values over time.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    T
                </div>

                <h5>
                    Time Based
                </h5>

                <p>
                    Some streams emit values according to time intervals.
                </p>

            </div>

        </div>

    </section>


    <!-- Simple Data Stream -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Simple Data Stream
        </h2>

        <p>
            An Observable can emit a sequence of values one after another.
        </p>

        <div class="code-card">

            <div class="code-title">
                TypeScript
            </div>

            <pre><code>const numbers$ =
    new Observable&lt;number&gt;(subscriber =&gt; {

        subscriber.next(10);
        subscriber.next(20);
        subscriber.next(30);

        subscriber.complete();

    });</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Stream Values
                </h4>

                <p>
                    10
                </p>

                <p>
                    20
                </p>

                <p class="mb-0">
                    30
                </p>

            </div>

        </div>

    </section>


    <!-- of -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Creating a Stream with of()
        </h2>

        <div class="info-card">

            <p>
                The <strong>of()</strong> creation function can be used to
                create an Observable that emits the supplied values.
            </p>

            <p class="mb-0">
                It is useful when we already have a small set of values
                that we want to represent as an Observable stream.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const courses$ = of(
    'Java Full Stack',
    '.NET Full Stack',
    'Python Full Stack'
);

courses$.subscribe({

    next: course =&gt; {

        console.log(course);

    }

});</code></pre>

        </div>

    </section>


    <!-- from -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Creating a Stream with from()
        </h2>

        <div class="info-card">

            <p>
                The <strong>from()</strong> creation function can create
                an Observable from supported iterable or promise-like
                sources.
            </p>

            <p class="mb-0">
                For example, an array can be converted into an Observable
                stream.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const technologies = [
    'Angular',
    'TypeScript',
    'RxJS'
];

const technology$ =
    from(technologies);

technology$.subscribe({

    next: technology =&gt; {

        console.log(technology);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Output
                </h4>

                <p>
                    Angular
                </p>

                <p>
                    TypeScript
                </p>

                <p class="mb-0">
                    RxJS
                </p>

            </div>

        </div>

    </section>


    <!-- interval -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Time-Based Data Stream
        </h2>

        <div class="info-card">

            <p>
                The <strong>interval()</strong> creation function produces
                sequential numbers at a specified time interval.
            </p>

            <p class="mb-0">
                This is an example of a time-based Observable stream.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example
            </div>

            <pre><code>const counter$ =
    interval(1000);

counter$.subscribe({

    next: value =&gt; {

        console.log(value);

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    Example Output
                </h4>

                <p>
                    0
                </p>

                <p>
                    1
                </p>

                <p>
                    2
                </p>

                <p class="mb-0">
                    3 ...
                </p>

            </div>

        </div>

    </section>


    <!-- Stream Timeline -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Data Stream Over Time
        </h2>

        <div class="syntax-flow">

            <div class="syntax-box">

                <strong>0</strong>

                <span>
                    First Value
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>1</strong>

                <span>
                    Next Value
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>2</strong>

                <span>
                    Next Value
                </span>

            </div>


            <div class="syntax-arrow">
                →
            </div>


            <div class="syntax-box">

                <strong>3</strong>

                <span>
                    Next Value
                </span>

            </div>

        </div>

        <div class="info-card">

            <p class="mb-0">
                Each emitted value becomes available to the subscriber
                through the <strong>next</strong> callback.
            </p>

        </div>

    </section>


    <!-- HTTP Data Stream -->
    <section class="mb-4">

        <h2 class="fw-bold">
            HTTP Response as a Data Stream
        </h2>

        <div class="info-card">

            <p>
                Angular HttpClient commonly exposes HTTP operations as
                Observables.
            </p>

            <p class="mb-0">
                The application can subscribe to the Observable and
                receive the response when it becomes available.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Service
            </div>

            <pre><code>getCourses() {

    return this.http.get&lt;Course[]&gt;(
        '/api/courses'
    );

}</code></pre>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Component
            </div>

            <pre><code>this.courseService
    .getCourses()
    .subscribe({

        next: courses =&gt; {

            this.courses = courses;

        },

        error: error =&gt; {

            console.error(error);

        }

    });</code></pre>

        </div>

    </section>


    <!-- Event Stream -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Event Data Stream
        </h2>

        <div class="info-card">

            <p>
                User interactions can also be represented as streams of
                events.
            </p>

            <p class="mb-0">
                For example, repeated button clicks or input changes can
                produce a sequence of event values.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Example Concept
            </div>

            <pre><code>User Action
      ↓
Event Source
      ↓
Observable Stream
      ↓
Subscriber
      ↓
Application Logic</code></pre>

        </div>

    </section>


    <!-- CIIT Example -->
    <section class="mb-4">

        <h2 class="fw-bold">
            CIIT Training Institute Example
        </h2>

        <div class="info-card">

            <p>
                Suppose the CIIT Training Institute dashboard receives
                course enquiry updates throughout the day.
            </p>

            <p class="mb-0">
                Every enquiry can become a value in a data stream.
                The dashboard can subscribe to that stream and process
                each enquiry.
            </p>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Enquiry Data Stream
            </div>

            <pre><code>const enquiries$ =
    new Observable&lt;string&gt;(subscriber =&gt; {

        subscriber.next(
            'Java Full Stack enquiry'
        );

        subscriber.next(
            '.NET Full Stack enquiry'
        );

        subscriber.next(
            'Python Full Stack enquiry'
        );

        subscriber.complete();

    });</code></pre>

        </div>


        <div class="code-card mt-3">

            <div class="code-title">
                Subscribe
            </div>

            <pre><code>enquiries$.subscribe({

    next: enquiry =&gt; {

        console.log(
            'New enquiry:',
            enquiry
        );

    },

    complete: () =&gt; {

        console.log(
            'Enquiry stream completed'
        );

    }

});</code></pre>

        </div>


        <div class="output-box mt-3">

            <div class="student-preview">

                <h4>
                    CIIT Enquiry Dashboard
                </h4>

                <p>
                    Java Full Stack enquiry
                </p>

                <p>
                    .NET Full Stack enquiry
                </p>

                <p class="mb-0">
                    Python Full Stack enquiry
                </p>

            </div>

        </div>

    </section>


    <!-- Stream Sources -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Common Data Stream Sources
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    H
                </div>

                <h5>
                    HTTP
                </h5>

                <p>
                    API responses received asynchronously.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    E
                </div>

                <h5>
                    Events
                </h5>

                <p>
                    User actions and browser events.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    T
                </div>

                <h5>
                    Timer
                </h5>

                <p>
                    Values generated according to time.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    D
                </div>

                <h5>
                    Data Source
                </h5>

                <p>
                    Application data represented as an Observable.
                </p>

            </div>

        </div>

    </section>


    <!-- Stream Types Table -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Data Stream Examples
        </h2>

        <div class="table-responsive">

            <table class="table syntax-table">

                <thead>

                    <tr>

                        <th>
                            Source
                        </th>

                        <th>
                            Example
                        </th>

                        <th>
                            Stream Behavior
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <tr>

                        <td>
                            Array
                        </td>

                        <td>
                            from(technologies)
                        </td>

                        <td>
                            Emits array values
                        </td>

                    </tr>


                    <tr>

                        <td>
                            Direct Values
                        </td>

                        <td>
                            of(10, 20, 30)
                        </td>

                        <td>
                            Emits supplied values
                        </td>

                    </tr>


                    <tr>

                        <td>
                            Timer
                        </td>

                        <td>
                            interval(1000)
                        </td>

                        <td>
                            Emits values periodically
                        </td>

                    </tr>


                    <tr>

                        <td>
                            HTTP
                        </td>

                        <td>
                            http.get()
                        </td>

                        <td>
                            Produces HTTP response data
                        </td>

                    </tr>


                    <tr>

                        <td>
                            Events
                        </td>

                        <td>
                            User interaction
                        </td>

                        <td>
                            Values can arrive as events occur
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- Stream States -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Data Stream States
        </h2>

        <div class="syntax-grid">

            <div class="syntax-card">

                <div class="syntax-icon">
                    N
                </div>

                <h5>
                    Next
                </h5>

                <p>
                    A value is emitted by the stream.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    E
                </div>

                <h5>
                    Error
                </h5>

                <p>
                    The stream reports an error.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    C
                </div>

                <h5>
                    Complete
                </h5>

                <p>
                    The stream finishes successfully.
                </p>

            </div>


            <div class="syntax-card">

                <div class="syntax-icon">
                    U
                </div>

                <h5>
                    Unsubscribe
                </h5>

                <p>
                    The consumer stops its subscription.
                </p>

            </div>

        </div>

    </section>


    <!-- Why Streams -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Why Use Data Streams?
        </h2>

        <ul class="best-practice-list">

            <li>
                They represent values that can arrive over time.
            </li>

            <li>
                They are useful for asynchronous application operations.
            </li>

            <li>
                They provide a consistent way to consume different
                sources of data.
            </li>

            <li>
                RxJS operators can transform and combine streams.
            </li>

            <li>
                They are useful for HTTP, events, timers and other
                asynchronous scenarios.
            </li>

        </ul>

    </section>


    <!-- Important Points -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Important Points
        </h2>

        <div class="best-practice-list">

            <div class="info-card mb-3">

                <strong>
                    1. Stream Represents Sequence
                </strong>

                <p class="mb-0">
                    A data stream represents values that can be emitted
                    one after another.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>
                    2. Observable Represents the Stream
                </strong>

                <p class="mb-0">
                    An Observable provides a way to represent and consume
                    the data stream.
                </p>

            </div>


            <div class="info-card mb-3">

                <strong>
                    3. Values Can Arrive Over Time
                </strong>

                <p class="mb-0">
                    Some streams emit values immediately while others
                    produce values asynchronously.
                </p>

            </div>


            <div class="info-card">

                <strong>
                    4. Streams Can Be Transformed
                </strong>

                <p class="mb-0">
                    RxJS operators can be applied when data needs to be
                    transformed, filtered or combined.
                </p>

            </div>

        </div>

    </section>


    <!-- Best Practices -->
    <section class="mb-4">

        <h2 class="fw-bold">
            Data Stream Best Practices
        </h2>

        <ul class="best-practice-list">

            <li>
                Understand where the stream data is coming from.
            </li>

            <li>
                Use meaningful names for Observable variables.
            </li>

            <li>
                Handle errors for important asynchronous operations.
            </li>

            <li>
                Manage long-lived streams carefully.
            </li>

            <li>
                Use RxJS operators when the data needs transformation.
            </li>

            <li>
                Avoid unnecessary active subscriptions.
            </li>

        </ul>

    </section>


    <!-- Summary -->
    <section class="mb-4">

        <div class="summary-box">

            <h4 class="fw-bold">
                Summary
            </h4>

            <p>
                A data stream represents a sequence of values that can be
                emitted over time.
            </p>

            <p>
                Angular applications can work with streams produced by
                HTTP calls, events, timers and other data sources.
            </p>

            <p class="mb-0">
                Observables provide a way to represent and consume these
                streams. In the next topic, we will learn about
                <strong>Observable Operators</strong>.
            </p>

        </div>

    </section>


    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Subscription", "Observables", new { area = "Angular" })">

            ← Subscription

        </a>


        <a class="btn btn-primary"
           href="@Url.Action("Operators", "Observables", new { area = "Angular" })">

            Operators →

        </a>

    </div>

</div>


<style>

    .info-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 5px solid #4c1d95;
        border-radius: 10px;
        padding: 20px;
        line-height: 1.7;
        color: #334155;
    }


    .syntax-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        margin: 25px 0;
    }


    .syntax-box {
        background: linear-gradient( 135deg, #2e1065, #4c1d95 );
        color: white;
        padding: 18px 25px;
        border-radius: 12px;
        text-align: center;
        min-width: 180px;
        box-shadow: 0 5px 15px rgba(76, 29, 149, 0.15);
    }


        .syntax-box strong {
            display: block;
            font-size: 16px;
        }


        .syntax-box span {
            display: block;
            margin-top: 5px;
            color: #d8c9f5;
            font-size: 14px;
        }


    .syntax-arrow {
        font-size: 28px;
        font-weight: bold;
        color: #4c1d95;
    }


    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }


    .syntax-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        text-align: center;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }


        .syntax-card h5 {
            margin-top: 15px;
            font-weight: 700;
            color: #2e1065;
        }


        .syntax-card p {
            color: #64748b;
            margin-bottom: 0;
            line-height: 1.6;
        }


    .syntax-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4c1d95;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin: 0 auto;
    }


    .code-card {
        background: #0f172a;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.10);
    }


    .code-title {
        background: #1e293b;
        color: #ffffff;
        padding: 12px 18px;
        font-weight: 700;
        font-size: 14px;
    }


    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }


    .code-card code {
        color: #f8fafc;
        font-size: 14px;
        line-height: 1.7;
    }


    .output-box {
        background: #f8fafc;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 20px;
    }


    .student-preview {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
    }


        .student-preview h4 {
            color: #2e1065;
            font-weight: 700;
        }


        .student-preview p {
            color: #64748b;
        }


    .syntax-table {
        width: 100%;
        margin-bottom: 0;
        border: 1px solid #e2e8f0;
    }


        .syntax-table thead th {
            background: #2e1065;
            color: white;
            padding: 14px;
            border-color: #4c1d95;
        }


        .syntax-table tbody td {
            padding: 14px;
            vertical-align: middle;
            color: #334155;
            border-color: #e2e8f0;
        }


        .syntax-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }


        .syntax-table code {
            color: #4c1d95;
            font-weight: 600;
        }


    .best-practice-list {
        margin: 0;
        padding-left: 20px;
    }


        .best-practice-list li {
            margin-bottom: 10px;
            color: #334155;
            line-height: 1.6;
        }


    .summary-box {
        background: #cfe2ff;
        color: #084298;
        border-radius: 10px;
        padding: 22px;
        border: 1px solid #b6d4fe;
    }


        .summary-box h4 {
            margin-bottom: 12px;
        }


    @@media (max-width: 991px) {

        .syntax-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syntax-flow {
            gap: 12px;
        }

        .syntax-box {
            min-width: 160px;
        }
    }


    @@media (max-width: 576px) {

        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-flow {
            flex-direction: column;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }

        .syntax-box {
            width: 100%;
            max-width: 300px;
        }

        .code-card pre {
            padding: 15px;
        }

        .code-card code {
            font-size: 13px;
        }
    }

</style>