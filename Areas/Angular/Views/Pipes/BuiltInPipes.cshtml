@{
    ViewData["Title"] = "Built-in Pipes";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <section class="mb-4">
        <h1 class="fw-bold text-dark">Built-in Pipes</h1>
        <p class="lead text-muted">
            Learn the commonly used built-in Angular Pipes for formatting
            strings, numbers, dates, currencies, and other values.
        </p>
    </section>

    <!-- What are Built-in Pipes -->
    <section class="mb-4">
        <h2 class="fw-bold">What are Built-in Pipes?</h2>

        <div class="info-card">
            <p>
                Angular provides several built-in pipes that can be used
                directly inside templates to transform and format data.
            </p>

            <p class="mb-0">
                These pipes help display component data in a clean and
                user-friendly format without modifying the original value.
            </p>
        </div>
    </section>

    <!-- Flow -->
    <section class="mb-4">
        <h2 class="fw-bold">Built-in Pipe Flow</h2>

        <div class="syntax-flow">

            <div class="syntax-box">
                <div class="syntax-icon">1</div>
                <h5>Original Value</h5>
                <p>Component contains the original data.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">2</div>
                <h5>Pipe</h5>
                <p>A built-in pipe transforms the value.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">3</div>
                <h5>Template</h5>
                <p>The transformed value is used in the template.</p>
            </div>

            <div class="syntax-arrow">→</div>

            <div class="syntax-box">
                <div class="syntax-icon">4</div>
                <h5>Output</h5>
                <p>The formatted value is displayed to the user.</p>
            </div>

        </div>
    </section>

    <!-- Common Built-in Pipes -->
    <section class="mb-4">
        <h2 class="fw-bold">Common Built-in Pipes</h2>

        <div class="syntax-grid">

            <div class="syntax-card">
                <div class="syntax-icon">T</div>
                <h5>UpperCase</h5>
                <p>
                    Converts text into uppercase characters.
                </p>
                <code>uppercase</code>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">t</div>
                <h5>LowerCase</h5>
                <p>
                    Converts text into lowercase characters.
                </p>
                <code>lowercase</code>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">D</div>
                <h5>Date</h5>
                <p>
                    Formats date values.
                </p>
                <code>date</code>
            </div>

            <div class="syntax-card">
                <div class="syntax-icon">C</div>
                <h5>Currency</h5>
                <p>
                    Formats numbers as currency.
                </p>
                <code>currency</code>
            </div>

        </div>
    </section>

    <!-- Uppercase -->
    <section class="mb-4">
        <h2 class="fw-bold">1. Uppercase Pipe</h2>

        <p>
            The <code>uppercase</code> pipe converts all characters in a
            string to uppercase.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>studentName = 'Samiksha';</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    {{studentName | uppercase}}
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                SAMIKSHA
            </div>
        </div>
    </section>

    <!-- Lowercase -->
    <section class="mb-4">
        <h2 class="fw-bold">2. Lowercase Pipe</h2>

        <p>
            The <code>lowercase</code> pipe converts all characters in
            a string to lowercase.
        </p>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    {{studentName | lowercase}}
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                samiksha
            </div>
        </div>
    </section>

    <!-- Date -->
    <section class="mb-4">
        <h2 class="fw-bold">3. Date Pipe</h2>

        <p>
            The <code>date</code> pipe formats a date value into a
            readable format.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>joiningDate = new Date();</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    {{joiningDate | date}}
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                The date is displayed in a formatted date representation.
            </div>
        </div>
    </section>

    <!-- Date Format -->
    <section class="mb-4">
        <h2 class="fw-bold">Date with Format</h2>

        <p>
            The date pipe can accept a format parameter.
        </p>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    {{joiningDate | date:'dd/MM/yyyy'}}
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Example Output:</strong>

            <div class="output-preview">
                07/10/2026
            </div>
        </div>
    </section>

    <!-- Currency -->
    <section class="mb-4">
        <h2 class="fw-bold">4. Currency Pipe</h2>

        <p>
            The <code>currency</code> pipe formats numeric values as
            currency.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>courseFee = 35000;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    {{courseFee | currency:'INR'}}
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                ₹35,000.00
            </div>
        </div>
    </section>

    <!-- Number -->
    <section class="mb-4">
        <h2 class="fw-bold">5. Number Pipe</h2>

        <p>
            The <code>number</code> pipe formats numeric values according
            to the specified digit information.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>percentage = 87.5678;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    {{percentage | number:'1.2-2'}}
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                87.57
            </div>
        </div>
    </section>

    <!-- Percent -->
    <section class="mb-4">
        <h2 class="fw-bold">6. Percent Pipe</h2>

        <p>
            The <code>percent</code> pipe formats a number as a percentage.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>completion = 0.85;</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    {{completion | percent}}
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Output:</strong>

            <div class="output-preview">
                85%
            </div>
        </div>
    </section>

    <!-- JSON -->
    <section class="mb-4">
        <h2 class="fw-bold">7. JSON Pipe</h2>

        <p>
            The <code>json</code> pipe is useful for displaying objects
            and arrays in JSON format, especially while debugging.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>student = {
    name: 'Sam',
    course: 'Angular',
    fee: 35000
};</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;pre&gt;
    {{student | json}}
&lt;/pre&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Purpose:</strong>

            <div class="output-preview">
                Displays the object in JSON format for easier inspection.
            </div>
        </div>
    </section>

    <!-- Slice -->
    <section class="mb-4">
        <h2 class="fw-bold">8. Slice Pipe</h2>

        <p>
            The <code>slice</code> pipe creates a subset of an array
            or string for display.
        </p>

        <div class="code-card">
            <div class="code-title">Component</div>

            <pre><code>students = [
    'Sam',
    'Pradnya',
    'Samiksha',
    'Rahul'
];</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    {{students | slice:0:2}}
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Purpose:</strong>

            <div class="output-preview">
                Displays a selected portion of the collection.
            </div>
        </div>
    </section>

    <!-- Async -->
    <section class="mb-4">
        <h2 class="fw-bold">9. Async Pipe</h2>

        <p>
            The <code>async</code> pipe subscribes to an Observable or
            Promise and displays the emitted value.
        </p>

        <div class="code-card">
            <div class="code-title">Template</div>

            <pre><code>&lt;p&gt;
    {{studentData$ | async}}
&lt;/p&gt;</code></pre>
        </div>

        <div class="output-box">
            <strong>Purpose:</strong>

            <div class="output-preview">
                Angular handles the subscription and updates the template
                when a new value is available.
            </div>
        </div>
    </section>

    <!-- Pipe Table -->
    <section class="mb-4">
        <h2 class="fw-bold">Built-in Pipe Reference</h2>

        <div class="table-responsive">

            <table class="table syntax-table">

                <thead>
                    <tr>
                        <th>Pipe</th>
                        <th>Purpose</th>
                        <th>Example</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td><code>uppercase</code></td>
                        <td>Convert text to uppercase</td>
                        <td><code>{{name | uppercase}}</code></td>
                    </tr>

                    <tr>
                        <td><code>lowercase</code></td>
                        <td>Convert text to lowercase</td>
                        <td><code>{{name | lowercase}}</code></td>
                    </tr>

                    <tr>
                        <td><code>date</code></td>
                        <td>Format dates</td>
                        <td><code>{{date | date}}</code></td>
                    </tr>

                    <tr>
                        <td><code>currency</code></td>
                        <td>Format currency</td>
                        <td><code>{{fee | currency:'INR'}}</code></td>
                    </tr>

                    <tr>
                        <td><code>number</code></td>
                        <td>Format numbers</td>
                        <td><code>{{value | number}}</code></td>
                    </tr>

                    <tr>
                        <td><code>percent</code></td>
                        <td>Format percentage</td>
                        <td><code>{{value | percent}}</code></td>
                    </tr>

                    <tr>
                        <td><code>json</code></td>
                        <td>Display objects as JSON</td>
                        <td><code>{{student | json}}</code></td>
                    </tr>

                    <tr>
                        <td><code>slice</code></td>
                        <td>Extract part of a value</td>
                        <td><code>{{students | slice:0:2}}</code></td>
                    </tr>

                    <tr>
                        <td><code>async</code></td>
                        <td>Handle Observable or Promise values</td>
                        <td><code>{{data$ | async}}</code></td>
                    </tr>

                </tbody>

            </table>

        </div>
    </section>

    <!-- Complete Example -->
    <section class="mb-4">
        <h2 class="fw-bold">Complete Student Example</h2>

        <div class="code-card">
            <div class="code-title">student.component.ts</div>

            <pre><code>export class StudentComponent {

    studentName = 'Samiksha';

    courseFee = 35000;

    completion = 0.85;

    joiningDate = new Date();

    student = {
        name: 'Sam',
        course: 'Angular'
    };

}</code></pre>
        </div>

        <div class="code-card">
            <div class="code-title">student.component.html</div>

            <pre><code>&lt;h3&gt;
    {{studentName | uppercase}}
&lt;/h3&gt;

&lt;p&gt;
    Course Fee:
    {{courseFee | currency:'INR'}}
&lt;/p&gt;

&lt;p&gt;
    Completion:
    {{completion | percent}}
&lt;/p&gt;

&lt;p&gt;
    Joining Date:
    {{joiningDate | date:'dd/MM/yyyy'}}
&lt;/p&gt;

&lt;pre&gt;
    {{student | json}}
&lt;/pre&gt;</code></pre>
        </div>

        <div class="student-preview">
            <h4>SAMIKSHA</h4>

            <p>Course Fee: ₹35,000.00</p>

            <p>Completion: 85%</p>

            <p>Angular Student</p>
        </div>
    </section>

    <!-- Best Practices -->
    <section class="mb-4">
        <h2 class="fw-bold">Best Practices</h2>

        <ul class="best-practice-list">
            <li>Use built-in pipes whenever they satisfy the requirement.</li>
            <li>Use pipes mainly for presentation and formatting.</li>
            <li>Keep complex business logic outside the template.</li>
            <li>Use parameters when customized formatting is required.</li>
            <li>Use the JSON pipe mainly for debugging purposes.</li>
            <li>Avoid unnecessary pipe chains in complex templates.</li>
        </ul>
    </section>

    <!-- Summary -->
    <section class="mb-4">
        <h2 class="fw-bold">Summary</h2>

        <div class="summary-box">
            <ul class="mb-0">
                <li>Angular provides many built-in pipes.</li>
                <li><code>uppercase</code> and <code>lowercase</code> format text.</li>
                <li><code>date</code> formats date values.</li>
                <li><code>currency</code> formats monetary values.</li>
                <li><code>number</code> formats numeric values.</li>
                <li><code>percent</code> formats percentages.</li>
                <li><code>json</code> helps inspect objects and arrays.</li>
                <li><code>slice</code> extracts a portion of a value.</li>
                <li><code>async</code> handles Observable and Promise values.</li>
            </ul>
        </div>
    </section>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", "Pipes", new { area = "Angular" })">
            ← Pipes Introduction
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("ParameterizedPipes", "Pipes", new { area = "Angular" })">
            Parameterized Pipes →
        </a>

    </div>

</div>

<style>

    .info-card {
        background: #f8fafc;
        border-left: 5px solid #4c1d95;
        padding: 20px;
        border-radius: 10px;
    }

    .syntax-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .syntax-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        width: 190px;
        min-height: 160px;
    }

    .syntax-icon {
        width: 45px;
        height: 45px;
        background: #4c1d95;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        font-weight: bold;
    }

    .syntax-arrow {
        font-size: 28px;
        font-weight: bold;
        color: #4c1d95;
    }

    .syntax-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .syntax-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }

    .code-card {
        background: #0f172a;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .code-title {
        background: #1e293b;
        color: #ddd6fe;
        padding: 10px 15px;
        font-weight: 600;
    }

    .code-card pre {
        margin: 0;
        padding: 20px;
        overflow-x: auto;
    }

    .code-card code {
        color: #f8fafc;
        font-family: Consolas, monospace;
        line-height: 1.7;
    }

    .output-box {
        background: #ede9fe;
        border-left: 5px solid #4c1d95;
        padding: 18px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .output-preview {
        background: white;
        border-radius: 8px;
        padding: 15px;
        margin-top: 10px;
    }

    .syntax-table {
        border: 1px solid #e2e8f0;
    }

        .syntax-table th {
            background: #4c1d95;
            color: white;
        }

        .syntax-table td {
            vertical-align: middle;
        }

    .student-preview {
        background: #ede9fe;
        border: 2px solid #4c1d95;
        border-radius: 12px;
        padding: 25px;
        text-align: center;
    }

    .best-practice-list {
        background: #f8fafc;
        border-radius: 10px;
        padding: 25px 40px;
        border-left: 5px solid #4c1d95;
    }

        .best-practice-list li {
            margin-bottom: 10px;
        }

    .summary-box {
        background: #cfe2ff;
        color: #084298;
        border-radius: 10px;
        padding: 20px;
    }

    @@media (max-width: 991px) {

        .syntax-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syntax-flow {
            flex-direction: column;
        }

        .syntax-arrow {
            transform: rotate(90deg);
        }
    }

    @@media (max-width: 576px) {

        .syntax-grid {
            grid-template-columns: 1fr;
        }

        .syntax-box {
            width: 100%;
        }

        .best-practice-list {
            padding: 20px 30px;
        }

        .code-card pre {
            font-size: 13px;
        }
    }

</style>