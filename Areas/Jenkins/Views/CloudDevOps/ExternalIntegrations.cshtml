@{
    Layout = "~/Areas/Jenkins/Views/Shared/JenkinsLayout.cshtml";
    ViewData["Title"] = "External Integrations";
}

<style>
    #external-integrations-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #external-integrations-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #external-integrations-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #external-integrations-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 18px;
        height: 100%;
    }

        #external-integrations-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #external-integrations-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }
</style>

<main id="external-integrations-page" class="container py-5">

    <div class="row g-4">

        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/Jenkins/Views/Shared/JenkinsTopics.cshtml"
            )

        </aside>

        <!-- MAIN CONTENT -->
        <section class="col-lg-9">

            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    External Integrations
                </h1>

                <p class="lead">
                    Learn the concepts, configurations, webhooks, and modern execution paradigms required to securely connect Jenkins with third-party enterprise tools.
                </p>

            </div>

            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    What is Jenkins External Integrations?
                </h2>

                <p>
                    <strong>External Integrations</strong> in Jenkins represents the engineering standard of linking your central orchestration engine to peripheral platforms within the modern software ecosystem—such as code repositories, communication applications, monitoring systems, and vulnerability scanners.
                </p>

                <p>
                    Isolated automation servers act as single bottlenecks. In a modern Phase 5 environment, Jenkins functions as a collaborative operational fabric, receiving inbound triggers via webhooks and updating external platforms automatically when build milestones are met.
                </p>

                <div class="alert alert-info">
                    <strong>Simple Definition:</strong> External Integrations allow Jenkins to pass information, share states, and orchestrate tools outside its host environment, changing it from a simple build script runner into an integrated DevSecOps nervous system.
                </div>

            </div>

            <!-- CORE TOPIC A: WHY IS IT IMPORTANT? -->
            <div class="mb-4">

                <h2 class="h3 fw-bold text-dark">
                    Why Are External Integrations So Important?
                </h2>

                <p>
                    Without deep tool integration, an infrastructure lifecycle suffers from tracking gaps and structural bottlenecks. External connectivity is essential for three primary architectural reasons:
                </p>

                <div class="bg-light p-3 rounded border mb-3">
                    <ul class="mb-0">
                        <li class="mb-2"><strong>Eliminates Information Silos:</strong> Instead of forcing engineers to log directly into the Jenkins dashboard to review logs, pipelines update tools like Slack or Microsoft Teams with dynamic event notifications.</li>
                        <li class="mb-2"><strong>Enforces Quality Gates:</strong> Pipelines integrate code security tools (like SonarQube or Aqua Trivy) to automatically block poor-quality pull requests before they reach cloud infrastructure.</li>
                        <li><strong>Drives ChatOps Workflows:</strong> Modern developer setups rely on bidirectional interfaces, triggering tests or approving staging promotions using simple commands like <code>/promote</code> straight from comments sections.</li>
                    </ul>
                </div>

            </div>

            <!-- CORE TOPIC B: WHAT IS THE ARCHITECTURAL IMPACT? -->
            <div class="mb-4">

                <h2 class="h3 fw-bold text-dark">
                    The Impact of Modern External Integrations
                </h2>

                <p>
                    Integrating systems impacts both system reliability and development speed across these core layers:
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="info-card">
                            <h5>Accelerated Feedback Loops</h5>
                            <p class="mb-0 small text-muted">Developers receive instant commit validations and compilation status checkmarks inside their SCM pull request view, which prevents bad changes from breaking downstream environments.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-card">
                            <h5>Automated Audit Trails</h5>
                            <p class="mb-0 small text-muted">Integrating ticket trackers like Jira allows pipelines to automatically append deployment logs and build versions to active issue metrics, ensuring complete regulatory compliance.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-card">
                            <h5>Real-time Security Gates</h5>
                            <p class="mb-0 small text-muted">Adding static application security testing (SAST) hooks breaks pipelines instantly if severe security exposures are introduced, avoiding vulnerability leaks in production images.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-card">
                            <h5>Proactive Performance Alerts</h5>
                            <p class="mb-0 small text-muted">Connecting pipelines with platforms like Datadog or Prometheus enables performance monitoring steps to log runtime exceptions during automated canary test runs.</p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- KEY CONCEPTS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Key Integration Mechanisms
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="info-card">
                            <h5>Webhook Handshakes</h5>
                            <p class="mb-0">Inbound HTTP POST signals sent from remote source management tools notify Jenkins when repository modifications occur, replacing slow, resource-heavy polling methods.</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-card">
                            <h5>API Authentication Wrappers</h5>
                            <p class="mb-0">Jenkins interfaces safely with external REST endpoints by wrapping credential requests inside short-lived Bearer tokens, keeping secret keys isolated in-memory.</p>
                        </div>
                    </div>

                </div>

            </div>

            <!-- EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practical Jenkins Example
                </h2>

                <p>The following production-ready Declarative Pipeline demonstrates secure external tool communication—running static code checks and pushing deployment update alerts to a remote Slack workspace channel:</p>

                <pre><code>pipeline {
    agent any












    environment {
        SLACK_CREDENTIALS_ID = 'slack-webhook-token-id'
        SONAR_SCANNER_HOME   = tool 'SonarQubeScanner' // Maps system tools configured in Jenkins
    }

    stages {
        stage('Checkout & Sync') {
            steps {
                checkout scm
            }
        }

        stage('SonarQube Code Analysis') {
            steps {
                // withSonarQubeEnv securely hooks up API keys and server connection settings
                withSonarQubeEnv('SonarQube-Enterprise') {
                    sh "$${SONAR_SCANNER_HOME}/bin/sonar-scanner"
                }
            }
        }

        stage('Evaluate Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    script {
                        // Halts execution block if external analysis returns a failure status
                        def gate = waitForQualityGate()
                        if (gate.status != 'OK') {
                            error "Pipeline stopped: External quality gate failure: $${gate.status}"
                        }
                    }
                }
            }
        }
    }


    post {
        success {
            // Sends automated notifications out to team chat platforms on successful deployment runs
            slackSend(
                color: '#00FF00',
                credentialId: "$${SLACK_CREDENTIALS_ID}",
                message: "SUCCESSFUL BUILD: Job '$${JOB_NAME}' (Build #$${BUILD_NUMBER}) has passed code audits."
            )
        }

}</code></pre>

            </div>

            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>
                    <li class="mb-2">Open Jenkins and identify the relevant configuration area.</li>
                    <li class="mb-2">Create or update a small test job or pipeline for this lesson.</li>
                    <li class="mb-2">Run the job and inspect the Console Output.</li>
                    <li>Record what changed and verify the result.</li>
                </ol>

            </div>

            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">
                <h2 class="h4 fw-bold">Summary</h2>
                <p class="mb-0">You have completed the <strong>External Integrations</strong> lesson. Continue through the syllabus to build the Jenkins skills required for real CI/CD automation.</p>
            </div>

            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-primary" href="@Url.Action("GitOps", "CloudDevOps", new { area = "Jenkins" })">← Previous: Jenkins and GitOps</a>
                <a class="btn btn-primary" href="@Url.Action("Index", "Master", new { area = "Jenkins" })">Next: Enterprise Jenkins →</a>
            </div>

        </section>

    </div>

</main>
