<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>CIIT Institute | Learn Jenkins Step-by-Step</title>

    <script type="importmap"></script>

    <!-- ===================================================== -->
    <!-- BOOTSTRAP -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ===================================================== -->
    <!-- SITE CSS -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- ===================================================== -->
    <!-- PROJECT CSS -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/CIITEdge.styles.css"
          asp-append-version="true" />

    <!-- ===================================================== -->
    <!-- BOOTSTRAP JS -->
    <!-- ===================================================== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <style>

            /* ===================================================== */
            /* SAME THEME AS C# / CORE JAVA / PYTHON */
            /* ===================================================== */

            :root {
                --brand-purple: #4c1d95;
                --brand-purple-dark: #2e1065;
                --syntax-bg: #0f172a;
            }


            /* ===================================================== */
            /* HERO GRADIENT */
            /* ===================================================== */

            .bg-brand-gradient {
                background: linear-gradient( 135deg, var(--brand-purple-dark) 0%, #312e81 100% );
            }


            /* ===================================================== */
            /* NAVBAR BRAND */
            /* ===================================================== */

            .navbar-brand span {
                color: #c084fc;
                font-weight: 900;
                letter-spacing: 0.05em;
            }


            /* ===================================================== */
            /* CODE BLOCK */
            /* ===================================================== */

            .code-block {
                background-color: var(--syntax-bg);
                color: #f1f5f9;
                padding: 1.5rem;
                border-radius: 0.5rem;
                font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.875rem;
                line-height: 1.6;
                position: relative;
                overflow-x: auto;
            }


            /* ===================================================== */
            /* CODE LANGUAGE TAG */
            /* ===================================================== */

            .code-lang-tag {
                position: absolute;
                top: 0.5rem;
                right: 1rem;
                font-size: 0.75rem;
                color: #64748b;
                user-select: none;
            }


            /* ===================================================== */
            /* CODE COLORS */
            /* ===================================================== */

            .keyword {
                color: #c084fc;
            }

            .class-name {
                color: #34d399;
            }

            .method-name {
                color: #fbbf24;
            }

            .string-lit {
                color: #fef08a;
            }


            /* ===================================================== */
            /* CODE EDITOR */
            /* ===================================================== */

            .editor-textarea {
                background-color: #1e1e1e !important;
                color: #d4d4d4 !important;
                font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.9rem;
                resize: vertical;
            }


            /* ===================================================== */
            /* TERMINAL OUTPUT */
            /* ===================================================== */

            .terminal-output {
                background-color: #000000;
                color: #f1f1f1;
                font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.85rem;
                min-height: 100px;
                white-space: pre-wrap;
            }


            /* ===================================================== */
            /* JENKINS SIDEBAR */
            /* ===================================================== */

            .jenkins-sidebar {
                position: sticky;
                top: 90px;
            }

                .jenkins-sidebar .card {
                    border-radius: 0.5rem;
                    overflow: hidden;
                }

                .jenkins-sidebar .module-title {
                    font-weight: 700;
                    background-color: #ffffff;
                    color: #212529;
                }

                .jenkins-sidebar .topic-link {
                    padding-left: 2rem;
                    font-size: 0.92rem;
                    text-decoration: none;
                    color: #495057;
                    font-weight: 400;
                    background-color: #ffffff;
                    border-top: 0;
                    border-left: 0;
                    border-right: 0;
                    border-bottom: 1px solid #e5e7eb;
                }

                    .jenkins-sidebar .topic-link:hover {
                        background-color: #ffffff;
                        color: #495057;
                    }

                    .jenkins-sidebar .topic-link.active {
                        background-color: #ffffff !important;
                        color: #495057 !important;
                        font-weight: 400 !important;
                        border-top: 0;
                        border-left: 0;
                        border-right: 0;
                        border-bottom: 2px solid #2563eb !important;
                    }


            /* ===================================================== */
            /* MOBILE */
            /* ===================================================== */

            @@media (max-width: 991.98px) {

                .jenkins-sidebar {
                    position: static;
                }
            }

    </style>

</head>


<body class="bg-light text-dark">


    <!-- ===================================================== -->
    <!-- NAVBAR -->
    <!-- ===================================================== -->

    <nav class="navbar navbar-expand-md navbar-dark bg-dark sticky-top shadow-sm"
         style="background-color: var(--brand-purple-dark) !important;">

        <div class="container">


            <!-- BRAND -->

            <a class="navbar-brand d-flex align-items-center fw-bold"
               href="@Url.Action("Index", "Foundations", new { area = "Jenkins" })">

                <span class="me-1">CIIT</span> Institute

            </a>


            <!-- MOBILE BUTTON -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- NAVIGATION -->

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <ul class="navbar-nav ms-auto mb-2 mb-md-0 align-items-md-center">


                    <!-- HTML -->

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           href="@Url.Action("Index", "Introduction", new { area = "HTML" })">

                            HTML

                        </a>

                    </li>


                    <!-- CSS -->

                        <li class="nav-item">

                            <a class="nav-link px-3"
                               href="@Url.Action("Index", "Introduction", new { area = "CSS" })">

                                CSS

                            </a>

                        </li>


                    <!-- C# -->

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           href="@Url.Action("Index", "Introduction", new { area = "CSharp" })">

                            C#

                        </a>

                    </li>


                    <!-- CORE JAVA -->

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           href="@Url.Action("Index", "Introduction", new { area = "CoreJava" })">

                            Core Java

                        </a>

                    </li>


                    <!-- PYTHON -->

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           href="@Url.Action("Index", "Introduction", new { area = "Python" })">

                            Python

                        </a>

                    </li>


                    <!-- JENKINS -->

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           href="@Url.Action("Index", "Foundations", new { area = "Jenkins" })">

                            Jenkins

                        </a>

                    </li>


                    <!-- TUTORIALS -->

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           href="#tutorials">

                            Tutorials

                        </a>

                    </li>


                    <!-- CODE PLAYGROUND -->

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           href="#playground">

                            Code Playground

                        </a>

                    </li>


                    <!-- TRY CODE PLAYGROUND -->

                    <li class="nav-item ms-md-2">

                        <a class="btn btn-sm text-white px-3 fw-semibold"
                           style="background-color: #8b5cf6;"
                           href="#playground">

                            Try Code Playground

                        </a>

                    </li>


                </ul>

            </div>

        </div>

    </nav>


    <!-- ===================================================== -->
    <!-- HTML HERO SECTION -->
    <!-- ===================================================== -->

    <header class="bg-brand-gradient text-white text-center py-5">

        <div class="container py-4">

            <div class="row justify-content-center">

                <div class="col-lg-8">

                    <h1 class="display-4 fw-extrabold mb-3">

                        Master Jenkins From Beginner to Enterprise

                    </h1>

                    <p class="lead text-purple-100 mb-4 opacity-75">

                        Clear, interactive, and structured Jenkins lessons
                        designed to take you from beginner to enterprise level.

                    </p>

                </div>

            </div>

        </div>

    </header>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <main id="tutorials"
          class="container py-1">

        @RenderBody()

    </main>


    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <footer class="bg-dark text-muted text-center py-4 border-top border-secondary mt-5">

    </footer>


</body>

</html>