    Layout = "~/Areas/Jenkins/Views/Shared/JenkinsLayout.cshtml";
    ViewData["Title"] = "Java and Maven Builds";
}

<style>
    #java-and-maven-builds-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #java-and-maven-builds-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #java-and-maven-builds-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #java-and-maven-builds-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 18px;
        height: 100%;
    }

        #java-and-maven-builds-page .info-card h5 {
            color: #5b21b6;
