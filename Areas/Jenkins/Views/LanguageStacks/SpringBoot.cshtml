    #spring-boot-ci-pipeline-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #spring-boot-ci-pipeline-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #spring-boot-ci-pipeline-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #spring-boot-ci-pipeline-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
