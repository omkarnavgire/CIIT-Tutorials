    Layout = "~/Areas/Jenkins/Views/Shared/JenkinsLayout.cshtml";
    ViewData["Title"] = "Backup and Disaster Recovery";
}

<style>
    #backup-and-disaster-recovery-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #backup-and-disaster-recovery-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #backup-and-disaster-recovery-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #backup-and-disaster-recovery-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 18px;
        height: 100%;
    }

        #backup-and-disaster-recovery-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #backup-and-disaster-recovery-page .example-box {
