@{
    Layout = "~/Areas/Jenkins/Views/Shared/JenkinsLayout.cshtml";
    ViewData["Title"] = "Managing Workspaces";
}

<style>
    #managing-workspaces-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

    #managing-workspaces-page pre code {
        background: transparent !important;
        color: #ffffff !important;
    }

    #managing-workspaces-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #managing-workspaces-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 18px;
        height: 100%;
    }

    #managing-workspaces-page .info-card h5 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #managing-workspaces-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }
</style>

<main id="managing-workspaces-page" class="container py-5">

    <div class="row g-4">

        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/Jenkins/Views/Shared/JenkinsTopics.cshtml"
            )

        </aside>

        <!-- MAIN CONTENT -->
        <section class="col-lg-9">

            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    Managing Workspaces
                </h1>

                <p class="lead">
                    Learn the concepts, configuration, commands, and practical workflow required to use Managing Workspaces in a real Jenkins environment.
                </p>

            </div>

            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    What is Managing Workspaces?
                </h2>

                <p>
                    <strong>Managing Workspaces</strong> is a core operational process in continuous integration where Jenkins sets aside, tracks, and cleans up the physical directories on its worker nodes where actual build operations happen.
                </p>

                <p>
                    Every single job that runs in Jenkins needs a place to live while executing. That dedicated folder structure on the server's hard drive is called the Workspace.
                </p>

                <div class="alert alert-info">
                    <strong>Simple Definition:</strong> Managing Workspaces is an important Jenkins topic in Phase 2. Core CI/CD Basics.
                </div>

            </div>

            <!-- KEY CONCEPTS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Key Concepts
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="info-card">
                            <h5>Concept</h5>
                            <p class="mb-0">Understand the purpose of Managing Workspaces and how it fits into a Jenkins workflow.</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-card">
                            <h5>Real-World Use</h5>
                            <p class="mb-0">Apply the concept when creating, running, testing, or deploying a Jenkins job or pipeline.</p>
                        </div>
                    </div>

                </div>

            </div>

            <!-- EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practical Jenkins Example
                </h2>

                <pre><code>pipeline {
    agent any
    stages {
        stage(&#x27;Learn Managing Workspaces&#x27;) {
            steps {
                echo &#x27;Jenkins lesson: Managing Workspaces &#x27; 
            }
        }
    }
}</code></pre>

            </div>

            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>
                    <li class="mb-2">Open Jenkins and identify the relevant configuration area.</li>
                    <li class="mb-2">Create or update a small test job or pipeline for this lesson.</li>
                    <li class="mb-2">Run the job and inspect the Console Output.</li>
                    <li>Record what changed and verify the result.</li>
                </ol>

            </div>

            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">
                <h2 class="h4 fw-bold">Summary</h2>
                <p class="mb-0">You have completed the <strong>Managing Workspaces</strong> lesson. Continue through the syllabus to build the Jenkins skills required for real CI/CD automation.</p>
            </div>

            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-primary" href="@Url.Action("GlobalTools", "CoreCICD", new { area = "Jenkins" })">← Previous: Global Tool Configuration</a>
                <a class="btn btn-primary" href="@Url.Action("Artifacts", "CoreCICD", new { area = "Jenkins" })">Next: Artifacts and Build Outputs →</a>
            </div>

        </section>

    </div>

</main>
