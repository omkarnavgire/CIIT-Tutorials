    Layout = "~/Areas/Jenkins/Views/Shared/JenkinsLayout.cshtml";
    ViewData["Title"] = "Build History and Console Output";
}

<style>
    #build-history-and-console-output-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #build-history-and-console-output-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #build-history-and-console-output-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #build-history-and-console-output-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 18px;
        height: 100%;
    }

        #build-history-and-console-output-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #build-history-and-console-output-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }
</style>

<main id="build-history-and-console-output-page" class="container py-5">

    <div class="row g-4">

        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">
            @Html.Partial("~/Areas/Jenkins/Views/Shared/JenkinsTopics.cshtml")
        </aside>

        <!-- MAIN CONTENT -->
        <section class="col-lg-9">

            <!-- PAGE TITLE -->
            <div class="mb-4">
                <h1 class="fw-bold">Build History and Console Output</h1>
                <p class="lead">
                    Learn the concepts, status indicators, live log streaming layers, and diagnostic steps required to audit past pipeline runs and troubleshoot script exceptions.
                </p>
            </div>

            <!-- INTRODUCTION -->
            <div class="mb-4">
                <h2 class="h3 fw-bold">What is Build History and Console Output?</h2>
                <p>
                    Every time a Jenkins job is triggered, it initializes a distinct execution record. Tracking these historical runs and reviewing the real-time stdout streams generated by your agent nodes is accomplished through two tightly coupled debugging views: the **Build History** panel and the **Console Output** log stream.
                </p>

                <div class="alert alert-info my-3">
                    <strong>Simple Definition:</strong> Build History is the chronological timeline panel displaying all past execution states of a job, while Console Output is the streaming text log tracking exactly what scripts ran and where failures occurred.
                </div>

                <h3 class="h4 fw-bold mt-4">Core Logging Metrics</h3>
                <p class="mb-2">Jenkins aggregates pipeline diagnostic data using three structural interface layers:</p>
                <ul class="mb-3">
                    <li class="mb-1"><strong>The Build History List:</strong> An incremental sidebar panel widget indexing each pipeline attempt with a unique hash tracking identifier (e.g., `#1`, `#2`), complete with execution timestamp baselines.</li>
                    <li class="mb-1"><strong>Color-Coded Status Statuses:</strong> Visual cues indicating pipeline results (e.g., Green/Blue circles for a clean `SUCCESS`, Yellow for unstable test drop-outs, and Red indicating step fatal failures).</li>
                    <li><strong>Streaming Plain Text View (`stdout`):</strong> A text stream capturing stderr outputs, shell command execution markers, and environmental details, which can be downloaded as raw log text files.</li>
                </ul>
            </div>

            <!-- KEY CONCEPTS -->
            <div class="mb-4">
                <h2 class="h3 fw-bold">Key Concepts</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="info-card">
                            <h5>Pinpointing Exception Stacktraces</h5>
                            <p class="mb-0">Learning to navigate down to the bottom lines of a failed build's console text stream to extract error exit codes or compiler faults that halted pipeline stages.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-card">
                            <h5>Log Rotation &amp; Cleanback Policies</h5>
                            <p class="mb-0">Configuring historical build retention policies (Discard Old Builds) to discard historical run profiles automatically, protecting the controller server from disk fill-ups.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- EXAMPLE -->
            <div class="mb-4">
                <h2 class="h3 fw-bold">Practical Jenkins Example</h2>
                <p>The following pipeline block shows how to intentionally generate multi-stage log signals and configure automated diagnostic summaries within error tracking blocks:</p>
                <pre><code>pipeline {
    agent any

















    stages {
        stage('Initialize System Checks') {
            steps {
                echo 'INFO: Spawning environment check hooks...'
                sh 'echo "Current Shell User Context: \$(whoami)"'
            }
        }
        stage('Simulate Diagnostic Logic') {
            steps {
                echo 'WARNING: Checking dependency version matching baselines...'
                sh 'echo "Simulating mock compile outputs streaming to stdout..."'
            }
        }
    }

    // Monitoring final status outputs to print customized tracking summaries
    post {
        always {
            echo 'AUDIT: Execution cycle terminated. Flushing output log lines to stable storage.'
        }
        failure {
            echo 'ERROR: Structural irregularities registered. Review the Console Output logs above.'
        }
    }
}</code></pre>
                </div>

            <!-- PRACTICE -->
            <div class="mb-4">
        <h2 class="h3 fw-bold">Practice Exercise: Investigate Execution Log Trails</h2>
                <div class="concept-box">
    <h5 class="fw-bold">Step-by-Step Task Sequence:</h5>
                    <ol class="ps-3 mb-0">
<li class="mb-2">Open the script block workspace of an active test project or instantiate a new Pipeline item from your portal dashboard.</li>
                        <li class="mb-2">Copy-paste the complete practical multi-stage logging script example provided above into your editor window and click <strong>Save</strong>.</li>
                        <li class="mb-2">Trigger a manual validation run by selecting the **Build Now** sidebar action link.</li>
<li class="mb-2">Locate the fresh execution entry item (e.g., `#1`) that appears under the **Build History** panel table on the lower left-hand column.</li>
<li>Hover over the iteration record item, click the dropdown chevron toggle element, choose **Console Output**, and trace the step strings printing to your screen.</li>
</ol>
</div>
</div>

<!-- SUMMARY -->
<div class="alert alert-info mt-4">
<h2 class="h4 fw-bold">Summary</h2>
<p class="mb-0">You have completed the <strong>Build History and Console Output</strong> lesson. You have finished Phase 2 (Core CI/CD Basics). Continue through the syllabus to learn how to write infrastructure pipelines as text code files inside Phase 3: Jenkinsfile Foundations.</p>
</div>

            <!-- NAVIGATION -->
             <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-primary" href="@Url.Action("UpstreamDownstream", "CoreCICD", new { area = "Jenkins" })">← Previous: Upstream and Downstream Jobs</a>
                <a class="btn btn-primary" href="@Url.Action("Index", "Pipeline", new { area = "Jenkins" })">Next: Jenkinsfile Foundations →</a>
            </div>

        </section>

    </div>

</main>
