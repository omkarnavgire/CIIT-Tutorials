                                 )"
                           class="btn btn-outline-secondary px-4">

                            <span class="me-2">←</span>
                            Previous: Initializing a Repository

                        </a>


                        <!-- NEXT TOPIC -->
                        <a href="@Url.Action(
                                    "TrackingChanges",
                                    "LocalGitWorkflow",
                                    new { area = "GitHub" }
                                 )"
                           class="btn btn-primary px-4">

                            Next: Tracking Changes
                            <span class="ms-2">→</span>

                        </a>

                    </div>
    </div>
</div>
        </section>
    </div>
</main>
