@{
    ViewData["Title"] = "Azure DevOps";
    Layout = "~/Areas/Azure/Views/Shared/AzureLayout.cshtml";
}

@await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureContentStyles.cshtml")

<div class="row g-4">
    <aside class="col-lg-3">
        @Html.Partial("~/Areas/Azure/Views/Shared/AzureTopics.cshtml")
    </aside>
    <section class="col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <div class="azure-notes-content">
                    <pre class="azure-notes-text">Azure DevOps
Azure DevOps is a comprehensive, cloud-based Software as a Service (SaaS) platform from
Microsoft that provides end-to-end DevOps toolchains for developing and deploying
software. It breaks down silos between development, project management, and operations
teams, allowing organizations to plan work, collaborate on code, and build and deploy
applications much faster.</pre>
                </div>
            </div>
        </div>
    

            @await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureLessonNavigation.cshtml")
</section>
</div>
<style>
.azure-notes-text{white-space:pre-wrap;word-break:normal;font-family:inherit;font-size:1rem;line-height:1.7;background:#fff;border:0;padding:0;margin:0;color:#212529;}
.azure-notes-content img{max-height:720px;}
</style>