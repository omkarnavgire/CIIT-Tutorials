@{
    ViewData["Title"] = "Benefits of DevOps";
    Layout = "~/Areas/Azure/Views/Shared/AzureLayout.cshtml";
}

@await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureContentStyles.cshtml")

<div class="row g-4">
    <aside class="col-lg-3">
        @Html.Partial("~/Areas/Azure/Views/Shared/AzureTopics.cshtml")
    </aside>
    <section class="col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <div class="azure-notes-content">
                    <pre class="azure-notes-text">Benefits of DevOps
   •   Improved Collaboration among teams.
   •   Reduction in Lead time from commit to deployment (Lead time is the time it takes for
       a feature to make it to the customer).
   •   Rapid Deployment: Software is deployed more frequently.
   •   Scaling is more efficient and involves less risk.
So, DevOps is not just a role, job title, methodology, or piece of software. DevOps is a field
that takes skills from Development and Operations to create and run applications more
effectively.</pre>
                </div>
            </div>
        </div>
    

            @await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureLessonNavigation.cshtml")
</section>
</div>
<style>
.azure-notes-text{white-space:pre-wrap;word-break:normal;font-family:inherit;font-size:1rem;line-height:1.7;background:#fff;border:0;padding:0;margin:0;color:#212529;}
.azure-notes-content img{max-height:720px;}
</style>