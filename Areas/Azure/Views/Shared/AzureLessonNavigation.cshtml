    var index = items.FindIndex(x => x.Controller == currentController && x.Action == currentAction);
    var hasPrevious = index > 0;
    var hasNext = index >= 0 && index < items.Count - 1;
}

@if (index >= 0)
{
    <div class="d-flex justify-content-between mt-4">
        <div>
            @if (hasPrevious)
            {
                var previous = items[index - 1];

                <a class="btn btn-outline-primary fw-semibold"
                   href="@Url.Action(previous.Action, previous.Controller, new { area = "Azure" })">
                    ← Previous
                </a>
            }
        </div>

        <div>
            @if (hasNext)
            {
                var next = items[index + 1];

                <a class="btn btn-primary fw-semibold"
                   href="@Url.Action(next.Action, next.Controller, new { area = "Azure" })">
                    Next →
                </a>
            }
        </div>
    </div>
}
