@model CIITEdge.Areas.Azure.Models.AzureLesson
@using CIITEdge.Areas.Azure
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Areas/Azure/Views/Shared/AzureLayout.cshtml";
    var module = AzureLessonCatalog.GetModule(Model.ModuleKey);
    var index = Model.Number - 1;
    var previous = index > 0 ? module.Topics[index - 1] : null;
    var next = index < module.Topics.Count - 1 ? module.Topics[index + 1] : null;
}

<div class="row g-4 aws-content">
    <div class="col-lg-3">
        @await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureTopics.cshtml")
    </div>

    <div class="col-lg-9">
        @await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureContentStyles.cshtml")

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 p-lg-5">
                <h1 class="fw-bold mb-2">@Model.Title</h1>
                <p class="text-muted mb-0">@module.Title</p>

                <div style="min-height:520px;"></div>

                <div class="mt-4 d-flex justify-content-between align-items-center">
                    @if (previous != null)
                    {
                        <a class="btn btn-outline-secondary"
                           href="@Url.Action(previous.Action, module.Controller, new { area = "Azure" })">
                            ← Previous
                        </a>
                    }
                    else
                    {
                        <span></span>
                    }

                    @if (next != null)
                    {
                        <a class="btn btn-primary fw-semibold"
                           href="@Url.Action(next.Action, module.Controller, new { area = "Azure" })">
                            Next →
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
