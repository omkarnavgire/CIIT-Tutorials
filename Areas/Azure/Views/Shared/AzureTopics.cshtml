<style>
.ciit-syllabus-card{border:0;border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.08);position:sticky;top:90px;max-height:calc(100vh - 110px);overflow-y:auto;overflow-x:hidden}
