@* =========================================================
   AZURE LEARNING SECTION LAYOUT
   ---------------------------------------------------------
   Same independent learning-section structure as HTML/CSS/C#.
   Only AWS-specific navigation and AWS content are used here.
   No global _Layout.cshtml is used by AWS pages.
   ========================================================= *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CIIT Institute | Learn Azure Step-by-Step</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CIITEdge.styles.css" asp-append-version="true" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --azure-blue-dark: #0b2e6f;
            --azure-blue: #1456b8;
            --azure-blue-light: #2f6fd6;
        }

        body {
            background-color: #f8f9fa;
            color: #212529;
        }

        .azure-section-navbar {
            background: linear-gradient(135deg, var(--azure-blue-dark) 0%, var(--azure-blue) 55%, var(--azure-blue-light) 100%) !important;
        }

        .azure-section-navbar .navbar-brand span {
            color: #ffb000;
            font-weight: 900;
            letter-spacing: 0.04em;
        }

        .azure-section-navbar .nav-link {
            color: rgba(255,255,255,.9) !important;
        }

        .azure-section-navbar .nav-link:hover,
        .azure-section-navbar .nav-link.active {
            color: #fff !important;
        }

    </style>
</head>

<body class="bg-light text-dark">

    <!-- =====================================================
         NAVBAR
         Same independent-section position as HTML/CSS/CSharp.
         ===================================================== -->
    <nav class="navbar navbar-expand-md navbar-dark azure-section-navbar sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center fw-bold"
               href="@Url.Action("Index", "Introduction", new { area = "Azure" })">
                <span class="me-1">CIIT</span> Institute
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#azureNavbarNav"
                    aria-controls="azureNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="azureNavbarNav">
                <ul class="navbar-nav ms-auto mb-2 mb-md-0 align-items-md-center">
                    <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Index", "Introduction", new { area = "Azure" })">Azure</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Index", "Introduction", new { area = "HTML" })">HTML</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Index", "Introduction", new { area = "CSS" })">CSS</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Index", "Introduction", new { area = "CSharp" })">C#</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Index", "Introduction", new { area = "CoreJava" })">Core Java</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Index", "PythonBasics", new { area = "Python" })">Python</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="#tutorials">Tutorials</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="#playground">Code Playground</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- =====================================================
         AWS HERO
         Same full-width section flow as the existing learning areas.
         ===================================================== -->
    @await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureHero.cshtml")

    <!-- =====================================================
         MAIN CONTENT
         Same container + spacing pattern as HTML/CSS/CSharp.
         ===================================================== -->
    <main id="tutorials" class="container py-1">
        @RenderBody()
    </main>

    <!-- =====================================================
         FOOTER
         Exact HTML-style footer structure: same classes,
         spacing and empty footer body.
         ===================================================== -->
    <footer class="bg-dark text-muted text-center py-4 border-top border-secondary mt-5">
    </footer>

</body>
</html>
