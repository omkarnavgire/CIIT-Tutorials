@{
    ViewData["Title"] = "The general syntax rules";
    Layout = "~/Areas/Azure/Views/Shared/AzureLayout.cshtml";
}

@await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureContentStyles.cshtml")

<div class="row g-4">
    <aside class="col-lg-3">
        @Html.Partial("~/Areas/Azure/Views/Shared/AzureTopics.cshtml")
    </aside>
    <section class="col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <div class="azure-notes-content">
                    <pre class="azure-notes-text">The general syntax rules are:

    •   Instruction keywords come first (e.g., FROM, RUN) and are uppercase by convention but
        case-insensitive.

    •   Arguments appear on the same line as their instruction.

    •   Comments begin with # and are ignored by the builder.

    •   Each instruction creates a new image layer, so order and grouping affect image size and
        cache behavior.

    •   The build context is sent with the build; use a .dockerignore to exclude files and speed builds.</pre>
                    <div class="text-center my-4">
                        <img src="/Images/AzureNotes/Chapter_2_-_DockerFile/p01-000.jpg" class="img-fluid rounded shadow-sm" alt="The general syntax rules - source image" />
                    </div>
                </div>
            </div>
        </div>
    

            @await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureLessonNavigation.cshtml")
</section>
</div>
<style>
.azure-notes-text{white-space:pre-wrap;word-break:normal;font-family:inherit;font-size:1rem;line-height:1.7;background:#fff;border:0;padding:0;margin:0;color:#212529;}
.azure-notes-content img{max-height:720px;}
