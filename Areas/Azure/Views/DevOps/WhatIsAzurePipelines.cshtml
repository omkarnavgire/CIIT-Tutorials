@{
    ViewData["Title"] = "What is Azure Pipelines?";
    Layout = "~/Areas/Azure/Views/Shared/AzureLayout.cshtml";
}

@await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureContentStyles.cshtml")

<div class="row g-4">
    <aside class="col-lg-3">
        @Html.Partial("~/Areas/Azure/Views/Shared/AzureTopics.cshtml")
    </aside>
    <section class="col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <div class="azure-notes-content">
                    <pre class="azure-notes-text">What is Azure Pipelines?
Microsoft offers Azure Pipelines, a cloud-based service that generates and tests code projects
automatically. It works with every major language and kind of project. Code can be tested, built, and
sent to any destination using Azure Pipelines&#x27; combination of continuous integration
(CI) and continuous delivery (CD). It also provides a safe and effective means of automating builds
and distributing them to end users.</pre>
                </div>
            </div>
        </div>
    

            @await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureLessonNavigation.cshtml")
</section>
</div>
