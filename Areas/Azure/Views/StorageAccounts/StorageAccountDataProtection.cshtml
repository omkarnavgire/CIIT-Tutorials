@{
    ViewData["Title"] = "Step 8: Choose the Next: Data protection option.";
    Layout = "~/Areas/Azure/Views/Shared/AzureLayout.cshtml";
}

@await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureContentStyles.cshtml")

<div class="row g-4">
    <aside class="col-lg-3">
        @Html.Partial("~/Areas/Azure/Views/Shared/AzureTopics.cshtml")
    </aside>
    <section class="col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <div class="azure-notes-content">
                    <pre class="azure-notes-text">Step 8: Choose the Next: Data protection option. In the tab enter the following details :

    •   Enable point-in-time restore for containers: For now, uncheck this option.

    •   Enable soft delete for blobs: It helps us recover blob data in cases where blobs or blob
        snapshots are accidentally deleted or overwritten. For now, uncheck this option.

    •   Enable soft delete for containers: This helps us recover the containers that are accidentally
        deleted. For now, uncheck.

    •   Enable soft delete for file shares: This helps us to recover the blob data more easily at the
        folder level. For now, uncheck.

    •   Enable versioning for blobs: For now, uncheck this option.

    •   Enable blob change feed: For now, uncheck this option.

    •   Enable version-level immutability support: For now, uncheck this option.</pre>
                    <div class="text-center my-4">
                        <img src="/Images/AzureNotes/Chapter_4_-_Microsoft_Azure_-_Storage_Accounts/p08-000.jpg" class="img-fluid rounded shadow-sm" alt="Step 8: Choose the Next: Data protection option. - source image" />
                    </div>
                </div>
            </div>
        </div>
    

            @await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureLessonNavigation.cshtml")
</section>
</div>
<style>
.azure-notes-text{white-space:pre-wrap;word-break:normal;font-family:inherit;font-size:1rem;line-height:1.7;background:#fff;border:0;padding:0;margin:0;color:#212529;}
.azure-notes-content img{max-height:720px;}
</style>