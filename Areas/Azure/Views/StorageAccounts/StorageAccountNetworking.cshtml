@{
    ViewData["Title"] = "Step 7: Choose the Next: Networking tab.";
    Layout = "~/Areas/Azure/Views/Shared/AzureLayout.cshtml";
}

@await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureContentStyles.cshtml")

<div class="row g-4">
    <aside class="col-lg-3">
        @Html.Partial("~/Areas/Azure/Views/Shared/AzureTopics.cshtml")
    </aside>
    <section class="col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <div class="azure-notes-content">
                    <pre class="azure-notes-text">Step 7: Choose the Next: Networking tab. In the tab enter the following details :

    •   Connectivity method: Choose the method with which you wish to connect your store with
        others. For now, choose a public endpoint to allow public internet access.

    •   Routing preference: Choose Microsoft network routing to make use of the Microsoft global
        network that is optimized for low-latency path selection.</pre>
                    <div class="text-center my-4">
                        <img src="/Images/AzureNotes/Chapter_4_-_Microsoft_Azure_-_Storage_Accounts/p07-000.jpg" class="img-fluid rounded shadow-sm" alt="Step 7: Choose the Next: Networking tab. - source image" />
                    </div>
                </div>
            </div>
        </div>
    

            @await Html.PartialAsync("~/Areas/Azure/Views/Shared/AzureLessonNavigation.cshtml")
</section>
</div>
<style>
.azure-notes-text{white-space:pre-wrap;word-break:normal;font-family:inherit;font-size:1rem;line-height:1.7;background:#fff;border:0;padding:0;margin:0;color:#212529;}
.azure-notes-content img{max-height:720px;}
</style>