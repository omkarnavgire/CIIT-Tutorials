<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        @ViewData["Title"] - CIIT Stack Lab
    </title>

    <script type="importmap"></script>


    <!-- ===================================================== -->
    <!-- BOOTSTRAP -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- ===================================================== -->
    <!-- SITE CSS -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- ===================================================== -->
    <!-- PROJECT CSS -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/CIITEdge.styles.css"
          asp-append-version="true" />


    <!-- ===================================================== -->
    <!-- BOOTSTRAP JS -->
    <!-- ===================================================== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <style>

        /* ===================================================== */
        /* SQL SERVER THEME */
        /* ===================================================== */

        :root {
            --brand-purple: #4c1d95;
            --brand-purple-dark: #2e1065;
            --syntax-bg: #0f172a;
        }


        /* ===================================================== */
        /* PAGE */
        /* ===================================================== */

        body {
            margin: 0;
            padding: 0;
            background: #f8f9fa;
            color: #212529;
        }


        /* ===================================================== */
        /* HERO GRADIENT */
        /* ===================================================== */

        .bg-brand-gradient {
            background: linear-gradient(
                135deg,
                var(--brand-purple-dark) 0%,
                #312e81 100%
            );
        }


        /* ===================================================== */
        /* HERO */
        /* ===================================================== */

        .hero-header {
            padding: 12px 0 !important;
        }

        .hero-header h1 {
            font-size: 52px;
            font-weight: 400;
            margin-bottom: 18px;
        }

        .hero-header p {
            font-size: 20px;
            color: #d8c9f5;
            margin-bottom: 10px;
        }


        /* ===================================================== */
        /* SQL SERVER MAIN AREA */
        /* ===================================================== */

        .sqlserver-page {
            width: 100%;
            padding: 30px 30px 50px 30px;
        }


        /* ===================================================== */
        /* LEFT SIDEBAR */
        /* ===================================================== */

        .sqlserver-sidebar {
            min-width: 0;
        }


        /* ===================================================== */
        /* RIGHT CONTENT */
        /* ===================================================== */

        .sqlserver-main {
            min-width: 0;
        }


        /* ===================================================== */
        /* SQL SERVER CONTENT CARD */
        /* ===================================================== */

        .sqlserver-content-card {

            background: #ffffff;

            border-radius: 14px;

            padding: 45px;

            box-shadow:
                0 4px 18px rgba(0, 0, 0, 0.06);

            min-height: 400px;
        }


        /* ===================================================== */
        /* CONTENT HEADINGS */
        /* ===================================================== */

        .sqlserver-content-card h1,
        .sqlserver-content-card h2,
        .sqlserver-content-card h3 {
            font-weight: 700;
            color: #212529;
        }


        .sqlserver-content-card h1 {
            font-size: 40px;
            margin-bottom: 20px;
        }


        .sqlserver-content-card h2 {
            font-size: 30px;
            margin-top: 30px;
            margin-bottom: 15px;
        }


        .sqlserver-content-card h3 {
            font-size: 24px;
            margin-top: 25px;
            margin-bottom: 12px;
        }


        .sqlserver-content-card p {
            font-size: 16px;
            line-height: 1.8;
            color: #495057;
        }


        .sqlserver-content-card li {
            font-size: 16px;
            line-height: 1.8;
        }


        /* ===================================================== */
        /* CODE BLOCK */
        /* ===================================================== */

        .code-block {
            background-color: var(--syntax-bg);
            color: #f1f5f9;
            padding: 1.5rem;
            border-radius: 0.5rem;
            font-family:
                SFMono-Regular,
                Menlo,
                Monaco,
                Consolas,
                monospace;
            font-size: 0.875rem;
            line-height: 1.6;
            position: relative;
            overflow-x: auto;
        }


        /* ===================================================== */
        /* CODE LANGUAGE TAG */
        /* ===================================================== */

        .code-lang-tag {
            position: absolute;
            top: 0.5rem;
            right: 1rem;
            font-size: 0.75rem;
            color: #64748b;
            user-select: none;
        }


        /* ===================================================== */
        /* CODE EDITOR */
        /* ===================================================== */

        .editor-textarea {
            background-color: #1e1e1e !important;
            color: #d4d4d4 !important;
            font-family:
                SFMono-Regular,
                Menlo,
                Monaco,
                Consolas,
                monospace;
            font-size: 0.9rem;
            resize: vertical;
        }


        /* ===================================================== */
        /* TERMINAL OUTPUT */
        /* ===================================================== */

        .terminal-output {
            background-color: #000000;
            color: #f1f1f1;
            font-family:
                SFMono-Regular,
                Menlo,
                Monaco,
                Consolas,
                monospace;
            font-size: 0.85rem;
            min-height: 100px;
            white-space: pre-wrap;
        }


        /* ===================================================== */
        /* MOBILE */
        /* ===================================================== */

        @@media (max-width: 991.98px) {

            .navbar-nav {
                padding-top: 10px;
            }

            .sqlserver-page {
                padding: 20px 15px 40px 15px;
            }

            .sqlserver-sidebar {
                margin-bottom: 25px;
            }

            .hero-header h1 {
                font-size: 40px;
            }

            .hero-header p {
                font-size: 17px;
            }

            .sqlserver-content-card {
                padding: 30px;
            }

        }


        /* ===================================================== */
        /* SMALL MOBILE */
        /* ===================================================== */

        @@media (max-width: 576px) {

            .sqlserver-page {
                padding: 15px 10px 30px 10px;
            }

            .hero-header h1 {
                font-size: 32px;
            }

            .hero-header p {
                font-size: 15px;
            }

            .sqlserver-content-card {
                padding: 22px 18px;
            }

        }

    </style>

</head>


<body class="bg-light text-dark">


    <!-- ===================================================== -->
    <!-- MAIN CIIT NAVIGATION -->
    <!-- ===================================================== -->

    @Html.Partial("~/Views/Shared/Menus/MenusWithDropdown.cshtml")

    @Html.Partial("~/Views/Shared/Menus/ProgrammingMenus.cshtml")


    <!-- ===================================================== -->
    <!-- SQL SERVER HERO -->
    <!-- ===================================================== -->

    <header class="bg-brand-gradient text-white text-center hero-header">

        <div class="container py-4">

            <div class="row justify-content-center">

                <div class="col-lg-10">

                    <h1 class="display-4 fw-extrabold mb-3">

                        Master SQL Server From Scratch

                    </h1>

                    <p class="lead mb-0 opacity-75">

                        Clear, interactive, and structured SQL Server
                        lessons designed for beginners and developers.

                    </p>

                </div>

            </div>

        </div>

    </header>


    <!-- ===================================================== -->
    <!-- SQL SERVER MAIN CONTENT -->
    <!-- ===================================================== -->

    <main id="tutorials"
          class="container-fluid sqlserver-page">

        <div class="row">


            <!-- ================================================= -->
            <!-- LEFT : COURSE SYLLABUS -->
            <!-- ================================================= -->

            <div class="col-lg-3 col-xl-3 sqlserver-sidebar">

                @await Html.PartialAsync(
                    "~/Areas/SQLServer/Views/Shared/SQLServerTopic.cshtml"
                )

            </div>


            <!-- ================================================= -->
            <!-- RIGHT : TOPIC CONTENT -->
            <!-- ================================================= -->

            <div class="col-lg-9 col-xl-9 sqlserver-main">

                <div class="sqlserver-content-card">

                    @RenderBody()

                </div>

            </div>

        </div>

    </main>


    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <footer class="bg-dark text-muted text-center py-4 border-top border-secondary mt-5">

    </footer>


    <!-- ===================================================== -->
    <!-- SCRIPTS -->
    <!-- ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>