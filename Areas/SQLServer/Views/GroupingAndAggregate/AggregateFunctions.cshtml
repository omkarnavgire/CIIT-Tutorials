@{
    ViewData["Title"] = "Aggregate Functions - SQL Server";
}

<div class="container-fluid py-4">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="mb-5">

        <h1 class="fw-bold">
            Aggregate Functions
        </h1>

        <p class="lead text-muted">
            Aggregate functions perform calculations on multiple rows
            and return a single summarized result.
        </p>

    </div>


    <!-- =========================
         1. INTRODUCTION
    ========================== -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            What are Aggregate Functions?
        </h2>

        <p>
            Aggregate functions in SQL Server are used to perform
            calculations on a set of rows and return one summarized
            value.
        </p>

        <p>
            They are commonly used with the
            <strong>GROUP BY</strong> clause when we need
            department-wise, category-wise, or other grouped results.
        </p>

        <div class="alert alert-info">

            <strong>In simple words:</strong>

            <p class="mb-0 mt-2">
                Aggregate functions take multiple records as input
                and produce a calculated result.
            </p>

        </div>

    </section>


    <!-- =========================
         2. COMMON FUNCTIONS
    ========================== -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Common Aggregate Functions
        </h2>

        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>Function</th>
                        <th>Purpose</th>
                        <th>Example</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td><strong>COUNT()</strong></td>
                        <td>Counts rows or values.</td>
                        <td>COUNT(*)</td>
                    </tr>

                    <tr>
                        <td><strong>SUM()</strong></td>
                        <td>Calculates the total.</td>
                        <td>SUM(Salary)</td>
                    </tr>

                    <tr>
                        <td><strong>AVG()</strong></td>
                        <td>Calculates the average.</td>
                        <td>AVG(Salary)</td>
                    </tr>

                    <tr>
                        <td><strong>MIN()</strong></td>
                        <td>Returns the smallest value.</td>
                        <td>MIN(Salary)</td>
                    </tr>

                    <tr>
                        <td><strong>MAX()</strong></td>
                        <td>Returns the largest value.</td>
                        <td>MAX(Salary)</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>


