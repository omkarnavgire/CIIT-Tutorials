@{
    ViewData["Title"] = "WHERE Clause";
}

<section>

    <!-- PAGE INTRODUCTION -->

    <div class="mb-5">

        <h1 class="fw-bold mb-3">
            WHERE Clause
        </h1>

        <p class="lead text-muted">
            The WHERE clause is used to filter records based on a
            specified condition.
        </p>

        <p>
            When we want to retrieve only specific records from a
            table instead of all records, we use the WHERE clause.
        </p>

    </div>


    <!-- WHAT IS WHERE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            What is WHERE Clause?
        </h2>

        <p>
            The <strong>WHERE</strong> clause specifies a condition
            that must be satisfied by the records returned by a SQL
            query.
        </p>

        <p>
            It is commonly used with the SELECT, UPDATE and DELETE
            statements.
        </p>

    </section>


    <!-- BASIC SYNTAX -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Syntax
        </h2>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT column_name
FROM table_name
WHERE condition;</code></pre>

        </div>

    </section>


    <!-- SAMPLE TABLE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Example Table
        </h2>

        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>StudentId</th>
                        <th>StudentName</th>
                        <th>Age</th>
                        <th>City</th>
                        <th>Fees</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>101</td>
                        <td>Rahul</td>
                        <td>22</td>
                        <td>Pune</td>
                        <td>35000</td>
                    </tr>

                    <tr>
                        <td>102</td>
                        <td>Priya</td>
                        <td>23</td>
                        <td>Mumbai</td>
                        <td>40000</td>
                    </tr>

                    <tr>
                        <td>103</td>
                        <td>Amit</td>
                        <td>21</td>
                        <td>Nashik</td>
                        <td>30000</td>
                    </tr>

                    <tr>
                        <td>104</td>
                        <td>Neha</td>
                        <td>24</td>
                        <td>Pune</td>
                        <td>45000</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- EQUAL TO -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            WHERE with Equal (=)
        </h2>

        <p>
            The equal operator is used when we want records having
            an exact value.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE City = 'Pune';</code></pre>

        </div>

        <p class="mt-3">
            This query returns students whose city is Pune.
        </p>

    </section>


    <!-- GREATER THAN -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            WHERE with Greater Than (&gt;)
        </h2>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE Age &gt; 22;</code></pre>

        </div>

        <p class="mt-3">
            This returns students whose age is greater than 22.
        </p>

    </section>


    <!-- LESS THAN -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            WHERE with Less Than (&lt;)
        </h2>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE Age &lt; 22;</code></pre>

        </div>

        <p class="mt-3">
            This returns students whose age is less than 22.
        </p>

    </section>


    <!-- GREATER THAN OR EQUAL -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Greater Than or Equal To (&gt;=)
        </h2>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE Age &gt;= 22;</code></pre>

        </div>

    </section>


    <!-- LESS THAN OR EQUAL -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Less Than or Equal To (&lt;=)
        </h2>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE Fees &lt;= 35000;</code></pre>

        </div>

    </section>


    <!-- NOT EQUAL -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Not Equal To (&lt;&gt;)
        </h2>

        <p>
            The &lt;&gt; operator returns records where the specified
            value is different.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE City &lt;&gt; 'Pune';</code></pre>

        </div>

    </section>


    <!-- AND -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            WHERE with AND
        </h2>

        <p>
            AND is used when all specified conditions must be true.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE Age &gt; 21
AND City = 'Pune';</code></pre>

        </div>

        <p class="mt-3">
            Both conditions must be satisfied.
        </p>

    </section>


    <!-- OR -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            WHERE with OR
        </h2>

        <p>
            OR is used when at least one of the specified conditions
            should be true.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE City = 'Pune'
OR City = 'Mumbai';</code></pre>

        </div>

    </section>


    <!-- MULTIPLE CONDITIONS -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Multiple Conditions
        </h2>

        <p>
            Multiple conditions can be combined using AND and OR.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE Age &gt; 21
AND Fees &gt; 30000
AND City = 'Pune';</code></pre>

        </div>

    </section>


    <!-- WHERE WITH UPDATE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            WHERE with UPDATE
        </h2>

        <p>
            The WHERE clause can be used with UPDATE to modify only
            selected records.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>UPDATE Students
SET Fees = 40000
WHERE StudentId = 101;</code></pre>

        </div>

    </section>


    <!-- WHERE WITH DELETE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            WHERE with DELETE
        </h2>

        <p>
            The WHERE clause can be used with DELETE to remove only
            selected records.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>DELETE FROM Students
WHERE StudentId = 104;</code></pre>

        </div>

    </section>


    <!-- IMPORTANT -->

    <section class="mb-5">

        <div class="alert alert-warning border-0">

            <h4 class="fw-bold mb-3">
                Important
            </h4>

            <ul class="mb-0">

                <li class="mb-2">
                    WHERE filters records based on a condition.
                </li>

                <li class="mb-2">
                    WHERE can be used with SELECT, UPDATE and DELETE.
                </li>

                <li class="mb-2">
                    AND requires all conditions to be true.
                </li>

                <li class="mb-2">
                    OR requires at least one condition to be true.
                </li>

                <li>
                    Always check the WHERE condition before UPDATE or
                    DELETE operations.
                </li>

            </ul>

        </div>

    </section>


    <!-- SUMMARY -->

    <section class="mb-4">

        <div class="alert alert-primary border-0">

            <h2 class="fw-bold mb-3">
                Summary
            </h2>

            <p class="mb-0">
                In this section, we learned how the WHERE clause is
                used to filter records in SQL Server. We covered
                comparison operators, AND, OR, and the use of WHERE
                with SELECT, UPDATE and DELETE statements.
            </p>

        </div>

    </section>


