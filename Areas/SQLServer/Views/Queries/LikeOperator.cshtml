@{
    ViewData["Title"] = "LIKE Operator";
}

<section>

    <!-- PAGE INTRODUCTION -->

    <div class="mb-5">

        <h1 class="fw-bold mb-3">
            LIKE Operator
        </h1>

        <p class="lead text-muted">
            The LIKE operator is used to search for a specified
            pattern in a column.
        </p>

        <p>
            It is mainly used when we do not know the complete value
            and want to find records based on a particular pattern.
        </p>

    </div>


    <!-- WHAT IS LIKE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            What is LIKE Operator?
        </h2>

        <p>
            The <strong>LIKE</strong> operator is used with the
            <strong>WHERE</strong> clause to search for a specific
            pattern in character or string data.
        </p>

        <p>
            LIKE is commonly used for searching names, cities,
            email addresses and other text values.
        </p>

    </section>


    <!-- BASIC SYNTAX -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Syntax
        </h2>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT column_name
FROM table_name
WHERE column_name LIKE 'pattern';</code></pre>

        </div>

    </section>


    <!-- SAMPLE TABLE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Example Table
        </h2>

        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>StudentId</th>
                        <th>StudentName</th>
                        <th>City</th>
                        <th>Course</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>101</td>
                        <td>Rahul</td>
                        <td>Pune</td>
                        <td>.NET</td>
                    </tr>

                    <tr>
                        <td>102</td>
                        <td>Priya</td>
                        <td>Mumbai</td>
                        <td>Java</td>
                    </tr>

                    <tr>
                        <td>103</td>
                        <td>Amit</td>
                        <td>Nashik</td>
                        <td>Python</td>
                    </tr>

                    <tr>
                        <td>104</td>
                        <td>Neha</td>
                        <td>Pune</td>
                        <td>.NET</td>
                    </tr>

                    <tr>
                        <td>105</td>
                        <td>Rohan</td>
                        <td>Pune</td>
                        <td>Java</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- PERCENTAGE WILDCARD -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            % Wildcard
        </h2>

        <p>
            The <strong>%</strong> wildcard represents zero, one or
            multiple characters.
        </p>

    </section>


    <!-- STARTS WITH -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Starts With a Pattern
        </h2>

        <p>
            To find names that start with a particular character,
            place the character before the % wildcard.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE StudentName LIKE 'R%';</code></pre>

        </div>

        <p class="mt-3">
            This returns students whose names start with
            <strong>R</strong>.
        </p>

    </section>


    <!-- ENDS WITH -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Ends With a Pattern
        </h2>

        <p>
            To find names ending with a particular character, place
            the % wildcard before the character.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE StudentName LIKE '%a';</code></pre>

        </div>

        <p class="mt-3">
            This searches for names ending with the letter
            <strong>a</strong>.
        </p>

    </section>


    <!-- CONTAINS -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Contains a Pattern
        </h2>

        <p>
            To search for a character or pattern anywhere in the
            value, use % on both sides.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE StudentName LIKE '%an%';</code></pre>

        </div>

        <p class="mt-3">
            This searches for names containing the pattern
            <strong>an</strong>.
        </p>

    </section>


    <!-- UNDERSCORE WILDCARD -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            _ Underscore Wildcard
        </h2>

        <p>
            The underscore <strong>_</strong> wildcard represents
            exactly one character.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE StudentName LIKE 'R_hul';</code></pre>

        </div>

        <p class="mt-3">
            Here, the underscore represents one character between
            <strong>R</strong> and <strong>hul</strong>.
        </p>

    </section>


    <!-- MULTIPLE UNDERSCORES -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Multiple Underscores
        </h2>

        <p>
            Multiple underscore characters can be used when a fixed
            number of unknown characters are required.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE StudentName LIKE '____';</code></pre>

        </div>

        <p class="mt-3">
            This pattern matches values containing exactly four
            characters.
        </p>

    </section>


    <!-- LIKE WITH WHERE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            LIKE with WHERE
        </h2>

        <p>
            LIKE is normally used together with the WHERE clause.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT StudentName, City
FROM Students
WHERE City LIKE 'P%';</code></pre>

        </div>

        <p class="mt-3">
            This searches for cities beginning with the letter
            <strong>P</strong>.
        </p>

    </section>


    <!-- LIKE WITH AND -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            LIKE with AND
        </h2>

        <p>
            Multiple LIKE conditions can be combined using AND.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE StudentName LIKE 'R%'
AND City LIKE 'P%';</code></pre>

        </div>

        <p class="mt-3">
            This searches for students whose name starts with R and
            whose city starts with P.
        </p>

    </section>


    <!-- LIKE WITH OR -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            LIKE with OR
        </h2>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE City LIKE 'P%'
OR City LIKE 'M%';</code></pre>

        </div>

        <p class="mt-3">
            This searches for cities beginning with either P or M.
        </p>

    </section>


    <!-- NOT LIKE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            NOT LIKE
        </h2>

        <p>
            The NOT LIKE operator is used when we want values that
            do not match a specified pattern.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT *
FROM Students
WHERE StudentName NOT LIKE 'R%';</code></pre>

        </div>

        <p class="mt-3">
            This returns students whose names do not start with R.
        </p>

    </section>


    <!-- IMPORTANT -->

    <section class="mb-5">

        <div class="alert alert-warning border-0">

            <h4 class="fw-bold mb-3">
                Important
            </h4>

            <ul class="mb-0">

                <li class="mb-2">
                    LIKE is used for pattern matching.
                </li>

                <li class="mb-2">
                    % represents zero or more characters.
                </li>

                <li class="mb-2">
                    _ represents exactly one character.
                </li>

                <li class="mb-2">
                    LIKE is commonly used with WHERE.
                </li>

                <li>
                    NOT LIKE is used to exclude a matching pattern.
                </li>

            </ul>

        </div>

    </section>


    <!-- SUMMARY -->

    <section class="mb-4">

        <div class="alert alert-primary border-0">

            <h2 class="fw-bold mb-3">
                Summary
            </h2>

            <p class="mb-0">
                In this section, we learned how the LIKE operator is
                used for pattern matching in SQL Server. We covered
                the % and _ wildcards, starts-with, ends-with,
                contains, NOT LIKE, and combining LIKE with AND and OR.
            </p>

        </div>

    </section>


