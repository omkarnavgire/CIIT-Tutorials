@{
    ViewData["Title"] = "SQL Functions Introduction";
}

<div class="container-fluid">

    <!-- PAGE HEADER -->

    <div class="mb-4">
        <h1 class="fw-bold">SQL Functions Introduction</h1>

        <p class="text-muted">
            SQL Server provides built-in functions that help us perform
            calculations, manipulate data, work with dates, convert data
            types and handle NULL values.
        </p>
    </div>


    <!-- INTRODUCTION -->

    <div class="alert alert-info">

        <h4 class="fw-bold">
            What are SQL Functions?
        </h4>

        <p class="mb-0">
            SQL Functions are predefined operations provided by SQL Server
            that perform a specific task and return a value.
        </p>

    </div>


    <!-- TYPES -->

    <h2 class="fw-bold mt-4">
        Types of SQL Functions
    </h2>


    <div class="row g-4 mt-2">

        <!-- STRING -->

        <div class="col-md-6">
            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h4 class="fw-bold">
                        String Functions
                    </h4>

                    <p>
                        String functions are used to manipulate and work
                        with character and text data.
                    </p>

                    <ul>
                        <li>LEN()</li>
                        <li>UPPER()</li>
                        <li>LOWER()</li>
                        <li>SUBSTRING()</li>
                        <li>REPLACE()</li>
                    </ul>

                </div>

            </div>
        </div>


        <!-- NUMERIC -->

        <div class="col-md-6">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Numeric Functions
                    </h4>

                    <p>
                        Numeric functions are used to perform mathematical
                        calculations.
                    </p>

                    <ul>
                        <li>ABS()</li>
                        <li>CEILING()</li>
                        <li>FLOOR()</li>
                        <li>ROUND()</li>
                    </ul>

                </div>

            </div>

        </div>


        <!-- DATE TIME -->

        <div class="col-md-6">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Date &amp; Time Functions
                    </h4>

                    <p>
                        Date and time functions are used to work with
                        dates and times.
                    </p>

                    <ul>
                        <li>GETDATE()</li>
                        <li>DATEADD()</li>
                        <li>DATEDIFF()</li>
                        <li>YEAR()</li>
                        <li>MONTH()</li>
                    </ul>

                </div>

            </div>

        </div>


        <!-- CONVERSION -->

        <div class="col-md-6">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Conversion Functions
                    </h4>

                    <p>
                        Conversion functions are used to convert data
                        from one data type to another.
                    </p>

                    <ul>
                        <li>CAST()</li>
                        <li>CONVERT()</li>
                        <li>TRY_CAST()</li>
                        <li>TRY_CONVERT()</li>
                    </ul>

                </div>

            </div>

        </div>


        <!-- NULL -->

        <div class="col-md-6">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h4 class="fw-bold">
                        NULL Functions
                    </h4>

                    <p>
                        NULL functions are used to handle NULL values
                        in SQL Server.
                    </p>

                    <ul>
                        <li>ISNULL()</li>
                        <li>COALESCE()</li>
                        <li>NULLIF()</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>


    <!-- KEY POINTS -->

    <div class="alert alert-warning mt-4">

        <h5 class="fw-bold">
            Key Point
        </h5>

        <p class="mb-0">
            SQL Functions can be used inside SELECT statements to
            manipulate, calculate and transform data.
        </p>

    </div>


    <!-- PREVIOUS / NEXT -->

    <div class="d-flex justify-content-between align-items-center
        mt-5 pt-4 border-top">

        <!-- PREVIOUS -->

        <a href="/SQLServer/Joins/CrossJoin"
           class="btn btn-outline-primary">

            ← Previous: CROSS JOIN

        </a>


        <!-- NEXT -->

        <a href="/SQLServer/Functions/StringFunctions"
           class="btn btn-primary">

            Next: String Functions →

        </a>

    </div>