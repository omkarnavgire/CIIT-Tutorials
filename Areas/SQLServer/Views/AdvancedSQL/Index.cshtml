         PREVIOUS / NEXT
    ========================== -->

    <div class="d-flex justify-content-between align-items-center
        mt-5 pt-4 border-top">

        <!-- PREVIOUS -->

        <a href="/SQLServer/WindowFunctions/PartitionBy"
           class="btn btn-outline-primary">

            ← Previous: PARTITION BY

        </a>


        <!-- NEXT -->

        <a href="/SQLServer/AdvancedSQL/TemporaryTables"
           class="btn btn-primary">

            Next: Temporary Tables →

        </a>

    </div>

</div>