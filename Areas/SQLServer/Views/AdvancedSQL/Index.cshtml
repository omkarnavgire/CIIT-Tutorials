@{
    ViewData["Title"] = "Advanced SQL Introduction";
}

<div class="container-fluid">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="mb-4">

        <h1 class="fw-bold">
            Advanced SQL Introduction
        </h1>

        <p class="text-muted">
            Learn advanced SQL Server concepts used for complex
            queries, temporary data processing, dynamic queries,
            error handling and performance optimization.
        </p>

    </div>


    <!-- =========================
         INTRODUCTION
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                What is Advanced SQL?
            </h2>

            <p>
                Advanced SQL includes techniques and features that
                help developers work with complex database operations
                and build efficient SQL Server solutions.
            </p>

            <p>
                These concepts are useful when working with large
                datasets, complex queries, temporary data, dynamic
                queries and database error handling.
            </p>

            <p class="mb-0">
                Advanced SQL also helps improve query performance
                and maintainability of database applications.
            </p>

        </div>

    </div>


    <!-- =========================
         TOPICS
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-4">
                Advanced SQL Topics
            </h2>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">

                        <tr>
                            <th>#</th>
                            <th>Topic</th>
                            <th>Description</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>1</td>
                            <td>
                                <strong>Temporary Tables</strong>
                            </td>
                            <td>
                                Store temporary data during SQL operations.
                            </td>
                        </tr>

                        <tr>
                            <td>2</td>
                            <td>
                                <strong>Table Variables</strong>
                            </td>
                            <td>
                                Store temporary data using table variables.
                            </td>
                        </tr>

                        <tr>
                            <td>3</td>
                            <td>
                                <strong>Dynamic SQL</strong>
                            </td>
                            <td>
                                Build and execute SQL statements dynamically.
                            </td>
                        </tr>

                        <tr>
                            <td>4</td>
                            <td>
                                <strong>Error Handling</strong>
                            </td>
                            <td>
                                Handle SQL Server errors using
                                TRY...CATCH.
                            </td>
                        </tr>

                        <tr>
                            <td>5</td>
                            <td>
                                <strong>Performance Optimization</strong>
                            </td>
                            <td>
                                Improve query execution and database
                                performance.
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =========================
         WHY ADVANCED SQL?
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Why Learn Advanced SQL?
            </h2>

            <ul>

                <li class="mb-2">
                    Helps write complex SQL queries.
                </li>

                <li class="mb-2">
                    Helps manage temporary data.
                </li>

                <li class="mb-2">
                    Helps create dynamic queries.
                </li>

                <li class="mb-2">
                    Helps handle database errors.
                </li>

                <li class="mb-2">
                    Helps improve query performance.
                </li>

                <li>
                    Useful for real-world database applications.
                </li>

            </ul>

        </div>

    </div>


    <!-- =========================
         IMPORTANT CONCEPTS
    ========================== -->

    <div class="alert alert-info mb-4">

        <h4 class="fw-bold">
            Important
        </h4>

        <p class="mb-0">
            Advanced SQL concepts are commonly used together.
            For example, temporary tables can be used to store
            intermediate results, dynamic SQL can generate queries
            at runtime, and performance optimization can improve
            the execution of those queries.
        </p>

    </div>


    <!-- =========================
         SUMMARY
    ========================== -->

    <div class="p-4 rounded mb-4"
         style="background-color:#cfe2ff;">

        <h2 class="fw-bold mb-3">
            Summary
        </h2>

        <p>
            Advanced SQL provides powerful techniques for handling
            complex database operations.
        </p>

        <p class="mb-0">
            In this module, you will learn Temporary Tables,
            Table Variables, Dynamic SQL, Error Handling and
            Performance Optimization.
        </p>

    </div>


