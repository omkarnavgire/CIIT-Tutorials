@{
    ViewData["Title"] = "Table Variables";
}

<div class="container-fluid">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="mb-4">

        <h1 class="fw-bold text-primary">
            Table Variables
        </h1>

        <p class="text-muted">
            Learn how to declare, insert, query, update and delete
            data using Table Variables in SQL Server.
        </p>

    </div>


    <!-- =========================
         INTRODUCTION
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                What is a Table Variable?
            </h2>

            <p>
                A <strong>Table Variable</strong> is a variable that can
                temporarily store multiple rows of data in SQL Server.
            </p>

            <p>
                Table variables are declared using the
                <strong>DECLARE</strong> statement and the
                <strong>TABLE</strong> keyword.
            </p>

            <p class="mb-0">
                They are useful when we need to store a small amount of
                temporary data during a SQL batch, stored procedure or
                function.
            </p>

        </div>

    </div>


    <!-- =========================
         BASIC SYNTAX
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Syntax of Table Variable
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>DECLARE @@TableName TABLE
(
    Column1 DataType,
    Column2 DataType,
    Column3 DataType
);</code></pre>

        </div>

    </div>


    <!-- =========================
         CREATE TABLE VARIABLE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Creating a Table Variable
            </h2>

            <p>
                The following example creates a table variable named
                <strong>@@Employees</strong>.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>DECLARE @@Employees TABLE
(
    EmployeeId INT,
    EmployeeName VARCHAR(100),
    Department VARCHAR(100),
    Salary DECIMAL(10,2)
);</code></pre>

        </div>

    </div>


    <!-- =========================
         INSERT DATA
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Insert Data into Table Variable
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>INSERT INTO @@Employees
(
    EmployeeId,
    EmployeeName,
    Department,
    Salary
)
VALUES
(1, 'Amit', 'IT', 70000),
(2, 'Rahul', 'HR', 60000),
(3, 'Priya', 'IT', 80000),
(4, 'Neha', 'Finance', 65000);</code></pre>

        </div>

    </div>


    <!-- =========================
         SELECT DATA
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Select Data from Table Variable
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>SELECT *
FROM @@Employees;</code></pre>

            <h4 class="fw-bold mt-4">
                Output
            </h4>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">

                        <tr>
                            <th>EmployeeId</th>
                            <th>EmployeeName</th>
                            <th>Department</th>
                            <th>Salary</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>1</td>
                            <td>Amit</td>
                            <td>IT</td>
                            <td>70000</td>
                        </tr>

                        <tr>
                            <td>2</td>
                            <td>Rahul</td>
                            <td>HR</td>
                            <td>60000</td>
                        </tr>

                        <tr>
                            <td>3</td>
                            <td>Priya</td>
                            <td>IT</td>
                            <td>80000</td>
                        </tr>

                        <tr>
                            <td>4</td>
                            <td>Neha</td>
                            <td>Finance</td>
                            <td>65000</td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =========================
         WHERE CLAUSE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Filtering Table Variable Data
            </h2>

            <p>
                We can use WHERE conditions while querying a table variable.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>SELECT
    EmployeeName,
    Department,
    Salary
FROM @@Employees
WHERE Salary &gt; 65000;</code></pre>

        </div>

    </div>


    <!-- =========================
         UPDATE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Update Data
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>UPDATE @@Employees
SET Salary = 75000
WHERE EmployeeId = 1;</code></pre>

            <p class="mt-3 mb-0">
                Table variables support UPDATE operations just like
                regular tables.
            </p>

        </div>

    </div>


    <!-- =========================
         DELETE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Delete Data
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>DELETE FROM @@Employees
WHERE EmployeeId = 4;</code></pre>

        </div>

    </div>


    <!-- =========================
         PRIMARY KEY
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Table Variable with Primary Key
            </h2>

            <p>
                A table variable can be declared with constraints such
                as a PRIMARY KEY.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>DECLARE @@Employees TABLE
(
    EmployeeId INT PRIMARY KEY,
    EmployeeName VARCHAR(100),
    Department VARCHAR(100),
    Salary DECIMAL(10,2)
);</code></pre>

        </div>

    </div>


    <!-- =========================
         IDENTITY
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Table Variable with IDENTITY
            </h2>

            <p>
                An IDENTITY column can be used when we want SQL Server
                to automatically generate numeric values.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>DECLARE @@Employees TABLE
(
    EmployeeId INT IDENTITY(1,1),
    EmployeeName VARCHAR(100),
    Department VARCHAR(100),
    Salary DECIMAL(10,2)
);</code></pre>

        </div>

    </div>


    <!-- =========================
         INSERT USING SELECT
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Insert Data using SELECT
            </h2>

            <p>
                Data from an existing table can be inserted into a
                table variable using SELECT.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>DECLARE @@ITEmployees TABLE
(
    EmployeeId INT,
    EmployeeName VARCHAR(100),
    Salary DECIMAL(10,2)
);

INSERT INTO @@ITEmployees
SELECT
    EmployeeId,
    EmployeeName,
    Salary
FROM Employees
WHERE Department = 'IT';

SELECT *
FROM @@ITEmployees;</code></pre>

        </div>

    </div>


    <!-- =========================
         JOIN
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Table Variable with JOIN
            </h2>

            <p>
                Table variables can also participate in JOIN operations.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>DECLARE @@EmployeeDetails TABLE
(
    EmployeeId INT,
    EmployeeName VARCHAR(100),
    DepartmentId INT
);

INSERT INTO @@EmployeeDetails
SELECT
    EmployeeId,
    EmployeeName,
    DepartmentId
FROM Employees;

SELECT
    e.EmployeeName,
    d.DepartmentName
FROM @@EmployeeDetails e
INNER JOIN Departments d
    ON e.DepartmentId = d.DepartmentId;</code></pre>

        </div>

    </div>


    <!-- =========================
         TABLE VARIABLE IN PROCEDURE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Table Variable in Stored Procedure
            </h2>

            <p>
                Table variables can be declared and used inside
                stored procedures.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>CREATE PROCEDURE GetITEmployees
AS
BEGIN

    DECLARE @@Employees TABLE
    (
        EmployeeId INT,
        EmployeeName VARCHAR(100),
        Salary DECIMAL(10,2)
    );

    INSERT INTO @@Employees
    SELECT
        EmployeeId,
        EmployeeName,
        Salary
    FROM Employees
    WHERE Department = 'IT';

    SELECT *
    FROM @@Employees;

END;</code></pre>

        </div>

    </div>


    <!-- =========================
         TEMP TABLE VS TABLE VARIABLE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Temporary Table vs Table Variable
            </h2>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">

                        <tr>
                            <th>Feature</th>
                            <th>Temporary Table</th>
                            <th>Table Variable</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Declaration</td>
                            <td>CREATE TABLE #Table</td>
                            <td>DECLARE @@Table TABLE</td>
                        </tr>

                        <tr>
                            <td>Prefix</td>
                            <td>#</td>
                            <td>@@</td>
                        </tr>

                        <tr>
                            <td>Scope</td>
                            <td>Session / Procedure scope</td>
                            <td>Batch / Procedure scope</td>
                        </tr>

                        <tr>
                            <td>Indexes</td>
                            <td>Supports indexes</td>
                            <td>Supports indexes through constraints/index definitions as applicable</td>
                        </tr>

                        <tr>
                            <td>Best suited for</td>
                            <td>Larger temporary datasets</td>
                            <td>Smaller temporary datasets</td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =========================
         ADVANTAGES
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Advantages of Table Variables
            </h2>

            <ul>

                <li class="mb-2">
                    Easy to declare and use.
                </li>

                <li class="mb-2">
                    Useful for small temporary datasets.
                </li>

                <li class="mb-2">
                    Can be used inside stored procedures and functions.
                </li>

                <li class="mb-2">
                    Supports INSERT, UPDATE, DELETE and SELECT operations.
                </li>

                <li>
                    Useful for storing intermediate results.
                </li>

            </ul>

        </div>

    </div>


    <!-- =========================
         IMPORTANT POINTS
    ========================== -->

    <div class="alert alert-warning shadow-sm mb-4">

        <h4 class="fw-bold">
            Important Points
        </h4>

        <ul class="mb-0">

            <li class="mb-2">
                Table variables are declared using
                <strong>DECLARE @@TableName TABLE</strong>.
            </li>

            <li class="mb-2">
                They are useful for temporary data processing.
            </li>

            <li class="mb-2">
                They support normal DML operations.
            </li>

            <li class="mb-2">
                They can contain constraints such as PRIMARY KEY.
            </li>

            <li>
                They are commonly used for smaller temporary datasets.
            </li>

        </ul>

    </div>


    <!-- =========================
         SUMMARY
    ========================== -->

    <div class="card shadow-sm mb-4"
         style="background-color:#cfe2ff;">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Summary
            </h2>

            <p>
                Table Variables provide a convenient way to store
                temporary data inside SQL Server batches, procedures
                and functions.
            </p>

            <p class="mb-0">
                They are declared using the DECLARE statement and
                TABLE keyword and support common SQL operations such
                as SELECT, INSERT, UPDATE and DELETE.
            </p>

        </div>

    </div>


