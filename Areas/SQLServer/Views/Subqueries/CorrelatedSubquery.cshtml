@{
    ViewData["Title"] = "Correlated Subquery";
}

<div class="container-fluid">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="mb-4">

        <h1 class="fw-bold">
            Correlated Subquery
        </h1>

        <p class="text-muted">
            Learn how a correlated subquery works with the outer query
            and is evaluated for each row.
        </p>

    </div>


    <!-- =========================
         WHAT IS CORRELATED SUBQUERY?
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                What is a Correlated Subquery?
            </h2>

            <p>
                A <strong>Correlated Subquery</strong> is a subquery
                that depends on a value from the outer query.
            </p>

            <p>
                Unlike a normal subquery, a correlated subquery cannot
                work independently because it references a column from
                the outer query.
            </p>

            <p>
                The subquery is evaluated for each row processed by the
                outer query.
            </p>

        </div>

    </div>


    <!-- =========================
         BASIC STRUCTURE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Basic Structure
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>
SELECT column_name
FROM table_name AS outer_table
WHERE condition
(
    SELECT column_name
    FROM table_name AS inner_table
    WHERE inner_table.column = outer_table.column
);
            </code></pre>

            <p class="mt-3 mb-0">
                Notice that the inner query refers to a column from
                the outer query. This dependency makes the subquery
                correlated.
            </p>

        </div>

    </div>


