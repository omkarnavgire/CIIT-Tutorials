@{
    ViewData["Title"] = "Multiple-Row Subquery";
}

<div class="container-fluid">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="mb-4">

        <h1 class="fw-bold">
            Multiple-Row Subquery
        </h1>

        <p class="text-muted">
            Learn how to use a subquery that returns multiple rows
            or multiple values.
        </p>

    </div>


    <!-- =========================
         WHAT IS MULTIPLE-ROW SUBQUERY?
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                What is a Multiple-Row Subquery?
            </h2>

            <p>
                A <strong>Multiple-Row Subquery</strong> is a subquery
                that returns more than one row or value.
            </p>

            <p>
                Since the subquery can return multiple values, operators
                such as <strong>IN</strong>, <strong>ANY</strong> and
                <strong>ALL</strong> are commonly used with it.
            </p>

        </div>

    </div>


    <!-- =========================
         BASIC SYNTAX
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Basic Syntax
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>
SELECT column_name
FROM table_name
WHERE column_name IN
(
    SELECT column_name
    FROM another_table
    WHERE condition
);
            </code></pre>

            <p class="mt-3 mb-0">
                The inner query returns multiple values and the outer
                query uses those values to filter records.
            </p>

        </div>

    </div>


