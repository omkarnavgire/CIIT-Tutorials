@{
    ViewData["Title"] = "Creating a View";
}

<div class="container-fluid">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="mb-4">

        <h1 class="fw-bold">
            Creating a View
        </h1>

        <p class="text-muted">
            Learn how to create a SQL Server View using the CREATE VIEW
            statement with simple and practical examples.
        </p>

    </div>


    <!-- =========================
         INTRODUCTION
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Introduction
            </h2>

            <p>
                A SQL View is created using the
                <strong>CREATE VIEW</strong> statement.
            </p>

            <p>
                A View contains a SELECT query that defines the data
                that will be displayed when the View is queried.
            </p>

            <p>
                Once created, the View can be used like a virtual table
                with a normal SELECT statement.
            </p>

        </div>

    </div>


    <!-- =========================
         CREATE VIEW SYNTAX
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                CREATE VIEW Syntax
            </h2>

            <pre class="bg-dark text-light p-3 rounded"><code>CREATE VIEW ViewName
AS
SELECT column1, column2, ...
FROM TableName
WHERE condition;</code></pre>

            <h5 class="fw-bold mt-4">
                Explanation
            </h5>

            <ul>

                <li class="mb-2">
                    <strong>CREATE VIEW</strong> is used to create a new View.
                </li>

                <li class="mb-2">
                    <strong>ViewName</strong> is the name given to the View.
                </li>

                <li class="mb-2">
                    <strong>AS</strong> separates the View name from the
                    SELECT query.
                </li>

                <li>
                    The SELECT query defines the data returned by the View.
                </li>

            </ul>

        </div>

    </div>


    <!-- =========================
         SAMPLE TABLE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Example Table
            </h2>

            <p>
                Consider the following <strong>Employees</strong> table:
            </p>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-primary">

                        <tr>
                            <th>EmployeeId</th>
                            <th>EmployeeName</th>
                            <th>Department</th>
                            <th>Salary</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>1</td>
                            <td>Rahul</td>
                            <td>IT</td>
                            <td>45000</td>
                        </tr>

                        <tr>
                            <td>2</td>
                            <td>Priya</td>
                            <td>HR</td>
                            <td>40000</td>
                        </tr>

                        <tr>
                            <td>3</td>
                            <td>Amit</td>
                            <td>IT</td>
                            <td>55000</td>
                        </tr>

                        <tr>
                            <td>4</td>
                            <td>Sneha</td>
                            <td>Finance</td>
                            <td>50000</td>
                        </tr>

                        <tr>
                            <td>5</td>
                            <td>Neha</td>
                            <td>IT</td>
                            <td>60000</td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =========================
         SIMPLE VIEW
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Example 1: Create a Simple View
            </h2>

            <p>
                Suppose we want a View that displays employee name and
                department only.
            </p>

            <pre class="bg-dark text-light p-3 rounded"><code>CREATE VIEW EmployeeDepartmentView
AS
SELECT
    EmployeeName,
    Department
FROM Employees;</code></pre>

            <h5 class="fw-bold mt-4">
                Execute the View
            </h5>

            <pre class="bg-dark text-light p-3 rounded"><code>SELECT *
FROM EmployeeDepartmentView;</code></pre>

        </div>

    </div>


    <!-- =========================
         VIEW WITH WHERE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Example 2: View with WHERE Clause
            </h2>

            <p>
                A View can also contain a WHERE condition.
                For example, we can create a View that displays
                only IT department employees.
            </p>

            <pre class="bg-dark text-light p-3 rounded"><code>CREATE VIEW ITEmployeesView
AS
SELECT
    EmployeeId,
    EmployeeName,
    Department,
    Salary
FROM Employees
WHERE Department = 'IT';</code></pre>

            <h5 class="fw-bold mt-4">
                Retrieve Data
            </h5>

            <pre class="bg-dark text-light p-3 rounded"><code>SELECT *
FROM ITEmployeesView;</code></pre>

        </div>

    </div>


    <!-- =========================
         VIEW WITH SELECTED COLUMNS
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Example 3: Selecting Specific Columns
            </h2>

            <p>
                A View does not need to contain every column from the
                original table.
            </p>

            <pre class="bg-dark text-light p-3 rounded"><code>CREATE VIEW EmployeeSalaryView
AS
SELECT
    EmployeeName,
    Salary
FROM Employees;</code></pre>

            <p class="mt-3">
                Now the View exposes only the employee name and salary.
            </p>

            <pre class="bg-dark text-light p-3 rounded"><code>SELECT *
FROM EmployeeSalaryView;</code></pre>

        </div>

    </div>


    <!-- =========================
         VIEW WITH MULTIPLE TABLES
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Example 4: View Using Multiple Tables
            </h2>

            <p>
                A View can also be created using a JOIN between multiple
                tables.
            </p>

            <pre class="bg-dark text-light p-3 rounded"><code>CREATE VIEW EmployeeDepartmentDetails
AS
SELECT
    e.EmployeeId,
    e.EmployeeName,
    d.DepartmentName
FROM Employees e
INNER JOIN Departments d
    ON e.DepartmentId = d.DepartmentId;</code></pre>

            <p class="mt-3">
                This View combines employee information with department
                information.
            </p>

        </div>

    </div>


    <!-- =========================
         CHECK VIEW
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Checking the Created View
            </h2>

            <p>
                After creating a View, we can retrieve its data using
                a SELECT statement.
            </p>

            <pre class="bg-dark text-light p-3 rounded"><code>SELECT *
FROM EmployeeDepartmentView;</code></pre>

            <p class="mt-3">
                SQL Server executes the query defined by the View and
                returns the result.
            </p>

        </div>

    </div>


    <!-- =========================
         LIST VIEWS
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Viewing Existing Views
            </h2>

            <p>
                SQL Server provides system catalog information that can
                be used to find Views in a database.
            </p>

            <pre class="bg-dark text-light p-3 rounded"><code>SELECT
    name
FROM sys.views;</code></pre>

            <p class="mt-3">
                This query displays the names of Views available in
                the current database.
            </p>

        </div>

    </div>


    <!-- =========================
         IMPORTANT POINTS
    ========================== -->

    <div class="alert alert-warning shadow-sm mb-4">

        <h3 class="fw-bold mb-3">
            Important Points
        </h3>

        <ul class="mb-0">

            <li class="mb-2">
                Use <strong>CREATE VIEW</strong> to create a View.
            </li>

            <li class="mb-2">
                The View definition contains a SELECT query.
            </li>

            <li class="mb-2">
                A View can select specific columns instead of all columns.
            </li>

            <li class="mb-2">
                A View can contain filtering conditions using WHERE.
            </li>

            <li class="mb-2">
                A View can be based on multiple tables using JOINs.
            </li>

            <li>
                After creating a View, it can be queried using SELECT.
            </li>

        </ul>

    </div>


    <!-- =========================
         SUMMARY
    ========================== -->

    <div class="alert alert-primary shadow-sm mb-4">

        <h2 class="fw-bold">
            Summary
        </h2>

        <p class="mb-0">
            The CREATE VIEW statement is used to create a SQL Server
            View. A View is based on a SELECT query and can contain
            selected columns, filtering conditions and data from
            multiple tables. Once created, it can be queried like
            a virtual table.
        </p>

    </div>


