@{
    ViewData["Title"] = "CROSS JOIN";
}

<section>

    <!-- PAGE INTRODUCTION -->

    <div class="mb-5">

        <h1 class="fw-bold mb-3">
            CROSS JOIN
        </h1>

        <p class="lead text-muted">
            CROSS JOIN returns every possible combination of rows
            from two tables.
        </p>

        <p>
            Unlike INNER JOIN, LEFT JOIN, or RIGHT JOIN, CROSS JOIN
            does not require an ON condition. It creates a
            <strong>Cartesian Product</strong> of the two tables.
        </p>

    </div>


    <!-- WHAT IS CROSS JOIN -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            What is CROSS JOIN?
        </h2>

        <p>
            A <strong>CROSS JOIN</strong> combines every row from the
            first table with every row from the second table.
        </p>

        <p>
            For example, if the first table contains 3 rows and the
            second table contains 4 rows, the result will contain:
        </p>

        <div class="alert alert-info border-0">

            <strong>3 × 4 = 12 rows</strong>

        </div>

        <p>
            This type of result is called a
            <strong>Cartesian Product</strong>.
        </p>

    </section>


    <!-- BASIC SYNTAX -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            CROSS JOIN Syntax
        </h2>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT columns
FROM Table1
CROSS JOIN Table2;</code></pre>

        </div>

        <div class="alert alert-warning border-0 mt-4">

            <strong>Important:</strong>
            CROSS JOIN does not normally use an
            <strong>ON</strong> condition.

        </div>

    </section>


    <!-- SAMPLE TABLES -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Example Tables
        </h2>


        <h4 class="fw-bold mt-4 mb-3">
            Students Table
        </h4>

        <div class="table-responsive mb-4">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>StudentId</th>
                        <th>StudentName</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>101</td>
                        <td>Rahul</td>
                    </tr>

                    <tr>
                        <td>102</td>
                        <td>Priya</td>
                    </tr>

                    <tr>
                        <td>103</td>
                        <td>Amit</td>
                    </tr>

                </tbody>

            </table>

        </div>


        <h4 class="fw-bold mt-4 mb-3">
            Courses Table
        </h4>

        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>CourseId</th>
                        <th>CourseName</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>1</td>
                        <td>.NET Full Stack</td>
                    </tr>

                    <tr>
                        <td>2</td>
                        <td>Java Full Stack</td>
                    </tr>

                    <tr>
                        <td>3</td>
                        <td>Python Full Stack</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- BASIC EXAMPLE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Basic CROSS JOIN Example
        </h2>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT
    Students.StudentName,
    Courses.CourseName
FROM Students
CROSS JOIN Courses;</code></pre>

        </div>

    </section>


    <!-- RESULT -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Result
        </h2>

        <p>
            Students contains 3 records and Courses contains
            3 records.
        </p>

        <p>
            Therefore:
        </p>

        <div class="alert alert-primary border-0">

            <strong>3 × 3 = 9 combinations</strong>

        </div>


        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>StudentName</th>
                        <th>CourseName</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>Rahul</td>
                        <td>.NET Full Stack</td>
                    </tr>

                    <tr>
                        <td>Rahul</td>
                        <td>Java Full Stack</td>
                    </tr>

                    <tr>
                        <td>Rahul</td>
                        <td>Python Full Stack</td>
                    </tr>

                    <tr>
                        <td>Priya</td>
                        <td>.NET Full Stack</td>
                    </tr>

                    <tr>
                        <td>Priya</td>
                        <td>Java Full Stack</td>
                    </tr>

                    <tr>
                        <td>Priya</td>
                        <td>Python Full Stack</td>
                    </tr>

                    <tr>
                        <td>Amit</td>
                        <td>.NET Full Stack</td>
                    </tr>

                    <tr>
                        <td>Amit</td>
                        <td>Java Full Stack</td>
                    </tr>

                    <tr>
                        <td>Amit</td>
                        <td>Python Full Stack</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- CARTESIAN PRODUCT -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Cartesian Product
        </h2>

        <p>
            The result produced by a CROSS JOIN is known as a
            <strong>Cartesian Product</strong>.
        </p>

        <p>
            Every row of the first table is combined with every row
            of the second table.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>Number of Result Rows
=
Rows in Table 1
×
Rows in Table 2</code></pre>

        </div>

    </section>


    <!-- CROSS JOIN WITH THREE TABLES -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            CROSS JOIN with Multiple Tables
        </h2>

        <p>
            CROSS JOIN can also be used with more than two tables.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT
    S.StudentName,
    C.CourseName,
    T.TrainerName
FROM Students AS S
CROSS JOIN Courses AS C
CROSS JOIN Trainers AS T;</code></pre>

        </div>

        <p class="mt-3">
            This produces combinations between all rows of the
            participating tables.
        </p>

    </section>


    <!-- CROSS JOIN WITH WHERE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            CROSS JOIN with WHERE
        </h2>

        <p>
            A WHERE condition can be used after a CROSS JOIN when
            specific combinations need to be selected.
        </p>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT
    S.StudentName,
    C.CourseName
FROM Students AS S
CROSS JOIN Courses AS C
WHERE C.CourseName = '.NET Full Stack';</code></pre>

        </div>

        <p class="mt-3">
            This filters the combinations and returns only those
            involving the .NET Full Stack course.
        </p>

    </section>


    <!-- PRACTICAL USE -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Practical Uses of CROSS JOIN
        </h2>

        <p>
            CROSS JOIN is useful when every possible combination is
            required.
        </p>

        <ul>

            <li class="mb-2">
                Creating combinations of products and sizes.
            </li>

            <li class="mb-2">
                Generating combinations of courses and batches.
            </li>

            <li class="mb-2">
                Creating possible schedules.
            </li>

            <li class="mb-2">
                Generating test data combinations.
            </li>

            <li>
                Creating all possible combinations between categories.
            </li>

        </ul>

    </section>


    <!-- CROSS JOIN VS INNER JOIN -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            CROSS JOIN vs INNER JOIN
        </h2>

        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>CROSS JOIN</th>
                        <th>INNER JOIN</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>
                            Returns every possible combination.
                        </td>

                        <td>
                            Returns only matching records.
                        </td>
                    </tr>

                    <tr>
                        <td>
                            Does not require an ON condition.
                        </td>

                        <td>
                            Usually uses an ON condition.
                        </td>
                    </tr>

                    <tr>
                        <td>
                            Produces a Cartesian Product.
                        </td>

                        <td>
                            Produces related matching records.
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- IMPORTANT POINTS -->

    <section class="mb-5">

        <div class="alert alert-warning border-0">

            <h4 class="fw-bold mb-3">
                Important Points
            </h4>

            <ul class="mb-0">

                <li class="mb-2">
                    CROSS JOIN returns every possible combination
                    between two tables.
                </li>

                <li class="mb-2">
                    CROSS JOIN does not require an ON condition.
                </li>

                <li class="mb-2">
                    The result is called a Cartesian Product.
                </li>

                <li class="mb-2">
                    Number of rows = rows in first table × rows in
                    second table.
                </li>

                <li class="mb-2">
                    CROSS JOIN can produce a very large result when
                    tables contain many rows.
                </li>

                <li>
                    CROSS JOIN should therefore be used carefully.
                </li>

            </ul>

        </div>

    </section>


    <!-- SUMMARY -->

    <section class="mb-4">

        <div class="alert alert-primary border-0">

            <h2 class="fw-bold mb-3">
                Summary
            </h2>

            <p class="mb-0">
                CROSS JOIN returns every possible combination of rows
                from two tables. It creates a Cartesian Product and
                does not require an ON condition. It is useful when
                all possible combinations between two sets of data
                are required.
            </p>

        </div>

    </section>



