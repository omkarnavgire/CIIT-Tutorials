                        <td>1</td>
                    </tr>

                    <tr>
                        <td>102</td>
                        <td>Priya</td>
                        <td>2</td>
                    </tr>

                    <tr>
                        <td>103</td>
                        <td>Amit</td>
                        <td>1</td>
                    </tr>

                    <tr>
                        <td>104</td>
                        <td>Neha</td>
                        <td>3</td>
                    </tr>

                    <tr>
                        <td>105</td>
                        <td>Rohan</td>
                        <td>5</td>
                    </tr>

                </tbody>

            </table>

        </div>


        <h4 class="fw-bold mt-4 mb-3">
            Courses Table
        </h4>

        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>CourseId</th>
                        <th>CourseName</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>1</td>
                        <td>.NET Full Stack</td>
                    </tr>

                    <tr>
