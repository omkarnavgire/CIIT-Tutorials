@{
    ViewData["Title"] = "INNER JOIN";
}

<section>

    <!-- PAGE INTRODUCTION -->

    <div class="mb-5">

        <h1 class="fw-bold mb-3">
            INNER JOIN
        </h1>

        <p class="lead text-muted">
            INNER JOIN is used to return only the records that have
            matching values in both tables.
        </p>

        <p>
            It is one of the most commonly used JOINs in SQL Server.
            When two tables are related through a common column,
            INNER JOIN can be used to retrieve matching information
            from both tables.
        </p>

    </div>


    <!-- WHAT IS INNER JOIN -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            What is INNER JOIN?
        </h2>

        <p>
            An <strong>INNER JOIN</strong> returns rows when there is
            a matching value in both the left table and the right
            table.
        </p>

        <p>
            If a record exists in one table but there is no matching
            record in the other table, that record is not included
            in the result.
        </p>

    </section>


    <!-- BASIC SYNTAX -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            INNER JOIN Syntax
        </h2>

        <div class="code-block">

            <div class="code-lang-tag">
                SQL
            </div>

            <pre class="mb-0"><code>SELECT columns
FROM Table1
INNER JOIN Table2
    ON Table1.CommonColumn = Table2.CommonColumn;</code></pre>

        </div>

    </section>


    <!-- SAMPLE TABLES -->

    <section class="mb-5">

        <h2 class="fw-bold mb-3">
            Example Tables
        </h2>

        <h4 class="fw-bold mt-4 mb-3">
            Students Table
        </h4>

        <div class="table-responsive mb-4">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>StudentId</th>
                        <th>StudentName</th>
                        <th>CourseId</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
