    ViewData["Title"] = "ROW_NUMBER()";
}

<div class="container-fluid">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="mb-4">

        <h1 class="fw-bold">
            ROW_NUMBER()
        </h1>

        <p class="text-muted">
            Learn how to use the ROW_NUMBER() Window Function
            in SQL Server to assign a unique sequential number
            to each row.
        </p>

    </div>


    <!-- =========================
         WHAT IS ROW_NUMBER()
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                What is ROW_NUMBER()?
            </h2>

            <p>
                <strong>ROW_NUMBER()</strong> is a SQL Server Window Function
                that assigns a unique sequential number to each row
                returned by a query.
            </p>

            <p>
                The numbering starts from <strong>1</strong> and continues
                according to the order specified inside the
                <strong>OVER()</strong> clause.
            </p>

            <p class="mb-0">
                It is commonly used for ranking, pagination,
                duplicate detection and selecting specific rows.
            </p>

        </div>

    </div>


    <!-- =========================
         SYNTAX
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Syntax
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>ROW_NUMBER()
OVER
(
    ORDER BY column_name
)</code></pre>

            <p class="mt-3 mb-0">
                The <strong>ORDER BY</strong> clause determines
                the order in which the row numbers are assigned.
            </p>

        </div>

    </div>


    <!-- =========================
         BASIC EXAMPLE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Basic Example
            </h2>

            <p>
                Suppose we have an <strong>Employees</strong> table
                containing employee details.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>SELECT
    EmployeeId,
    EmployeeName,
    Salary,

    ROW_NUMBER() OVER
    (
        ORDER BY Salary DESC
    ) AS RowNumber

FROM Employees;</code></pre>

        </div>

    </div>


