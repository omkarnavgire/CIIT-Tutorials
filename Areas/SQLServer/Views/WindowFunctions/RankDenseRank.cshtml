@{
    ViewData["Title"] = "RANK() and DENSE_RANK()";
}

<div class="container-fluid">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="mb-4">

        <h1 class="fw-bold">
            RANK() and DENSE_RANK()
        </h1>

        <p class="text-muted">
            Learn how to use RANK() and DENSE_RANK() Window Functions
            in SQL Server to assign rankings to rows.
        </p>

    </div>


    <!-- =========================
         INTRODUCTION
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                What are RANK() and DENSE_RANK()?
            </h2>

            <p>
                <strong>RANK()</strong> and
                <strong>DENSE_RANK()</strong> are SQL Server Window
                Functions used to assign rankings to rows based on
                a specified order.
            </p>

            <p>
                Both functions assign the same rank to rows when they
                contain the same value.
            </p>

            <p class="mb-0">
                The main difference is how they handle the next rank
                when duplicate values are present.
            </p>

        </div>

    </div>


    <!-- =========================
         RANK()
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                RANK()
            </h2>

            <p>
                The <strong>RANK()</strong> function assigns the same
                rank to rows having equal values.
            </p>

            <p>
                When duplicate values occur, the next rank is skipped.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>SELECT
    EmployeeId,
    EmployeeName,
    Salary,

    RANK() OVER
    (
        ORDER BY Salary DESC
    ) AS SalaryRank

FROM Employees;</code></pre>

        </div>

    </div>


    <!-- =========================
         RANK OUTPUT
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                RANK() Example
            </h2>

            <p>
                Suppose the employee salaries are:
            </p>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">

                        <tr>
                            <th>EmployeeName</th>
                            <th>Salary</th>
                            <th>RANK()</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Rahul</td>
                            <td>80000</td>
                            <td>1</td>
                        </tr>

                        <tr>
                            <td>Amit</td>
                            <td>70000</td>
                            <td>2</td>
                        </tr>

                        <tr>
                            <td>Priya</td>
                            <td>70000</td>
                            <td>2</td>
                        </tr>

                        <tr>
                            <td>Neha</td>
                            <td>60000</td>
                            <td>4</td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <p class="mt-3 mb-0">
                Amit and Priya both have a salary of 70000, so both
                receive rank <strong>2</strong>. The next rank becomes
                <strong>4</strong>, because rank 3 is skipped.
            </p>

        </div>

    </div>


    <!-- =========================
         DENSE_RANK()
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                DENSE_RANK()
            </h2>

            <p>
                The <strong>DENSE_RANK()</strong> function also assigns
                the same rank to rows having equal values.
            </p>

            <p>
                However, unlike RANK(), it does not skip the next
                ranking number after duplicate values.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>SELECT
    EmployeeId,
    EmployeeName,
    Salary,

    DENSE_RANK() OVER
    (
        ORDER BY Salary DESC
    ) AS SalaryRank

FROM Employees;</code></pre>

        </div>

    </div>


    <!-- =========================
         DENSE_RANK OUTPUT
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                DENSE_RANK() Example
            </h2>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">

                        <tr>
                            <th>EmployeeName</th>
                            <th>Salary</th>
                            <th>DENSE_RANK()</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Rahul</td>
                            <td>80000</td>
                            <td>1</td>
                        </tr>

                        <tr>
                            <td>Amit</td>
                            <td>70000</td>
                            <td>2</td>
                        </tr>

                        <tr>
                            <td>Priya</td>
                            <td>70000</td>
                            <td>2</td>
                        </tr>

                        <tr>
                            <td>Neha</td>
                            <td>60000</td>
                            <td>3</td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <p class="mt-3 mb-0">
                Amit and Priya both receive rank <strong>2</strong>,
                but Neha receives rank <strong>3</strong>.
                No rank is skipped.
            </p>

        </div>

    </div>


    <!-- =========================
         MAIN DIFFERENCE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Difference Between RANK() and DENSE_RANK()
            </h2>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">

                        <tr>
                            <th>Feature</th>
                            <th>RANK()</th>
                            <th>DENSE_RANK()</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Same values get same rank</td>
                            <td>Yes</td>
                            <td>Yes</td>
                        </tr>

                        <tr>
                            <td>Skips rank after duplicate</td>
                            <td>Yes</td>
                            <td>No</td>
                        </tr>

                        <tr>
                            <td>Example</td>
                            <td>1, 2, 2, 4</td>
                            <td>1, 2, 2, 3</td>
                        </tr>

                        <tr>
                            <td>Useful for ranking</td>
                            <td>Yes</td>
                            <td>Yes</td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =========================
         VISUAL EXPLANATION
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Easy Way to Remember
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>Values:

100
90
90
80

RANK():

100 → 1
90  → 2
90  → 2
80  → 4


DENSE_RANK():

100 → 1
90  → 2
90  → 2
80  → 3</code></pre>

        </div>

    </div>


    <!-- =========================
         RANK WITH PARTITION
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                RANK() with PARTITION BY
            </h2>

            <p>
                We can use <strong>PARTITION BY</strong> with RANK()
                to create separate rankings for different groups.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>SELECT
    EmployeeId,
    EmployeeName,
    Department,
    Salary,

    RANK() OVER
    (
        PARTITION BY Department
        ORDER BY Salary DESC
    ) AS DepartmentRank

FROM Employees;</code></pre>

            <p class="mt-3 mb-0">
                In this example, employees are ranked separately
                within each department.
            </p>

        </div>

    </div>


    <!-- =========================
         DENSE_RANK WITH PARTITION
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                DENSE_RANK() with PARTITION BY
            </h2>

            <p>
                DENSE_RANK() can also be used with PARTITION BY.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>SELECT
    EmployeeId,
    EmployeeName,
    Department,
    Salary,

    DENSE_RANK() OVER
    (
        PARTITION BY Department
        ORDER BY Salary DESC
    ) AS DepartmentRank

FROM Employees;</code></pre>

            <p class="mt-3 mb-0">
                The ranking starts again for every department,
                without leaving gaps between ranking numbers.
            </p>

        </div>

    </div>


    <!-- =========================
         PRACTICAL USES
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Practical Uses
            </h2>

            <ul>

                <li class="mb-2">
                    Ranking employees based on salary.
                </li>

                <li class="mb-2">
                    Ranking students based on marks.
                </li>

                <li class="mb-2">
                    Ranking products based on sales.
                </li>

                <li class="mb-2">
                    Finding top-performing employees.
                </li>

                <li class="mb-2">
                    Creating department-wise rankings.
                </li>

                <li>
                    Comparing records based on a particular value.
                </li>

            </ul>

        </div>

    </div>


    <!-- =========================
         IMPORTANT POINTS
    ========================== -->

    <div class="alert alert-warning mb-4">

        <h4 class="fw-bold">
            Important Points
        </h4>

        <ul class="mb-0">

            <li class="mb-2">
                Both RANK() and DENSE_RANK() use the
                <strong>OVER()</strong> clause.
            </li>

            <li class="mb-2">
                Equal values receive the same rank.
            </li>

            <li class="mb-2">
                RANK() skips ranking numbers after duplicates.
            </li>

            <li class="mb-2">
                DENSE_RANK() does not skip ranking numbers.
            </li>

            <li>
                PARTITION BY can create separate rankings for
                different groups.
            </li>

        </ul>

    </div>


    <!-- =========================
         SUMMARY
    ========================== -->

    <div class="p-4 rounded mb-4"
         style="background-color:#cfe2ff;">

        <h2 class="fw-bold mb-3">
            Summary
        </h2>

        <p>
            <strong>RANK()</strong> and
            <strong>DENSE_RANK()</strong> are Window Functions
            used to assign rankings to rows.
        </p>

        <p class="mb-0">
            RANK() leaves gaps after duplicate rankings, while
            DENSE_RANK() continues with the next consecutive ranking.
            Both functions can be combined with PARTITION BY to
            calculate rankings separately for different groups.
        </p>

    </div>


