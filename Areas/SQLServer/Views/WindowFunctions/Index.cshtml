@{
    ViewData["Title"] = "Window Functions Introduction";
}

<div class="container-fluid">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="mb-4">

        <h1 class="fw-bold">
            Window Functions Introduction
        </h1>

        <p class="text-muted">
            Learn how SQL Server Window Functions work and how they are
            used to perform calculations across related rows without
            grouping the result into a single row.
        </p>

    </div>


    <!-- =========================
         INTRODUCTION
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                What are Window Functions?
            </h2>

            <p>
                Window Functions in SQL Server perform calculations across
                a set of rows that are related to the current row.
            </p>

            <p>
                Unlike aggregate functions such as
                <strong>SUM()</strong>, <strong>AVG()</strong> and
                <strong>COUNT()</strong>, Window Functions do not combine
                multiple rows into a single result row.
            </p>

            <p class="mb-0">
                Instead, they return a calculated value for each row while
                still keeping the individual rows in the result.
            </p>

        </div>

    </div>


    <!-- =========================
         WHY USE WINDOW FUNCTIONS
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Why Use Window Functions?
            </h2>

            <ul>

                <li class="mb-2">
                    To calculate rankings for records.
                </li>

                <li class="mb-2">
                    To assign row numbers to records.
                </li>

                <li class="mb-2">
                    To compare the current row with previous or next rows.
                </li>

                <li class="mb-2">
                    To calculate running totals and averages.
                </li>

                <li class="mb-2">
                    To divide data into groups or partitions.
                </li>

                <li>
                    To perform analytical calculations without losing
                    individual rows.
                </li>

            </ul>

        </div>

    </div>


    <!-- =========================
         COMMON WINDOW FUNCTIONS
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Common Window Functions
            </h2>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">

                        <tr>
                            <th>Function</th>
                            <th>Purpose</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>
                                <strong>ROW_NUMBER()</strong>
                            </td>

                            <td>
                                Assigns a unique sequential number to each row.
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <strong>RANK()</strong>
                            </td>

                            <td>
                                Assigns a rank to rows and leaves gaps when
                                duplicate values occur.
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <strong>DENSE_RANK()</strong>
                            </td>

                            <td>
                                Assigns a rank without leaving gaps between
                                duplicate ranking values.
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <strong>LEAD()</strong>
                            </td>

                            <td>
                                Accesses a value from a following row.
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <strong>LAG()</strong>
                            </td>

                            <td>
                                Accesses a value from a previous row.
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =========================
         BASIC SYNTAX
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Basic Window Function Syntax
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>SELECT
    column_name,
    WindowFunction() OVER
    (
        PARTITION BY column_name
        ORDER BY column_name
    ) AS Result
FROM TableName;</code></pre>

        </div>

    </div>


    <!-- =========================
         SIMPLE EXAMPLE
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Example: ROW_NUMBER()
            </h2>

            <p>
                Suppose we have an <strong>Employees</strong> table.
                We can use <strong>ROW_NUMBER()</strong> to assign a
                sequential number to each employee.
            </p>

            <pre class="bg-dark text-white p-3 rounded"><code>SELECT
    EmployeeId,
    EmployeeName,
    Salary,

    ROW_NUMBER() OVER
    (
        ORDER BY Salary DESC
    ) AS RowNumber

FROM Employees;</code></pre>

            <p class="mt-3 mb-0">
                The result contains every employee along with a sequential
                row number based on salary in descending order.
            </p>

        </div>

    </div>


    <!-- =========================
         IMPORTANT POINTS
    ========================== -->

    <div class="alert alert-warning mb-4">

        <h4 class="fw-bold">
            Important Points
        </h4>

        <ul class="mb-0">

            <li>
                Window Functions use the <strong>OVER()</strong> clause.
            </li>

            <li>
                <strong>ORDER BY</strong> inside OVER() determines the
                order used for the calculation.
            </li>

            <li>
                <strong>PARTITION BY</strong> divides rows into separate
                groups for the calculation.
            </li>

            <li>
                Window Functions normally keep individual rows in the
                result.
            </li>

        </ul>

    </div>


    <!-- =========================
         SUMMARY
    ========================== -->

    <div class="p-4 rounded mb-4"
         style="background-color:#cfe2ff;">

        <h2 class="fw-bold">
            Summary
        </h2>

        <p>
            Window Functions are powerful SQL Server features used for
            analytical calculations across related rows while preserving
            individual records in the result.
        </p>

        <p class="mb-0">
            Common Window Functions include
            <strong>ROW_NUMBER()</strong>,
            <strong>RANK()</strong>,
            <strong>DENSE_RANK()</strong>,
            <strong>LEAD()</strong> and
            <strong>LAG()</strong>.
            These functions are commonly combined with
            <strong>OVER()</strong>, <strong>ORDER BY</strong> and
            <strong>PARTITION BY</strong>.
        </p>

    </div>


