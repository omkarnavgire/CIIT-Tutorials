@{
    ViewData["Title"] = "PARTITION BY";
}

<div class="container-fluid">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="mb-4">

        <h1 class="fw-bold">
            PARTITION BY
        </h1>

        <p class="text-muted">
            Learn how to use PARTITION BY with SQL Server Window
            Functions to perform calculations separately for
            different groups.
        </p>

    </div>


    <!-- =========================
         INTRODUCTION
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                What is PARTITION BY?
            </h2>

            <p>
                <strong>PARTITION BY</strong> is used with SQL Server
                Window Functions to divide the result set into
                separate groups.
            </p>

            <p>
                The Window Function then performs its calculation
                separately within each group.
            </p>

            <p class="mb-0">
                Unlike GROUP BY, PARTITION BY does not combine rows
                into a single row. All original rows remain in the
                result.
            </p>

        </div>

    </div>


    <!-- =========================
         SYNTAX
    ========================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-3">
                Syntax
            </h2>

            <pre class="bg-dark text-white p-3 rounded"><code>WindowFunction()
OVER
(
    PARTITION BY column_name
    ORDER BY column_name
)</code></pre>

            <p class="mt-3 mb-0">
                PARTITION BY defines the groups, while ORDER BY
                determines the order within each group.
            </p>

        </div>

    </div>


    <!-- =========================
         SAMPLE DATA
    ========================== -->

